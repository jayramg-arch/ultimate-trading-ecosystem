//
// LATEST BAR READ v1.0 (12-Oct-2026)
// -----------------------------------------------------------------------------
// The S4 B gate passes a bar that closed green OR in the upper half of its range, so a
// green bar with a long top wick passes. That is kept loose on purpose: the GO is an
// alert trigger, and tightening it was measured three times in Aug 2026 and cost winners.
// Jay reads the latest closed bar by eye before ordering; this indicator names that read.
//
//   WEAK    close in the lower third of the range, OR an upper wick >= half the range
//   STRONG  close in the upper third AND an upper wick under a quarter of the range
//   NEUTRAL everything else
//
// DISPLAY ONLY. No request calls, no bindings, no alerts - nothing in S4 depends on it.
// The four numbers below are the SAME constants as gm_trigger_board.py (BAR_*), which
// drives the board's Bar column; tests/test_bar_read.py fails if they drift.
// Whether a weak bar should matter is pre-registered as H2 in
// docs/PREREG_rejection_at_level.md - until it is measured this is a read, not a rule.
//
// "Closed" = confirmed, or past the bar's close time. On Daily, TradingView keeps the
// day's bar unconfirmed after 15:30; this treats it as closed then (same as S4 v11.27).
//@version=6
indicator("Latest Bar Read v1.0", shorttitle = "BarRead", overlay = true, max_labels_count = 5)

// ── Constants (identical to gm_trigger_board.py) ─────────────────────────────
WEAK_CLOSE_POS   = 1.0 / 3.0
WEAK_TOP_WICK    = 0.50
STRONG_CLOSE_POS = 2.0 / 3.0
STRONG_TOP_WICK  = 0.25

// ── Inputs (display only) ────────────────────────────────────────────────────
showWeak   = input.bool(true,  "Mark weak bars",            tooltip = "Orange dot above every closed weak bar.")
showStrong = input.bool(false, "Mark strong bars",          tooltip = "Teal triangle below every closed strong bar.")
showLabel  = input.bool(true,  "Label the last closed bar", tooltip = "Grade, close position and top-wick share of the latest closed bar.")

// ── Grade: -1 weak, 0 neutral, 1 strong, na unreadable (zero range) ──────────
f_grade(float o, float h, float l, float c) =>
    float rng  = h - l
    float cpos = rng > 0 ? (c - l) / rng : na
    float wick = rng > 0 ? (h - math.max(o, c)) / rng : na
    int g = na
    if not na(cpos)
        if cpos < WEAK_CLOSE_POS or wick >= WEAK_TOP_WICK
            g := -1
        else if cpos >= STRONG_CLOSE_POS and wick < STRONG_TOP_WICK
            g := 1
        else
            g := 0
    [g, cpos, wick]

[g, cpos, wick] = f_grade(open, high, low, close)
bool closed = barstate.isconfirmed or (not na(time_close) and timenow >= time_close)

plotshape(showWeak and closed and g == -1, "Weak bar", shape.circle, location.abovebar, color.new(color.orange, 0), size = size.tiny)
plotshape(showStrong and closed and g == 1, "Strong bar", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.tiny)

// ── Label on the latest CLOSED bar ───────────────────────────────────────────
var label lb = na
if barstate.islast and showLabel
    int k = closed ? 0 : 1
    int gk = g[k]
    float cp = cpos[k]
    float wk = wick[k]
    string name = na(gk) ? "n/a" : gk == -1 ? "WEAK" : gk == 1 ? "STRONG" : "NEUTRAL"
    string txt = na(gk) ? "Bar n/a (zero range)" : name + " · close " + str.tostring(math.round(cp * 100)) + "% · top wick " + str.tostring(math.round(wk * 100)) + "%"
    color bg = na(gk) ? color.gray : gk == -1 ? color.new(color.orange, 10) : gk == 1 ? color.new(color.teal, 10) : color.new(color.gray, 10)
    label.delete(lb)
    lb := label.new(bar_index - k, high[k], txt, style = label.style_label_down, color = bg, textcolor = color.white, size = size.small)
