// ============================================================================
// S4Core  v7  --  shared engines for the Section 4 / Golden Matcher ecosystem
//
// NOTE this line is DOCUMENTATION ONLY. A library's version is assigned by TradingView
// at publish time and auto-increments; nothing in the source declares it. Keep it in step
// with the last publish by hand, and do not confuse it with //@version=6 below, which is
// the Pine LANGUAGE version.
//
// v7 (12-Aug-2026) — the Zone RECORD and its two heaviest consumers moved here from
// Section 4, which had compiled at 101,149 against a 100,256 ceiling: `export type Zone`
// (field order and defaults UNCHANGED, so S4's 20-argument positional constructor still
// binds identically), `declutterZones` and `confluenceBoost`. Everything those two read
// from S4 globals is a parameter now. A library body compiles separately, so the tokens
// leave S4's budget with the behaviour byte-identical. Measured: S4 -540 source tokens,
// ~-1,312 compiled.
//
// v4 (5-Aug-2026) — structZone gained `rejectOnly` (appended, default true): a pivot
// shelf now spans the REJECTION region only (supply body-top→high, demand low→body-bottom)
// instead of the whole bridged body. Measured over 55 names: monthly median zone width
// 8.7%→4.9% of price, weekly 5.5%→3.9%, zone count UP (narrow shelves survive the
// max-width ceiling), and ZERO at_support flips. Callers on v3 are unaffected — the
// parameter was appended, so no positional argument moved.
// ============================================================================
// Compiled SEPARATELY from the scripts that import it, which is what keeps
// Section 4 Entry Trigger under the 100,256 compiled-token ceiling -- and what
// makes zero-drift structural: S4 and the visual indicators call the SAME
// function, so there is exactly one definition of each engine.
//
// EXPORTS
//   type ZoneSig   leg-base-leg zone signature (also returned by structZone)
//   type SRSig     the two nearest S/R levels each side, with test counts
//   detectZone()   Institutional Zone Engine: gap-bridged candles, RBR/DBR/
//                  RBD/DBD, per-TF leg-in, wick distals + narrow rescue, width
//                  band, FVG Polygraph, scoring, Controlling promotion.
//   structZone()   pivot-based structural shelves (PvH/PvL), same lifecycle.
//   srLevels()     horizontal S/R: per-TF pivot clustering, wick-fit placement,
//                  wick-pierce touches, MTTWR grading (tests WEAKEN a level).
//   dailyPA()      the 17-bull / 10-recovery price-action battery + the stage
//                  inputs (off-52w, below-30WMA, 30WMA 3-state slope, RV).
//   autoTL()       envelope fit for an auto trendline.
//
// CHANGES FROM THE S4 ORIGINALS -- names only, never logic. A library cannot
// read the caller's scope, so values these functions used to take from S4
// globals are now TRAILING parameters (appended, so no existing positional
// argument moved):
//   detectZone : base_rng_atr->baseRngAtr, ctrlMinLowerHighs->ctrlMinLH,
//                gapBonus->gapBonusPts, narrowWickToWick->narrowWick
//   srLevels   : sr_wick_fit->wickFit
//   dailyPA    : confirm_daily->confirmDaily, wma_flat_pct->wmaFlatPct
// Bodies are otherwise character-identical to the S4 versions they replaced.
// ============================================================================
//@version=6
library("S4Core", overlay=true)

// ---- ZoneSig -------------------------------------------------------------
export type ZoneSig
    int    zoneTime
    float  proximal
    float  distal
    bool   isDemand
    int    rawScore
    string pattern
    int    nBase
    int    bStart
    int    baseStartTime
    bool   isControlling
    bool   hasFVG        // S4: leg-out left an FVG (imbalance) — gates intraday chart-TF zones
    bool   isProv        // v3.2: found at ft=0 (leg-out = the last CLOSED bar) → PREVIEW only

// ---- detectZone ----------------------------------------------------------
export detectZone(simple float ercM,  simple int minB,  simple int maxB, simple float bodyR,
             simple float legBodyR, simple float legBodyAvgR, simple float strongFTMul,
             simple float minW,  simple float maxW, simple float volM,
             simple bool needBOS,
             simple string proxMode, simple int ftLag, simple int ftRescue,
             simple bool ctrlAllowed, simple bool provOn, simple int nbTol,
             simple float maxBaseTRm, simple float legInWickRatio, simple int fvgBonusPts,
             simple float leginAtrP, simple float baseRngAtr, simple int ctrlMinLH, simple int gapBonusPts, simple bool narrowWick) =>
    a  = ta.atr(14)
    v  = ta.sma(volume, 20)
    tr = ta.tr
    // INVISIBLE (gap-bridged) CANDLES — ALWAYS ON. Zone marking is defined on bridged
    // price: each bar's open re-anchored at the previous close, high/low expanded to
    // cover the gap, so a small-bodied gap day classifies as the leg candle it really
    // is. This is methodology, not preference — there is deliberately NO toggle. The
    // "Draw Invisible Candles" input (Zones — Visual) controls the VIEW only, so the
    // overlay can never disagree with what the engine reads.
    inv_open  = nz(close[1], open)
    eff_open  = inv_open
    eff_close = close
    eff_high  = math.max(high, inv_open)
    eff_low   = math.min(low,  inv_open)
    eff_body  = math.abs(eff_close - eff_open)
    eff_rng   = eff_high - eff_low
    var float ath = na
    var float atl = na
    ath := na(ath) ? eff_high : math.max(ath, eff_high)
    atl := na(atl) ? eff_low  : math.min(atl, eff_low)
    ma50 = ta.sma(eff_close, 50)
    // Bars since the running extreme last ADVANCED — drives the Controlling pullback rule.
    // Because `ath` is a running max, every bar between the ATH bar and a later bar has a
    // LOWER HIGH by definition. So "N bars of lower highs since the prior ATH" is exactly
    // "the ATH bar is >= N bars older". barssince gives that in O(1) and keeps the history
    // offset shallow (we read it at [liIdx], <= ~8 bars back). Must be called every bar.
    newATHprint = not na(ath[1]) and eff_high > ath[1]
    newATLprint = not na(atl[1]) and eff_low  < atl[1]
    bsATH = ta.barssince(newATHprint)
    bsATL = ta.barssince(newATLprint)
    ph_l = ta.pivothigh(high, 10, 5)
    pl_l = ta.pivotlow(low,  10, 5)
    var float lph = na
    var float lpl = na
    if not na(ph_l)
        lph := ph_l
    if not na(pl_l)
        lpl := pl_l
    var int    sigTime      = 0
    var float  sigProx      = na
    var float  sigDist      = na
    var bool   sigIsDmd     = false
    var int    sigScore     = 0
    var string sigPattern   = ""
    var int    sigNb        = 0
    var int    sigBStart    = 1
    var int    sigBaseTime  = 0
    var bool   sigCtrl      = false
    var bool   sigFVG       = false
    var bool   sigProv      = false
    // ---- VARIABLE-LENGTH FOLLOW-THROUGH RESCUE SEARCH ----
    // `ft` is the offset of the candidate LEG-OUT bar, and therefore also the number
    // of follow-through bars available to judge it (the FT terms below measure from
    // eff_close[ft] to the current bar). We try the SHORTEST ft first and stop at the
    // first zone found, which gives exactly the intended behaviour:
    //   * a STRONG leg-out (body >= legBodyR) needs NO follow-through and is found
    //     immediately at ft = ftLag — one closed bar after it printed.
    //   * an AVERAGE leg-out (legBodyAvgR <= body < legBodyR) fails at ft = ftLag and
    //     gets another chance at ft+1, ft+2 ... where 2-3 bars of follow-through can
    //     rescue it. Because it is then the LEG-OUT and not a base candle, the base
    //     scan starts past it and the resulting zone is NARROWER.
    // Previously ft was a FIXED input, so only one offset was ever tried: a weak
    // leg-out could never be rescued, and raising the input just slid the whole
    // detection window into the past rather than requiring more follow-through.
    bool _found = false
    // ---- PROVISIONAL PASS (v3.2) ----------------------------------------------
    // ft >= 1 means the leg-out must be at least one bar back, so a leg-out on the
    // LAST bar can never be a candidate: the newest zone stays invisible until a
    // fresh bar exists. Intraday that is 75 minutes. At a session close it is until
    // the next session — and at FRIDAY's close it is the whole weekend, which is
    // exactly when the zone marking happens.
    // So AFTER the normal search fails, on the last CONFIRMED bar only, try ft=0.
    // ORDER MATTERS: last, never first. The loop takes the shortest successful ft,
    // so trying 0 first would let a brand-new preview shadow an older REAL formation
    // that ft=1 was about to find.
    // ft=0 self-limits to STRONG legs, and that is correct rather than a compromise:
    // `strongFT` and `hasFVG` both require a bar AFTER the leg-out, so they are
    // unmeasurable here — that is time, not something code can work around. A strong
    // leg needs no follow-through, which is precisely why it can be read at its close.
    bool _provTry = provOn and barstate.islast and barstate.isconfirmed
    for _i = 0 to ftRescue + (_provTry ? 1 : 0)
        if _found
            break
        int ft = _i <= ftRescue ? ftLag + _i : 0
        legBodyPct      = eff_rng[ft] > 0 ? eff_body[ft] / eff_rng[ft] : 0.0
        legBodyStrong   = legBodyPct >= legBodyR
        legBodyAverage  = legBodyPct >= legBodyAvgR and legBodyPct < legBodyR
        legOutBig       = tr[ft] > a[ft] * ercM
        closesUpper     = eff_close[ft] > eff_high[ft] - eff_rng[ft] * 0.25
        closesLower     = eff_close[ft] < eff_low[ft]  + eff_rng[ft] * 0.25
        dirBull         = eff_close[ft] > eff_open[ft]
        dirBear         = eff_close[ft] < eff_open[ft]
        strongFT_bull   = ft > 0 and (eff_close - eff_close[ft]) > a[ft] * strongFTMul
        strongFT_bear   = ft > 0 and (eff_close[ft] - eff_close) > a[ft] * strongFTMul
        // NOTE: the live leg-out gates are bullERC / bearERC below. Do not re-introduce a
        // second "bullLegOut/bearLegOut" pair here — a dead FT-less twin of those gates used
        // to sit at this spot, assigned and never read, so edits to it were silent no-ops.
        bool ftOKbull = true
        bool ftOKbear = true
        if ft > 0
            ercH = eff_high[ft]
            ercL = eff_low[ft]
            ercC = eff_close[ft]
            progBull = eff_close > ercC
            progBear = eff_close < ercC
            bool noRevBull = true
            bool noRevBear = true
            for j = ft - 1 to 0
                if eff_close[j] < ercL
                    noRevBull := false
                if eff_close[j] > ercH
                    noRevBear := false
            ftOKbull := progBull and noRevBull
            ftOKbear := progBear and noRevBear
        bullERC = (legOutBig and dirBull and closesUpper and legBodyStrong) or
                  (legOutBig and dirBull and closesUpper and legBodyAverage and strongFT_bull and ftOKbull)
        bearERC = (legOutBig and dirBear and closesLower and legBodyStrong) or
                  (legOutBig and dirBear and closesLower and legBodyAverage and strongFT_bear and ftOKbear)
        // ===== DEMAND =====
        if bullERC
            volOK = volM > 0.0 ? volume[ft] > v[ft] * volM : true
            bosOK = needBOS ? (not na(lph[ft]) and eff_close[ft] > lph[ft]) : true
            if volOK and bosOK
                float zT = na
                float zTwk = na                 // #34: base's WICK high, for the narrow-zone wick-to-wick rescue
                int   nBC = 0
                int   bS  = ft + 1
                int   nbStreak = 0
                for i = ft + 1 to ft + maxB
                    cRange = eff_rng[i]
                    cBody  = eff_body[i]
                    smallBody  = cRange > 0 and (cBody / cRange) <= bodyR
                    smallRange = tr[i] < a[i] * baseRngAtr
                    isBase = (smallBody or smallRange) and tr[i] < a[i] * maxBaseTRm
                    if isBase
                        nbStreak := 0
                        nBC := nBC + 1
                        bS  := i
                        pVal = proxMode == "Body Extreme" ? math.max(eff_close[i], eff_open[i]) : eff_high[i]
                        zT := na(zT) ? pVal : math.max(zT, pVal)
                        zTwk := na(zTwk) ? eff_high[i] : math.max(zTwk, eff_high[i])
                    else
                        nbStreak := nbStreak + 1
                        if nbStreak > nbTol
                            break
                if nBC >= minB and nBC <= maxB and not na(zT)
                    int liIdx = bS + 1
                    liRng = eff_rng[liIdx]
                    liBody = eff_body[liIdx]
                    liUpWick   = eff_high[liIdx] - math.max(eff_close[liIdx], eff_open[liIdx])
                    liLowWick  = math.min(eff_close[liIdx], eff_open[liIdx]) - eff_low[liIdx]
                    liMaxWick  = math.max(liUpWick, liLowWick)
                    bool legInWickOK = liBody > 0 and liMaxWick <= liBody * legInWickRatio
                    bool legInValid = liRng > 0 and (liBody / liRng) >= legBodyAvgR and tr[liIdx] > a[liIdx] * leginAtrP and legInWickOK
                    bool legInBullish = eff_close[liIdx] > eff_open[liIdx]
                    if legInValid
                        string pat = legInBullish ? "RBR" : "DBR"
                        float zB = na
                        int   distFrom = ft
                        int   distTo   = pat == "DBR" ? liIdx : bS
                        for k = distFrom to distTo
                            lowSide = eff_low[k]     // ALL distals are WICK distals (house rule 17-Jul); scan range is pattern-aware via distTo
                            zB := na(zB) ? lowSide : math.min(zB, lowSide)
                        if not na(zB)
                            // #34 NARROW-ZONE WICK-TO-WICK: the distal is already a wick
                            // (eff_low). If the body-based proximal makes the zone thinner
                            // than the band FLOOR, widen the proximal out to the base's wick
                            // high — a thin-bodied base's true zone runs to its wicks, so
                            // this rescues a precise zone that would otherwise be rejected.
                            if narrowWick and not na(zTwk) and (zT - zB) < a[ft] * minW
                                zT := math.max(zT, zTwk)
                            w = zT - zB
                            if w >= a[ft] * minW and w <= a[ft] * maxW
                                bodyR_legOut = eff_body[ft] / math.max(eff_rng[ft], 0.001)
                                volR  = volume[ft] / math.max(v[ft], 1.0)
                                eP    = int(math.min(bodyR_legOut * 40.0, 40.0))
                                // Volume is a BONUS, floored at 0. It used to be unclamped below
                                // zero, so a below-average-volume leg-out silently subtracted up to
                                // -12 from a zone's structural merit. `volMult` is the intended
                                // volume GATE; scoring shouldn't double as a second, hidden one.
                                vP    = int(math.min(math.max((volR - 1.0) * 12.0, 0.0), 30.0))
                                bP    = nBC == 1 ? 12 : nBC == 2 ? 25 : nBC == 3 ? 25 : nBC == 4 ? 20 : nBC == 5 ? 10 : 5
                                raw   = math.min(eP + vP + bP, 95)
                                gapSize = open[ft] - close[ft + 1]          // RAW prices: the gap-bridge erases the gap (eff_open[ft] IS close[ft+1] -> the old expression was identically 0, gapBonusPts dead)
                                hasGap  = gapSize > a[ft] * 0.3
                                gapPts  = hasGap ? gapBonusPts : 0
                                hasFVG  = ft > 0 and low[ft - 1] > high[ft + 1]      // RAW: bridged lows/highs close the very imbalance being tested
                                fvgPts  = hasFVG ? fvgBonusPts : 0
                                int pivBroken = 0
                                for kk = ft + 1 to ft + 30
                                    pk = ph_l[kk]
                                    if not na(pk) and pk > eff_close[bS] and pk < eff_close[ft]
                                        pivBroken := pivBroken + 1
                                multiPivPts = math.min(pivBroken * 5, 15)
                                patPts = pat == "DBR" ? 10 : 0
                                sc = math.min(raw + gapPts + fvgPts + multiPivPts + patPts, 100)
                                // ---- Controlling criterion #1: LEADS TO a new ATH ----
                                // House rule (Jay's trainer): a DZ is Controlling only if it LEADS
                                // TO a new ATH — it cannot be a CONTINUATION of one. Price must have
                                // come off the prior high (lower highs printed) and the base must
                                // form below it; the leg-out then breaks it. A base built while
                                // price is already ratcheting the ATH up is disqualified.
                                float athPrior = ath[liIdx]                       // ATH before this formation began
                                // (a) NON-CONTINUATION: the ATH must not have advanced during the base.
                                bool baseNoNewATH = not na(athPrior) and ath[ft + 1] <= athPrior
                                // (b) PULLBACK: >= ctrlMinLH bars printed a lower high since the prior ATH.
                                bool pulledBack   = not na(bsATH[liIdx]) and bsATH[liIdx] >= ctrlMinLH
                                // (c) LEADS TO the new ATH: the leg-out closes through the prior high.
                                bool leadsToATH   = not na(athPrior) and eff_close[ft] > athPrior
                                bool isNewATH     = leadsToATH and baseNoNewATH and pulledBack
                                bool wasBelowMA = true
                                for kk2 = ft + 1 to ft + 20
                                    if not na(ma50[kk2]) and eff_close[kk2] > ma50[kk2]
                                        wasBelowMA := false
                                        break
                                bool isTrendShiftUp = wasBelowMA and not na(ma50[ft]) and eff_close[ft] > ma50[ft]
                                bool isCtrl = ctrlAllowed and (isNewATH or isTrendShiftUp)
                                sigTime     := time[ft]
                                sigProx     := zT
                                sigDist     := zB
                                sigIsDmd    := true
                                sigScore    := sc
                                sigPattern  := pat
                                sigNb       := nBC
                                sigBStart   := bS
                                sigBaseTime := time[bS]
                                sigCtrl     := isCtrl
                                sigFVG      := hasFVG
                                sigProv     := ft == 0
                                _found      := true
        // ===== SUPPLY =====
        if bearERC
            volOK2 = volM > 0.0 ? volume[ft] > v[ft] * volM : true
            bosOK2 = needBOS ? (not na(lpl[ft]) and eff_close[ft] < lpl[ft]) : true
            if volOK2 and bosOK2
                float zB2 = na
                float zB2wk = na                // #34: base's WICK low, for the narrow-zone wick-to-wick rescue
                int   nBC2 = 0
                int   bS2  = ft + 1
                int   nbStreak2 = 0
                for i = ft + 1 to ft + maxB
                    cR2 = eff_rng[i]
                    cB2 = eff_body[i]
                    smallBody2  = cR2 > 0 and (cB2 / cR2) <= bodyR
                    smallRange2 = tr[i] < a[i] * baseRngAtr
                    isBase2 = (smallBody2 or smallRange2) and tr[i] < a[i] * maxBaseTRm
                    if isBase2
                        nbStreak2 := 0
                        nBC2 := nBC2 + 1
                        bS2  := i
                        pVal2 = proxMode == "Body Extreme" ? math.min(eff_close[i], eff_open[i]) : eff_low[i]
                        zB2 := na(zB2) ? pVal2 : math.min(zB2, pVal2)
                        zB2wk := na(zB2wk) ? eff_low[i] : math.min(zB2wk, eff_low[i])
                    else
                        nbStreak2 := nbStreak2 + 1
                        if nbStreak2 > nbTol
                            break
                if nBC2 >= minB and nBC2 <= maxB and not na(zB2)
                    int liIdx2 = bS2 + 1
                    liRng2 = eff_rng[liIdx2]
                    liBody2 = eff_body[liIdx2]
                    liUpWick2  = eff_high[liIdx2] - math.max(eff_close[liIdx2], eff_open[liIdx2])
                    liLowWick2 = math.min(eff_close[liIdx2], eff_open[liIdx2]) - eff_low[liIdx2]
                    liMaxWick2 = math.max(liUpWick2, liLowWick2)
                    bool legInWickOK2 = liBody2 > 0 and liMaxWick2 <= liBody2 * legInWickRatio
                    bool legInValid2 = liRng2 > 0 and (liBody2 / liRng2) >= legBodyAvgR and tr[liIdx2] > a[liIdx2] * leginAtrP and legInWickOK2
                    bool legInBullish2 = eff_close[liIdx2] > eff_open[liIdx2]
                    if legInValid2
                        string pat2 = legInBullish2 ? "RBD" : "DBD"
                        float zT2 = na
                        int   distFrom2 = ft
                        int   distTo2   = pat2 == "RBD" ? liIdx2 : bS2
                        for k = distFrom2 to distTo2
                            highSide = eff_high[k]   // ALL distals are WICK distals — see the demand mirror
                            zT2 := na(zT2) ? highSide : math.max(zT2, highSide)
                        if not na(zT2)
                            // #34 NARROW-ZONE WICK-TO-WICK (supply mirror): widen the
                            // proximal DOWN to the base's wick low when the body zone is
                            // thinner than the band floor. Distal (zT2) is already a wick.
                            if narrowWick and not na(zB2wk) and (zT2 - zB2) < a[ft] * minW
                                zB2 := math.min(zB2, zB2wk)
                            w2 = zT2 - zB2
                            if w2 >= a[ft] * minW and w2 <= a[ft] * maxW
                                bodyR_legOut2 = eff_body[ft] / math.max(eff_rng[ft], 0.001)
                                volR2  = volume[ft] / math.max(v[ft], 1.0)
                                eP2    = int(math.min(bodyR_legOut2 * 40.0, 40.0))
                                vP2    = int(math.min(math.max((volR2 - 1.0) * 12.0, 0.0), 30.0))   // floored at 0 — see the demand mirror
                                bP2    = nBC2 == 1 ? 12 : nBC2 == 2 ? 25 : nBC2 == 3 ? 25 : nBC2 == 4 ? 20 : nBC2 == 5 ? 10 : 5
                                raw2   = math.min(eP2 + vP2 + bP2, 95)
                                gapSize2 = close[ft + 1] - open[ft]         // RAW prices - see the demand mirror
                                hasGap2  = gapSize2 > a[ft] * 0.3
                                gapPts2  = hasGap2 ? gapBonusPts : 0
                                hasFVG2  = ft > 0 and high[ft - 1] < low[ft + 1]     // RAW - see the demand mirror
                                fvgPts2  = hasFVG2 ? fvgBonusPts : 0
                                int pivBroken2 = 0
                                for kk = ft + 1 to ft + 30
                                    pk = pl_l[kk]
                                    if not na(pk) and pk < eff_close[bS2] and pk > eff_close[ft]
                                        pivBroken2 := pivBroken2 + 1
                                multiPivPts2 = math.min(pivBroken2 * 5, 15)
                                patPts2 = pat2 == "RBD" ? 10 : 0
                                sc2 = math.min(raw2 + gapPts2 + fvgPts2 + multiPivPts2 + patPts2, 100)
                                // ---- Controlling criterion #1 (mirror): LEADS TO a new ATL ----
                                // An SZ is Controlling only if it LEADS TO a new ATL, never if it
                                // continues one: price must have bounced off the prior low (higher
                                // lows printed), the base must form above it, and the leg-out breaks it.
                                float atlPrior = atl[liIdx2]                      // ATL before this formation began
                                bool baseNoNewATL = not na(atlPrior) and atl[ft + 1] >= atlPrior
                                bool pushedUp     = not na(bsATL[liIdx2]) and bsATL[liIdx2] >= ctrlMinLH
                                bool leadsToATL   = not na(atlPrior) and eff_close[ft] < atlPrior
                                bool isNewATL     = leadsToATL and baseNoNewATL and pushedUp
                                bool wasAboveMA = true
                                for kk2 = ft + 1 to ft + 20
                                    if not na(ma50[kk2]) and eff_close[kk2] < ma50[kk2]
                                        wasAboveMA := false
                                        break
                                bool isTrendShiftDown = wasAboveMA and not na(ma50[ft]) and eff_close[ft] < ma50[ft]
                                bool isCtrl2 = ctrlAllowed and (isNewATL or isTrendShiftDown)
                                sigTime     := time[ft]
                                sigProx     := zB2
                                sigDist     := zT2
                                sigIsDmd    := false
                                sigScore    := sc2
                                sigPattern  := pat2
                                sigNb       := nBC2
                                sigBStart   := bS2
                                sigBaseTime := time[bS2]
                                sigCtrl     := isCtrl2
                                sigFVG      := hasFVG2
                                sigProv     := ft == 0
                                _found      := true
    ZoneSig.new(sigTime, sigProx, sigDist, sigIsDmd, sigScore, sigPattern, sigNb, sigBStart, sigBaseTime, sigCtrl, sigFVG, sigProv)

// ---- autoTL --------------------------------------------------------------
export autoTL(array<float> py, array<int> px, bool isSupport, int off, float tolPx, float nudgePx, int maxAge) =>
    int   _n = array.size(py) - off
    bool  _live = false
    int   _ax = na
    float _ay = na
    float _now = na
    if _n >= 2
        int _bT = -1                       // best touch count · _bA/_bB = anchor pivot indices
        int _bA = -1
        int _bB = -1
        int _bSpan = -1
        for _a = 0 to _n - 2
            int   _xa = array.get(px, _a)
            float _ya = array.get(py, _a)
            for _b = _a + 1 to _n - 1
                int _xb = array.get(px, _b)
                int _dx = _xb - _xa
                // the line's LATER anchor must be recent, so the line is current
                if _dx > 0 and bar_index - _xb <= maxAge
                    float _slope = (array.get(py, _b) - _ya) / float(_dx)
                    bool  _valid = true
                    int   _touch = 0
                    for _j = 0 to _n - 1
                        float _pred = _ya + _slope * float(array.get(px, _j) - _xa)
                        float _d = array.get(py, _j) - _pred
                        if isSupport and _d < -tolPx
                            _valid := false       // a low BELOW the support line ⇒ not an envelope
                        if (not isSupport) and _d > tolPx
                            _valid := false       // a high ABOVE the resistance line ⇒ not an envelope
                        if math.abs(_d) <= tolPx
                            _touch += 1
                    if _valid and _touch >= 2
                        int _span = _xb - _xa
                        if _touch > _bT or (_touch == _bT and _span > _bSpan)
                            _bT := _touch
                            _bA := _a
                            _bB := _b
                            _bSpan := _span
        if _bA >= 0
            int   _xa2 = array.get(px, _bA)
            float _ya2 = array.get(py, _bA)
            float _slp = (array.get(py, _bB) - _ya2) / float(array.get(px, _bB) - _xa2)
            float _proj = _ya2 + _slp * float(bar_index - _xa2) + nudgePx
            bool  _broken = isSupport ? (close < _proj - tolPx) : (close > _proj + tolPx)
            if not _broken
                _ax   := _xa2               // draw from the OLD (major-swing) anchor to now
                _ay   := _ya2 + nudgePx
                _now  := _proj
                _live := true
    [_live, _ax, _ay, _now]

// ---- SRSig ---------------------------------------------------------------
export type SRSig
    float a1        // nearest level ABOVE
    int   a1t       // touch count
    int   a1x       // TIME of its first touch
    bool  a1h       // origin = pivot HIGHS (else lows)
    float a2
    int   a2t
    int   a2x
    bool  a2h
    float b1        // nearest level BELOW
    int   b1t
    int   b1x
    bool  b1h
    float b2
    int   b2t
    int   b2x
    bool  b2h

// ---- srLevels ------------------------------------------------------------
export srLevels(simple int pvL, simple int pvR, simple int poolN, simple float tolAtr, simple int minSpace, simple int minTouch, simple bool wickTouch, simple bool wickFit) =>
    a = ta.atr(14)
    // ta.* unconditional every bar (Pine consistency rule).
    float ph = ta.pivothigh(high, pvL, pvR)
    float pl = ta.pivotlow(low,  pvL, pvR)
    // PERSISTENT LEVEL OBJECTS (v3.3 — the grade-drift fix). The old engine kept a
    // rolling 40-PIVOT pool and re-clustered it every bar, so a level's touch count
    // DECAYED as its old members were evicted: MTTWR could quietly downgrade itself
    // to "fresh" — and re-enter the picker as a stop candidate — with no price having
    // touched it. Levels are now first-class objects: a confirmed pivot either MERGES
    // into the level it belongs to (cumulative count — never decays; running-mean
    // price; first-touch time kept, so the ray no longer creeps) or CREATES one.
    // Capacity is a cap on LEVELS (poolN, evicting the oldest first-touch), and since
    // levels are far scarcer than pivots, 40 levels holds YEARS of structure.
    // Merging-on-arrival also makes levels >= tol apart by construction, which
    // retires the slot-dedup patch the old clustering needed.
    var array<float> Lp = array.new<float>()   // level price (running mean of touches)
    var array<int>   Lc = array.new<int>()     // CUMULATIVE touch count
    var array<int>   Lt = array.new<int>()     // first-touch TIME (ray anchor + origin)
    var array<bool>  Lh = array.new<bool>()    // origin: born from a pivot HIGH
    var array<int>   Lb = array.new<int>()     // last-touch bar (distinct-test spacing)
    // #8 wick-fit: running INTERSECTION of the member pivots' wick bands. A line inside
    // this interval threads EVERY member wick — placed at its midpoint (wickFit).
    var array<float> Lil = array.new<float>()  // intersection low
    var array<float> Lih = array.new<float>()  // intersection high
    float tol = tolAtr * a
    if not na(ph) and not na(a) and a > 0
        // #30: match a level by EXTREME within tol OR by the level PIERCING the pivot's
        // upper wick (body-top..high). Nearest-to-extreme wins among candidates. A
        // pierce-only touch is counted but does NOT drag the level's mean.
        float _wkLo = wickTouch ? math.max(open[pvR], close[pvR]) : ph
        int _j = -1
        float _bd = 1e15
        bool _pierceOnly = false
        if array.size(Lp) > 0
            for i2 = 0 to array.size(Lp) - 1
                float _lp   = array.get(Lp, i2)
                float _d    = math.abs(_lp - ph)
                bool  _near = _d <= tol
                bool  _prc  = wickTouch and _lp <= ph and _lp >= _wkLo
                if (_near or _prc) and _d < _bd
                    _bd := _d
                    _j := i2
                    _pierceOnly := _prc and not _near
        float _bTop = math.max(open[pvR], close[pvR])   // wick band = body-top .. high
        if _j >= 0
            if bar_index - pvR - array.get(Lb, _j) >= minSpace
                int _c = array.get(Lc, _j) + 1
                // #8: place the line to thread the MAXIMUM wicks — intersect this
                // pivot's wick band with the level's running intersection; when it
                // holds, the line moves to the midpoint (threads every member wick).
                // When it doesn't, keep the interval and fall back to the mean drag.
                float _nl = math.max(array.get(Lil, _j), _bTop)
                float _nh = math.min(array.get(Lih, _j), ph)
                // #8 (Jay, 19-Jul): thread the MAX wicks "to the extent possible". When the
                // new pivot's wick band still intersects the running band, shrink+re-centre
                // (one more wick threaded). When it does NOT, the touch STILL COUNTS (Lc++
                // below — count is pivots-only) but the line STAYS put on the max-wick set;
                // it must NOT drift to the mean. Mean-drag only when wick-fit is OFF.
                if wickFit and _nl <= _nh
                    array.set(Lil, _j, _nl)
                    array.set(Lih, _j, _nh)
                    array.set(Lp, _j, (_nl + _nh) / 2.0)
                else if not wickFit and not _pierceOnly
                    array.set(Lp, _j, (array.get(Lp, _j) * (_c - 1) + ph) / _c)
                array.set(Lc, _j, _c)
                array.set(Lb, _j, bar_index - pvR)
        else
            array.push(Lp, ph)
            array.push(Lc, 1)
            array.push(Lt, time[pvR])
            array.push(Lh, true)
            array.push(Lb, bar_index - pvR)
            array.push(Lil, _bTop)
            array.push(Lih, ph)
    if not na(pl) and not na(a) and a > 0
        // #30 mirror: match by EXTREME within tol OR the level piercing the pivot's LOWER
        // wick (low..body-bottom). Pierce-only touch counted, does not drag the mean.
        float _wkHi = wickTouch ? math.min(open[pvR], close[pvR]) : pl
        int _j = -1
        float _bd = 1e15
        bool _pierceOnly = false
        if array.size(Lp) > 0
            for i2 = 0 to array.size(Lp) - 1
                float _lp   = array.get(Lp, i2)
                float _d    = math.abs(_lp - pl)
                bool  _near = _d <= tol
                bool  _prc  = wickTouch and _lp >= pl and _lp <= _wkHi
                if (_near or _prc) and _d < _bd
                    _bd := _d
                    _j := i2
                    _pierceOnly := _prc and not _near
        float _bBot = math.min(open[pvR], close[pvR])   // wick band = low .. body-bottom
        if _j >= 0
            if bar_index - pvR - array.get(Lb, _j) >= minSpace
                int _c = array.get(Lc, _j) + 1
                float _nl = math.max(array.get(Lil, _j), pl)
                float _nh = math.min(array.get(Lih, _j), _bBot)
                if wickFit and _nl <= _nh
                    array.set(Lil, _j, _nl)
                    array.set(Lih, _j, _nh)
                    array.set(Lp, _j, (_nl + _nh) / 2.0)
                else if not wickFit and not _pierceOnly
                    array.set(Lp, _j, (array.get(Lp, _j) * (_c - 1) + pl) / _c)
                array.set(Lc, _j, _c)
                array.set(Lb, _j, bar_index - pvR)
        else
            array.push(Lp, pl)
            array.push(Lc, 1)
            array.push(Lt, time[pvR])
            array.push(Lh, false)
            array.push(Lb, bar_index - pvR)
            array.push(Lil, pl)
            array.push(Lih, _bBot)
    // Cap on LEVELS: evict the one that came into play longest ago.
    while array.size(Lp) > poolN
        int _old = 0
        for i2 = 1 to array.size(Lp) - 1
            if array.get(Lt, i2) < array.get(Lt, _old)
                _old := i2
        array.remove(Lp, _old)
        array.remove(Lc, _old)
        array.remove(Lt, _old)
        array.remove(Lh, _old)
        array.remove(Lb, _old)
        array.remove(Lil, _old)
        array.remove(Lih, _old)
    // SELECT the two nearest qualified levels per side. NEAREST, not most-tested —
    // ranking by touch count is the inversion this engine exists to remove. The
    // min-touch gate stays: one pivot is a swing point, not a level.
    float a1 = na
    float a2 = na
    float b1 = na
    float b2 = na
    int   a1t = 0
    int   a2t = 0
    int   b1t = 0
    int   b2t = 0
    int   a1x = 0
    int   a2x = 0
    int   b1x = 0
    int   b2x = 0
    bool  a1h = false
    bool  a2h = false
    bool  b1h = false
    bool  b2h = false
    if array.size(Lp) > 0
        for i2 = 0 to array.size(Lp) - 1
            float lvl = array.get(Lp, i2)
            int   c   = array.get(Lc, i2)
            if c >= minTouch
                if lvl > close
                    if na(a1) or lvl < a1
                        a2 := a1
                        a2t := a1t
                        a2x := a1x
                        a2h := a1h
                        a1 := lvl
                        a1t := c
                        a1x := array.get(Lt, i2)
                        a1h := array.get(Lh, i2)
                    else if na(a2) or lvl < a2
                        a2 := lvl
                        a2t := c
                        a2x := array.get(Lt, i2)
                        a2h := array.get(Lh, i2)
                else if lvl < close
                    if na(b1) or lvl > b1
                        b2 := b1
                        b2t := b1t
                        b2x := b1x
                        b2h := b1h
                        b1 := lvl
                        b1t := c
                        b1x := array.get(Lt, i2)
                        b1h := array.get(Lh, i2)
                    else if na(b2) or lvl > b2
                        b2 := lvl
                        b2t := c
                        b2x := array.get(Lt, i2)
                        b2h := array.get(Lh, i2)
    SRSig.new(a1, a1t, a1x, a1h, a2, a2t, a2x, a2h, b1, b1t, b1x, b1h, b2, b2t, b2x, b2h)

// ---- structZone ----------------------------------------------------------
// v4 — `rejectOnly` APPENDED (never inserted): every existing positional argument keeps
// its slot, so a caller on the old signature is unaffected apart from the new default.
// TRUE = the shelf is the REJECTION region only (supply: body TOP -> high · demand:
// low -> body BOTTOM). FALSE = the old body-to-extreme span, which swallowed the whole
// bridged body — and for a pivot HIGH the lower body is where price traded UP THROUGH,
// not where supply sat. Measured over 55 board names: monthly median zone width
// 8.7% -> 4.9% of price, weekly 5.5% -> 3.9%, zone count UP (narrow shelves survive the
// max-width ceiling that was discarding them), and ZERO at_support flips — tighter
// geometry at no cost to the location gate.
export structZone(simple int pvLeft, simple int pvRight, simple int padBars, simple float topThr, simple float deepThr, simple float minMove, simple float minW, simple float maxW, simple float minWMult, simple bool rejectOnly = true) =>
    a = ta.atr(14)
    // INVISIBLE CANDLES (gap-bridged OHLC) — derivation IDENTICAL to f_detectZone, so both
    // detectors read the SAME price structure. This function previously used RAW OHLC
    // throughout and never even received the flag, so every structural PvL/PvH zone was
    // built on un-bridged prices while pattern zones were bridged — the two engines
    // silently disagreed about where price had been, and structural zones ignored the
    // "Use Invisible Candles" setting entirely.
    // The pivot IS the zone here (unlike f_detectZone, where pivots only confirm BOS and
    // score), so the pivots themselves must be found on the bridged series too.
    inv_open  = nz(close[1], open)
    eff_open  = inv_open
    eff_close = close
    eff_high  = math.max(high, inv_open)
    eff_low   = math.min(low,  inv_open)
    // ta.* called unconditionally every bar (Pine consistency rule).
    float ph = ta.pivothigh(eff_high, pvLeft, pvRight)
    float pl = ta.pivotlow(eff_low,  pvLeft, pvRight)
    float lowestSinceH  = ta.lowest(eff_low,  pvRight + 1)
    float highestSinceL = ta.highest(eff_high, pvRight + 1)
    var int    sT      = 0
    var float  sProx   = na
    var float  sDist   = na
    var bool   sDmd    = false
    var int    sScore  = 0
    var string sPat    = ""
    var int    sBStart = 1
    var int    sBaseT  = 0
    // ----- Pivot HIGH → structural SUPPLY -----
    if not na(ph)
        int   pBarH = pvRight
        float sTop  = eff_high[pBarH]
        float sBot  = rejectOnly ? math.max(eff_close[pBarH], eff_open[pBarH]) : math.min(eff_close[pBarH], eff_open[pBarH])
        float proxThrH = nz(a[pBarH], a) * topThr
        float deepThrH = nz(a[pBarH], a) * deepThr
        for k = math.max(pBarH - padBars, 0) to pBarH + padBars
            bodyHiK = math.max(eff_close[k], eff_open[k])
            bodyLoK = math.min(eff_close[k], eff_open[k])
            if bodyHiK >= sTop - proxThrH and bodyLoK >= sTop - deepThrH and bodyLoK < sBot
                sBot := bodyLoK
        float wH = sTop - sBot
        if not na(a) and (sTop - lowestSinceH) > a * minMove and wH >= a * minW * minWMult and wH <= a * maxW
            sT      := time
            sProx   := sBot
            sDist   := sTop
            sDmd    := false
            // A structural zone is a WEAKER construct than a validated leg-base-leg
            // formation — it has no leg-in, no base and no leg-out. It used to score
            // 60..100, i.e. a flat 60 floor on a different scale, so every PvL/PvH read
            // 86-93pts and out-ranked real pattern zones. Scored 40..75 it can never
            // out-rank a high-quality RBR/DBR (95-100), which is the correct ordering.
            sScore  := math.min(40 + int((sTop - lowestSinceH) / a * 5.0), 75)
            sPat    := "PvH"
            sBStart := pBarH + padBars
            sBaseT  := time[math.min(pBarH + padBars, bar_index)]
    // ----- Pivot LOW → structural DEMAND -----
    if not na(pl)
        int   pBarL = pvRight
        float dBot  = eff_low[pBarL]
        float dTop  = rejectOnly ? math.min(eff_close[pBarL], eff_open[pBarL]) : math.max(eff_close[pBarL], eff_open[pBarL])
        float proxThrL = nz(a[pBarL], a) * topThr
        float deepThrL = nz(a[pBarL], a) * deepThr
        for k = math.max(pBarL - padBars, 0) to pBarL + padBars
            bodyHiK = math.max(eff_close[k], eff_open[k])
            bodyLoK = math.min(eff_close[k], eff_open[k])
            if bodyLoK <= dBot + proxThrL and bodyHiK <= dBot + deepThrL and bodyHiK > dTop
                dTop := bodyHiK
        float wL = dTop - dBot
        if not na(a) and (highestSinceL - dBot) > a * minMove and wL >= a * minW * minWMult and wL <= a * maxW
            sT      := time
            sProx   := dTop
            sDist   := dBot
            sDmd    := true
            sScore  := math.min(40 + int((highestSinceL - dBot) / a * 5.0), 75)   // 40..75 — see the PvH mirror
            sPat    := "PvL"
            sBStart := pBarL + padBars
            sBaseT  := time[math.min(pBarL + padBars, bar_index)]
    ZoneSig.new(sT, sProx, sDist, sDmd, sScore, sPat, 0, sBStart, sBaseT, false, false, false)

// ---- dailyPA -------------------------------------------------------------
// KNIFE-EDGE TEST (v5). True when a governing value sits within `eps` of the threshold
// that decides its pattern — i.e. the pattern is one rounding away from the opposite
// answer. Ratio-based, so it works for a volume multiple and a price distance alike.
// Pine cannot re-run the battery on perturbed series the way the Python mirror does
// (pa_patterns.marginal_patterns), so the chart side tests each governing scalar
// against its own threshold instead. Same question, different mechanics: the Python
// side asks "would another feed disagree?", this asks "is this decided by a hair?".
edgeNear(float v, float t, float eps) =>
    t != 0.0 and not na(v) and math.abs(v / t - 1.0) <= eps

export dailyPA(float ema10_ref, float ema20_ref, simple bool confirmShift, simple bool confirmDaily, simple float wmaFlatPct) =>
    float rng     = high - low
    float vol50   = ta.sma(volume, 50)
    float rv      = vol50 > 0 ? volume / vol50 : 0.0
    float sma50   = ta.sma(close, 50)
    float ema10   = ta.ema(close, 10)
    float ema20   = ta.ema(close, 20)
    // EMA20/EMA10 are DAILY anchors (DNA). The daily security call passes na
    // (use this context's own daily EMAs); the chart-TF `loc_*` call passes the
    // DAILY EMAs so the engulf trend-context stays daily even on 75/125m.
    float _e10    = na(ema10_ref) ? ema10 : ema10_ref
    float _e20    = na(ema20_ref) ? ema20 : ema20_ref
    float intrap  = rng > 0 ? (close - low) / rng : 0.0
    float atr10   = ta.atr(10)
    float atr10s  = ta.sma(atr10, 50)
    float vwmaV5  = ta.vwma(volume, 5)               // CORRECT dry-up: vwma of VOLUME
    float rsi14   = ta.rsi(close, 14)
    float hh10    = ta.highest(high, 10)             // hoisted (runs every bar)
    float hh3     = ta.highest(high, 3)
    float ll5     = ta.lowest(low, 5)
    float sma200  = ta.sma(close, 200)
    float body    = math.abs(close - open)
    float uwick   = high - math.max(open, close)
    float lwick   = math.min(open, close) - low
    bool  hammer  = rng > 0 and lwick > body * 2.0 and uwick < body and math.max(open, close) >= low + rng * 0.66
    float l50_1   = ta.lowest(low, 50)[1]            // prior 50-bar low (for Spring)
    float dlockH  = ta.highest(high, 20)[1]          // 20-bar locked resistance (Gap-BO / Breakout-Confirmed)
    // 1. ★★ Power Play (HTF) +4
    float low8w = ta.lowest(low, 40)
    float hi15  = ta.highest(high, 15)
    float lo15  = ta.lowest(low, 15)
    bool p_htf = low8w > 0 and lo15 > 0 and (close - low8w) / low8w > 1.0 and (hi15 - lo15) / lo15 < 0.20 and close > sma50
    // 2. Power Play (Strong Close) +2
    bool p_sc = close > open and (close - low) > (high - close) * 3 and rv > 1.0
    // 3. VCP Breakout +3 (contraction on PRIOR bar → 10d-high break on vol)
    bool vcp_prior = not na(atr10s[1]) and atr10[1] < atr10s[1] * 1.5 and vwmaV5[1] < vol50[1]
    bool p_vcp = vcp_prior and close > hh10[1] and rv > 1.2 and intrap >= 0.60
    // 4. Pocket Pivot +2
    float mdv = 0.0
    for j = 1 to 10
        if close[j] < close[j + 1] and volume[j] > mdv
            mdv := volume[j]
    bool p_pp = close > close[1] and close > open and mdv > 0 and volume > mdv and close > sma50 and (close - low) >= rng * 0.5
    // 5. Bullish Engulfing (gated) +2
    bool raw_eng = close[1] < open[1] and close > open and open <= close[1] and close >= open[1]
    bool p_eng = raw_eng and close < _e10 and _e10 < _e20 and rv > 2.0 and not na(rsi14[1]) and rsi14[1] < 40
    // 6. Liquidity Sweep Reclaim +2
    bool p_liq = ll5 < sma50 and close > sma50 and volume > vol50 * 1.5
    // 7. 3-Bar Bull Reversal +2
    bool p_3b = low[1] < low[2] and low[2] < low[3] and close > hh3[1]
    // 9. Inside-3 (Coil) +2
    bool ins1 = high < high[1] and low > low[1]
    bool ins2 = high[1] < high[2] and low[1] > low[2]
    bool ins3 = high[2] < high[3] and low[2] > low[3]
    bool p_in3 = ins1 and ins2 and ins3
    // 10. True NR7 +1 (current range <= each of prior 6)
    float low_rng6 = ta.lowest(high - low, 6)
    bool  p_nr7    = rng > 0 and low_rng6[1] >= rng
    // 11. ★ IB-NR7 Coil +2
    bool p_ibnr7 = ins1 and p_nr7
    // 12. Wyckoff Spring +3 — undercut prior 50-bar low, reclaim green, on LOW volume
    bool p_spr  = not na(l50_1) and low < l50_1 and close > l50_1 and close > open and volume < vol50
    // 13. Gap-Up Breakout +3 — gap over prior high, clears 20-bar locked resistance on vol
    bool p_gap  = not na(dlockH) and open > high[1] and close > dlockH and close > open and rv > 1.25
    // 14. 50-SMA Undercut & Reclaim +2
    bool p_u50  = not na(sma50) and low < sma50 and close > sma50 and close > open and rv > 1.25
    // 15. Hammer at 50-SMA +2 (hammer within 1.5% of the 50-SMA, closes above, on vol)
    bool near50 = not na(sma50) and math.abs(low - sma50) / sma50 <= 0.015
    bool p_h50  = hammer and near50 and close > sma50 and rv > 1.0
    // 16. Hammer at 200-SMA +2 (within 2% of the 200-SMA)
    bool near200 = not na(sma200) and math.abs(low - sma200) / sma200 <= 0.020
    bool p_h200 = hammer and near200 and close > sma200 and rv > 1.0
    // 17. Breakout Confirmed +2 — anti-algo: close > 20-bar lock, top-quartile close, on vol
    bool p_bc   = not na(dlockH) and close > dlockH and (close - low) > rng * 0.75 and rv > 1.25
    // --- RECOVERY-mode extras (5 new; Spring/Engulf/3-Bar/Pocket/30-WMA are reused) ---
    float atr14 = ta.atr(14)
    float lo_recent = ta.lowest(low, 10)
    float lo_prior  = ta.lowest(low, 30)[10]         // 30-bar base low ending 10 bars ago
    // R1. Climax Reversal (SC+AR) +3 — a climax down-bar in last 10, midpoint reclaimed
    int climax_j = 0
    for cj = 1 to 10
        if climax_j == 0 and close[cj] < open[cj] and volume[cj] > vol50 * 2.5 and (high[cj]-low[cj]) > atr14 * 2
            climax_j := cj
    bool p_climax = false
    if climax_j > 0
        float cmid = (high[climax_j] + low[climax_j]) / 2.0
        p_climax := close > cmid and close > open
    // R2. Higher-Low / Double-Bottom +3 — recent low RETESTS the prior base low
    // (holds >= 1% undercut, stays within 10% above it) and turns up. The
    // proximity ceiling (v1.9, mirrors pa_patterns.py fix 9-Jul-2026) stops the
    // pattern firing on every green day of an uptrend, where the 10-bar low is
    // trivially above the 30-bar base low.
    bool p_2b = lo_prior > 0 and lo_recent >= lo_prior * 0.99 and lo_recent <= lo_prior * 1.10 and close > open and close > close[1]
    // R3. Base Breakout (SOS/JAC) +3 — wide up-bar over 20-bar base resistance on vol
    float base_res = ta.highest(high, 20)[1]
    bool p_sos = close > base_res and rng > atr14 * 1.3 and rv > 1.5 and close > open
    // R4. Hammer at support +2 — hammer at the 200-SMA or the base low
    bool near_base = lo_prior > 0 and math.abs(low - lo_prior) / lo_prior <= 0.03
    bool p_hsup = hammer and (near200 or near_base) and close > open and rv > 1.0
    // R5. Volume Dry-Up +1 — supply exhausted at the base
    bool p_vdu = rv < 0.5 and rng < atr14 * 0.8
    // AUTO-mode path inference (v1.8): >=10% off the 52-week high (the GM recovery
    // CONTEXT gate) AND the long-term trend not yet repaired — below the 30-WMA proxy
    // (SMA150) OR the proxy still falling. v1.7's "below SMA150" AND-leg was self-
    // defeating: recovery names at Step 5 have confirmed the turn and often reclaimed
    // SMA150, so the best recoveries resolved Bull. Slope catches them: even after a
    // reclaim, a recovering name's SMA150 is flat/falling; a bull leader's is rising.
    float h52    = ta.highest(high, 252)
    float sma150 = ta.sma(close, 150)
    float off52  = h52 > 0 ? (h52 - close) / h52 * 100.0 : 0.0
    bool  bel30w = close < sma150
    // v7.2 THREE-STATE 30WMA SLOPE (was `sma150 <= sma150[10]`, a boolean whose `<=`
    // counted a FLAT MA as FALLING). A flattening 30-week MA IS the Weinstein Stage-1
    // base, so the defining signature of a base was being read as "declining" and the
    // name resolved Stage 4 -> NO TRADE. Encoded in the SAME tuple slot (no new element,
    // no new security call): 0.0 = rising · 0.5 = flat · 1.0 = falling.
    // Back-compatible for the existing `< 0.5` readers (s2_proxy, dyn_s2): rising still
    // passes, flat and falling still fail, exactly as before. Only the `> 0.5` readers
    // change meaning, and both are updated with this edit.
    float _s150chg = sma150 > 0 ? (sma150 - sma150[10]) / sma150 * 100.0 : 0.0
    float s150dn   = _s150chg > wmaFlatPct ? 0.0 : _s150chg < -wmaFlatPct ? 1.0 : 0.5
    // v2.3 — 200-DMA position: the GM's Bull-vs-Recovery split hinges on it
    // (Bull/accumulation lives ABOVE the 200-DMA; a beaten-down recovery is
    // BELOW it). Used to align Auto with the Golden Matcher's structural path.
    bool  bel200 = not na(sma200) and close < sma200

    // NOTE (v2.1): the OB / FVG / pivot support trackers moved to f_zones()
    // below, so they can be requested on BOTH "D" and "W" (the trading TF is
    // 125/75-min, but demand zones come from Daily + Weekly structure).

    // return as floats (na(series bool) is illegal; guard the float with nz()>0.5).
    // _o = 1 when "Confirmed daily only" is on → return each pattern evaluated on the
    // LAST CLOSED daily bar (no forming-bar repaint); _o = 0 = live developing bar.
    // NOTE (v2.0): the [_o] offset is applied INSIDE the daily-context function, so it
    // is measured in DAILY bars and is timeframe-INDEPENDENT — `expr[1]` is yesterday's
    // confirmed daily value whether the chart is Daily or 75/125-min. A prior edit gated
    // this on `timeframe.isdaily`, which made intraday charts read the DEVELOPING daily
    // bar → the battery repainted through the session (the exact flicker confirmDaily
    // exists to stop). Reverted: for a live developing-daily view, turn confirmDaily OFF.
    // BUGFIX (18-Jul): the [_o] confirm shift must apply ONLY to the DAILY security
    // call. It was applied unconditionally, so the CHART-TF (loc_*) battery was also
    // read one bar back — the battery evaluated a STALE bar while the Golden Matcher
    // evaluated the last closed one (CDSL: Rec Sum +3 in Python vs 0 in Pine, purely
    // from this one-bar offset). Worse, during live hours it compounded with
    // use_closed_candle's own [_so] display shift = up to TWO bars stale, silently
    // eating triggers. confirmDaily's own tooltip already said it "applies only when
    // Use chart timeframe is OFF" — the code just never honoured it. The chart-TF path
    // needs no shift: use_closed_candle is what protects it from the forming bar.
    int _o = (confirmShift and confirmDaily) ? 1 : 0
    // ── MARGINAL (knife-edge) COUNT — v5 ────────────────────────────────────────────
    // How many patterns that FIRED did so by a hair. NAM-INDIA read Sigma 6 on the
    // Golden Matcher and Sigma 2 on this panel for the SAME 75m bar: Dhan closed it at
    // 1210.4 (76.4% up the bar's range), TradingView at 1210.0 (73.2%), and three
    // patterns sat right on their cut. Forty paise, four points of Sigma. The two
    // surfaces read different feeds by design, so the fix is not to chase agreement —
    // it is to say which points are a coin-flip, and let a thin Sigma look thin.
    // Only patterns with a CONTINUOUS governing gate can be knife-edge; a purely
    // structural one (inside bars, 3-bar sequence) either happened or did not, and is
    // deliberately absent here rather than reported as always-solid.
    // The Python mirror answers this by perturbation (pa_patterns.marginal_patterns),
    // which Pine cannot do — it cannot re-run this body on modified series. Testing each
    // governing scalar against its own threshold is the same question, asked directly.
    float _mEps = 0.02
    int _marg = 0
    if p_sc and (edgeNear(close - low, (high - close) * 3.0, _mEps) or edgeNear(rv, 1.0, _mEps))
        _marg += 1
    if p_vcp and (edgeNear(rv, 1.2, _mEps) or edgeNear(intrap, 0.60, _mEps) or edgeNear(close, hh10[1], _mEps))
        _marg += 1
    if p_pp and (edgeNear(volume, mdv, _mEps) or edgeNear(close - low, rng * 0.5, _mEps))
        _marg += 1
    if p_bc and (edgeNear(rv, 1.25, _mEps) or edgeNear(close - low, rng * 0.75, _mEps) or edgeNear(close, dlockH, _mEps))
        _marg += 1
    if p_gap and (edgeNear(rv, 1.25, _mEps) or edgeNear(close, dlockH, _mEps))
        _marg += 1
    if p_u50 and (edgeNear(rv, 1.25, _mEps) or edgeNear(close, sma50, _mEps))
        _marg += 1
    if p_liq and edgeNear(volume, vol50 * 1.5, _mEps)
        _marg += 1
    if p_eng and (edgeNear(rv, 2.0, _mEps) or edgeNear(rsi14[1], 40.0, _mEps))
        _marg += 1
    if p_h50 and (edgeNear(rv, 1.0, _mEps) or edgeNear(close, sma50, _mEps))
        _marg += 1
    if p_h200 and (edgeNear(rv, 1.0, _mEps) or edgeNear(close, sma200, _mEps))
        _marg += 1
    if p_sos and (edgeNear(rv, 1.5, _mEps) or edgeNear(rng, atr14 * 1.3, _mEps) or edgeNear(close, base_res, _mEps))
        _marg += 1
    if p_hsup and edgeNear(rv, 1.0, _mEps)
        _marg += 1
    if p_vdu and (edgeNear(rv, 0.5, _mEps) or edgeNear(rng, atr14 * 0.8, _mEps))
        _marg += 1
    [(p_htf?1.0:0.0)[_o], (p_sc?1.0:0.0)[_o], (p_vcp?1.0:0.0)[_o], (p_pp?1.0:0.0)[_o], (p_eng?1.0:0.0)[_o], (p_liq?1.0:0.0)[_o], (p_3b?1.0:0.0)[_o], (p_in3?1.0:0.0)[_o], (p_nr7?1.0:0.0)[_o], (p_ibnr7?1.0:0.0)[_o], (p_spr?1.0:0.0)[_o], (p_gap?1.0:0.0)[_o], (p_u50?1.0:0.0)[_o], (p_h50?1.0:0.0)[_o], (p_h200?1.0:0.0)[_o], (p_bc?1.0:0.0)[_o], (p_climax?1.0:0.0)[_o], (p_2b?1.0:0.0)[_o], (p_sos?1.0:0.0)[_o], (p_hsup?1.0:0.0)[_o], (p_vdu?1.0:0.0)[_o], off52[_o], (bel30w?1.0:0.0)[_o], s150dn[_o], rv[_o], (bel200?1.0:0.0)[_o], _marg[_o]]


// ═══════════════════════════════════════════════════════════════════════════
// RRG — moved out of S4 (10-Aug-2026) to reclaim compiled tokens.
//
// WHY IT MOVED, and why this one first: S4 sits ~190 compiled tokens under the
// 100,256 ceiling, and a library body compiles separately so it costs the caller
// nothing but the call. `f_rrgInfo` was the cleanest candidate in the file —
// measured ZERO free variables (it already took everything as arguments) and a
// single call site, so moving it changes no behaviour and needs no new plumbing.
// Frees ~758 compiled tokens in S4. Bodies with many free variables (the f_fold*
// wrappers, up to 35) are POOR candidates: every global becomes a parameter and
// the call site pays for it, which can cost more than the body saves.
// ═══════════════════════════════════════════════════════════════════════════

// Quadrant, trajectory and arrow from the (RS-Ratio, RS-Momentum) pair and its
// trail. Byte-identical to S4's f_rrgInfo — same thresholds, same ternaries, so
// the panel reads exactly as before.
//   v, m   = current RS-Ratio / RS-Momentum (100-centred, i.e. already -100)
//   vt, mt = the trailing pair, for the direction of travel
// @returns [arrow, trajectory, quadrant, score, tradeable]
export rrgInfo(float v, float m, float vt, float mt) =>
    float dv = v - vt
    float dm = m - mt
    string cur = v >= 0 and m >= 0 ? "LEADING" : v >= 0 ? "WEAKENING" : v < 0 and m < 0 ? "LAGGING" : "IMPROVING"
    string nxt = cur
    if cur == "LEADING"
        nxt := dm < -0.3 ? "WEAKENING" : (dv < -0.3 and dm < 0.3 ? "IMPROVING" : cur)
    else if cur == "WEAKENING"
        nxt := dv < -0.3 ? "LAGGING" : (dm > 0.3 and dv > -0.3 ? "LEADING" : cur)
    else if cur == "LAGGING"
        nxt := dm > 0.3 ? "IMPROVING" : (dv > 0.3 and dm > -0.3 ? "WEAKENING" : cur)
    else
        nxt := dv > 0.3 ? "LEADING" : (dm < -0.3 and dv < 0.3 ? "LAGGING" : cur)
    string arw = dv > 0.3 ? (dm > 0.3 ? "↗️" : dm < -0.3 ? "↘️" : "➡️") : dv < -0.3 ? (dm > 0.3 ? "↖️" : "↙️") : (dm > 0.3 ? "⬆️" : dm < -0.3 ? "⬇️" : "➡️")
    string trj = nxt == cur ? cur + " (stable)" : cur + " → " + nxt
    int sc = cur == "LEADING" ? 2 : 0
    bool tr = (cur == "LEADING" and (nxt == "LEADING" or nxt == "IMPROVING")) or (cur == "IMPROVING" and nxt == "LEADING") or (cur == "LAGGING" and nxt == "IMPROVING") or (cur == "WEAKENING" and nxt == "LEADING")
    [arw, trj, cur, sc, tr]

// STRIKE RRG — Jay's MANUAL Strike.Money weekly read, pasted from the Golden
// Matcher board (gm_trigger_board.s4_rrg_lists emits one comma list per quadrant).
//
// ADDITIVE, never an override: S4's computed quadrant from rrgInfo() above stays
// exactly as it is and keeps its own panel row. This is a SECOND, independent
// reading — the one he actually trades — shown beside it. When the two disagree
// that disagreement is the information, so collapsing them would destroy it.
//
// Lists arrive already upper-cased, stripped and NSE:-free from the GM, so the
// match is a plain str.contains against a comma-fenced key — no split loop, which
// is what keeps this affordable. A stray space is still tolerated by str.replace_all.
// Absence from every list means NOT LISTED — deliberately not "Lagging": an
// unflagged name simply has no manual read, and silence must never read as a verdict.
// @returns [text, colour] ready for the panel row
// Comma-fence a pasted list so a whole-symbol match cannot hit a substring
// (",SAIL," must not match inside ",SAILIFE,"). Library-scope, not nested inside
// strikeRrg — Pine forbids declaring a function inside a function body.
f_rrgFence(simple string s) =>
    "," + str.replace_all(str.upper(s), " ", "") + ","

export strikeRrg(simple string lead, simple string impr, simple string weak,
                 color cOk, color cWarn, color cNo, color cDim) =>
    // THREE lists, LAGGING INFERRED (Jay, 10-Aug). An RRG has exactly four quadrants, so
    // a name that is not Leading, Improving or Weakening is Lagging by elimination — there
    // is no point pasting a fourth list to say so.
    //
    // The one guard that must stay: if ALL THREE inputs are blank the lists were never
    // pasted, and inferring "Lagging" there would paint the WHOLE board as lagging off a
    // setup mistake. Elimination is only valid once at least one list has content; before
    // that, silence means nothing has been said yet.
    //
    // Known trade-off, and it is the right way round: a name not yet reviewed on Strike
    // reads LAGGING rather than "unknown". Defaulting an unflagged name to the WEAKEST
    // quadrant is conservative — it can only make you slower to buy, never quicker.
    string _k = "," + str.upper(syminfo.ticker) + ","
    bool _any = str.length(str.replace_all(lead + impr + weak, " ", "")) > 0
    string _q = not _any ? ""
         : str.contains(f_rrgFence(lead), _k) ? "LEADING"
         : str.contains(f_rrgFence(impr), _k) ? "IMPROVING"
         : str.contains(f_rrgFence(weak), _k) ? "WEAKENING"
         : "LAGGING"
    string _txt = _q == "" ? "lists not pasted — S4's computed quadrant stands"
         : _q == "LAGGING" ? "LAGGING  ·  by elimination (on no Strike list)"
         : _q + "  ·  Strike.Money weekly"
    color  _col = _q == "LEADING" ? cOk : _q == "IMPROVING" ? cWarn : _q == "" ? cDim : cNo
    [_txt, _col]

// ============================================================================
// ZONE  --  the live zone record, moved out of Section 4 (12-Aug-2026)
//
// S4 compiled at 101,149 of a 100,256 token ceiling. The type and the two zone
// helpers below are what came across: a library BODY is compiled separately, so
// the tokens leave S4's budget while the behaviour is byte-identical.
//
// Field order and defaults are UNCHANGED, so the existing 20-argument positional
// Zone.new() call in S4 still binds the same way -- it only gains the `core.`
// prefix. Methods (checkMitigation / deleteDrawings) stay in S4: a method on an
// imported type is script-local and costs nothing to leave where it is.
// ============================================================================
export type Zone
    float  proximal
    float  distal
    int    originBar
    int    originTime
    bool   isDemand
    int    strength
    int    confBonus
    int    nBase
    string pattern
    string tf
    bool   isControlling
    box    drawing
    label  infoLabel
    bool   wasInZone
    bool   reacted       // S4: price entered then left the zone (a reaction occurred)
    float  reactRef      // S4: proximal captured at the reaction (travel reference)
    float  strongLvl     // S4: nearest strong pivot level to watch (tested rule 3)
    bool   emaPre        // S4: at reaction, price on the pre-cross side of EMA20 (rule 2)
    bool   hasFVG        // S4: leg-out left an FVG → FVG-Polygraph-qualified (⚡ tag)
    bool   tested        // #41: greyed tested state (kept for verification, excluded from trigger)
    // #room (2-Aug, Jay): how many times this zone has been TESTED. LAST field, and
    // defaulted, so the existing 20-argument positional Zone.new() call is unchanged.
    // Leash = 1 for a normal zone, 2 for a Controlling one. One test BEYOND the leash
    // (twice-tested normal, three-times-tested controlling) means the level is BREAKING
    // rather than holding, so it stops being reported as overhead supply — the same
    // MTTWR logic the S/R levels use: tests WEAKEN a level, they never strengthen it.
    int    touches = 0
    // v8.5 declutter: the styling this zone SHOULD have when painted. Remembered so a
    // zone hidden for being far from price can be restored exactly, without re-deriving
    // colours from pattern/TF/controlling state. Defaulted + LAST, so the existing
    // positional Zone.new() call is untouched.
    color  bgKeep  = na
    color  bdKeep  = na
    string txtKeep = ""

// ---------------------------------------------------------------------------
// DECLUTTER -- display only. Paint the nearest `maxDraw` zones per side and mute
// the rest. Ranking is by distance from price WITHIN each direction, so the
// nearest demand and nearest supply always survive -- the two a decision uses.
//
// Zones stay in the array, keep their state, and keep satisfying z_inDZ and the
// counts: the ONLY thing this changes is whether the box is painted. It must run
// AFTER all lifecycle work so it can never influence what the gate sees.
//
// A tested zone is already greyed by the lifecycle -- left alone rather than
// fighting that styling here.
//
// Returns 0 so the caller can consume it in one statement (Pine has no void).
// ---------------------------------------------------------------------------
export declutterZones(array<Zone> zones, simple int maxDraw, float px) =>
    if maxDraw > 0 and array.size(zones) > 0
        int _nz2 = array.size(zones)
        for _a = 0 to _nz2 - 1
            _za = array.get(zones, _a)
            if not na(_za.drawing)
                float _da = math.abs(px - _za.proximal)
                int _rank = 0
                for _b = 0 to _nz2 - 1
                    if _b != _a
                        _zb = array.get(zones, _b)
                        // Same side of the book only -- demand competes with demand.
                        if _zb.isDemand == _za.isDemand and not na(_zb.drawing)
                            if math.abs(px - _zb.proximal) < _da
                                _rank += 1
                if not _za.tested
                    bool _show = _rank < maxDraw
                    box.set_bgcolor(_za.drawing, _show ? _za.bgKeep : color.new(color.gray, 100))
                    box.set_border_color(_za.drawing, _show ? _za.bdKeep : color.new(color.gray, 100))
                    box.set_text(_za.drawing, _show ? _za.txtKeep : "")
    0

// ---------------------------------------------------------------------------
// CONFLUENCE BOOST -- moved out of Section 4 (12-Aug-2026) with the Zone type.
// Scores a CANDIDATE zone against the zones already live: same-direction overlap
// (a HIGHER-timeframe zone overlapping this one is the big bonus) plus proximity
// to the daily 20-EMA, with a malus for an orphaned zone far on the wrong side.
//
// Everything it used to read from S4 globals is a parameter now, in the order
// zones, geometry, then the tuning inputs. Body is otherwise unchanged.
// ---------------------------------------------------------------------------
export confluenceBoost(array<Zone> zones, float newProx, float newDist, bool newIsDmd, string newTf,
     simple int htfBoost, simple int sameTfBoost, float dailyEMA20, float chart_atr,
     float atrM_tf, float atrW_tf, float atrD_tf, simple float emaProxThreshATR,
     simple int emaProxBoost, simple float emaFarAtr, simple int emaFarMalus, simple int maxConfBoost) =>
    int bonus = 0
    nLo = math.min(newProx, newDist)
    nHi = math.max(newProx, newDist)
    sz = array.size(zones)
    if sz > 0
        for i = 0 to sz - 1
            zz = array.get(zones, i)
            zLo = math.min(zz.proximal, zz.distal)
            zHi = math.max(zz.proximal, zz.distal)
            overlap = nLo <= zHi and nHi >= zLo
            sameDir = zz.isDemand == newIsDmd
            if overlap and sameDir
                // Direction-aware: the big bonus is for a HIGHER-TF zone overlapping
                // this one. It used to fire for ANY different TF — a Monthly zone was
                // collecting the '+15 HTF overlap' from a 75-minute zone.
                int _rN = newTf == "M" ? 4 : newTf == "W" ? 3 : newTf == "D" ? 2 : 1
                int _rZ = zz.tf == "M" ? 4 : zz.tf == "W" ? 3 : zz.tf == "D" ? 2 : 1
                bonus := bonus + (_rZ > _rN ? htfBoost : sameTfBoost)
    if not na(dailyEMA20) and not na(chart_atr)
        emaInZone = dailyEMA20 >= nLo and dailyEMA20 <= nHi
        edgeDist  = emaInZone ? 0.0 : math.min(math.abs(dailyEMA20 - nLo), math.abs(dailyEMA20 - nHi))
        // The zone's OWN TF ATR — the same v3.2 fix the tested-travel rule got.
        // With the chart ATR, "near the EMA20" for a Monthly zone on a 75m chart
        // meant "touching it": the same zone scored ~10 pts differently per chart TF.
        float _cbAtr = newTf == "M" ? atrM_tf : newTf == "W" ? atrW_tf : newTf == "D" ? atrD_tf : chart_atr
        nearby    = emaInZone or edgeDist <= nz(_cbAtr, chart_atr) * emaProxThreshATR
        // EMA20 confluence = PROXIMITY only. This used to also grant the bonus to any
        // demand zone sitting entirely BELOW the EMA20 (mirror for supply above) — which
        // is every demand zone in an uptrend, regardless of distance. That made ★ a near
        // constant (~everything read ★10) and stripped it of information. Distance to the
        // daily EMA20 is the actual confluence; the half-plane is not.
        if nearby
            bonus := bonus + emaProxBoost
        else
            // #4 (19-Jul): the MIRROR — an ORPHANED zone loses quality. EMA20 on the
            // WRONG side and far away (below-and-away from a DZ / above-and-away from
            // an SZ) means price returns to this zone only when badly extended from
            // value, which weakens the expected reaction.
            bool _farDZ = newIsDmd and dailyEMA20 < nLo and (nLo - dailyEMA20) > nz(_cbAtr, chart_atr) * emaFarAtr
            bool _farSZ = (not newIsDmd) and dailyEMA20 > nHi and (dailyEMA20 - nHi) > nz(_cbAtr, chart_atr) * emaFarAtr
            if _farDZ or _farSZ
                bonus := bonus - emaFarMalus
    math.min(bonus, maxConfBoost)

// ---------------------------------------------------------------------------
// AVWAP + INTRADAY TRIGGER  (moved out of Section 4, 12-Aug-2026)
//
// Distance to the nearest AVWAP and which one it is, the AVWAP bounce/reclaim
// test, and the intraday leg: a rising-EMA reclaim, optionally gated on a TTM
// squeeze release. S4 called this as f_fold2715 - a wrapper that existed only to
// keep these statements out of the main body, which Pine caps at ~1000. It is a
// pure function of its inputs (no globals written, no S4 helpers called), so it
// moved verbatim with its ten reads turned into parameters.
//
// S4 compiled at 100,914 against a 100,256 ceiling; a library body compiles
// separately, so this returns ~1,090 tokens to that budget unchanged.
// ---------------------------------------------------------------------------
export avwapIntradayTrigger(float nearest_sup, float avwap_low, float avwap_bo, float avwap_gap,
     simple float tol_pct, simple int ema_len, simple int sqz_len, simple float bb_mult,
     simple float kc_mult, simple bool require_squeeze) =>
    float sup_dist = (not na(nearest_sup) and close > 0) ? (close - nearest_sup) / close * 100.0 : na
    string nearest_sup_lbl = na(nearest_sup) ? "" : (not na(avwap_bo) and nearest_sup == avwap_bo ? "BO" : not na(avwap_gap) and nearest_sup == avwap_gap ? "Gap" : not na(avwap_low) and nearest_sup == avwap_low ? "L" : "?")
    float _tol = tol_pct / 100.0
    bool b_low = not na(avwap_low) and low <= avwap_low * (1.0 + _tol) and close > avwap_low and close > open
    bool b_bo  = not na(avwap_bo)  and low <= avwap_bo  * (1.0 + _tol) and close > avwap_bo  and close > open
    bool b_gap = not na(avwap_gap) and low <= avwap_gap * (1.0 + _tol) and close > avwap_gap and close > open
    bool _r2g_x = ta.crossover(close, avwap_bo)
    bool _r2g  = not na(avwap_bo) and _r2g_x
    bool avwap_trig = b_low or b_bo or b_gap or _r2g
    float ema10c = ta.ema(close, ema_len)
    bool  ema_reclaim = close > ema10c and ema10c > ema10c[1]
    float basis  = ta.sma(close, sqz_len)
    float dev    = bb_mult * ta.stdev(close, sqz_len)
    float kc_rng = ta.atr(sqz_len)
    bool  sqz_on   = (basis + dev) < (basis + kc_mult * kc_rng) and (basis - dev) > (basis - kc_mult * kc_rng)
    bool  sqz_fire = not sqz_on and sqz_on[1]
    float sqz_mom  = ta.linreg(close - math.avg(math.avg(ta.highest(high, sqz_len), ta.lowest(low, sqz_len)), ta.sma(close, sqz_len)), sqz_len, 0)
    bool  sqz_releasing = (not sqz_on) and sqz_mom > 0 and (sqz_fire or sqz_mom >= nz(sqz_mom[1]))
    bool  intraday_trig = ema_reclaim and (not require_squeeze or sqz_releasing)
    [sup_dist, nearest_sup_lbl, _tol, _r2g, avwap_trig, ema_reclaim, basis, sqz_on, intraday_trig]

// ---------------------------------------------------------------------------
// PATH RESOLVE  (moved out of Section 4, 12-Aug-2026)
//
// Decides BULL vs RECOVERY and whether the stage gate blocks the name outright,
// plus whether the ticker appears on the pasted Golden-Matcher recovery/pullback
// lists. Was f_fold2949 - another main-body-statement wrapper, pure, so it moved
// verbatim with its reads as parameters.
//
// stage_skip is Stage 3/4: a fact about the chart, applied even under a MANUAL
// mode override, which is why it is resolved here and not inside a mode branch.
// ---------------------------------------------------------------------------
export pathResolve(simple bool stage_gate, int stage_n, simple bool use_dd_recovery, float dd60,
     simple float rec_dd_min, simple float rec_dd_max, simple string gm_rec_list,
     simple string gm_pb_list, float d_bel200, simple string mode) =>
    bool stage_skip = stage_gate and stage_n >= 3
    bool rec_dd  = use_dd_recovery and not na(dd60) and dd60 >= rec_dd_min and dd60 <= rec_dd_max
    string _gmL = str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.upper(gm_rec_list), "NSE:", ""), ";", ","), " ", ""), "\n", ",")
    bool gm_rec = str.length(_gmL) > 0 and str.contains("," + _gmL + ",", "," + str.upper(syminfo.ticker) + ",")
    string _gmP = str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.upper(gm_pb_list), "NSE:", ""), ";", ","), " ", ""), "\n", ",")
    bool gm_pb = str.length(_gmP) > 0 and str.contains("," + _gmP + ",", "," + str.upper(syminfo.ticker) + ",")
    bool _bel200path = nz(d_bel200, 0.0) > 0.5
    bool auto_rec = gm_rec or rec_dd or (stage_n == 1 and _bel200path)
    bool is_rec   = mode == "Recovery" or (mode == "Auto" and auto_rec)
    [stage_skip, gm_rec, gm_pb, is_rec]

// ── buildLabel ───────────────────────────────────────────────────────────────
// Moved out of Section 4 on 18-Aug-2026 to reclaim compiled-token budget: S4 hit
// 100,351 against the 100,256 ceiling and Jay's instruction was "do not remove
// any functionality, move some code to S4Core". A library body compiles
// separately, so what lives here costs the caller only the call.
// Pure by construction — every value arrives as a parameter, and the timeframe.*
// built-ins resolve in the CALLER's context, so the chart-TF fallback keeps
// working exactly as it did in place.
// Renders the two-line zone caption, 10-space indented so the text starts inside
// the zone body rather than on its left edge.
// `tf` is SERIES string, not simple: the call sites pass Zone fields (_zc.tf,
// z.tf) and UDT fields are always series. Qualifying it `simple` on the way into
// the library is what broke the first v9 publish — the local version this
// replaced had plain `string tf`, and copying it faithfully was the whole job.
export buildLabel(string tf, bool isDemand, string pattern, int score,
     int nBase, int confBonus, bool isControlling, bool hasFVG) =>
    chartTfName = timeframe.ismonthly ? "Monthly" : timeframe.isweekly ? "Weekly" :
                  timeframe.isdaily   ? "Daily"   : timeframe.period
    tfName   = tf == "M" ? "Monthly" : tf == "W" ? "Weekly" : tf == "D" ? "Daily" : chartTfName
    zType    = isDemand ? "DZ" : "SZ"
    bonusTag = confBonus > 0 ? " ★" + str.tostring(confBonus) : ""
    prefix   = isControlling ? "Controlling " : ""
    fvgTag   = hasFVG ? " ⚡" : ""
    baseInfo = nBase > 0 ? str.tostring(nBase) + "B" : "Pivot"
    line1    = prefix + tfName + " " + zType + fvgTag
    line2    = pattern + "  " + str.tostring(score) + "pts  " + baseInfo + bonusTag
    "          " + line1 + "\n          " + line2


// ---- summaryRead ------------------------------------------------------------
// A SYNTHESIS of the whole panel, not a digest of it. v6.1 deleted the old metrics
// line precisely because it restated rows already on screen; this earns its space by
// saying what the COMBINATION means and what to do about it. Every value it reasons
// from is printed above, so it prints none of them back - it prints the reading.
//
// Lives in the library on purpose: S4 sits at the compiled-token ceiling and a library
// body compiles separately, so the cost in S4 is one call plus its arguments. A string
// LITERAL is one token however long it is, so the verbosity here is nearly free - the

// ═══════════════════════════════════════════════════════════════════════════
//  TREND STATE — one renderer for every trend column
// ═══════════════════════════════════════════════════════════════════════════
// Added 23-Aug-2026. S4 reads three Swing-Zigzag trend states through
// input.source: the chart timeframe, MTF-1 (Daily) and MTF-2 (Weekly). Each
// needed the same two things at the call site — an unbound-source check and a
// three-way arrow — so the same six operations existed three times over in a
// file that is against the compiled-token limit. Moving the body here costs S4
// one call per column and costs the library nothing it cannot afford.
//
// THE UNBOUND-SOURCE CHECK IS THE POINT. An unwired `input.source` silently
// reads `close`, which is never na, so a dropped binding does not error - it
// quietly feeds a price into a field expecting -1/0/+1. Every Zigzag binding in
// S4 is dropped on every recompile, so this is the normal state of the file
// after a compile, not an edge case. A price cannot sit inside -1..1, which is
// what makes the test reliable.

// True only when `v` is a genuine trend state AND that state is UP.
// A price series can exceed 0.5 easily, so the range test must come first.
export trendUp(float v) =>
    v >= -1.0 and v <= 1.0 and v > 0.5

// The arrow for a trend state, or `fallback` when the source is not bound.
// Callers pass whatever they want an absent binding to look like - an em-dash,
// an empty string, or a tilde-marked proxy read.
export trendArw(float v, string fallback) =>
    v >= -1.0 and v <= 1.0 ? (v > 0.5 ? "⬆️" : v < -0.5 ? "⬇️" : "➡️") : fallback
// expense is OPERATIONS, hence ladders that SELECT prose rather than build it.
export summaryRead(int stage, float stgWks, float trW, float trD, bool tfUp,
       bool zzOkD, bool zzOkW, bool rrgTr, bool rsUp, bool rsSecUp,
       float secStg, bool inDZ, bool inSZ, bool nearSR, bool nearAvwap, bool nearEma,
       float extAtr, float off52, float rv, bool arrFast, bool ofBull,
       bool isRec, float roomR, int cf, int cfMax, bool ttSwing, float entry,
       float sl, float atrD, bool go) =>
    bool wUp = zzOkW and trW > 0.5
    bool wDn = zzOkW and trW < -0.5
    bool dUp = zzOkD and trD > 0.5
    // 1. TREND STACK - the gap Jay named: the verdict reasoned from location and
    // geometry and never from the three degrees of trend at the top of the panel.
    string sTrend = wUp and dUp and tfUp ? "TREND · Aligned up at all three degrees. Weekly, daily and the entry timeframe agree, so nothing is fighting you: a long is WITH the dominant flow and the only question left is the price paid, not the direction." : wUp and not dUp and not tfUp ? "TREND · A dip inside a weekly uptrend. The higher degree still points up while the daily and entry timeframe have turned down - the textbook pullback shape and the best kind of long, PROVIDED the weekly holds. It also means you are catching a small-degree falling knife, so the entry needs a level under it, not just a pattern." : wUp and dUp and not tfUp ? "TREND · Weekly and daily up, entry timeframe pulling back. The shallowest buyable dip; the risk is that a 75m dip in a strong name barely retraces, so insisting on a deep entry may simply cost you the trade." : wDn and not dUp and not tfUp ? "TREND · Down at every degree. There is no trend to lean on: a long here is a counter-trend bounce and must be traded as one - smaller size, the first obstacle as the target, and no expectation of follow-through." : wDn ? "TREND · The WEEKLY is down. Whatever the smaller degrees do, the dominant trend has not turned, so strength here is a rally inside a downtrend until a weekly higher-high says otherwise. Trade it for a move, not for a position." : "TREND · Mixed across degrees. The degrees disagree, which usually means a transition - a base forming under a falling weekly, or a topping process under a rising one. Transitions pay the patient and punish the early; size accordingly."
    // `stage` is a first-class part of the read, not decoration: a Stage-1 base and a
    // Stage-2 advance are different trades with different waits, and nothing else in
    // this summary distinguishes them. It was also an UNUSED ARGUMENT, which Pine
    // rejects outright - the compiler strips no-op variables and errors on the param.
    string sStage = stage <= 1 ? "  This is a Stage-1 BASE rather than an advance: the pay-off comes from a breakout that has not happened yet, so a long here is early BY DESIGN - size it for the wait and judge it on the base holding, not on momentum." : stage >= 3 ? "  Stage 3 or 4 - distribution or decline. Nothing else on this panel outranks that, and a long is fighting the primary structure whatever the trigger says." : ""
    string sAge = stgWks > 0 and stgWks <= 4 ? "  The Stage-2 leg is only weeks old - early, which is where the move is, but the structure has not proved itself yet." : stgWks >= 30 and stgWks < 500 ? "  This Stage-2 leg is long in the tooth; late-stage advances give back fast, so demand more from the entry than you would early on." : ""
    // 2. LEADERSHIP
    string sLead = rsUp and rsSecUp and rrgTr ? "LEADERSHIP · Outperforming both the index and its own sector with rotation still pointed the right way. This is the profile that keeps working when the tape wobbles - the strongest single argument in favour of the name." : rsUp and rrgTr ? "LEADERSHIP · Beating the index with rotation intact, but not clearly leading its sector - the strength is stock-specific rather than a group move, so there is no peer group to carry it if the tape turns." : rsUp ? "LEADERSHIP · Above the index, but the rotation has rolled over: relative strength is being GIVEN BACK, not built. That is the state where a name looks fine on price and quietly stops leading, so treat the outperformance as history, not forecast." : "LEADERSHIP · Not leading. Buying a laggard asks the setup to do all the work, because relative strength will not help you and this is what gets sold first on any market weakness."
    string sSec = secStg >= 3.5 ? "  Its sector is in Stage 4 decline - long a name inside a group being distributed, which is the most common way a good-looking chart fails." : secStg >= 2.5 ? "  Its sector is Stage 3 and topping, so there is no group tailwind; the name must carry itself." : ""
    // 3. LOCATION
    string sLoc = inSZ ? "LOCATION · Price is INSIDE supply. You would be buying where sellers are already positioned, which caps the near reward and is why the room reading is poor. A long from inside supply only makes sense if the plan is to be paid for BREAKING it, not for reaching it." : inDZ and extAtr < 1.5 ? "LOCATION · At demand and not extended. The house A+ location: a level beneath the entry that defines wrong, and enough distance from the mean that you are buying value rather than chasing it." : inDZ ? "LOCATION · In a demand zone but stretched from the mean. The zone gives a floor to work with, yet the distance already travelled means the first move against you can be large in ATR terms before anything structural breaks." : extAtr >= 2.5 ? "LOCATION · Extended above the mean with no zone under price. Nothing structural defines risk, so any stop is arbitrary and every dip looks like an entry - the classic way to buy a top." : nearSR or nearAvwap or nearEma ? "LOCATION · Not in a zone, but resting on a secondary reference - a level, an anchored VWAP or the mean. Weaker than a zone: these are lines, not areas, and they give way without the warning a zone gives." : "LOCATION · Nowhere in particular. No zone, no level, no anchor under price - whatever the trigger says, there is nothing here to define where you are wrong."
    string sOff = off52 <= -25.0 ? "  It is deeply off its 52-week high, so this is repair work rather than a leadership breakout - expect overhead supply at every prior shelf." : off52 >= -3.0 ? "  It sits within a whisker of its 52-week high, so overhead is thin and a break puts it in clear air." : ""
    // 4. PARTICIPATION
    string sPart = rv >= 1.5 and inSZ ? "PARTICIPATION · Heavy volume arriving INTO resistance. Crowded buying at a ceiling is how upthrusts are built; strong volume here is not confirmation, it is the supply of buyers a seller needs." : rv >= 1.5 ? "PARTICIPATION · Real volume behind the move - the most reliable confirmation this panel offers, and the thing most often missing from failed breakouts." : rv >= 1.0 ? "PARTICIPATION · Volume is adequate but unremarkable; the move is drifting rather than being driven." : inDZ ? "PARTICIPATION · Volume is thin, which at a demand zone is what you WANT - dry-up means sellers are exhausted rather than absent. It stops being a virtue the moment you need follow-through." : "PARTICIPATION · Thin volume with nothing structural behind it. Moves made on no participation are the ones that reverse without warning."
    string sFlow = arrFast and not inDZ ? "  Price arrived fast, which into resistance reads as chase rather than conviction." : arrFast and inDZ ? "  The approach was sharp, which at demand tends to produce an equally sharp rejection - good for the entry, and a reason not to widen the stop into the noise of that reaction." : ""
    string sOf = ofBull ? "  Order flow is absorbing on the buy side." : "  Order flow is not confirming the buyers."
    // 5. GEOMETRY - the lever that has failed most often here: a stop tucked so close
    // that the R-multiple flatters a trade with no room to be wrong.
    float risk = entry - sl
    float rATR = atrD > 0 and risk > 0 ? risk / atrD : na
    string sGeo = na(rATR) ? "GEOMETRY · No usable stop distance - treat every R figure on this panel as meaningless." : rATR < 0.5 ? "GEOMETRY · THE STOP IS INSIDE THE NOISE. It sits well under one daily ATR from the entry, so ordinary daily movement will take it out before the idea is ever tested - and because R is measured against that distance, every reward multiple above is FLATTERED by it. Re-price the trade against a stop of roughly one ATR before believing any R number here." : rATR < 0.9 ? "GEOMETRY · The stop is tight relative to daily range. Workable, but it will be tested by noise as much as by thesis, so the R shown is optimistic rather than wrong." : rATR > 2.5 ? "GEOMETRY · The stop is very wide in ATR terms. Honest, but position size has to come down hard for risk to stay constant - check the reward still justifies the exposure." : "GEOMETRY · The stop clears daily noise without being extravagant, so the reward multiples above can be taken at face value."
    string sRoom = roomR > 0 and roomR < 1.0 ? "  There is under 1R of room to the first obstacle: the trade is being asked to pay before it reaches anything, which it usually cannot." : roomR >= 3.0 ? "  Room to the first obstacle is generous, so the target is not fighting structure." : ""
    string sType = ttSwing ? "  Structure says SWING: book into strength rather than holding for a positional target this does not support." : "  Structure says POSITIONAL, so size and hold for a move measured in months, not days."
    // 6. DIRECTION - a decision, in words, that names what would change it.
    bool bigProblem = inSZ or (roomR > 0 and roomR < 1.0) or (not na(rATR) and rATR < 0.5)
    string sDir = not go ? "DIRECTION · Nothing to do yet. The trigger is incomplete, so the work now is to decide IN ADVANCE what would make this actionable and let the alert do the waiting - a name watched tick by tick gets bought early." : not bigProblem and (wUp or dUp) ? "DIRECTION · This is a take-it. Trend, leadership and location agree, the geometry is honest and the trigger is live, so what remains is ordinary trade risk rather than a flaw in the setup. Execute the plan as written and let the stop, not an opinion, decide the outcome." : bigProblem and (wUp or dUp) ? "DIRECTION · The SETUP is sound but the TRADE as planned is not. What is wrong is fixable - the entry, the stop or the target, not the thesis - so either restructure it with a deeper entry, a stop that clears noise, or a target beyond the obstacle, or leave it alone. Do not take the plan as printed merely because the trigger fired." : "DIRECTION · The trigger is live but the context is against it. A long here is counter-trend, which is legitimate only if you size it as one, take the first obstacle as the target and accept a lower hit rate. If you would not defend this entry out loud, that is your answer."
    string sConf = cf >= cfMax / 2 ? "  Confluence is dense - several independent facts point the same way." : "  Confluence is thin: few independent facts agree, so this rests largely on the trigger alone."
    string sPath = isRec ? "  Read this as a RECOVERY entry: qualification is fundamental (RFF) and this chart cannot see it, so the Golden Matcher remains the authority on whether the name belongs on the list at all." : ""
    sTrend + sStage + sAge + "\n" + sLead + sSec + "\n" + sLoc + sOff + "\n" + sPart + sFlow + sOf + "\n" + sGeo + sRoom + sType + "\n" + sDir + sConf + sPath


// ---- wrapText ---------------------------------------------------------------
// Greedy word-wrap to a character width.
//
// WHY THIS HAS TO EXIST: a Pine table cell does NOT auto-wrap. Long text renders on a
// single line and the cell simply grows, which is how the SUMMARY row pushed the panel
// across a 34-inch monitor. The only way to constrain width is to put the newlines in
// yourself, so the "auto wrap" is done here.
//
// Breaks on spaces and never mid-word; a token longer than `width` is emitted on its own
// line rather than truncated, because silently losing text from a decision panel is
// worse than one over-long line. Newlines already present in the input are preserved as
// paragraph breaks, so summaryRead's six sections stay six paragraphs.
export wrapText(string src, int width) =>
    string outAll = ""
    array<string> paras = str.split(src, "\n")
    for pi = 0 to array.size(paras) - 1
        string para = array.get(paras, pi)
        string line = ""
        string block = ""
        array<string> words = str.split(para, " ")
        for wi = 0 to array.size(words) - 1
            string w = array.get(words, wi)
            if str.length(w) == 0
                continue
            if str.length(line) == 0
                line := w
            else if str.length(line) + 1 + str.length(w) <= width
                line := line + " " + w
            else
                block := block + (str.length(block) == 0 ? "" : "\n") + line
                line := w
        if str.length(line) > 0
            block := block + (str.length(block) == 0 ? "" : "\n") + line
        outAll := outAll + (pi == 0 ? "" : "\n") + block
    outAll


// ---- oiBasis ----------------------------------------------------------------
// WHERE THE OPEN INTEREST WAS BUILT — an OI-change-weighted average price.
//
// WHAT IT IS: every time futures OI RISES, positions were opened at roughly that price.
// Weighting price by the positive OI change over the last N update events gives the
// average cost of the open book: sum(dOI+ * px) / sum(dOI+). That level is where the
// marginal long is at breakeven, which is why price returning to it tends to attract a
// defence (longs adding / shorts covering) and why losing it tends to accelerate.
//
// WHAT IT IS NOT — read this before calling it a forecast:
//   * It is NOT max pain and NOT an options-strike calculation. Max pain needs the
//     OPTIONS chain by strike, and Pine cannot access an options chain on any plan. The
//     "strike" this reports is simply the nearest tradeable strike to the futures basis,
//     rounded for convenience - not a strike where OI is concentrated.
//   * OI FALLING is deliberately ignored. A drop tells you positions CLOSED; it does not
//     tell you at what price they were opened, so folding it in would corrupt the basis.
//   * The basis is a MAGNET and a breakeven line, not a target. It says where pressure
//     sits, not where price is going.
//
// EVENT-BASED, not bar-based, on purpose: TradingView publishes futures OI once per day,
// so on a 75m chart the value is forward-filled and 4 of every 5 bars carry no new
// information. Sampling on CHANGE makes the window mean "the last N OI prints" on every
// timeframe instead of silently meaning 4 hours on one and 20 days on another.
//
// Returns [basis, builtPct, nEvents] where builtPct is the share of the window's total
// OI movement that was BUILDING (a low share means the book is being unwound and the
// basis is stale).
export oiBasis(float oi, float px, simple int nEvents) =>
    var array<float> dq = array.new<float>()
    var array<float> pq = array.new<float>()
    var array<float> aq = array.new<float>()        // absolute move, for the built share
    float prev = nz(oi[1], oi)
    bool fresh = not na(oi) and not na(oi[1]) and oi != oi[1] and prev > 0
    if fresh
        float d = oi - prev
        array.push(dq, math.max(d, 0.0))
        array.push(aq, math.abs(d))
        array.push(pq, px)
        while array.size(dq) > nEvents
            array.shift(dq)
            array.shift(pq)
            array.shift(aq)
    float wsum = 0.0
    float dsum = 0.0
    float asum = 0.0
    if array.size(dq) > 0
        for i = 0 to array.size(dq) - 1
            float d = array.get(dq, i)
            wsum += d * array.get(pq, i)
            dsum += d
            asum += array.get(aq, i)
    float basis = dsum > 0 ? wsum / dsum : na
    float builtPct = asum > 0 ? dsum / asum * 100.0 : na
    [basis, builtPct, array.size(dq)]


// ---- invalLevels -------------------------------------------------------------
// INVALIDATION is NOT the stop. The stop is where you get out; invalidation is the price
// at which the REASON you bought stops being true. CHOLAFIN, 18-Aug-2026, is why this
// exists: the engine put the stop 13 points under a demand zone whose distal sat ONE
// point below the entry, so "wrong" and "stopped" were the same price and the R was
// meaningless. Separating them is what makes the two-level discipline possible - a hard
// stop for the wick, a closing-basis exit for the thesis.
//
// RANKED BY SEVERITY, NOT PROXIMITY. The first version of this ranked by distance and so
// reported "INVAL 1862 EMA20(D)" on CHOLAFIN purely because the EMA sat nearest, when the
// pullback thesis actually died at the zone distal 1852.7. Losing the EMA20 is a warning;
// losing the zone that DEFINED the entry is the trade being wrong.
//   INVAL      = strongest structural level below price   (zone distal > swing > S/R > EMA)
//   first test = nearest level below price, when different (what price meets first)
//
// Lives in the library for the same reason as summaryRead: S4 is against BOTH Pine
// ceilings, and this is 40 statements of picker that would otherwise sit in the main body.
export invalLevels(float px, float zoneDistal, bool inZone, float swingLo, float srBelow,
       float ema20D, float atrRef) =>
    float ivZone = (inZone and not na(zoneDistal)) ? zoneDistal : na
    // strongest-first: each stronger candidate overwrites the weaker one
    float st = na
    string stn = ""
    if not na(ema20D) and ema20D < px
        st := ema20D
        stn := "EMA20(D)"
    if not na(srBelow) and srBelow < px
        st := srBelow
        stn := "S/R"
    if not na(swingLo) and swingLo < px
        st := swingLo
        stn := "swing low"
    if not na(ivZone) and ivZone < px
        st := ivZone
        stn := "zone distal"
    // nearest below price, whatever kind
    float nr = na
    string nrn = ""
    if not na(ivZone) and ivZone < px and (na(nr) or ivZone > nr)
        nr := ivZone
        nrn := "zone distal"
    if not na(swingLo) and swingLo < px and (na(nr) or swingLo > nr)
        nr := swingLo
        nrn := "swing low"
    if not na(srBelow) and srBelow < px and (na(nr) or srBelow > nr)
        nr := srBelow
        nrn := "S/R"
    if not na(ema20D) and ema20D < px and (na(nr) or ema20D > nr)
        nr := ema20D
        nrn := "EMA20(D)"
    float atrs = (px - st) / math.max(atrRef, 0.01)
    string out = na(st) ? "" : "\n" + "INVAL " + str.tostring(st, format.mintick) + " " + stn +
         " (-" + str.tostring((px / st - 1.0) * 100.0, "0.0") + "%, " + str.tostring(atrs, "0.00") + "xATR)" +
         ((na(nr) or nr == st) ? "" : "  ·  first test " + str.tostring(nr, format.mintick) + " " + nrn) +
         (atrs < 0.5 ? "  ⚠ inside daily noise — close-basis only, do not stop here" : "")
    out


// ---- oiText -------------------------------------------------------------------
// Renders oiBasis() for the panel. See oiBasis for what the number is and is NOT - in
// particular it is NOT max pain and the "strike" is only the nearest tradeable strike to
// the futures basis, because Pine cannot read an options chain.
export oiText(float basis, float builtPct, int nPrints, float px, float strikeStep) =>
    float strike = na(basis) ? na : math.round(basis / strikeStep) * strikeStep
    string out = na(basis) ? "" : "\n" + "OI basis " + str.tostring(basis, format.mintick) +
         " (~" + str.tostring(strike, format.mintick) + " strike)  ·  " +
         (px >= basis ? "price ABOVE it - the marginal long is in profit, so it is SUPPORT until lost"
                      : "price BELOW it - the marginal long is underwater, so it is RESISTANCE until reclaimed") +
         "  ·  " + str.tostring(math.abs(px / basis - 1.0) * 100.0, "0.0") + "% away  ·  bld " +
         str.tostring(nz(builtPct, 0.0), "0") + "% of " + str.tostring(nPrints) + " prints" +
         (nz(builtPct, 100.0) < 40.0 ? "  ⚠ book is unwinding, basis stale" : "")
    out

// --------------------------------------------------------------------------
// VERDICT LADDER - moved out of S4's main body 24-Aug-2026 (Jay: "free up the
// tokens on S4 ... this is top priority"). A library body compiles SEPARATELY, so
// relocating it returns its whole cost to S4's budget: ~1,082 operations out, ~45
// back at the call site.
//
// VERBATIM lift. The ruling ladder, its branch ORDER and every string are unchanged,
// so the panel reads exactly as before. The only edit is mechanical: the 40 values
// the block used to read as globals are now parameters. Add any future param at the
// END so no existing position shifts under the call site.
//
// Returns the assembled verdict and its colour. S4 keeps the RENDERING (show_analysis,
// f_softBg, table.cell) because those touch chart-local state a library cannot reach.
export verdictRead(color C_NO, color C_OK, color C_WARN, string _act, bool _atValue, float _band_r, 
  string _blk, bool _blueSky, float _cl_r, string _degTxt, string _extTxt, float _extV, float _off52v, 
  float _ovh, float _pbLvl, bool _qArrBad, bool _qArrGood, bool _qExt, bool _qLocWeak, bool _qRoomBad, 
  bool _qSupply, string _roomWord, float _so_high, bool _stage2ok, bool any_pa_v, int cf_strong, 
  int cf_v, bool go_v, bool is_rec_v, bool momentum_clear, float pl_entry, float pl_rr1, float pl_t1, 
  int stage_n, bool stage_skip, bool support_v, int trigAge, float trigHi, bool tt_swing, 
  bool use_retest) =>
    // _anCol was declared ABOVE the lifted range in S4 (v7.2:5311) and every branch
    // below only ASSIGNS it, so the function has to declare it itself. Same default
    // as the original, so an unmatched ladder returns the identical neutral colour.
    color _anCol = color.new(#b2b5be, 0)
    string _L1 = ""
    string _L2 = ""
    string _L3 = ""
    string _L5 = ""
    // STAGE VETO REACHES BOTH ARMS (v7.9, 5-Aug-2026). `stage_skip` was the first branch
    // INSIDE this GO+plan arm, so a Stage-3/4 name that had not triggered yet skipped it
    // entirely and fell through to the no-GO chain below — where it read "ARM", inviting
    // an alert on a stock in a topping or declining structure. Same defect Jay caught the
    // same day in the board's S4-GO column, on the other side of the trigger.
    // Admitting stage_skip to this arm keeps the NO-TRADE block exactly where it is (it
    // is already the first branch) while making it unreachable-proof: every other branch
    // here is an `else if`, so they still require go_v and a plan.
    if stage_skip or (go_v and not na(pl_entry))
        bool _swingOk = not na(pl_rr1) and pl_rr1 >= 2.0
        float _roiT1  = na(pl_t1) ? na : (pl_t1 - pl_entry) / pl_entry * 100.0
        bool _posOk   = not na(_roiT1) and _roiT1 >= 20.0
        // CLEAR TO BREAK (the 75-min room fix): a Stage-2 leader with a live GO whose only
        // problem is a nearby overhead is NOT a no-room reject — the overhead is a level to
        // BREAK toward the real target. Fires only when neither house gate clears (so it can
        // ONLY reframe a would-be SKIP, never downgrade a genuine TAKE IT), not in-supply
        // (that stays a caution unless ATH blue-sky), not already blue-sky, and Stage-2 only.
        // v7.1: `not _atValue` — an at-value pullback has its own ruling above now.
        bool _clearToBreak = momentum_clear and _stage2ok and not _blueSky and not _atValue and not _qSupply and not (_posOk or _swingOk) and not na(_ovh)
        // #verdict (30-Jul, TITAN): the TRADE TYPE decides which house gate applies — DNA
        // has swing at 5-8% over 8-12 weeks and positional at 10-30% over 6-8 months, so
        // they are not peer tests. Reporting them as peers printed "SWING only" directly
        // under a "POSITIONAL" Plan row, which reads as a second, contradicting trade-type
        // call. Now: name the APPLICABLE gate, quote its own number, and when the trade
        // clears only the OTHER bar say what to do about it instead of restating a label.
        //
        // NOTE the structural tension this exposed: a POSITIONAL plan targets tt_t1r_pos
        // (5R), so ROI to T1 = 5 x risk%. With a 2.3% stop that is 11.5% and the 20% rule
        // can NEVER be met — the two positional rules are mutually unreachable whenever
        // risk% < 4%. That is why TITAN read "SWING only" while planned POSITIONAL.
        string _roiTxt = na(_roiT1) ? "n/a" : (_roiT1 >= 0 ? "+" : "") + str.tostring(_roiT1, "0.0") + "%"
        string _rrTxt  = na(pl_rr1) ? "n/a" : str.tostring(pl_rr1, "0.0") + "R"
        string _rule   = ""
        if tt_swing
            if _swingOk
                _rule := "Swing reward confirmed — T1 " + _rrTxt + ", clears the 2R bar."
            else if _posOk
                _rule := "Swing clock, positional-sized room (" + _roiTxt + ") but only " + _rrTxt + " — the stop is too wide for a swing. Tighten the stop or trade it as a positional."
            else
                _rule := "Reward clears neither bar — T1 " + _rrTxt + " and " + _roiTxt + "."
        else
            if _posOk
                _rule := "Positional reward confirmed — T1 " + _roiTxt + ", clears the 20% bar."
            else if _swingOk
                _rule := "Positional structure, SWING-SIZED reward — T1 is only " + _roiTxt + " (20% rule) though R:R is " + _rrTxt + ". Either take it as a SWING and book at 2R, or wait for a deeper entry to earn the positional target."
            else
                _rule := "Reward clears neither bar — T1 " + _roiTxt + " and " + _rrTxt + "."
        // v7.1: the ACTION line hoisted out of the generic TAKE IT branch so the AT-VALUE
        // branch reuses it rather than carrying a second copy. One expression, ONE line —
        // a wrapped ternary indented by a multiple of 4 is the CE10156 trap.
        string _actLine = use_retest ? ("Action: buy-LIMIT " + str.tostring(pl_entry, format.mintick) + (trigAge > 0 ? " on the pullback." : " — but that IS this bar's close, so it fills at MARKET, not a pullback.\n" + (_pbLvl > 0 ? "A true pullback entry sits ~" + str.tostring(_pbLvl, format.mintick) + "." : ""))) : ("Action: buy-STOP above " + str.tostring(nz(trigHi, _so_high), format.mintick) + " (the trigger bar's high). Never buy the touch.")
        if stage_skip
            _L1 := "NO TRADE — Stage " + str.tostring(stage_n) + (stage_n == 3 ? " (topping: 30WMA falling, price still above)" : " (declining: below a falling 30WMA)")
            _L2 := "The house rule is Stage 2 advances and Stage 1 turns only.\nA GO here is a valid TRIGGER inside an invalid CONTEXT —\nthe pattern fired, the stage says do not own it."
            _L3 := "If you take it anyway it is a counter-trend trade: half size at most,\nand manage against the stage, not the target."
            _anCol := C_NO
        // v7.0 (31-Jul, Jay - NYKAA): this branch was UNCONDITIONAL, so a name forced
        // to Manual=Recovery short-circuited here and printed "TAKE IT - Recovery"
        // while _blueSky and _clearToBreak below were unreachable - which is why the
        // SAME bar read TAKE IT in Recovery and CLEAR TO BREAK in Bull. Only the mode
        // differed, and this branch is the greedy one: no reward gate, and _qRoomBad
        // excludes is_rec_v so room is bypassed too.
        // The guard is _stage2ok, NOT an ATH test. stage_skip already vetoes Stage 3/4,
        // so the one remaining contradiction is Manual=Recovery on a REPAIRED name, and
        // _stage2ok is exactly that: Stage 2 (above a RISING 30WMA) AND above the
        // 200-DMA - the v2.3 Auto discriminant and the v5.9 GLAXO stage ruling. A real
        // in-progress recovery that reclaimed the 30WMA but is still under the 200-DMA
        // fails _stage2ok and KEEPS this branch, which is correct. Costs nothing new.
        else if is_rec_v and not _stage2ok
            _L1 := "TAKE IT — Recovery" + (cf_v >= cf_strong ? " ★strong" : "") + ((_qArrBad or _qLocWeak) ? " (size down)" : "")
            _L2 := "A recovery climbs back THROUGH overhead —\nthe levels above ARE the target ladder (T1/T2), not a wall.\nThin room / 'in supply' is EXPECTED for a recovery and does NOT deny the trade."
            // v5.4 (#3 of 3): this buy-STOP is DELIBERATE for a recovery — you confirm the
            // TURN before entering, never buy the touch of a level in a name that has been
            // falling. It is therefore NOT switched by entry_method. But the Plan row below
            // follows entry_method and will be showing a retest LIMIT, so the panel gave two
            // entries again. Say which wins. (Same fix as CLEAR-TO-BREAK and BLUE-SKY in v5.2.)
            // #wrap (30-Jul, Jay — SAILIFE screenshot): the break I added earlier only
            // covered the STATIC head of this string. The two optional tails below are
            // appended AFTER it with no break of their own, so on a recovery with a caveat
            // the line ran ~200 chars unbroken and set the panel width — the "one line with
            // lots of text is not wrapping" case. Each optional tail now opens with its own
            // \n, so it wraps whether or not the ones before it are present.
            _L3 := "Buy-STOP above the trigger bar's high. Targets = the resistance ladder\n(trail as each clears); SL under the recovery low."
                     + (use_retest ? "\nTHIS OVERRIDES the Plan row's retest limit — on a recovery you confirm the turn, not buy the touch." : "") + (_qArrBad ? "\nCaveat: Δ− arrival — size down / await a sharper turn." : _qLocWeak ? "\nCaveat: location is AVWAP/EMA, not a fresh zone — size down." : "")
            _L5 := "Manage against the TURN, not the overhead — exit if it loses the recovery low."
            _anCol := C_OK
        else if _blueSky
            _L1 := "BREAKOUT PIVOT — Stage-2 leader at its high"
            _L2 := "Consolidating under the ATH (" + str.tostring(_off52v, "0.0") + "% off 52WH) —\nthe 'supply' here IS the prior high, meant to BREAK.\nNot distribution, not a range reject."
            // v5.2 (#1): the buy-STOP here is DELIBERATE and is NOT switched by
            // entry_method — price is inside the supply band, so a retest limit would
            // buy INTO resistance, which the blue-sky doctrine forbids. Say explicitly
            // that this overrides the Plan row, which follows entry_method and will be
            // showing a retest limit.
            // #wrap: same fix as the recovery branch — the optional retest-override tail
            // gets its own \n instead of riding on the end of the previous line.
            _L3 := "Don't buy HERE (into the resistance). Arm a buy-STOP above " + (na(_band_r) ? "the band ceiling" : str.tostring(_band_r, format.mintick)) + " — \nabove it is BLUE SKY (reward = measured move / trail, not the next level)." + (use_retest ? "\nTHIS OVERRIDES the Plan row's retest limit — a retest here fills you inside the band." : "")
            _L5 := "Only valid Stage-2 (above 30WMA+200DMA).\nIf RS fades / it's Stage 3, this same band is real supply → skip."
            _anCol := C_OK
        // v7.1 — THE PULLBACK RULING. Sits ABOVE CLEAR TO BREAK deliberately: a name
        // standing IN a demand zone is at value, so "the overhead is a level to break"
        // is the wrong frame for it even though both can be true. Fires whether or not
        // the reward gates clear — the headline says which and _rule carries the number,
        // so a thin-reward pullback reads ARM, never a green light.
        else if _atValue
            _L1 := ((_posOk or _swingOk) ? "TAKE IT — PULLBACK TO VALUE" : "ARM — PULLBACK TO VALUE, reward still thin") + (cf_v >= cf_strong ? " ★strong" : "")
            _L2 := _rule
            _L3 := "In a demand zone, Stage-2, not extended, not in supply —\nthe house A+ location. Buy the pullback; this is NOT a breakout entry." + (_qArrBad ? "\nCaveat: GRIND arrival with Δ− — size down or wait for a sharper turn." : "")
            _L5 := _actLine
            _anCol := _qArrBad ? C_WARN : C_OK
        else if _clearToBreak
            _L1 := "CLEAR TO BREAK — Stage-2, level overhead"
            _L2 := "Nearest overhead " + str.tostring(_ovh, format.mintick) + " (+" + str.tostring((_ovh - _cl_r) / _cl_r * 100.0, "0.0") + "%) is a level to BREAK, not the target —\non the trading TF an HTF level is ALWAYS overhead within a thin R."
            // v5.2 (#1): this line hardcoded "Arm a buy-STOP" (written under the v4.7
            // APOLLOHOSP ruling, which assumed buy-stop entry) while the Plan row and
            // STATUS follow entry_method — defaulted to RETEST since the 23-Jul entry
            // A/B, where retest beat buy-stop on every family. The panel therefore told
            // you to enter in two places ~4% apart. It now follows the SAME input, so
            // there is one entry instruction on the panel.
            _L3 := (use_retest ? "Enter per the Plan — buy-LIMIT at the trigger close (retest the pullback);\n" + str.tostring(_ovh, format.mintick) + " is the level to CLEAR on the way, not the entry." : "Arm a buy-STOP above " + str.tostring(_ovh, format.mintick) + ".") + " \nReal target = the measured move / swing-positional R-objective,\nnot this level; room to THIS level is thin by design."
            _L5 := "Valid only in a Stage-2 uptrend (above 30WMA+200DMA).\nStage 3/4 into overhead, or price INSIDE a supply band, stays a SKIP."
            _anCol := C_OK
        else if _qRoomBad
            _L1 := "SKIP — clean trigger, no room"
            _L2 := _roomWord
            _L3 := "Buying into overhead supply is not a trade."
            _anCol := C_NO
        else if _posOk or _swingOk
            _L1 := (_qLocWeak or _qExt) ? "CAUTION — momentum/chase" : ("TAKE IT" + (cf_v >= cf_strong ? " ★strong" : "") + (_qArrGood ? " · quality arrival" : ""))
            _L2 := _rule
            _L3 := _qLocWeak ? "Location is the AVWAP/EMA only — NOT a demand zone. A momentum/breakout entry,\nnot a pullback to support (your A+ setup). Size down or wait for a pullback into a zone." : _qExt ? ("Caveat: EXTENDED " + str.tostring(_extV, "0.0") + " ATR above the EMA20 — chasing;\nsize down or wait for a pullback toward value.") : _qArrBad ? "Caveat: GRIND arrival with Δ− — size down or wait for a sharper re-test." : ""
            // #verdict (30-Jul, TITAN): the panel was giving THREE entry instructions at
            // once — Plan "Buy-LIMIT 4855 = trigger close", STATUS "arm buy-limit @ close
            // on the pullback", and this line "Buy-STOP above the high (overrides the Plan
            // row)". This branch has no SITUATIONAL reason to override (unlike in-supply,
            // recovery or blue-sky, which still do and still say so); it was overriding
            // entry_method unconditionally, which also silently reversed the retest default
            // the 23-Jul A/B established. `entry_method` is now the single source of truth
            // here, and the action line adds only what the Plan row cannot: whether that
            // limit is actually a pullback, and where a real one sits.
            // v7.1: hoisted verbatim to `_actLine` above and shared with AT-VALUE —
            // one action instruction, one definition.
            _L5 := _actLine
            _anCol := (_qArrBad or _qExt or _qLocWeak) ? C_WARN : C_OK
        else
            _L1 := "SKIP — payoff too thin"
            _L2 := _rule
            _L3 := "The entry is clean; the reward does not justify the risk."
            _anCol := C_NO
    else if go_v
        _L1 := "GO — but no plan"
        _L2 := "No structural stop / target could be built."
        _L5 := "Mark the levels by hand before acting."
        _anCol := C_WARN
    else if _blueSky
        _L1 := "BREAKOUT PIVOT (arming)"
        _L2 := "Stage-2 leader consolidating under its ATH (" + str.tostring(_off52v, "0.0") + "% off 52WH). Blocked: " + _blk + "."
        _L3 := "Not a 'no room' reject — the band ceiling IS the breakout level.\nArm a buy-STOP above " + (na(_band_r) ? "the band ceiling" : str.tostring(_band_r, format.mintick)) + "; above it is blue sky."
        _anCol := C_WARN
    else if _qRoomBad
        _L1 := "NOT TRADEABLE"
        _L2 := "Blocked: " + _blk
        _L3 := "Disqualifier: " + _roomWord + "\n— clearing that gate alone will NOT make this a trade."
        _anCol := C_NO
    else if _qArrBad
        _L1 := "LOW QUALITY — wait for a better tap"
        _L2 := "Blocked: " + _blk
        _L3 := "Arrival is a GRIND with Δ− — momentum is absorbing the level (bleed-through risk)."
        _L5 := _act
        _anCol := C_WARN
    else
        _L1 := "ARM" + (_qArrGood ? " — quality setup" : "")
        _L2 := "Waiting on: " + _blk
        _L3 := (not any_pa_v and support_v) ? "At a location with clean volume/bar — only the pattern is missing." : ""
        _L5 := _act
        _anCol := C_WARN
    // v5.4: the EXTENDED warning rides on the HEADLINE where it cannot be missed — a
    // late entry is a property of the ENTRY, not a reason the trade itself is wrong.
    // The verdict is now exactly four lines: ruling · why · the one caveat · the action.
    string _aVerOut = _L1 + _degTxt + _extTxt + "\n" + _L2 + (str.length(_L3) > 0 ? "\n" + _L3 : "") + (str.length(_L5) > 0 ? "\n" + _L5 : "")
    [_aVerOut, _anCol]

