        _b += "10,10,10,11,0,11,15,7,14,10,10,17,8,8,11,9,6,10,1,13,14,4,13,13,8,10,13,4,8,7,13,10,6,7,10,13,17,13,14,11,10,9,10,0,1,10,6,10,1,0,0,0,8,14,10,10,1,1,11,15,0,11,6,9,0,13,8,14,11,14,10,10,6,6,6,8,8,13,13,16,22,10,8,9,11,11,11,4,14,13,"
        _b += "8,4,8,15,16,17,13,40,8,14,11,9,4,11,14,0,8,14,6,13,14,8,43,17,30,30,41,31,4,11,9,10,35,41,30,23,25,3,16,4,8,11,4,7,17,4,0,8,4,8,8,8,14,13,17,10,5,12,10,10,9,11,12,14,11,28,14,7,8,21,11,8,7,13,13,7,7,8,10,26,17,16,16,11,7,43,43,4,4,4,"
        _b += "16,14,7,0,9,5,0,9,17,5,8,11,43,8,14,12,6,9,14,16,5,5,11,8,1,8,10,17,0,14,8,7,10,14,0,0,16,4,4,13,10,10,15,15,10,13,12,32,6,17,9,10,13,14,9,13,10,13,9,1,16,8,17,6,7,13,10,4,4,13,11,7,0,7,0,11,13,14,8,4,17,13,12,12,8,8,8,29,1,0,"
        _b += "0,10,9,17,1,11,6,13,17,10,8,13,0,16,17,7,0,33,18,16,0,4,11,14,5,5,8,10,13,5,8,14,16,12,4,10,13,14,0,10,17,14,0,11,10,8,13,10,9,11,8,4,7,13,11,6,17,17,11,17,11,0,0,10,4,6,0,14,4,0,12,0,6,4,4,42,2,14,7,6,6,9,0,9,10,4,4,9,15,13,"
        _b += "10,1,9,4,5,11,13,8,6,11,13,9,9,13,9,14,13,6,13,6,6,9,0,13,10,9,17,6,11,14,1,12,11,0,4,17,14,9"
        _secSym := str.split(_a, ",")
        _secCod := str.split(_b, ",")
        _secNam := str.split("Capital Goods & Defense,Bank Nifty,Nifty 100,Nifty 500,Auto,Nifty Commodities,Nifty India Consumption,Energy,Financial Services,FMCG,Infra,Nifty IT,Media,Metal,Pharma,PSU Bank,Realty,Services,NIFTY Smallcap 100,Nifty CPSE,Finnifty,Nifty 50,Nifty 100 Low Volatility 30,Nifty 200 Momentum 30,Nifty 200 Alpha 30,Nifty 500 Momentum 50,Nifty50 Value 20 Index,NIFTY ALPHA 50,Nifty Next 50,Nifty Midcap 150 Momentum,Nifty Mid Cap 50,Nifty MidSmallCap 400,Nifty Private Bank,Nifty Smallcap250 Momentum Quality 100,NIFTY Smallcap 250,Nifty Capital Market,Nifty Chemicals,Nifty EV and New Age Auto,Nifty Financial Services Ex Bank,Nifty Healthcare,Nifty India Manufacturing,India Defence,Nifty India Digital,Oil & Gas", ",")
    string _out = ""
    if not na(sym) and array.size(_secSym) > 0
        int _i = array.indexof(_secSym, str.upper(sym))
        if _i >= 0
            int _c = math.round(nz(str.tonumber(array.get(_secCod, _i)), -1))
            if _c >= 0 and _c < array.size(_secNam)
                _out := array.get(_secNam, _c)
    _out
// <SECTOR_MAP_END>
export fundGate(simple string mode, bool isRec, float score, int minScore, string bits, bool haveList, simple bool strict) =>
    // THE FLOOR SCALES TO THE CHECKS THAT APPLIED - this mirrors
    // bull_fundamental_filter.bff_passes(), and a flat comparison is a KNOWN BUG.
    // margin_expansion is deliberately dropped for financials (lenders report no
    // OPM), so a bank has FOUR applicable checks where everything else has five.
    // Comparing a bank's score against a flat "4 of 5" demands a PERFECT 4 of 4
    // from every lender - that is what kept HDFCBANK / ICICIBANK / AXISBANK / SBIN
    // out of the book until 13-Aug-2026. floor 4 of 5 == 80%, so a 4-check name
    // needs round(0.8 x 4) = 3. The BFFC bitstring carries this for free: "-" marks
    // a check that did not apply, so its length minus the dashes IS `applicable`.
    // RECOVERY is NOT scaled - recovery_screener compares rff_base to a flat
    // rff_min_score with no re-basing, so scaling it here would invent a rule.
    int _res = 0
    int _pas = 0
    if str.length(bits) > 0
        for _i = 0 to str.length(bits) - 1
            string _c = str.substring(bits, _i, _i + 1)
            if _c != "-"
                _res += 1
                if _c == "1"
                    _pas += 1
    bool  _scaled = (not isRec) and _res > 0
    int   _req    = _scaled ? math.max(1, int(math.round(minScore / 5.0 * _res))) : minScore
    float _sc     = _scaled ? _pas : score
    bool  _scored = not na(_sc)
    bool  _ok     = not haveList ? true : _scored ? _sc >= _req : not strict
    string _chip  = not haveList ? "?" : _scored ? (_ok ? "🟢" : "🔴") : (strict ? "🔴" : "?")
    string _note  = not haveList ? "no GM list pasted — gate inactive" : _scored ? ((isRec ? "RFF " : "BFF ") + str.tostring(_sc, "0") + "/" + str.tostring(_scaled ? _res : (isRec ? 6 : 5)) + " vs min " + str.tostring(_req)) : "not on the GM's scored list"
    [mode != "Gate" or _ok, _ok, _chip, _note]


// ── volumeProfile ───────────────────────────────────────────────
// POC / VAH / VAL over a fixed-row histogram (29-Aug-2026). Moved out of Section 4,
// which sits permanently against the 100,256 compiled-token ceiling: a library body
// compiles separately, so the arithmetic leaves S4's budget with behaviour identical.
//
// WHAT DID *NOT* MOVE, and why it matters: the caller keeps `var float vp_poc/vah/val`
// and the barstate gate. The gate is the load-bearing part -- this is a
// rows x lookback nested loop (40 x 100 = 4,000 iterations) and `barstate.isrealtime`
// is true on EVERY TICK, which is what produced "Calculation timed out" twice in 30
// minutes once the market opened. Moving code to a library relieves TOKENS ONLY; it
// does nothing for the 20-second execution limit, so the caller must keep computing
// this once per CLOSED bar.
//
// Series parameters retain their history, so hiS[i] / loS[i] / volS[i] index exactly
// as high[i] / low[i] / volume[i] did in place.
// Returns [na, na, na] when the range is degenerate, so the caller can leave the
// previous profile standing rather than blanking it.
// `run` IS THE GATE, and it is a parameter rather than a wrapper `if` on purpose.
// Pine requires a function that indexes its series parameters to be called on EVERY
// calculation so those history buffers are sized consistently -- calling it inside an
// `if` raises "should be called on each calculation for consistency" and leaves the
// allocation to inference. But calling this unconditionally would run a
// rows x lookback loop every bar AND every tick, which is what produced
// "Calculation timed out" twice in 30 minutes once the market opened.
// Passing the gate in satisfies both: the CALL happens every bar, the LOOP does not.
// Returns [na, na, na] when run is false, so the caller keeps its previous profile.
export volumeProfile(bool run, float hiS, float loS, float volS, float rngHi, float rngLo,
     simple int rows, simple int lookback, int barIdx) =>
    float _poc = na
    float _vah = na
    float _val = na
    float _range = rngHi - rngLo
    if run and _range > 0 and rows > 0
        float _row  = _range / rows
        _varr = array.new_float(rows, 0.0)
        int _bars = math.min(lookback, barIdx)
        for i = 0 to _bars - 1
            float bhi  = hiS[i]
            float blo  = loS[i]
            float bvol = volS[i]
            float brang = bhi - blo
            if brang > 0
                for j = 0 to rows - 1
                    float lvlo = rngLo + j       * _row
                    float lvhi = rngLo + (j + 1) * _row
                    float overlap = math.max(0.0, math.min(bhi, lvhi) - math.max(blo, lvlo))
                    if overlap > 0
                        array.set(_varr, j, array.get(_varr, j) + bvol * (overlap / brang))
        float _maxv = array.max(_varr)
        int _pocidx = array.indexof(_varr, _maxv)
        _poc := rngLo + (_pocidx + 0.5) * _row
        float _totv  = array.sum(_varr)
        float _vatgt = _totv * 0.70
        float _vavol = _maxv
        int   _vai   = _pocidx
        int   _vbi   = _pocidx
        for _i = 0 to rows - 1
            if _vavol >= _vatgt
                break
            float _nhi = _vai + 1 < rows ? array.get(_varr, _vai + 1) : 0.0
            float _nlo = _vbi - 1 >= 0   ? array.get(_varr, _vbi - 1) : 0.0
            if _nhi >= _nlo
                _vai   := _vai + 1
                _vavol += _nhi
            else
                _vbi   := _vbi - 1
                _vavol += _nlo
        _vah := rngLo + (_vai + 1) * _row
        _val := rngLo +  _vbi      * _row
    [_poc, _vah, _val]


// ---- qualityRead ------------------------------------------------------------
// The SUMMARY's non-technical section. Added when Gate 6 shipped: the field that reads
// the whole panel as ONE judgement was, until then, entirely technical - which is the
// exact thing the fundamental gate exists to stop.
//
// Lives here rather than at the call site because it is five ternary branches, and S4's
// main body is limited by BRANCHES as much as by statements. Inlining it there cost the
// file a compile (CE10295); one call costs nothing measurable.
//
// It prints no number that appears on the FUNDAMENTALS row above it. `raw` is the
// unconditional verdict and `ok` is the gate-mode-applied one, so the two disagreeing is
// precisely the Warn state - a name below the floor that is not being blocked, which is
// the case worth spelling out and the one nothing else on the panel says.
export qualityRead(bool isEtf, bool have, bool raw, bool ok) =>
    isEtf ? "QUALITY · There are no company books to judge here. An ETF's quality read is its LIQUIDITY and its PREMIUM TO NAV, both on the rows above - and the premium is the only thing on this panel that can make a technically perfect chart the wrong trade, because that loss is booked on entry whatever the index does next."
     : not have ? "QUALITY · Nothing has vouched for the books. The Golden Matcher has not scored this name, so the fundamental gate is inert and everything below is a purely technical case. Fine for a chart you are studying; thin ground for a position."
     : raw ? "QUALITY · The books clear the Golden Matcher's floor, so the technical read below is not carrying this trade on its own. It is a SUBSET of the GM's verdict rather than the whole of it - return on equity, leverage and the size/pledge floor are not carried onto this chart, so the board can still reject a name that passes here."
     : ok ? "QUALITY · The books are BELOW the floor and the gate is set to Warn, so nothing is being blocked. Everything below is a technical case for a name the Golden Matcher scores as fundamentally weak: take it as a trade if you must, never as a position, and size it as the former."
     : "QUALITY · Blocked on the books, and that outranks every technical line below. No amount of waiting for volume or a better bar fixes it - the Golden Matcher scores this name under the fundamental floor, and the chart is not the thing that is wrong."


// ---- blockRead --------------------------------------------------------------
// Which gate is red, and what would change it. Returned together because they are ONE
// decision read twice, and holding them apart is how they drifted: _blk grew the EMA20
// and rotation branches while _act still answered every case with "wait for a bar that
// closes strong" - telling you to watch the candle on a name whose candle was fine.
//
// The order mirrors the TRIGGER chip left to right (P L V B R F) so the sentence and the
// chips can never disagree about which gate is red. Covers every term in `go`; the final
// fallback is the bar, which is the only one left once the others are true.
export blockRead(bool anyPa, bool supportOk, bool volOk, float rv, float rvFloor,
       bool emaOk, bool rrgOk, bool fundOk, string fundNote) =>
    string blk = not anyPa ? "no PA pattern"
     : not supportOk ? "not at a location"
     : not volOk ? ("volume below floor (RV " + str.tostring(rv, "0.00") + "/" + str.tostring(rvFloor, "0.00") + ")")
     : not emaOk ? "price is below the EMA20"
     : not rrgOk ? "rotation is outside the whitelist"
     : not fundOk ? ("the fundamental gate blocked it (" + fundNote + ")")
     : "the trigger bar closed weak"
    string act = not anyPa ? "Watch for a closed-bar PA trigger here."
     : not supportOk ? "Needs a pullback into a zone / level."
     : not volOk ? "Watch for a volume surge."
     : not emaOk ? "Needs a reclaim of the EMA20 first."
     : not rrgOk ? "Not a price problem - wait for the rotation to turn, or switch the RRG gate off if you are deliberately trading this against it."
     : not fundOk ? "Not a technical problem - the GM scores this name below the fundamental floor, and no amount of waiting for a better bar will change that."
     : "Wait for a bar that closes strong."
    [blk, act]


// ---- packField ---------------------------------------------------------------
// Pull field `idx` (0-based) out of a "/"-packed value.
//
// The options bundle carries six numbers per symbol as SYM:pcr/maxpain/ce/pe/atm/peK/ceK
// instead of six separate sections. That is not a micro-optimisation: the repeated
// SYMBOL NAME is the dominant cost in a bundle against a ~4,096-char input.string cap,
// so packing is the difference between six fields fitting and not.
//
// "/" is the separator because "|" already separates bundle SECTIONS and "," already
// separates SYMBOLS - reusing either would make the bundle unparseable from the first
// options value onward.
//
// An absent or empty field returns na, never 0. These become price levels on the chart.
export packField(string packed, simple int idx) =>
    float out = na
    if str.length(packed) > 0
        string rest = packed
        int i = 0
        bool done = false
        while not done
            int at = str.pos(rest, "/")
            string tok = na(at) ? rest : str.substring(rest, 0, at)
            if i == idx
                out := str.length(tok) > 0 ? str.tonumber(tok) : na
                done := true
            else if na(at)
                done := true
            else
                rest := str.substring(rest, at + 1)
                i += 1
    out


// ---- oiBasis2 ----------------------------------------------------------------
// Futures OI basis, SPLIT by the price direction at each OI event.
//
// oiBasis pools every OI increase into one weighted mean, so a name with shorts built at
// one price and longs at another reports a level between them where neither side is
// positioned. The two sides defend different prices and that is the whole point:
//
//     OI built while price ROSE   -> longs  -> the basis is SUPPORT beneath
//     OI built while price FELL   -> shorts -> the basis is RESISTANCE above
//
// Counts are returned so the caller can decline to draw a level off one or two events.
// The two can invert (short basis below the long basis) in a genuinely two-sided market;
// that is a real state meaning "no clean OI level", not an error, and the caller should
// say so rather than draw an upside-down band.
export oiBasis2(float oi, float px, bool pxUp, simple int nEvents) =>
    var array<float> lp = array.new<float>()
    var array<float> lw = array.new<float>()
    var array<float> sp = array.new<float>()
    var array<float> sw = array.new<float>()
    float prev = nz(oi[1], oi)
    bool fresh = not na(oi) and not na(oi[1]) and oi != oi[1] and prev > 0
    if fresh
        float d = oi - prev
        if d > 0
            if pxUp
                array.push(lp, px)
                array.push(lw, d)
                while array.size(lp) > nEvents
                    array.shift(lp)
                    array.shift(lw)
            else
                array.push(sp, px)
                array.push(sw, d)
                while array.size(sp) > nEvents
                    array.shift(sp)
                    array.shift(sw)
    float lNum = 0.0
    float lDen = 0.0
    if array.size(lp) > 0
        for i = 0 to array.size(lp) - 1
            lNum += array.get(lw, i) * array.get(lp, i)
            lDen += array.get(lw, i)
    float sNum = 0.0
    float sDen = 0.0
    if array.size(sp) > 0
        for i = 0 to array.size(sp) - 1
            sNum += array.get(sw, i) * array.get(sp, i)
            sDen += array.get(sw, i)
    [lDen > 0 ? lNum / lDen : na, sDen > 0 ? sNum / sDen : na, array.size(lp), array.size(sp)]


// ---- optText -----------------------------------------------------------------
// The Options OI row.
//
// EVERY field renders "-" when absent, never 0. nse_options returns None on a failed
// fetch for exactly this reason: three of these numbers are drawn as price levels, and a
// max pain of 0 renders as a line below every stop that is indistinguishable from a real
// one. "No data" and "zero" are different facts about an option chain.
//
// PCR is banded rather than printed raw against a threshold, because the number alone
// does not say which way to read it: above ~1.3 is put-heavy (contrarian bullish), below
// ~0.7 is call-heavy complacency, and the middle is noise.
export optText(float pcr, float maxPain, float totCe, float totPe, float atmShift,
       float peK, float ceK, float px) =>
    string sPcr = na(pcr) ? "PCR -"
     : "PCR " + str.tostring(pcr, "0.00") + (pcr > 1.3 ? " 🟢" : pcr < 0.7 ? " 🔴" : " ⚪")
    string sMp = na(maxPain) or na(px) or px <= 0 ? "  │  Max pain -"
     : "  │  Max pain " + str.tostring(maxPain, format.mintick)
       // Sign built by hand: str.tostring(x, "+0.0") emits the format's "+" AND the
       // value's own "-", so a negative distance printed as "-+0.9%" on the live panel.
       // Pine's short format strings misbehave in more than one way; do not trust them
       // to carry a sign.
       + " (" + ((maxPain - px) >= 0 ? "+" : "")
       + str.tostring((maxPain - px) / px * 100.0, "0.0") + "%)"
    string sOi = na(totCe) or na(totPe) ? "  │  OI -"
     : "  │  OI " + str.tostring(totCe / 100000.0, "0.0") + "L CE / "
       + str.tostring(totPe / 100000.0, "0.0") + "L PE"
    string sAtm = na(atmShift) ? "" : "  │  ATM ΔOI " + (atmShift >= 0 ? "+" : "") + str.tostring(atmShift, "0.0") + "%"
    string sK = na(peK) and na(ceK) ? "" :
       "  │  writers S " + (na(peK) ? "-" : str.tostring(peK, format.mintick))
       + " · R " + (na(ceK) ? "-" : str.tostring(ceK, format.mintick))
    sPcr + sMp + sOi + sAtm + sK


// ---- optRead -----------------------------------------------------------------
// All six packed option fields for `sym`, in one call.
//
// Packed as SYM:pcr/maxpain/totCE/totPE/atmShift/peStrike/ceStrike. Six separate
// packField calls at the S4 site would be six main-body statements against a ~1,000
// ceiling S4 already sits on; one tuple destructure is one.
//
// Every field is na when absent - never 0. Three of these are drawn as price levels.
export optRead(string section, simple string sym) =>
    string packed = fundStr(section, sym)
    [packField(packed, 0), packField(packed, 1), packField(packed, 2),
     packField(packed, 3), packField(packed, 4), packField(packed, 5), packField(packed, 6)]


// ---- oiLevels ----------------------------------------------------------------
// Draw the OI-derived support/resistance rays. One call, five lines.
//
// Rays, not plot(): these are daily values forward-filled onto an intraday chart, so a
// plot would render a staircase rather than a level - and drawn objects cost none of the
// 64 plot outputs (S4 uses 22).
//
// A `var` inside a Pine function is per CALL SITE, so the five handles below stay
// independent without S4 declaring a single one of them.
//
// Passing na for a level is how the caller declines to draw it, and that is the
// mechanism that keeps a one-event OI basis or a failed option fetch OFF the chart. A
// line drawn from one observation looks exactly as authoritative as one drawn from
// thirty, which is why the count test belongs at the source and na belongs here.
// Takes the raw levels PLUS their event counts and applies the minimum here, so the
// caller does not spend two main-body branches deciding what to suppress.
// MIN_OI_EVENTS is defined here, not passed in, so the rule has ONE home and the two
// functions that apply it cannot drift. Three prints is the floor for calling
// something a level: one observation drawn as a ray looks exactly as authoritative
// as thirty, and the chart must not assert more than the data supports.
export oiLevels(bool show, float longB, float shortB, int nLong, int nShort,
       float maxPain, float peK, float ceK,
       color cLong, color cShort, color cPain, color cPe, color cCe, simple int wid) =>
    int   minN     = 3
    float longUse  = nLong  >= minN ? longB  : na
    float shortUse = nShort >= minN ? shortB : na
    var line l1 = na
    var line l2 = na
    var line l3 = na
    var line l4 = na
    var line l5 = na
    var label b1 = na
    var label b2 = na
    var label b3 = na
    var label b4 = na
    var label b5 = na
    if barstate.islast
        line.delete(l1), line.delete(l2), line.delete(l3), line.delete(l4), line.delete(l5)
        label.delete(b1), label.delete(b2), label.delete(b3), label.delete(b4), label.delete(b5)
        if show
            int x = bar_index - 60
            if not na(longUse)
                l1 := line.new(x, longUse, bar_index, longUse, extend=extend.right, color=cLong, width=wid, style=line.style_dashed)
                b1 := label.new(bar_index, longUse, "FUT long basis", style=label.style_label_left, color=color.new(cLong, 85), textcolor=cLong, size=size.tiny)
            if not na(shortUse)
                l2 := line.new(x, shortUse, bar_index, shortUse, extend=extend.right, color=cShort, width=wid, style=line.style_dashed)
                b2 := label.new(bar_index, shortUse, "FUT short basis", style=label.style_label_left, color=color.new(cShort, 85), textcolor=cShort, size=size.tiny)
            if not na(maxPain)
                l3 := line.new(x, maxPain, bar_index, maxPain, extend=extend.right, color=cPain, width=wid, style=line.style_dashed)
                b3 := label.new(bar_index, maxPain, "max pain", style=label.style_label_left, color=color.new(cPain, 85), textcolor=cPain, size=size.tiny)
            if not na(peK)
                l4 := line.new(x, peK, bar_index, peK, extend=extend.right, color=cPe, width=wid, style=line.style_dashed)
                b4 := label.new(bar_index, peK, "PE writers", style=label.style_label_left, color=color.new(cPe, 85), textcolor=cPe, size=size.tiny)
            if not na(ceK)
                l5 := line.new(x, ceK, bar_index, ceK, extend=extend.right, color=cCe, width=wid, style=line.style_dashed)
                b5 := label.new(bar_index, ceK, "CE writers", style=label.style_label_left, color=color.new(cCe, 85), textcolor=cCe, size=size.tiny)
    true


// ---- oiBasisTxt --------------------------------------------------------------
// The two futures OI levels, formatted, with the event minimum applied here.
//
// A side below `minN` prints an em-dash rather than a price: one OI observation is not a
// level, and the panel must not state something the data cannot support. Returns an
// empty string when neither side exists, so the caller appends it unconditionally.
export oiBasisTxt(float longB, float shortB, int nLong, int nShort) =>
    int minN = 3          // same floor as oiLevels; see the note there
    string out = ""
    if not (na(longB) and na(shortB))
        out := "   │   basis  L "
             + (nLong >= minN and not na(longB) ? str.tostring(longB, format.mintick) : "—")
             + " · S "
             + (nShort >= minN and not na(shortB) ? str.tostring(shortB, format.mintick) : "—")
    out


// ---- optRow ------------------------------------------------------------------
// The Options OI row: text AND colour in one call, so the S4 site spends no branches.
//
// The cash-only case is handled HERE and reads "no options" rather than a row of
// em-dashes. Absent and empty are different facts about a symbol - most of the board has
// no F&O at all, and a line of dashes would read as a failed fetch instead of a name
// that simply has no option chain to read.
// SPLIT into text and colour rather than returning a tuple: a tuple forces a
// destructure at the call site, and that is a main-body statement S4 cannot spare.
// Two calls inline straight into the f_row arguments and cost nothing.
export optRowTxt(float pcr, float maxPain, float totCe, float totPe, float atmShift,
       float peK, float ceK, float px) =>
    na(pcr) and na(maxPain) and na(totCe)
      ? "no options — cash-only name, or not in the OPT paste"
      : optText(pcr, maxPain, totCe, totPe, atmShift, peK, ceK, px)

export optRowCol(float pcr, float maxPain, float totCe,
       color cMute, color cOk, color cNo, color cInfo) =>
    na(pcr) and na(maxPain) and na(totCe) ? cMute
      : (not na(pcr)) and pcr > 1.3 ? cOk
      : (not na(pcr)) and pcr < 0.7 ? cNo : cInfo


// ---- wallCheck ---------------------------------------------------------------
// Re-prices the quoted R:R against OPTION-WRITER positioning, and flags a stop that
// sits inside the band the put writers are defending. Appended to the Entry/SL/T1/T2
// row - no new row, the same rule the invalidation text already follows.
//
// SEVEN STATEMENTS, DELIBERATELY. A library call INLINES its body into the caller's
// main body, so every statement here is spent from S4's ~1,000 budget at the single
// call site. The first draft was ~19 and would not compile. Keep it terse; if this
// grows, S4 stops compiling and the error names the main body, not this file.
//
// WHY THE CALL WALL AND NOT MAX PAIN. Measured across the 23 F&O names on the live
// 75m board (2 Sep 2026): the call-writer strike sits a median +5.73% from spot,
// ranging +0.4% to +17.4%, so it DISCRIMINATES - 6 of 23 had clear air to T1 while
// TECHM had its entire first reward behind a wall 1.5% away. Max pain sits a median
// 1.33% from spot with 78% inside 2%: it is the ATM strike wearing another name, so
// truncating a target at it collapses R:R by arithmetic. It is NOT read here.
//
// THE PUT-WALL BAND IS REASONED, NOT FITTED - there is no outcome data to fit it on.
// Below loATR the wall is effectively AT the stop; above hiATR it is a deep-OTM strike
// where cheap puts pile up rather than a floor anyone defends (SOLARINDS sat 3.58 ATR
// out, at -9.6% from spot). Raw "SL above the put wall" fired on 13 of 23 - wallpaper.
//
// GEOMETRY, NOT AN OUTCOME TEST. No options-OI history exists in any feed wired to
// this system, so nothing here may gate: it re-prices, and it warns. Near-month, so
// it speaks to the swing leg and not a positional T2 six months out, and it is silent
// on any name with no futures contract - about half the book.
// SECONDARY CHECKS, not overrides (Jay, 4-Sep-2026). basis and maxPain annotate the
// plan the engine already produced - they never move entry, SL or a target. The
// point is to catch a good-looking plan sitting in a bad place relative to
// positioning, which is a hit-rate problem rather than a levels problem.
export wallCheck(float entry, float sl, float t1, float ceK, float peK, float atr, float loATR, float hiATR, float px, float basis, float maxPain) =>
    float risk = (na(entry) or na(sl)) ? na : entry - sl
    bool okR = not na(risk) and risk > 0
    // PROVISIONAL — no plan yet, but the ceiling is what decides whether arming is
    // worth it. Priced against a 1xATR reference stop (Golden Rule 3's own unit) and
    // always TAGGED: an R against an entry you have not taken is the shape of number
    // that produced CHOLAFIN's 5.6R.
    bool prov = (not okR) and not na(px) and px > 0 and not na(atr) and atr > 0
    float e0 = okR ? entry : px
    float r0 = okR ? risk : atr
    bool binds = okR and not na(ceK) and not na(t1) and ceK > entry and ceK < t1
    float pwGap = (not okR or na(peK) or na(atr) or atr <= 0) ? na : (sl - peK) / atr
    string sCe = binds ? "  │  ⚠ call wall " + str.tostring(ceK, format.mintick) + " (+" + str.tostring((ceK / entry - 1.0) * 100.0, "0.0") + "%) → " + str.tostring((ceK - entry) / risk, "0.0") + "R to the wall" : (okR and not na(ceK) and not na(t1) and ceK >= t1 ? "  │  call wall " + str.tostring(ceK, format.mintick) + " clear of T1 · " + str.tostring((ceK - entry) / risk, "0.0") + "R to the wall" : (prov and not na(ceK) and ceK > px ? "  │  prov · call wall " + str.tostring(ceK, format.mintick) + " (+" + str.tostring((ceK / px - 1.0) * 100.0, "0.0") + "%) ≈ " + str.tostring((ceK - px) / atr, "0.0") + "R at a 1×ATR stop" : ""))
    string sPe = (not na(pwGap) and pwGap >= loATR and pwGap <= hiATR) ? "  │  ⚠ SL sits " + str.tostring(pwGap, "0.0") + "×ATR above the put wall " + str.tostring(peK, format.mintick) + " (" + str.tostring((peK / entry - 1.0) * 100.0, "0.0") + "%) — it triggers before that floor is tested" : ""
    // SL vs the FUTURES BASIS - the level where the marginal long is trapped. A stop
    // parked just above it gets taken out by a routine test of the level before that
    // test decides anything; a stop below it survives the test. Reported both ways:
    // one is a warning, the other is a reason to hold through noise.
    float bGap = (not okR or na(basis) or na(atr) or atr <= 0) ? na : (sl - basis) / atr
    string sBs = na(bGap) ? "" : (bGap > 0 and bGap <= 0.75) ? "  │  ⚠ SL sits " + str.tostring(bGap, "0.0") + "×ATR above the futures basis " + str.tostring(basis, format.mintick) + " — a routine test of the basis stops you out first" : bGap <= 0 ? "  │  SL is below the futures basis " + str.tostring(basis, format.mintick) + " — it survives a test of the trapped-long level" : ""
    // MAX PAIN between entry and T1 pulls AGAINST the target into expiry. It is not a
    // reason to skip - it is a reason not to expect T1 this cycle. Median max pain sits
    // ~1.3% from spot, so it lands inside a 2R target far more often than it looks.
    string sMp = (not okR or na(maxPain) or na(t1)) ? "" : (maxPain > entry and maxPain < t1) ? "  │  ⚠ max pain " + str.tostring(maxPain, format.mintick) + " sits between entry and T1 — expiry pinning pulls against the target until it rolls" : ""
    sCe + sPe + sBs + sMp + (str.length(sCe) + str.length(sPe) + str.length(sBs) + str.length(sMp) > 0 ? "  · near-month" : "")


// ---- oiNarrative -------------------------------------------------------------
// The plain-English reading under rows 9 and 10. Jay is new to F&O and asked for
// guidance rather than figures - "throwing various numbers will not make much sense
// to me" - so each row states what the positioning MEANS and what to expect. The
// numeric strips above them are untouched: scan the figures, then read this.
//
// IT LIVES HERE FOR TOKENS. Built inline in S4 it cost ~1,050 compiled tokens and
// put the script over the 100,256 ceiling; a library body compiles separately. S4
// calls it from inside a LOCAL function, so the statements this inlines land in
// that function rather than in the main body.
//
// Prose is PRE-BROKEN with newlines, never wrapped at runtime: a string literal is
// one token however long it is, while core.wrapText() is loops and array work. The
// break points also cap the panel width, which a runtime wrap could not promise.
export oiNarrative(float oiPct, bool pxUp, bool oiUp, float basis, float builtPct, float px, float pcr, float maxPain, float totCe, float atmShift, float peK, float ceK) =>
    // TWO LINES PER ROW. The first draft ran to 8 and 13 lines and pushed the top of
    // the panel off screen. Say the one thing that changes a decision, then stop.
        // Returned SEPARATELY and with no shouted prefix, because it is appended to the
    // row's first line, which already names the state ("OI Short covering -1.1%").
    // Repeating "SHORT COVERING" there bought a line of height and no information.
    string fRead = na(oiPct) ? "" : pxUp and oiUp ? "   —   new buyers behind the move, so a breakout has fuel." : pxUp and not oiUp ? "   —   shorts buying back, not new demand; it can stall when they finish." : (not pxUp) and oiUp ? "   —   new sellers pressing; treat bounces as suspect." : "   —   longs leaving rather than shorts arriving: exhaustion, not aggression."
    string fBasis = na(basis) ? "" : (px >= basis ? "\nBasis is BELOW price → SUPPORT while it holds (the marginal long is in profit)." : "\nBasis is ABOVE price → RESISTANCE until reclaimed (the marginal long is underwater).") + (nz(builtPct, 100.0) < 40.0 ? " Book mostly unwound — stale." : "")
    bool noOpt = na(pcr) and na(maxPain) and na(totCe)
    string oBias = na(pcr) ? "" : (pcr > 1.3 ? "\nPUT-HEAVY — writers defending the downside; mildly bullish." : pcr < 0.7 ? "\nCALL-HEAVY — writers selling upside, so rallies get capped." : "\nBALANCED — positioning gives no strong bias.")
    string oRange = (na(peK) and na(ceK)) ? "" : " Range " + (na(peK) ? "?" : str.tostring(peK, format.mintick)) + " support → " + (na(ceK) ? "?" : str.tostring(ceK, format.mintick)) + " resistance."
    string oPain = (na(maxPain) or na(px) or px <= 0) ? "" : "\nMax pain " + str.tostring(maxPain, format.mintick) + " pulls " + (maxPain >= px ? "UP" : "DOWN") + " into expiry" + (na(atmShift) ? "." : atmShift > 0 ? "; writers ADDING → slow drift, not a clean breakout." : "; writers PULLING → a sharp move is likelier.")
    // THREE returns now: the caller puts fRead on line 1 and fBasis on its own line.
    [fRead, fBasis, noOpt ? "" : oBias + oRange + oPain]


// ---- rrgSecTxt ---------------------------------------------------------------
// The stock-vs-SECTOR RRG, as one string for the RRG row.
//
// Formats to "vs Pharma: LEADING ^" or "vs Pharma: -" when the pair is not bound. Lives
// here so the S4 call site declares nothing: that file compiles on the ~1,000 main-body
// statement ceiling and this would have cost it two.
//
// THE SHAPE TEST IS THE POINT. An unbound input.source silently returns `close` - never
// na - so a dropped binding cannot be detected with na(). Every input.source in S4 is
// dropped on every recompile, so "unbound" is the normal state after a compile rather
// than an edge case, and the guard has to be a RANGE: an RRG coordinate sits near 100,
// where a share price does not except by coincidence.
//
// No trajectory: the trailing pair would cost two more bindings and two more of v67's 64
// plot outputs, so the current pair is passed as its own trailing value - the same
// fallback the N500 side already uses. A quadrant, honestly, rather than a made-up
// direction.
// TRAILING PAIR BOUND (2 Sep 2026). The note above said a real trajectory "would cost
// two more bindings and two more of v67's 64 plot outputs" and settled for passing the
// current pair as its own trailing value. That made the whole right-hand half degenerate,
// not merely absent: with dv = dm = 0 the arrow is always ➡️, `nxt` always equals `cur`,
// so the gradient was always +2-or-0 and the signal was just "is it LEADING". Jay read the
// row against the N500 half and saw the difference.
// v67 was ALREADY computing both values - _valTrailSec and _momTrailSec fall out of the
// same weekly request.security call as valSec and _rsMomSec - so the true cost was two
// plot slots (41 -> 43 of 64) and no new computation anywhere.
// The trail params are LAST so no existing call-site position shifts, and they carry the
// same range guard as the pair: an unbound input.source returns `close`, never na, so an
// unbound trail must fall back to the old self-referential behaviour and SAY SO rather
// than print a confident zero gradient.
// secName REMOVED from the signature, not just the body (6 Sep): a library must USE
// every argument it takes (CE10237), so keeping it "in case a caller needs it" does
// not compile. The row title already carries the sector name.
export rrgSecTxt(float ratio, float mom, float ratioTr, float momTr) =>
    // 0-CENTERED, not 100-based. S4's own _okRat / _okRatSec both test
    // math.abs(x) <= 60 on these very series, and the panel adds 100 only when it
    // PRINTS the ratio - which is why the row reads "RS-Ratio 123.8" off a stored 23.8.
    // Testing abs(x - 100) rejected every valid value and the row read an em-dash on a
    // correctly bound source. The convention was two lines above where this was written.
    bool ok = math.abs(ratio) <= 60 and math.abs(mom) <= 60
    bool okTr = math.abs(ratioTr) <= 60 and math.abs(momTr) <= 60
    // 6 Sep (Jay): secName DROPPED from the value - the row TITLE already carries it
    // ("RRG (N500 / Capital Goods & Defense)"), and repeating it widened the panel
    // for no information. secName stays in the signature so no call site changes.
    string out = "   │   vs sector: "
    if ok
        [arw, trj, cur, sc, tr] = rrgInfo(ratio, mom, okTr ? ratioTr : ratio, okTr ? momTr : mom)
        // Same fields, same order, same separators as the N500 half - so the eye reads
        // one row twice rather than two different rows. Trajectory and signal print only
        // when the trail is real; without it they would be restating the quadrant.
        // a bare "0" read as noise; it is the RRG score, and 0 means neutral, so it
        // now prints only when it says something.
        out := out + cur + " " + arw + (sc != 0 ? "  " + (sc > 0 ? "+" : "") + str.tostring(sc) : "")
        out := out + (okTr ? "  │  " + trj + "  │  " + (tr ? "🟢 BUY OK" : "🔴 WAIT") : "")
        out := out + "  (RS-Ratio " + str.tostring(ratio + 100, "0.0") + ")"
        out := out + (okTr ? "" : "  │  sector trail unbound")
    else
        out := out + "—"
    out


// ARRIVAL VELOCITY (moved out of S4, 6-Sep-2026). How fast price travelled the last leg
// INTO a zone, in ATR per bar: a sharp approach tends to produce a sharp rejection, a
// grind tends to bleed through. Pure geometry - no request.*, no drawing - which is why
// it was the right block to relocate when S4 went 511 tokens over the ceiling restoring
// request.footprint(). The footprint call itself stays in S4: only ONE is permitted per
// script and it should be visible where the request budget is counted.
// high/low resolve to the CALLER's chart, the same way dailyPA() reads them.
export arrivalStyle(bool inDmd, bool inSup, simple int look, float atr, float fast, float slow) =>
    float  _hi    = ta.highest(high, look)
    float  _lo    = ta.lowest(low,  look)
    int    _hiAgo = math.max(math.abs(ta.highestbars(high, look)), 1)
    int    _loAgo = math.max(math.abs(ta.lowestbars(low,  look)), 1)
    int    _bars  = inSup ? _loAgo : _hiAgo
    float  _dist  = inSup ? (high - _lo) : (_hi - low)
    float  _vel   = (atr > 0 and _bars > 0 and _dist > 0) ? (_dist / atr) / _bars : na
    string _sty   = (not (inDmd or inSup)) ? "—" : na(_vel) ? "—" : _vel >= fast ? "FAST" : _vel <= slow ? "GRIND" : "NORMAL"
    [_vel, _sty]

// SETUP + BAR READS (moved out of S4, 6-Sep-2026). Both are pure: they take numbers
// and booleans and return prose plus a colour, touching no chart state. They came here
// because S4 stayed 332 tokens over the ceiling after arrivalStyle() returned only 179 -
// far less than the line count suggested, because a library saves you the BODY and
// charges you the CALL. These two have the best body-to-interface ratio left in S4.
// Colours and latchBars arrive as parameters, the same way verdictRead() takes them.
// isEtf DROPPED (6-Sep): the ETF carve-out was removed on 3-Sep - ETFs are held to the
// same setup criteria as every stock, resolved from structure - but the parameter
// survived in S4 unused and only surfaced here, where a library must use what it takes.
export setupRead(bool isRec, bool gmPb, bool inDZ, bool anyPa, bool ign, bool rev, bool con,
     bool roleMis, int catCode, int catAge, simple int latchBars, color C_OK, color C_WARN, color C_MUTE, color C_NO) =>
    // STRUCTURE decides for everyone, not just ETFs. Reading the GM pullback LIST
    // alone put APARINDS on a BREAKOUT playbook while the engine's own verdict said
    // PULLBACK TO VALUE - a name can be in a pullback without being on the list.
    bool _pbLike = gmPb or inDZ
    // A CATALYST HAS A SHELF LIFE (6 Sep 2026, Jay). Past half the latch window it is
    // no longer current evidence, and on LAURUSLABS 125m a BREAKOUT catalyst carried
    // 15 of 15 bars outranked a live pullback: the location row said REACTING off DZ,
    // the GM pullback flag was set, and the VERDICT one row below read PULLBACK TO
    // VALUE - while this row judged an NR7 coil against a breakout and failed it. The
    // coil was the RIGHT trigger for what the trade actually was.
    // Only a PULLBACK can supersede, and only when structure asserts one NOW. A stale
    // catalyst with no live pullback context still rules: absence of evidence is not
    // evidence, and falling back to structure there would say less, not more.
    bool _catStale = catAge * 2 > latchBars
    // catCode > 0 MATTERS: catAge keeps counting after the latch expires, so without
    // it a name with NO catalyst but sitting in a zone would be forced to PULLBACK
    // and skip the isRec -> RECOVERY fallback. Only a real catalyst can be overruled.
    bool _catOut   = _catStale and _pbLike and catCode > 0
    // THIRTEEN catalysts, FIVE playbooks. The catalyst names the playbook outright
    // when Unified is bound; structure remains the fallback, unchanged, when it is not.
    // ACCUMULATION is the one that could never be inferred: it is structurally a
    // BREAKOUT (not in a zone) but wants a coil and dry-up, which is a breakout's
    // opposite.
    //
    // 5-Sep-2026 (Jay): the seven RECOVERY catalysts used to collapse into one bucket
    // whose test was "rev or ign" - it accepted either family, so it could only fail on
    // a pure contraction. The loosest gate in the set was carrying the largest group,
    // while the Bull side got four graded standards. They are now split by what each
    // catalyst IS, which is definitional rather than tuned:
    //   REV-CB (7) climax bounce, REV-RS (8) higher-low, WYC-SPRING (13) shakeout
    //     -> REVERSAL. Each is a TURN; an ignition firing here is a chase.
    //   REV-EARLY (9) trendline reclaim, WYC-JAC (11), WYC-SOS (12)
    //     -> BREAKOUT. A Sign of Strength is by definition a demand-led breakout, and
    //        jumping the creek is the same event under another name.
    //   WYC-SPRING+SOS (10) -> RECOVERY, which keeps "rev or ign" because it genuinely
    //     is both legs. The isRec structural fallback lands here too.
    string _play = _catOut ? "PULLBACK" : catCode == 2 ? "ACCUMULATION" : (catCode == 5 or catCode == 7 or catCode == 8 or catCode == 13) ? "REVERSAL" : catCode == 3 ? "PULLBACK" : (catCode == 1 or catCode == 4 or catCode == 6 or catCode == 9 or catCode == 11 or catCode == 12) ? "BREAKOUT" : catCode == 10 ? "RECOVERY" : isRec ? "RECOVERY" : _pbLike ? "PULLBACK" : "BREAKOUT"
    // A pullback accepts ANY of the three: the dip stopping (contraction), the turn
    // (reversal), or the resumption off the low (ignition - a Pocket Pivot at demand
    // is a textbook pullback entry). What stays incoherent is a coil on a BREAKOUT
    // thesis and a coil on a RECOVERY thesis, and those are what this still flags.
    // ONE RULE (4 Sep 2026). Setup said "PULLBACK ✓ the pattern that fired is this
    // playbook's trigger" on BAJFINANCE while the TRIGGER row flagged ⚠role on the
    // same bar - two overlapping checks answering differently. A pullback now fails
    // exactly when roleMismatch fails it: an IGNITION pattern inside a demand zone,
    // which is a breakout's trigger in a pullback's location.
    // Each playbook's own trigger. ACCUMULATION explicitly REFUSES an ignition: a base
    // that is already breaking is POS-BO, and calling it accumulation would hold it to
    // the wrong standard in both directions — volume and bar.
    bool _ok = _play == "ACCUMULATION" ? (con or rev) and not ign : _play == "REVERSAL" ? rev : _play == "RECOVERY" ? (rev or ign) : _play == "PULLBACK" ? (not roleMis) : ign
    string _want = _play == "ACCUMULATION" ? "a coil and dry-up — an ignition here is a breakout, not accumulation" : _play == "REVERSAL" ? "a turn — spring, engulf, 3-bar, climax, higher-low or a 30-WMA reclaim" : _play == "RECOVERY" ? "a turn, or a Sign of Strength breaking the base" : _play == "PULLBACK" ? "compression or a turn, not an ignition fired inside the zone" : "an ignition — breakout, VCP, pocket pivot or a Sign of Strength"
    // PROVENANCE. The defect that started this was a row reading "PULLBACK ✓" that had
    // come from the demand zone, not from the catalyst, with nothing on the panel saying
    // so. A carried catalyst is weaker evidence than a live one and structure is weaker
    // than both, so the row now names which it used.
    string _src = catCode < 0 ? "   │   bridge not bound — playbook from structure" : catCode == 0 ? "   │   no catalyst live or carried — playbook from structure" : _catOut ? "   │   catalyst carried " + str.tostring(catAge) + "b — superseded by live pullback context" : catAge <= 0 ? "   │   catalyst live this bar" : "   │   catalyst carried " + str.tostring(catAge) + "b"
    // Jay, 5-Sep: a dot, not a tick. Every other row in the panel states pass/fail with
    // 🟢 / 🔴 / ⚪ and this row was the only one using ✓, so it did not scan with them.
    // ⚪ (not 🔴) when no pattern has fired: nothing has failed yet, there is simply
    // nothing to pair - the same distinction the rest of the panel draws.
    string _out = (not anyPa ? "⚪ —   no pattern yet, so nothing to pair" : _ok ? "🟢 " + _play + "   —   the pattern that fired is this playbook's trigger" : (_catStale ? "🟡 " : "🔴 ") + "MISMATCH · " + _play + " wants " + _want) + _src
    // 6 Sep: a MISMATCH resting on a catalyst past half its latch window recedes -
    // marker red -> yellow, row C_WARN (amber) -> C_MUTE (grey). LAURUSLABS 125m read a hard red BREAKOUT mismatch off a catalyst
    // carried 15 of 15 bars while the location, the GM pullback flag and the VERDICT
    // directly above all said PULLBACK - under which the row would have been green.
    // The age was already printed; now the ruling's confidence reflects it.
    // 6 Sep (Jay): the marker and the row colour disagreed - a RED dot sat on an
    // AMBER row, because C_WARN is #ff9800. They now move together: a fresh mismatch
    // is red in both, a stale-catalyst mismatch is amber in both.
    [_out, not anyPa ? C_MUTE : _ok ? C_OK : _catStale ? C_WARN : C_NO]

export barRead(int so, float soClose, float soHigh, bool barOkV, color C_OK, color C_NO) =>
    float _bO     = open[so]
    float _bC     = soClose
    float _bRng2  = soHigh - low[so]
    float _bClPos = _bRng2 > 0 ? (_bC - low[so]) / _bRng2 * 100.0 : 50.0
    bool  _bGreen = _bC >= _bO
    // The description must explain the VERDICT, not just the colour (18-Aug, Jay
    // on IPCALAB 125m). Since v9.17 bar_ok needs `close >= open` AND the close in
    // the upper half of the RANGE, so a green body can be vetoed — but this line
    // still branched on colour alone and printed "green candle (bullish close)"
    // next to WEAK/VETOED, i.e. a reason that contradicted the ruling. IPCALAB
    // was O 1866.2 / H 1898.0 / L 1865.2 / C 1875.2: green body, closed 30% up
    // its range, sold into the close — vetoed correctly, explained wrongly.
    // Now the close POSITION is always stated, for both colours.
    // Name the FAILING test, not just the outcome. B now has three; a description
    // that only ever mentions close position sends you looking at the wrong thing —
    // which is exactly what "green candle (bullish close)" did on IPCALAB.
    // The SAME 20% cap reads the other way for a red bar: a long LOWER wick means
    // the lows were rejected, so the bar is not bearish either — it is a shakeout.
    // Calling that "bearish" would be the mirror of the mistake this row already
    // made in the other direction (Jay, 18-Aug).
    float _bUpW = soHigh - math.max(_bC, _bO)
    float _bLoW = math.min(_bC, _bO) - low[so]
    // _bUwP / _bLwP REMOVED (23-Aug-2026): upper and lower wick percentages,
    // computed every bar and never read. Bar quality is judged by _bqClpos.
    // Colour is now CONTEXT, not the verdict — so the reason must lead with close
    // position and the wick, and call a strong red bar what it is: a shakeout.
    // Reason matches the 11-Aug gate (green OR upper-half). The close position and
    // upper wick are still PRINTED — they are what let Jay catch IGIL and IPCALAB
    // by eye — but they are context now, not the verdict. A bar can read
    // "OK ... 36% upper wick" and that is honest: B passed it, the shape is poor,
    // and the chart read decides.
    // A12: TITAN printed "🟢OK — red candle, closed 40% up its range — red and closed
    // in the lower half" - the verdict passing while the words described a failure.
    // The gate is deliberately lenient (a false negative costs the trade, a false
    // positive costs a glance), so when it passes below the 50% line, say that.
    string _barWhy = _bGreen ? " — green close" : _bClPos >= 50 ? " — shakeout: red body but closed strong, fine for a long" : barOkV ? " — red body closed under mid-range; the bar gate is deliberately lenient and let it through" : " — red and closed in the lower half"
    string _barDesc = (_bGreen ? "green" : "red") + " candle, closed " + str.tostring(_bClPos, "0") + "% up its range" + _barWhy
    string _barTxt  = (barOkV ? "OK" : "WEAK/VETOED") + "   —   " + _barDesc
    color  _barCol  = barOkV ? C_OK : C_NO
    [_barTxt, _barCol]
