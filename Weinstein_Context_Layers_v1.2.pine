alertcondition(wyk_sos_c,        title="Wyckoff SOS",         message="WCL: Sign of Strength detected — bullish breakout")
alertcondition(wyk_spr_c,        title="Wyckoff Spring",      message="WCL: Spring detected — accumulation reversal")
alertcondition(wyk_sow_c,        title="Wyckoff SOW",         message="WCL: Sign of Weakness — distribution confirmed")
alertcondition(smc_choch_up,     title="SMC CHoCH ▲",         message="WCL: Bullish change of character — reversal up")
alertcondition(smc_choch_dn,     title="SMC CHoCH ▼",         message="WCL: Bearish change of character — reversal down")
alertcondition(smc_bull_sweep,   title="Liq Sweep ▲",         message="WCL: Bullish liquidity sweep — stop hunt below recovered")
alertcondition(smc_bear_sweep,   title="Liq Sweep ▼",         message="WCL: Bearish liquidity sweep — stop hunt above rejected")

