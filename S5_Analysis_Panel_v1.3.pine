// ============================================================================
// S5 ANALYSIS PANEL  v1.0  (8 Sep 2026)
//
// v1.7 (22 Oct 2026) - S/R AND TRENDLINES REBUILT ON THE REFERENCE METHODS.
//   Jay: "you have been drawing them incorrectly". The old S/R engine kept the two
//   NEAREST pivot clusters per side and deleted any level closed through twice, so the
//   shelves price actually trades against (BAJFINANCE 125m 975-985) were never drawn
//   while lone pivots were. The old auto trendline was an envelope under EVERY pivot in
//   its pool, which drew falling "support" lines through a decline's lows.
//   S/R  = LonesomeTheBlue "Support Resistance Channels" (MPL-2.0): pivot highs + lows
//          banded within 5% of the 300-bar range, ranked by 20/pivot + 1/bar touch, the
//          strongest non-overlapping bands, then the strongest N EACH SIDE of price.
//          Line on the band edge facing price; tests counted since the last flip (MTTWR
//          kept). Now also on the CHART timeframe when intraday.
//   TL   = pivot pairs (LonesomeTheBlue "Trend Lines" / Adam Moradi tutorial): a higher
//          low to an earlier low, a lower high to an earlier high; no close through it
//          since the first anchor; most touches, then longest span. Auto is ON.
//   Removed inputs: the cluster tolerance / cap, wick-fit, wick-pierce, graze, span cap,
//   max closes beyond, test spacing, levels tracked, max pivot age.
//
// S4 DECIDES. S5 EXPLAINS.
//
// S4 is the execution surface - gates, plan, verdict - and it sits permanently against
// the 100,256-token ceiling, so every diagnostic it ever carried was eventually cut to
// buy room for a decision field. Those cuts are the contents of this file. Nothing here
// gates anything and S5 publishes NO plots, so nothing can bind TO it and it cannot
// drift from S4. It does inherit TWO optional input.source inputs from the Lab -
// the S4 Trendline Tool bridge (tl_ext1/tl_ext2) - which are OFF unless you point
// them at that companion. Left in because they are the only way a hand-drawn
// trendline reaches an engine, but note they unbind on every recompile like any
// other source, so if the trendline row goes quiet after a compile, that is why.
//
// BUILT FROM THE LAB, not from scratch. SR_Trendline_Lab_v1.0 already carried the
// canonical pivots, the S/R clustering engine, the trendline fitters and the drawing
// block - all tested. S5 is that file plus the two things it lacked: the GEOMETRY
// classifier (recovered from Section4_Entry_Trigger_v5.9.pine, which is the only copy
// still holding it - current S4 has comment remnants only, and the file has no git
// history to recover from) and a PANEL.
//
// WHAT IS AND IS NOT HERE
//   IN : geometry / shape read, S/R levels with touch grades, trendlines, structural
//        zones, pivot-pool diagnostics.
//   IN : the FOOTPRINT delta, buy/sell split, auction levels and per-row imbalances.
//   IN : Wyckoff DISTRIBUTION events - PSY / BC / AR / ST / UT / UTAD / LPSY - which S4
//        collapsed into one "DIST" tag to save tokens.
//   OUT: setups S3/S6 - no live code survives on disk AND no spec survives either. S3
//        was the SMC liquidity-sweep block's only reader and nothing records what it
//        fired on, so rebuilding it would be inventing a setup, not restoring one.
//
// *** WHERE THIS RUNS - NOT NEGOTIABLE ***
// S5 now carries request.footprint(), which retains per-bar volume-row objects, and Pine
// meters runtime memory PER CHART (measured 6-8 Sep 2026: a 55-line feeder ran clean
// while S4, holding two floats from it, threw "Memory limits exceeded" on the same
// chart; removing the feeder cleared it with no recompile). So:
//
//     S4  -> primary chart.      S5 -> a SECOND, symbol-synced chart.
//
// Loading S5 beside S4 will kill S4's panel. That is measured behaviour, not caution.
//   OUT: the CONTEXT row - four of its six fields are already on S4's panel, and
//        duplicating them would repeat the restatement problem the v6.1 verdict fixed.
//
// MEMORY NOTE: this shares S4's chart budget. It is pure computation on pivots - no
// request.footprint, no per-bar object retention - so it is cheap, but if the chart
// ever throws "Memory limits exceeded" again, this is a thing to remove and test.
// ============================================================================
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// (c) Jayram G
//
// ############################################################################
// S/R + TRENDLINE LAB  v1.0   --  TEMPORARY TESTBED
// ############################################################################
//
// A standalone copy of the horizontal-S/R and trendline engines, lifted VERBATIM
// out of "Section 4 Entry Trigger" (v7.2 working copy) so both can be tuned in
// isolation -- on their own chart, without recompiling S4 and without competing
// for its token budget (S4 currently sits ON the 100,256 compiled-token limit).
//
// NOTHING WAS REMOVED FROM S4. This is a COPY. The engine code here is
// character-identical to S4's, so when a setting proves out, only the changed
// INPUT DEFAULT needs to travel back -- never the logic.
//
// WHAT IS HERE (each independently switchable at the top of the settings):
//   * S/R LEVELS -- per-TF pivot clustering (M/W/D each cluster their OWN pivots
//     at their OWN ATR scale), wick-fit line placement (#8), wick-pierce touch
//     counting (#30), MTTWR grading (tests WEAKEN a level -- the house rule that
//     inverts the usual convention), and R<->S flip with reset-on-flip.
//   * TRENDLINES -- manual numeric anchors (the live path), the parked auto
//     envelope fit (f_bestLine / f_autoTL), and the external-tool source bridge.
//
// WHAT IS DELIBERATELY ABSENT: zones, the PA battery, the GO gate, the verdict
// panel, alerts. This is a DRAWING/BEHAVIOUR lab, not a decision surface -- so
// nothing on it can be mistaken for a trade signal while you are tuning.
//
// THE DIALS THAT MATTER MOST -- start here:
//   S/R : sr_w_pct       max level width, % of the 300-bar range -- the #1 dial
//         sr_min_touch   pivots a band needs to be a level at all
//         sr_keep_*      levels drawn per side, per timeframe
//         sr_mttwr_n     how many tests before a level is spent
//   TL  : tl_auto        ON: pivot-pair lines (higher lows / lower highs, no close through)
//         tl_thread      touch tolerance (x ATR) that ranks candidate lines
//         tl_pool        how far back a line may anchor
//         tls_/tlr_anch_off   re-anchor by skipping N recent pivots
//         tls_/tlr_nudge      shift the line without changing its slope
//         pv_chart         pivot half-width feeding the pools
//
// ############################################################################
//@version=6
// calc_bars_count BOUNDS THE FOOTPRINT. It retains per-bar volume-row objects, and
// bar count is the one lever never tested against the memory ceiling - fpTicks was
// tried twice (20 and 200) and changed nothing, because the cost is retention, not
// row size. 1500 keeps ample history for the pivot pools and the S/R clustering
// while capping what footprint can hoard. IF THE CHART EVER REPORTS "Memory limits
// exceeded": drop this first (800, then 400), and turn show_fp off second.
// The D/W/M security calls have their own contexts and are unaffected by it.
indicator("S5 Analysis Panel v1.7", shorttitle="S5", overlay=true, max_lines_count=250, max_labels_count=500, max_boxes_count=100, max_bars_back=300, calc_bars_count=1500)

grpLab = "LAB -- which engine to test"
d_sr = input.bool(true, "S/R levels engine", group=grpLab, tooltip="Master switch for the horizontal-level engine (auto clustering + your manual levels). Turn OFF to study trendlines alone on a clean chart.")
d_geo = input.bool(true, "Geometry / shape read", group=grpLab, tooltip="Master switch for the triangle / wedge / channel / range classifier. It reads the SAME 6-pivot pool the trendline fitter uses, so it costs no extra pivot work.")
d_tl = input.bool(true, "Trendline engine", group=grpLab, tooltip="Master switch for trendlines (manual anchors, the auto envelope fit, and the external-tool bridge). Turn OFF to study S/R alone.")

// Zone-display flags the shared timeframe guardrails reference. There are no
// zones in this lab, so they are plain constants rather than inputs -- kept only
// so the guardrail block below stays character-identical to S4's.
bool showMonthly = true
bool showWeekly  = true
bool showDaily   = true

// ── CANONICAL PIVOT LENGTHS — ONE definition, used by BOTH engines ───────────
// Mirrors the Swing Zigzag [Strict v6.3] (piv_m/piv_w/piv_d/piv_intra), which is the
// canonical structure layer: it is on every template and it is the HH/HL reference at
// gate 1, the break-of-structure confirm at gate 3 and the trail reference at gate 5.
// If S/R lines and trendlines detect different pivots from the swings on screen, the
// count you make by eye can never match the count the engine reports.
//
// One set feeds both: the S/R engine takes the per-TF value for each of its Monthly /
// Weekly / Daily security calls, while the trendline pools take the CHART's value
// (they run natively, on whatever timeframe you are looking at).
//
// NOT part of this canon, deliberately: the Institutional Zone Engine runs 5 left / 3
// right, fixed and ASYMMETRIC — a zone needs less right-confirmation than a swing pivot
// so it arms sooner. That is a different job, and forcing it onto these values would
// change zone detection to solve a problem it does not have.
grpPV = "Pivots — canonical (mirrors the Swing Zigzag)"
piv_m      = input.int(1, "Pivot length — Monthly",  group=grpPV, minval=1, maxval=20, tooltip="Zigzag piv_m. Monthly bars are scarce and each is significant, so a long lookback finds almost no pivots at all.")
piv_w      = input.int(5, "Pivot length — Weekly",   group=grpPV, minval=1, maxval=20, tooltip="Zigzag piv_w.")
piv_d      = input.int(2, "Pivot length — Daily",    group=grpPV, minval=1, maxval=20, tooltip="Zigzag piv_d. NOTE this is far looser than the 5 the S/R engine used before — expect many more daily levels. If that is too noisy, do NOT raise it (that breaks alignment with the Zigzag); filter instead, with min-touches or the swing-magnitude gate.")
piv_i      = input.int(2, "Pivot length — Intraday", group=grpPV, minval=1, maxval=20, tooltip="Zigzag piv_intra.")
// The chart's own pivot length — what the trendline pools use, since they run natively.
int pv_chart = timeframe.ismonthly ? piv_m : timeframe.isweekly ? piv_w : timeframe.isdaily ? piv_d : piv_i

// ============================================================================
// COLOUR CONSTANTS (verbatim from S4)
// ============================================================================
color C_OK = color.new(#26a69a, 0)
color C_NO = color.new(#ef5350, 0)
color C_WARN = color.new(#ff9800, 0)
color C_REC = color.new(#00838f, 0)
color C_GO = color.new(#00e676, 0)
color C_INFO = color.new(#42a5f5, 0)
color C_MUTE = color.new(#787b86, 0)
color C_MAROON = color.new(color.maroon, 0)
color C_WHITE = color.new(color.white, 0)
color C_BLUE = color.new(color.blue, 0)
color C_RED45 = color.new(color.red, 45)
color C_GOLD = color.new(#FFB300, 0)
color C_SKY = color.new(#4FC3F7, 0)
color C_GREY20 = color.new(#9598a1, 20)
color C_PURPLE = color.new(#7e57c2, 0)
color C_OK82 = color.new(#26a69a, 82)
color C_NO82 = color.new(#ef5350, 82)
color C_GRID = color.new(#2a2e39, 0)

// ==========================================================================
// DISPLAY — CATEGORY MASTER SWITCHES  (triage / declutter)
// --------------------------------------------------------------------------

// ============================================================================
// S/R INPUTS -- auto + manual M/W/D
// ============================================================================
grpSR = "S/R Levels — Auto (strength-ranked)"
show_sr_lv   = input.bool(true, "Draw auto S/R levels", group=grpSR)
// 22-Oct-2026: the engine below REPLACED the nearest-pivot clusterer (Jay: "you have been
// drawing them incorrectly"). Method = LonesomeTheBlue's "Support Resistance Channels" -
// the most-used open-source S/R script on TradingView - adapted to the house rules. The
// old engine picked the two NEAREST levels per side and deleted any level price had closed
// through twice, so congestion shelves (BAJFINANCE 125m 975-985, closed through and
// retested for weeks) were never drawn while lone pivots were.
sr_w_pct     = input.float(5.0, "Max level width (% of the 300-bar range)", group=grpSR, minval=1.0, maxval=10.0, step=0.5, tooltip="How wide one level may be. Pivots (highs AND lows) within this distance of each other form one level, so a level that flipped from resistance to support keeps its whole history.\n\nMeasured against the timeframe's own 300-bar high-low range, so it scales with the stock and the timeframe without any ATR arithmetic. 5% is LonesomeTheBlue's default. Lower = tighter, more literal levels; higher = broader shelves.")
sr_loop      = input.int(290, "Lookback (bars)", group=grpSR, minval=100, maxval=290, tooltip="Pivots older than this are dropped, and bar touches are counted over the same window. 290 is the ceiling: the script keeps a 300-bar history buffer.")
sr_min_touch = input.int(2, "Min pivots in a level", group=grpSR, minval=1, maxval=6, tooltip="A single pivot is a swing point, not a level - it takes a second pivot in the band to prove price respects it. 1 = LonesomeTheBlue's default (any pivot can be a level).")
sr_mttwr_n   = input.int(6, "MTTWR: tests before a level is 'primed to break'", group=grpSR, minval=2, maxval=12, tooltip="HOUSE RULE: tests WEAKEN a level. A test is a pivot on the level's CURRENT side (pivot lows for a support, highs for a resistance) since price last closed through it - a flipped level starts fresh in its new role. At this many tests the label reads MTTWR: spent as a floor, now a breakout candidate. Strength (which ranks the levels) is a different number: it measures how much the market has traded there.")
// Clamp: with sr_min_touch >= sr_mttwr_n (both individually legal), every level
// that EXISTS would already read MTTWR. The effective MTTWR count is forced above it.
int mttwrEff = math.max(sr_mttwr_n, sr_min_touch + 1)
sr_keep_c    = input.int(2, "Levels per side — chart timeframe (intraday charts)", group=grpSR, minval=0, maxval=3, tooltip="The strongest levels above and below price on the chart's own timeframe. Drawn only on intraday charts - on a Daily chart the Daily levels ARE the chart's. 0 = none.")
sr_keep_d    = input.int(2, "Levels per side — Daily",   group=grpSR, minval=0, maxval=3)
sr_keep_w    = input.int(2, "Levels per side — Weekly",  group=grpSR, minval=0, maxval=3)
sr_keep_m    = input.int(1, "Levels per side — Monthly", group=grpSR, minval=0, maxval=3)
sr_band      = input.bool(true, "Shade each level's band", group=grpSR, tooltip="The band is the price range the level's pivots span. The LINE sits on the edge facing price - the top of a support, the bottom of a resistance - which is the first price the market meets. Where two timeframes' bands overlap only the higher timeframe is drawn.")
sr_show_M    = input.bool(true, "Show Monthly levels", group=grpSR, inline="tf")
sr_show_W    = input.bool(true, "Weekly",              group=grpSR, inline="tf")
sr_show_D    = input.bool(true, "Daily",               group=grpSR, inline="tf")

grpSRM = "S/R Levels — MANUAL · MONTHLY  (0 = off; shows on ALL timeframes)"
sr_on = input.bool(true, "Enable manual levels (override auto)", group=grpSRM, tooltip="Manual levels OUTRANK auto ones on a side you have marked: your hand-drawn levels ARE the location layer (Gate 2), the auto ones are the fallback for a side you have not marked yet. A side you leave blank still falls back to auto.\n\nType the price once (from the panel), then drag the handle on the chart.")
mv1 = input.price(0.0, "Monthly level 1", group=grpSRM)
mv2 = input.price(0.0, "Monthly level 2", group=grpSRM)
mv3 = input.price(0.0, "Monthly level 3", group=grpSRM)
mv4 = input.price(0.0, "Monthly level 4", group=grpSRM)

grpSRW = "S/R Levels — MANUAL · WEEKLY  (shows on Weekly and below)"
wv1 = input.price(0.0, "Weekly level 1", group=grpSRW)
wv2 = input.price(0.0, "Weekly level 2", group=grpSRW)
wv3 = input.price(0.0, "Weekly level 3", group=grpSRW)
wv4 = input.price(0.0, "Weekly level 4", group=grpSRW)

grpSRD = "S/R Levels — MANUAL · DAILY  (shows on Daily and below; hidden on W/M)"
dv1 = input.price(0.0, "Daily level 1", group=grpSRD)
dv2 = input.price(0.0, "Daily level 2", group=grpSRD)
dv3 = input.price(0.0, "Daily level 3", group=grpSRD)
dv4 = input.price(0.0, "Daily level 4", group=grpSRD)

// ==========================================================================
// TRENDLINES — MANUAL ONLY, by deliberate decision.

// ============================================================================
// TRENDLINE INPUTS -- auto + manual + external bridge
// ============================================================================
grpTL = "Trendlines — AUTO + manual"
tl_on  = input.bool(true, "Enable manual trendlines", group=grpTL, tooltip="Master enable for the MANUAL numeric anchors below. Auto-detect (next input) does not need these — it draws from pivots. Manual anchors are the exact-placement fallback: turn Auto OFF to use them.\n\nAnchors are numeric (0 = off) — enter time/price in this dialog. confirm/click-to-place was removed because it forced a draw on every add and closed the indicator on Esc.")
// ── AUTO trendlines (Path A, 24-Jul): fit + adjust WITHOUT typing coordinates. Reuses
// the geometry engine's f_bestLine (no 10th from-scratch fitter — the 9 failed rewrites
// were all attempts at a GLOBAL auto-fit; this fits a sensible line and lets you nudge it).
tl_auto      = input.bool(true, "Auto-detect trendlines (pivot pairs)", group=grpTL, tooltip="ON (22-Oct-2026): support = a HIGHER LOW joined to an earlier pivot low, resistance = a LOWER HIGH joined to an earlier pivot high - the way a trader draws one and the method the open-source references use. A line is drawn only while no CLOSE has crossed it since its first anchor (wicks may pierce). Among valid lines the one through the MOST pivots wins, then the longest. OFF = your manual anchors below.")
tl_thread    = input.float(0.25, "Auto: touch tolerance (× ATR)", group=grpTL, minval=0.05, maxval=2.0, step=0.05, tooltip="How close a pivot must sit to the line to count as a TOUCH, which ranks the candidate lines. It does not loosen the validity rule: a close beyond the line always disqualifies it.")
tl_pool      = input.int(40, "Auto: pivots pool (how far back a line can anchor)", group=grpTL, minval=4, maxval=60, tooltip="How many recent pivots of each side the fitter searches.")
tl_look      = input.int(290, "Auto: lookback (bars)", group=grpTL, minval=50, maxval=290, tooltip="The FIRST anchor must be within this many bars. 290 is the ceiling - the script keeps a 300-bar history buffer and every close back to the anchor is checked.")
tls_anch_off = input.int(0, "Auto Support: re-anchor (skip N recent lows)", group=grpTL, minval=0, maxval=5, tooltip="Adjust WITHOUT coordinates: drop the N most-recent pivot LOWS before fitting, so the line re-anchors on older structure. 0 = use all recent lows (the default auto pick). Bump to 1-2 if the freshest low skews the line you actually want.")
tlr_anch_off = input.int(0, "Auto Resistance: re-anchor (skip N recent highs)", group=grpTL, minval=0, maxval=5, tooltip="Same as the support re-anchor, for the resistance line (pivot HIGHS).")
tls_nudge    = input.float(0.0, "Auto Support: nudge (× ATR, + up / − down)", group=grpTL, minval=-5.0, maxval=5.0, step=0.1, tooltip="Shift the whole support line up (+) or down (−) by this many ATR WITHOUT changing its slope — the numeric stand-in for dragging it a touch. 0 = sit on the fit.")
tlr_nudge    = input.float(0.0, "Auto Resistance: nudge (× ATR, + up / − down)", group=grpTL, minval=-5.0, maxval=5.0, step=0.1, tooltip="Shift the whole resistance line up/down by this many ATR without changing its slope.")
tls_tf = input.string("Daily", "Support TL — timeframe", options=["Monthly", "Weekly", "Daily"], group=grpTL, tooltip="The TF a line is drawn on IS its weight. Shows on this timeframe and every LOWER one, never upward — a Daily trendline never renders on a Weekly chart.")
tls_t1 = input.time(0,    "Support TL — anchor 1 (swing low) time",   group=grpTL)
tls_p1 = input.price(0.0, "Support TL — anchor 1 price",              group=grpTL)
tls_t2 = input.time(0,    "Support TL — anchor 2 (higher low) time",  group=grpTL)
tls_p2 = input.price(0.0, "Support TL — anchor 2 price",              group=grpTL)
tlr_tf = input.string("Daily", "Resistance TL — timeframe", options=["Monthly", "Weekly", "Daily"], group=grpTL)
tlr_t1 = input.time(0,    "Resistance TL — anchor 1 (swing high) time", group=grpTL)
tlr_p1 = input.price(0.0, "Resistance TL — anchor 1 price",             group=grpTL)
tlr_t2 = input.time(0,    "Resistance TL — anchor 2 (lower high) time", group=grpTL)
tlr_p2 = input.price(0.0, "Resistance TL — anchor 2 price",             group=grpTL)
// ── Hand-drawn trendlines SENSED from the "S4 Trendline Tool" companion (Option 2, 24-Jul).
// S4 never prompts: the companion carries the click-to-place, S4 just reads its value. Each
// sensed line feeds the picker/plan/confluence and self-sorts to support/resistance by the
// side of price it sits on. Turn ON only AFTER adding the companion and wiring the source(s).
tl_ext_on   = input.bool(false, "Sense hand-drawn trendlines (from 'S4 Trendline Tool')", group=grpTL, tooltip="Add the 'S4 Trendline Tool' companion to the chart, place a line on it, then point 'External trendline 1' below at its 'Trendline Value' plot and turn this ON. Add a second companion instance for a second line. S4 shows no placement prompt of its own.")
tl_ext1_src = input.source(close, "  · External trendline 1", group=grpTL, tooltip="Select the 'S4 Trendline Tool' → 'Trendline Value' plot. Left on 'close' = treated as unused (ignored).")
tl_ext2_src = input.source(close, "  · External trendline 2", group=grpTL, tooltip="A second companion instance (e.g. the other side). Left on 'close' = unused.")

grpZP = "Zones — Structural (Pivot-Based)"
useStructural   = input.bool(true,  "Draw Pivot (Structural) zones",  group=grpZP, tooltip="Master on/off for ALL pivot (PvH/PvL) zones — the weaker, dashed shelves that come from a bare swing high/low with no leg-base-leg. Uncheck to hide EVERY pivot zone on all timeframes (it stops their creation, so a recompile leaves none on the chart).\n\nUSE THIS TO ISOLATE: turn pivot zones OFF to see ONLY the pattern demand/supply zones (RBR/DBR/RBD/DBD). If a pattern DZ/SZ still doesn't mark with pivots off, the issue is in pattern detection (leg/base/width gates), not a pivot zone hiding or overriding it. Turn the diagnostics row on and read natC d/f/m/L + struct D/C/L alongside.")


// ============================================================================
// GEOMETRY INPUTS  (recovered from S4 v5.9, which is the last copy holding them)
// ============================================================================
grpGEO = "Geometry — shape classifier"
show_geom     = input.bool(true,  "Classify the shape (triangle / wedge / channel / range)", group=grpGEO)
drawGeomLines = input.bool(true,  "Draw the connectors, not just the name", group=grpGEO, tooltip="A named shape with nothing drawn is unfalsifiable - you cannot see whether the classifier used the pivots you would have used. A range draws as a BOX, every other shape as its two connectors.")
geo_flat      = input.float(0.5,  "Flat tolerance (x ATR)", group=grpGEO, minval=0.05, step=0.05, tooltip="Two pivots within this distance count as a FLAT edge. RAISED from S4's 0.3 for v1: at 0.3 an obvious rectangle was being classified 'Symmetrical triangle' on APOLLOHOSP and GLAXO, because ordinary noise between two highs exceeded the tolerance and read as a downslope. This is the item Jay parked as #11.")
geo_maxfit    = input.bool(true,  "TradingView-style validated boundary", group=grpGEO, tooltip="ON (default): search pivot PAIRS newest-first and take the first whose segment no intermediate close breaches - this is how TV builds a boundary, and the line that survives is an envelope. OFF: the LAST TWO pivots, unvalidated - the pre-8-Sep behaviour, kept only so the two can be compared on a live chart. Note the old max-threading fit (f_bestLine) is no longer used by the classifier at all: it puts pivots on BOTH sides of the line, so it can never satisfy an interior test.")
geo_thread    = input.float(0.5,  "Fit tolerance (x ATR)", group=grpGEO, minval=0.1, step=0.05, tooltip="How close a pivot must sit to the fitted line to count as ON it.")
// --- TradingView-documented criteria (8 Sep 2026) -------------------------
// From TradingView's own Help Centre pages for the built-in pattern indicators,
// NOT from its source, which is closed and compiled into the charting engine. The
// four values below are the ones TV publishes; everything else about their engine
// is undocumented and is NOT guessed at here.
geo_piv       = input.int(5,      "Pivot strength (bars each side)", group=grpGEO, minval=1, maxval=20, tooltip="TradingView anchors every pattern line to 5/5 pivots - a high with no higher high five bars either side. S5 previously used the CHART pivot length, which is 2 on intraday, so it was reading swings four times smaller than TV and classifying noise.")
geo_look      = input.int(600,    "Pattern lookback (bars)", group=grpGEO, minval=50, maxval=1200, tooltip="TradingView scans the last 600 bars for patterns. Kept separate from geo_maxage, which ages out a FORMED shape.")
geo_dev       = input.float(15.0, "Permissible deviation (% of channel width)", group=grpGEO, minval=0.0, maxval=100.0, step=1.0, tooltip="TV's own term. An intermediate bar may deviate from a boundary line by this much, measured as a percentage of the vertical distance BETWEEN the two lines. Beyond it, the line is not a boundary and the pattern is rejected.")
geo_strict    = input.bool(false, "Validate on wicks instead of closes", group=grpGEO, tooltip="TV validates on CLOSE. Wicks are stricter and will reject more.")
flag_pole     = input.float(2.0,  "Flagpole: minimum size (x ATR)", group=grpGEO, minval=0.5, step=0.5, tooltip="The move INTO the pattern. TV calls it the flagpole and describes it as the main trend, the channel being the correction. Without a pole a parallel channel is just a channel.")
flag_look     = input.int(30,     "Flagpole: bars to measure it over", group=grpGEO, minval=5, maxval=200)
flag_roll     = input.float(50.0, "Max Rollback (% of flagpole)", group=grpGEO, minval=10.0, maxval=100.0, step=5.0, tooltip="TradingView's own term and definition: the maximum price rollback in the flag channel as a percentage of the height of the flagpole. A correction that retraces most of the pole is not a flag, it is a reversal.")
geo_ovlp      = input.float(60.0, "Boundaries must share this much of their span (%)", group=grpGEO, minval=0.0, maxval=100.0, step=5.0, tooltip="The upper and lower boundaries are found independently, so nothing forces them to describe the SAME stretch of chart. If they overlap by less than this, they are two unrelated segments rather than one pattern, and every width-based test between them - wedge vs channel above all - is meaningless. TV builds one pattern from points 1-5 over one span.")
geo_edge      = input.float(20.0, "Flag a call as marginal within (% of the flat threshold)", group=grpGEO, minval=0.0, maxval=50.0, step=5.0, tooltip="A slope sitting just inside geo_flat is classified FLAT with full confidence, and one tick the other way gives a different shape with the opposite reading. ANANDRATHI 75m read a base slope of 0.47x against a 0.50x threshold - flat by six percent - and the panel said Broadening (ascending) as though it were settled. Same idea as S4's knife-edge counter.")
geo_conv      = input.float(20.0, "Channel Width Ratio Start/End (%)", group=grpGEO, minval=1.0, maxval=90.0, step=1.0, tooltip="TradingView's own name and definition: the minimum required channel height difference between the START and the END of the pattern. It is what separates a WEDGE from a CHANNEL - both lines slope the same way in each, but a wedge CONVERGES. S5 used to lump them into one label while its own READ line told you to go and check which it was. Per TV, a rising wedge is expected to break DOWN through the lower line and a falling wedge UP.")

// ============================================================================
// TIMEFRAME GUARDRAILS + ATR (verbatim: HTF shows on LTF, never upward)
// ============================================================================
int chartSec   = timeframe.in_seconds(timeframe.period)
int dailySec   = 86400
// CALENDAR seconds, to match timeframe.in_seconds(). The old 432000/1900800 were
// TRADING-day approximations (5x/22x 86400); compared against the calendar chartSec
// they hid Weekly levels on the Weekly chart and blanked the Monthly chart entirely.
// (Zone guardrail behaviour is unchanged by this on every standard TF - verified.)
int weeklySec  = 604800
int monthlySec = 2592000
bool useDailyZ   = showDaily   and dailySec   > chartSec
bool useWeeklyZ  = showWeekly  and weeklySec  > chartSec
bool useMonthlyZ = showMonthly and monthlySec > chartSec
// S/R LEVELS use the SAME guardrail — HTF propagates DOWN, LTF never renders UP —
// reusing the constants above rather than declaring a second set that could drift.
// `>=` not `>`: unlike a zone, a hand-typed Daily level has no separate "native"
// path, so it MUST still render on a Daily chart.
// TF VISIBILITY — stated as predicates, not seconds arithmetic (2-Aug fix).
// The rule is unchanged: a level shows on its OWN timeframe and every LOWER one, never
// upward. What changed is HOW it is decided. The old form compared a hard-coded
// monthlySec (2,592,000 = 30 days) against timeframe.in_seconds(), and a calendar month
// is not 30 days — so on a MONTHLY chart the comparison failed and monthly levels
// vanished from the one timeframe they matter most on. That is the same class of failure
// the constants caused once before ("blanked the Monthly chart entirely"), which is why
// this now avoids the arithmetic entirely rather than patching the constant again.
bool useLvM = true                                                  // highest tier — always eligible
bool useLvW = not timeframe.ismonthly                               // hidden only above weekly
bool useLvD = not (timeframe.ismonthly or timeframe.isweekly)       // hidden on W and M

// ============================================================================
// CHART ATR + EMA20
// ============================================================================
float chart_atr = ta.atr(14)
// v3.2: PER-TIMEFRAME ATR for the tested-travel rule. The travel a zone must see

// ============================================================================
// SRSig TYPE
// ============================================================================
type SRSig
    float a1        // nearest level ABOVE
    int   a1t       // touch count
    int   a1x       // TIME of its first touch
    bool  a1h       // origin = pivot HIGHS (else lows)
    float a2
    int   a2t
    int   a2x
    bool  a2h
    float b1        // nearest level BELOW
    int   b1t
    int   b1x
    bool  b1h
    float b2
    int   b2t
    int   b2x
    bool  b2h

// ============================================================================
// ChSig + f_srChannels -- the S/R ENGINE  (22-Oct-2026)
// ============================================================================
// LonesomeTheBlue "Support Resistance Channels" (MPL-2.0), adapted:
//   1. every confirmed pivot high AND low in the lookback seeds a band, and every other
//      pivot within the max width joins it - highs and lows together, so a level that
//      flipped role keeps its history;
//   2. strength = 20 per pivot + 1 per bar whose high or low entered the band. Bar
//      touches are what make a congestion shelf outrank a lone pivot - the thing the
//      old nearest-pivot engine got backwards;
//   3. the strongest non-overlapping bands win (greedy, strongest first);
//   4. then the strongest N EACH SIDE of price, plus the band price is inside, if any.
//      LonesomeTheBlue keeps the N strongest overall; on BAJFINANCE 125m (22 Oct) all six
//      sat above price and no support was drawn at all.
// TESTS (house MTTWR rule) are counted separately: pivots on the level's current side
// since price last closed through the band. A flip resets them - an old resistance has
// never been tested as support.
// COST: building the bands is O(pivots^2 + pivots x lookback), so it runs only on the
// last few bars of the context (the only ones anything reads) and never on an unclosed
// realtime bar. Picking the side runs every bar and is cheap.
type ChSig
    float a1lo
    float a1hi
    int a1st
    int a1ts
    int a1t0
    bool a1fl
    float a2lo
    float a2hi
    int a2st
    int a2ts
    int a2t0
    bool a2fl
    float a3lo
    float a3hi
    int a3st
    int a3ts
    int a3t0
    bool a3fl
    float b1lo
    float b1hi
    int b1st
    int b1ts
    int b1t0
    bool b1fl
    float b2lo
    float b2hi
    int b2st
    int b2ts
    int b2t0
    bool b2fl
    float b3lo
    float b3hi
    int b3st
    int b3ts
    int b3t0
    bool b3fl
    float i1lo
    float i1hi
    int i1st
    int i1ts
    int i1t0
    bool i1fl
    string dbg = ""

f_srChannels(simple int pvLen, simple float wPct, simple int loopN, simple int minPiv, simple int keepN) =>
    float _ph = ta.pivothigh(high, pvLen, pvLen)
    float _pl = ta.pivotlow(low,  pvLen, pvLen)
    int   _rl = math.min(300, bar_index + 1)
    float _rng = ta.highest(high, _rl) - ta.lowest(low, _rl)
    var array<float> vP = array.new<float>()   // pivot price, NEWEST first
    var array<int>   vB = array.new<int>()     // pivot bar index
    var array<int>   vT = array.new<int>()     // pivot time (draw anchor)
    var array<bool>  vH = array.new<bool>()    // true = pivot high
    if not na(_ph)
        array.unshift(vP, _ph)
        array.unshift(vB, bar_index - pvLen)
        array.unshift(vT, time[pvLen])
        array.unshift(vH, true)
    if not na(_pl)
        array.unshift(vP, _pl)
        array.unshift(vB, bar_index - pvLen)
        array.unshift(vT, time[pvLen])
        array.unshift(vH, false)
    while array.size(vP) > 0 and (bar_index - array.last(vB) > loopN or array.size(vP) > 160)
        array.pop(vP)
        array.pop(vB)
        array.pop(vT)
        array.pop(vH)
    // the selected bands, strongest first - rebuilt on the last closed bars only
    var array<float> sLo = array.new<float>()
    var array<float> sHi = array.new<float>()
    var array<int>   sSt = array.new<int>()
    var string _dbg = "no build yet"
    // "the last few bars of THIS context". last_bar_index alone is not trusted inside
    // request.security, so a time test backs it up: within ~8 bars of now plus four days
    // for a weekend or holiday. Running a few bars too many costs time, never accuracy.
    int  _tfMs = timeframe.in_seconds(timeframe.period) * 1000
    bool _near = barstate.isrealtime or bar_index >= last_bar_index - 3 or (timenow - time) <= 8 * _tfMs + 345600000
    if _near and (barstate.isconfirmed or not barstate.isrealtime) and array.size(vP) > 0
        float _cw = nz(_rng) * wPct / 100.0
        int   _n  = array.size(vP)
        int   _lk = math.min(loopN, bar_index)
        array<float> cLo = array.new<float>()
        array<float> cHi = array.new<float>()
        array<int>   cSt = array.new<int>()
        array<int>   cPv = array.new<int>()
        for _i = 0 to _n - 1
            float _hi = array.get(vP, _i)
            float _lo = _hi
            int   _num = 0
            for _j = 0 to _n - 1
                float _c = array.get(vP, _j)
                float _w = _c <= _hi ? _hi - _c : _c - _lo
                if _w <= _cw
                    if _c <= _hi
                        _lo := math.min(_lo, _c)
                    else
                        _hi := math.max(_hi, _c)
                    _num += 1
            int _tch = 0
            for _k = 0 to _lk
                if (high[_k] <= _hi and high[_k] >= _lo) or (low[_k] <= _hi and low[_k] >= _lo)
                    _tch += 1
            array.push(cLo, _lo)
            array.push(cHi, _hi)
            array.push(cSt, 20 * _num + _tch)
            array.push(cPv, _num)
        array.clear(sLo)
        array.clear(sHi)
        array.clear(sSt)
        // GREEDY PICK, strongest first. A candidate is out once its top or bottom falls inside
        // a band already picked (LonesomeTheBlue's rule). Checked DIRECTLY against the picked
        // bands: the first build kept a separate "used" flag array, and on the chart that flag
        // never took effect - the build read b16 (16 rounds) where 8 bands exist, i.e. the same
        // strongest band picked every round, which is why each timeframe drew ONE level
        // (22-Oct-2026, read off the diagnostic row). This form cannot re-pick a band.
        for _r = 0 to 15
            int _bs = -1
            int _bi = -1
            for _k = 0 to _n - 1
                int _ks = array.get(cSt, _k)
                if array.get(cPv, _k) >= minPiv and _ks > _bs
                    float _kl = array.get(cLo, _k)
                    float _kh = array.get(cHi, _k)
                    bool _taken = false
                    int _ns = array.size(sLo)
                    if _ns > 0
                        for _s = 0 to _ns - 1
                            float _sl = array.get(sLo, _s)
                            float _sh = array.get(sHi, _s)
                            if (_kh >= _sl and _kh <= _sh) or (_kl >= _sl and _kl <= _sh)
                                _taken := true
                    if not _taken
                        _bs := _ks
                        _bi := _k
            if _bi < 0
                break
            array.push(sLo, array.get(cLo, _bi))
            array.push(sHi, array.get(cHi, _bi))
            array.push(sSt, _bs)
        int _q = 0
        for _k = 0 to _n - 1
            if array.get(cPv, _k) >= minPiv
                _q += 1
        // u = distinct bands among those picked (must equal b)
        int _u = 0
        int _nsel = array.size(sLo)
        if _nsel > 0
            for _s = 0 to _nsel - 1
                bool _dup = false
                if _s > 0
                    for _t = 0 to _s - 1
                        if array.get(sLo, _t) == array.get(sLo, _s) and array.get(sHi, _t) == array.get(sHi, _s)
                            _dup := true
                if not _dup
                    _u += 1
        _dbg := str.tostring(_n) + "pv w" + str.tostring(_cw, "#.##") + " q" + str.tostring(_q) + " b" + str.tostring(_nsel) + " u" + str.tostring(_u)
    ChSig res = ChSig.new()
    res.dbg := _dbg
    if _near and array.size(sLo) > 0
        int _lk2 = math.min(loopN, bar_index)
        int _na = 0
        int _nb = 0
        bool _hasIn = false
        for _i = 0 to array.size(sLo) - 1
            float _lo = array.get(sLo, _i)
            float _hi = array.get(sHi, _i)
            int   _side = _lo > close ? 1 : _hi < close ? -1 : 0
            bool  _take = _side == 1 ? _na < keepN : _side == -1 ? _nb < keepN : not _hasIn
            if _take
                // the bar price last closed THROUGH the band (from the other side)
                int _flipK = -1
                if _side != 0
                    for _k = 0 to _lk2
                        if _side == -1 ? close[_k] < _lo : close[_k] > _hi
                            _flipK := _k
                            break
                int  _ts = 0
                int  _t0 = time
                for _j = 0 to array.size(vP) - 1
                    float _p = array.get(vP, _j)
                    if _p >= _lo and _p <= _hi
                        _t0 := math.min(_t0, array.get(vT, _j))
                        int _age = bar_index - array.get(vB, _j)
                        bool _facing = _side == 1 ? array.get(vH, _j) : _side == -1 ? not array.get(vH, _j) : true
                        if _facing and (_flipK < 0 or _age < _flipK)
                            _ts += 1
                int   _st  = array.get(sSt, _i)
                // "flip" is a LABEL only when it is news - price crossed the band in the last
                // 20 bars. Over 290 bars nearly every nearby level has been crossed at some
                // point, so an unconditional tag sat on everything and meant nothing. The
                // test count above resets at ANY flip.
                bool  _fl  = _flipK >= 0 and _flipK <= 20
                // field by field, so the object stays a plain-scalar UDT that
                // request.security can return
                if _side == 0
                    _hasIn := true
                    res.i1lo := _lo
                    res.i1hi := _hi
                    res.i1st := _st
                    res.i1ts := _ts
                    res.i1t0 := _t0
                    res.i1fl := false
                else
                    if _side == 1 and _na == 0
                        res.a1lo := _lo
                        res.a1hi := _hi
                        res.a1st := _st
                        res.a1ts := _ts
                        res.a1t0 := _t0
                        res.a1fl := _fl
                    else if _side == 1 and _na == 1
                        res.a2lo := _lo
                        res.a2hi := _hi
                        res.a2st := _st
                        res.a2ts := _ts
                        res.a2t0 := _t0
                        res.a2fl := _fl
                    else if _side == 1 and _na == 2
                        res.a3lo := _lo
                        res.a3hi := _hi
                        res.a3st := _st
                        res.a3ts := _ts
                        res.a3t0 := _t0
                        res.a3fl := _fl
                    else if _side == -1 and _nb == 0
                        res.b1lo := _lo
                        res.b1hi := _hi
                        res.b1st := _st
                        res.b1ts := _ts
                        res.b1t0 := _t0
                        res.b1fl := _fl
                    else if _side == -1 and _nb == 1
                        res.b2lo := _lo
                        res.b2hi := _hi
                        res.b2st := _st
                        res.b2ts := _ts
                        res.b2t0 := _t0
                        res.b2fl := _fl
                    else if _side == -1 and _nb == 2
                        res.b3lo := _lo
                        res.b3hi := _hi
                        res.b3st := _st
                        res.b3ts := _ts
                        res.b3t0 := _t0
                        res.b3fl := _fl
                    if _side == 1
                        _na += 1
                    else
                        _nb += 1
    res

f_chArr(ChSig s) =>
    array<float> lo = array.new<float>()
    array<float> hi = array.new<float>()
    array<int>   st = array.new<int>()
    array<int>   ts = array.new<int>()
    array<int>   t0 = array.new<int>()
    array<bool>  fl = array.new<bool>()
    if not na(s)
        if not na(s.a1lo)
            array.push(lo, s.a1lo)
            array.push(hi, s.a1hi)
            array.push(st, s.a1st)
            array.push(ts, s.a1ts)
            array.push(t0, s.a1t0)
            array.push(fl, s.a1fl)
        if not na(s.a2lo)
            array.push(lo, s.a2lo)
            array.push(hi, s.a2hi)
            array.push(st, s.a2st)
            array.push(ts, s.a2ts)
            array.push(t0, s.a2t0)
            array.push(fl, s.a2fl)
        if not na(s.a3lo)
            array.push(lo, s.a3lo)
            array.push(hi, s.a3hi)
            array.push(st, s.a3st)
            array.push(ts, s.a3ts)
            array.push(t0, s.a3t0)
            array.push(fl, s.a3fl)
        if not na(s.b1lo)
            array.push(lo, s.b1lo)
            array.push(hi, s.b1hi)
            array.push(st, s.b1st)
            array.push(ts, s.b1ts)
            array.push(t0, s.b1t0)
            array.push(fl, s.b1fl)
        if not na(s.b2lo)
            array.push(lo, s.b2lo)
            array.push(hi, s.b2hi)
            array.push(st, s.b2st)
            array.push(ts, s.b2ts)
            array.push(t0, s.b2t0)
            array.push(fl, s.b2fl)
        if not na(s.b3lo)
            array.push(lo, s.b3lo)
            array.push(hi, s.b3hi)
            array.push(st, s.b3st)
            array.push(ts, s.b3ts)
            array.push(t0, s.b3t0)
            array.push(fl, s.b3fl)
        if not na(s.i1lo)
            array.push(lo, s.i1lo)
            array.push(hi, s.i1hi)
            array.push(st, s.i1st)
            array.push(ts, s.i1ts)
            array.push(t0, s.i1t0)
            array.push(fl, s.i1fl)
    [lo, hi, st, ts, t0, fl]

// The four nearest-level fields every existing consumer reads (panel rows, the order-flow
// ladder, SWP-RC). A level's price is its FACING edge: the bottom of a band above price,
// the top of a band below it. A band price is INSIDE offers both edges.
f_toSR(ChSig s) =>
    [lo, hi, st, ts, t0, fl] = f_chArr(s)
    float a1 = na
    float a2 = na
    float b1 = na
    float b2 = na
    int a1t = 0
    int a2t = 0
    int b1t = 0
    int b2t = 0
    int a1x = 0
    int a2x = 0
    int b1x = 0
    int b2x = 0
    if array.size(lo) > 0
        for _i = 0 to array.size(lo) - 1
            float _lo = array.get(lo, _i)
            float _hi = array.get(hi, _i)
            float _up = _lo > close ? _lo : _hi > close ? _hi : na
            float _dn = _hi < close ? _hi : _lo < close ? _lo : na
            if not na(_up)
                if na(a1) or _up < a1
                    a2 := a1
                    a2t := a1t
                    a2x := a1x
                    a1 := _up
                    a1t := array.get(ts, _i)
                    a1x := array.get(t0, _i)
                else if na(a2) or _up < a2
                    a2 := _up
                    a2t := array.get(ts, _i)
                    a2x := array.get(t0, _i)
            if not na(_dn)
                if na(b1) or _dn > b1
                    b2 := b1
                    b2t := b1t
                    b2x := b1x
                    b1 := _dn
                    b1t := array.get(ts, _i)
                    b1x := array.get(t0, _i)
                else if na(b2) or _dn > b2
                    b2 := _dn
                    b2t := array.get(ts, _i)
                    b2x := array.get(t0, _i)
    SRSig.new(a1, a1t, a1x, true, a2, a2t, a2x, true, b1, b1t, b1x, false, b2, b2t, b2x, false)

// ==========================================================================
// Z3. ZONE ENGINE — LABEL + METHODS
// ==========================================================================
// NOTE: there is no touch counter. Zones are DELETED the moment they are tested (see the
// state block below), so a "T n/max" token could never render. The old touchCount field and
// the controllingMaxTouches input were dead weight and have been removed.

// ============================================================================
// S/R CORE -- security calls, helpers, draw fns, manual TL resolve
// ============================================================================
// ==========================================================================
// S/R LEVELS — per-TF detection, then MANUAL-over-AUTO resolution
// ==========================================================================
// Each TF bands its OWN pivots against its OWN 300-bar range — a weekly level comes
// from weekly swings, not from squinting at daily ones.
chM = request.security(syminfo.tickerid, "M", f_srChannels(piv_m, sr_w_pct, sr_loop, sr_min_touch, sr_keep_m), lookahead=barmerge.lookahead_off)
chW = request.security(syminfo.tickerid, "W", f_srChannels(piv_w, sr_w_pct, sr_loop, sr_min_touch, sr_keep_w), lookahead=barmerge.lookahead_off)
// Daily 200-SMA for the SWP-RC context gate. lookahead_off, like every other call
// here - a repainting context gate would make the detector untestable.
sma200D = request.security(syminfo.tickerid, "D", ta.sma(close, 200), lookahead=barmerge.lookahead_off)
chD = request.security(syminfo.tickerid, "D", f_srChannels(piv_d, sr_w_pct, sr_loop, sr_min_touch, sr_keep_d), lookahead=barmerge.lookahead_off)
// The CHART's own levels (22-Oct-2026). On a 75m/125m chart the old engine showed only
// D/W/M, so intraday congestion - the shelf price is actually trading against - was
// invisible. Computed natively every bar (the pivot bookkeeping must run on every bar);
// used only when the chart is intraday, since on a Daily chart chD is the same thing.
chC = f_srChannels(pv_chart, sr_w_pct, sr_loop, sr_min_touch, sr_keep_c)
bool isIntra = timeframe.isintraday
string tfC = timeframe.period
SRSig srM = f_toSR(chM)
SRSig srW = f_toSR(chW)
SRSig srD = f_toSR(chD)
SRSig srC = f_toSR(chC)

// A manual level is live if the master switch is on, it has been placed (>0), and
// its TF is visible on this chart.
f_lvOn(float px, bool tfOk) => sr_on and d_sr and tfOk and not na(px) and px > 0.0
// ROLE IS DERIVED — never fixed at detection — so a level flips Support↔Resistance
// when price closes through it (the R-flip→S rule) instead of going stale.
f_lvRole(float px) => px > close ? "Resistance" : "Support"
// TESTS GRADE A LEVEL, and MORE IS WORSE (MTTWR). This is the inversion.
// Grade anchors to the MIN-TOUCH count, not to 1. A level does not exist below
// sr_min_touch touches, so minTouch touches IS the fresh state — the level has just
// proved itself and is unspent. More = weakening. >= sr_mttwr_n = primed to break.
// (Keyed to 1 this read "fresh" only for one-touch levels, which are now — correctly —
//  not levels at all, so "fresh" would have become unreachable.)
f_lvGrade(int tests) => tests >= mttwrEff ? "MTTWR" : tests <= sr_min_touch ? "fresh" : "tested×" + str.tostring(tests)
// Does this TF have ANY manual level placed? If so it OWNS that timeframe: the
// auto levels for that TF are suppressed entirely rather than drawn alongside,
// because "your hand-drawn levels ARE the location layer" — a machine guess sitting
// next to your mark on the same timeframe is noise, not a second opinion.
f_tfHasManual(float v1, float v2, float v3, float v4, bool tfOk) => f_lvOn(v1, tfOk) or f_lvOn(v2, tfOk) or f_lvOn(v3, tfOk) or f_lvOn(v4, tfOk)

bool manM = f_tfHasManual(mv1, mv2, mv3, mv4, useLvM)
bool manW = f_tfHasManual(wv1, wv2, wv3, wv4, useLvW)
bool manD = f_tfHasManual(dv1, dv2, dv3, dv4, useLvD)

// --- MANUAL TRENDLINES: TF visibility, live test, projection to the current bar ---
// Same guardrail as the levels (HTF down, never LTF up), driven by the line's own
// TF dropdown rather than the group it sits in.
f_tlVis(string tf) => tf == "Monthly" ? useLvM : tf == "Weekly" ? useLvW : useLvD
// A line is live only when BOTH anchors carry a time AND a non-zero price. A
// half-placed line must draw nothing rather than a line to somewhere arbitrary.
bool tls_live = tl_on and d_tl and tls_t1 > 0 and tls_t2 > 0 and tls_p1 > 0.0 and tls_p2 > 0.0 and tls_t2 != tls_t1 and f_tlVis(tls_tf)
bool tlr_live = tl_on and d_tl and tlr_t1 > 0 and tlr_t2 > 0 and tlr_p1 > 0.0 and tlr_p2 > 0.0 and tlr_t2 != tlr_t1 and f_tlVis(tlr_tf)
// Projected value AT THIS BAR — this is what makes the line machine-readable: a
// trendline is just a level whose price moves, so once projected it flows through
// the same nearest-S/R pickers the horizontals use, and reaches the PLAN and the
// confluence score without any of those consumers knowing it is a diagonal.
// Anchors are in TIME (ms), so the slope is price-per-ms and must be applied to a
// time delta — never mixed with a bar-index slope.
float tls_now = tls_live ? tls_p2 + (tls_p2 - tls_p1) / float(tls_t2 - tls_t1) * float(time - tls_t2) : na
float tlr_now = tlr_live ? tlr_p2 + (tlr_p2 - tlr_p1) / float(tlr_t2 - tlr_t1) * float(time - tlr_t2) : na
string tls_tfTag = tls_tf == "Monthly" ? "M" : tls_tf == "Weekly" ? "W" : "D"
string tlr_tfTag = tlr_tf == "Monthly" ? "M" : tlr_tf == "Weekly" ? "W" : "D"

// Line WEIGHT encodes conviction, because the timeframe a level is drawn on IS its
// weight: Monthly 3px, Weekly 2px, Daily 1px. You should be able to tell a weekly
// floor from a daily one without reading the label.
var array<line>  srLines = array.new<line>()
var array<label> srLbls  = array.new<label>()
var line  lnTlS = na
var line  lnTlR = na
var label lbTlS = na
var label lbTlR = na
var box   bxFlag = na
var label lbFlag = na
var box   bxMan  = na
var label lbMan  = na

var array<box> srBoxes = array.new<box>()

// MANUAL levels (your hand-typed prices). Colour by role, width by timeframe.
f_drawLv(float px, string tfTag) =>
    if not na(px) and px > 0
        bool isSup = px <= close
        color lc = isSup ? #26a69a : #ef5350
        int   w  = tfTag == "M" ? 3 : tfTag == "W" ? 2 : 1
        array.push(srLines, line.new(time[math.min(300, bar_index)], px, time, px, xloc=xloc.bar_time, color=lc, width=w))
        array.push(srLbls,  label.new(time, px, tfTag + " · " + f_lvRole(px) + "  " + str.tostring(px, format.mintick) + " · manual", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(lc, 82), textcolor=lc, size=size.small))

// AUTO levels for one timeframe. Higher timeframes are drawn first and a lower-timeframe
// band that overlaps one already drawn is skipped - the heavier line already says it.
// GREEN = support (line on the band top), RED = resistance (line on the band bottom),
// GREY = price is inside the band. Width = timeframe (M 3 · W 2 · D/chart 1). DASHED =
// tested beyond the fresh state; MTTWR is spelled out.
f_drawCh(ChSig s, string tfTag, bool tfOk, bool tfShow, bool hasManual, array<float> dLo, array<float> dHi) =>
    if show_sr_lv and d_sr and tfOk and tfShow and not hasManual and not na(s)
        [lo, hi, st, ts, t0, fl] = f_chArr(s)
        if array.size(lo) > 0
            for _i = 0 to array.size(lo) - 1
                float _lo = array.get(lo, _i)
                float _hi = array.get(hi, _i)
                bool _clash = false
                if array.size(dLo) > 0
                    for _j = 0 to array.size(dLo) - 1
                        if _lo <= array.get(dHi, _j) and _hi >= array.get(dLo, _j)
                            _clash := true
                if not _clash
                    array.push(dLo, _lo)
                    array.push(dHi, _hi)
                    bool  _sup = _hi < close
                    bool  _res = _lo > close
                    color lc  = _sup ? #26a69a : _res ? #ef5350 : #9598a1
                    int   w   = tfTag == "M" ? 3 : tfTag == "W" ? 2 : 1
                    int   _ts = array.get(ts, _i)
                    bool  _fl = array.get(fl, _i)
                    int   _t0 = array.get(t0, _i)
                    float px  = _sup ? _hi : _res ? _lo : (_lo + _hi) / 2.0
                    bool  dash = _ts > sr_min_touch
                    string g  = (_sup or _res) ? f_lvGrade(_ts) : "price inside"
                    string ft = _fl ? (_sup ? " · R→S" : " · S→R") : ""
                    if sr_band
                        array.push(srBoxes, box.new(_t0, _hi, time, _lo, xloc=xloc.bar_time, border_color=color.new(lc, 100), bgcolor=color.new(lc, 90)))
                    if _sup or _res
                        array.push(srLines, line.new(_t0, px, time, px, xloc=xloc.bar_time, color=color.new(lc, dash ? 30 : 0), width=w, style=dash ? line.style_dashed : line.style_solid))
                    array.push(srLbls, label.new(time, px, tfTag + " · " + ((_sup or _res) ? f_lvRole(px) : "In level") + "  " + ((_sup or _res) ? str.tostring(px, format.mintick) : str.tostring(_lo, format.mintick) + "-" + str.tostring(_hi, format.mintick)) + ft + " · " + g + " · s" + str.tostring(array.get(st, _i)), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(lc, 82), textcolor=lc, size=size.small))
    0

// ============================================================================
// f_bestLine (max-threading fit, no longer called) + f_pairTL (the auto trendline)
// ============================================================================
f_bestLine(array<float> py, array<int> px, float tol) =>
    int _n = array.size(py)
    int   _xE = na
    float _yE = na
    int   _xL = na
    float _yL = na
    if _n >= 2
        int _bestCount = -1
        int _bestA = 0
        int _bestB = 1
        for _a = 0 to _n - 2
            for _b = _a + 1 to _n - 1
                int   _xa = array.get(px, _a)
                float _ya = array.get(py, _a)
                int   _dx = array.get(px, _b) - _xa
                if _dx != 0
                    float _slope = (array.get(py, _b) - _ya) / _dx
                    int _cnt = 0
                    for _k = 0 to _n - 1
                        float _pred = _ya + _slope * (array.get(px, _k) - _xa)
                        if math.abs(array.get(py, _k) - _pred) <= tol
                            _cnt += 1
                    if _cnt > _bestCount
                        _bestCount := _cnt
                        _bestA := _a
                        _bestB := _b
        int   _xa2 = array.get(px, _bestA)
        float _ya2 = array.get(py, _bestA)
        int   _dx2 = array.get(px, _bestB) - array.get(px, _bestA)
        float _slp = _dx2 != 0 ? (array.get(py, _bestB) - _ya2) / _dx2 : 0.0
        int   _minx =  2147483647
        int   _maxx = -2147483647
        for _k = 0 to _n - 1
            int   _xk   = array.get(px, _k)
            float _pred = _ya2 + _slp * (_xk - _xa2)
            if math.abs(array.get(py, _k) - _pred) <= tol
                if _xk < _minx
                    _minx := _xk
                    _yE   := _pred
                if _xk > _maxx
                    _maxx := _xk
                    _yL   := _pred
        _xE := _minx
        _xL := _maxx
    [_xE, _yE, _xL, _yL]

// AUTO TRENDLINE = PIVOT PAIR  (22-Oct-2026, replaces the envelope fit)
// The method the open-source references use (LonesomeTheBlue "Trend Lines", the Adam
// Moradi tutorial) and the way a trader draws one:
//   * SUPPORT joins a HIGHER LOW to an earlier pivot low; RESISTANCE a LOWER HIGH to an
//     earlier pivot high. (The envelope fit demanded the line sit under EVERY pivot in a
//     16-pivot pool, which drew falling "support" lines through a decline's lows.)
//   * VALID only if no CLOSE crosses it from the first anchor to the current bar - wicks
//     may pierce, closes may not. A broken line is not drawn.
//   * BEST = most pivots on the line (within the touch tolerance), then the LONGEST span
//     (the dominant trend line), then the most recent second anchor.
// `off` skips the N most-recent pivots; `nudgePx` shifts the line parallel.
// Returns [live, anchorX (bar_index), anchorY, slope per bar].
f_pairTL(array<float> py, array<int> px, bool isSupport, int off, float tolPx, float nudgePx, int lookN) =>
    int   _n = array.size(py) - off
    bool  _live = false
    int   _ax = na
    float _ay = na
    float _sl = na
    if _n >= 2
        int _bT = -1
        int _bSpan = -1
        int _bB = -1
        for _a = 0 to _n - 2
            int   _xa = array.get(px, _a)
            float _ya = array.get(py, _a)
            if bar_index - _xa <= lookN
                for _b = _a + 1 to _n - 1
                    int   _xb = array.get(px, _b)
                    float _yb = array.get(py, _b)
                    if _xb > _xa and (isSupport ? _yb > _ya : _yb < _ya)
                        float _slope = (_yb - _ya) / float(_xb - _xa)
                        bool  _ok = true
                        for _x = _xa + 1 to bar_index
                            float _lv = _ya + _slope * float(_x - _xa)
                            float _c  = close[bar_index - _x]
                            if isSupport ? _c < _lv : _c > _lv
                                _ok := false
                                break
                        if _ok
                            int _t = 0
                            for _j = _a to _n - 1
                                if math.abs(array.get(py, _j) - (_ya + _slope * float(array.get(px, _j) - _xa))) <= tolPx
                                    _t += 1
                            int _span = _xb - _xa
                            if _t > _bT or (_t == _bT and (_span > _bSpan or (_span == _bSpan and _xb > _bB)))
                                _bT := _t
                                _bSpan := _span
                                _bB := _xb
                                _ax := _xa
                                _ay := _ya + nudgePx
                                _sl := _slope
                                _live := true
    [_live, _ax, _ay, _sl]

// ============================================================================
// PIVOT DETECTION + TRENDLINE POOLS
// ============================================================================
var array<float> gphy = array.new<float>()
var array<float> gply = array.new<float>()
float _gph = ta.pivothigh(high, pv_chart, pv_chart)
float _gpl = ta.pivotlow(low,  pv_chart, pv_chart)
var array<int> gpxh = array.new<int>()
var array<int> gpxl = array.new<int>()
if not na(_gph)
    array.push(gphy, _gph)
    array.push(gpxh, bar_index - pv_chart)
    if array.size(gphy) > 6
        array.shift(gphy)
        array.shift(gpxh)
if not na(_gpl)
    array.push(gply, _gpl)
    array.push(gpxl, bar_index - pv_chart)
    if array.size(gply) > 6
        array.shift(gply)
        array.shift(gpxl)
// Dedicated, LARGER pivot pool for the auto-trendlines (the geometry read stays at 6 —
// a channel/wedge only needs the last few; a trendline may span many higher-lows). Same
// pivots (_gph/_gpl), bigger cap so the pair search can reach a major swing anchor.
var array<float> tlhy = array.new<float>()
var array<int>   tlhx = array.new<int>()
var array<float> tlly = array.new<float>()
var array<int>   tllx = array.new<int>()
if not na(_gph)
    array.push(tlhy, _gph)
    array.push(tlhx, bar_index - pv_chart)
    if array.size(tlhy) > tl_pool
        array.shift(tlhy)
        array.shift(tlhx)
if not na(_gpl)
    array.push(tlly, _gpl)
    array.push(tllx, bar_index - pv_chart)
    if array.size(tlly) > tl_pool
        array.shift(tlly)
        array.shift(tllx)

// ============================================================================
// CHART TAG + AUTO-TL RESOLUTION
// ============================================================================
// ── AUTO TRENDLINES (tl_auto): fit a support line (pivot lows) + resistance line (pivot
// highs) from the geometry pivots, then OVERRIDE tls_*/tlr_* so every consumer below —
// the nearest-S/R picker, near_tl, the display marking and the drawing — uses them with
// no extra wiring. When tl_auto is OFF, the manual anchors (computed above) stand.
string _chartTag = timeframe.isdaily ? "D" : timeframe.isweekly ? "W" : timeframe.ismonthly ? "M" : "i"
int   _tlsAX = na
float _tlsAY = na
int   _tlrAX = na
float _tlrAY = na
// Fitted on the last CLOSED bar only (the history's last bar, then each realtime bar as it
// closes - never on every tick: the pair search validates up to ~300 closes per pair).
// The anchors are kept; the line's price at the current bar is projected every bar.
var bool  _tlS_ok = false
var int   _tlS_x  = na
var float _tlS_y  = na
var float _tlS_m  = na
var bool  _tlR_ok = false
var int   _tlR_x  = na
var float _tlR_y  = na
var float _tlR_m  = na
if tl_auto and d_tl and (barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isconfirmed))
    [_sLive, _sX, _sY, _sM] = f_pairTL(tlly, tllx, true,  tls_anch_off, tl_thread * chart_atr, tls_nudge * chart_atr, tl_look)
    [_rLive, _rX, _rY, _rM] = f_pairTL(tlhy, tlhx, false, tlr_anch_off, tl_thread * chart_atr, tlr_nudge * chart_atr, tl_look)
    _tlS_ok := _sLive
    _tlS_x  := _sX
    _tlS_y  := _sY
    _tlS_m  := _sM
    _tlR_ok := _rLive
    _tlR_x  := _rX
    _tlR_y  := _rY
    _tlR_m  := _rM
if tl_auto and d_tl and barstate.islast
    float _sNow = _tlS_ok ? _tlS_y + _tlS_m * float(bar_index - _tlS_x) : na
    float _rNow = _tlR_ok ? _tlR_y + _tlR_m * float(bar_index - _tlR_x) : na
    tls_live := _tlS_ok
    tls_now  := _sNow
    tlr_live := _tlR_ok
    tlr_now  := _rNow
    tls_tfTag := _chartTag
    tlr_tfTag := _chartTag
    _tlsAX := _tlS_x
    _tlsAY := _tlS_y
    _tlrAX := _tlR_x
    _tlrAY := _tlR_y



// ---- SRSig SAFE READS (RE10041) --------------------------------------------
// A request.security UDT is `na` until it resolves, and Pine throws when you touch a
// FIELD of an na object - so `na(srD.b1)` does not protect anything, it is the very
// expression that errors. Guard the OBJECT, once, and read these locals everywhere.
// srD/srW/srM/srC are built locally by f_toSR (never na objects); "ok" now means the
// timeframe's engine produced a result object at all.
bool  _okD = not na(chD)
bool  _okW = not na(chW)
bool  _okM = not na(chM)
bool  _okC = isIntra and not na(chC)
float _dA1 = _okD ? srD.a1 : na
float _dB1 = _okD ? srD.b1 : na
int   _dA1t = _okD ? srD.a1t : na
int   _dB1t = _okD ? srD.b1t : na
float _wA1 = _okW ? srW.a1 : na
float _wB1 = _okW ? srW.b1 : na
int   _wA1t = _okW ? srW.a1t : na
int   _wB1t = _okW ? srW.b1t : na
float _mA1 = _okM ? srM.a1 : na
float _mB1 = _okM ? srM.b1 : na
int   _mA1t = _okM ? srM.a1t : na
int   _mB1t = _okM ? srM.b1t : na
float _cA1 = _okC ? srC.a1 : na
float _cB1 = _okC ? srC.b1 : na
int   _cA1t = _okC ? srC.a1t : na
int   _cB1t = _okC ? srC.b1t : na
// second-nearest levels each side (12-Oct-2026): the order-flow read places a signal
// against ANY nearby level, and the bar that tested a level is often one level away
// from where price sits now.
float _dA2 = _okD ? srD.a2 : na
float _dB2 = _okD ? srD.b2 : na
float _wA2 = _okW ? srW.a2 : na
float _wB2 = _okW ? srW.b2 : na
float _mA2 = _okM ? srM.a2 : na
float _mB2 = _okM ? srM.b2 : na
float _cA2 = _okC ? srC.a2 : na
float _cB2 = _okC ? srC.b2 : na

// ============================================================================
// GEOMETRY — 5/5 PIVOT POOL  (TradingView-documented)
// ============================================================================
// A pool of its OWN, at geo_piv strength, separate from the chart-TF pool the zones
// and trendlines use. TV pins every pattern anchor to a 5/5 pivot regardless of
// timeframe; S5's chart pool is piv_intra = 2 on 75m, so the classifier was reading
// swings a quarter the size and calling the noise between them a slope. That is the
// most likely cause of open item #11 - an obvious rectangle read as a symmetrical
// triangle on APOLLOHOSP and GLAXO.
var array<float> g5hy = array.new<float>()
var array<int>   g5hx = array.new<int>()
var array<float> g5ly = array.new<float>()
var array<int>   g5lx = array.new<int>()
float _g5h = ta.pivothigh(high, geo_piv, geo_piv)
float _g5l = ta.pivotlow(low,  geo_piv, geo_piv)
if not na(_g5h)
    array.push(g5hy, _g5h)
    array.push(g5hx, bar_index - geo_piv)
    if array.size(g5hy) > 8
        array.shift(g5hy)
        array.shift(g5hx)
if not na(_g5l)
    array.push(g5ly, _g5l)
    array.push(g5lx, bar_index - geo_piv)
    if array.size(g5ly) > 8
        array.shift(g5ly)
        array.shift(g5lx)

// THE NON-INTERSECTION RULE. A line whose INTERIOR is breached is not a boundary at
// all: between the two anchors, no intermediate close may cross it.
//
// PROVENANCE, because these are not the same standing. The 5/5 pivots, the 600-bar
// lookback and Permissible Deviation are all stated on TradingView's own Help
// Centre pages for the built-in pattern indicators. This interior test is NOT -
// it came from a third-party account of how their engine behaves, and TV's actual
// wording for Permissible Deviation is the "maximum allowable deviation of a POINT
// from its corresponding line" (Rectangle page), i.e. how far a pattern VERTEX may
// sit off its own boundary - not a tolerance on intermediate bars.
// So geo_dev is being reused here for a related but different job. The % OF CHANNEL
// WIDTH basis is TV's (Triangle page: "as a percentage of the distance between the
// lines"); applying it to interior closes is this file's adaptation. Worth knowing
// if the shapes ever disagree with TV's - this is the first place they would.
// Returns true when the segment survives.
f_geoClean(int x1, float y1, int x2, float y2, bool isUpper, float widthPx) =>
    bool _ok = true
    int  _dx = x2 - x1
    if _dx > 1
        float _m   = (y2 - y1) / _dx
        float _tol = widthPx * geo_dev / 100.0
        for _i = 1 to _dx - 1
            int _off = bar_index - (x1 + _i)
            // AUD-PINE-02 (20-Sep-2026): the script declares max_bars_back=300 (S5 is
            // memory-bound, so the buffer is kept small), yet this loop indexed close[]
            // up to 3,999 bars back — fine on 75m where eight 5/5 pivots sit inside 300
            // bars, a runtime "referencing length" error on a DAILY chart, and the error
            // blanks the whole panel. Clamp to the buffer; a pair whose interior test
            // would need older bars is treated as UNVERIFIED (not clean) so the
            // classifier stays quiet rather than crashing.
            if _off >= 300
                _ok := false
                break
            if _off >= 0 and _off < 300
                float _lvl = y1 + _m * _i
                float _p   = isUpper ? (geo_strict ? high[_off] : close[_off]) : (geo_strict ? low[_off] : close[_off])
                if isUpper ? (_p > _lvl + _tol) : (_p < _lvl - _tol)
                    _ok := false
                    break
    _ok

// TV-STYLE BOUNDARY SELECTION (8 Sep 2026).
// f_bestLine and the non-intersection rule are INCOMPATIBLE objectives, and pairing
// them was my error: f_bestLine returns the line threading the MOST pivots, which by
// construction leaves pivots on both sides of it, so an intermediate close breaches it
// almost every time. On ANANDRATHI 75m the classifier went silent for exactly this
// reason, with a full 8H/8L pivot pool.
//
// TradingView does not fit-then-reject. It anchors a boundary to TWO 5/5 pivots and
// validates the interior between them, so the line that survives IS an envelope rather
// than a regression through the middle of the swing. This searches pivot PAIRS, newest
// first, and returns the first pair whose segment is clean.
//
// Newest-first matters: the most recent clean boundary is the live one. An older pair
// might also be clean but describes a shape price has already left.
// Returns [x1, y1, x2, y2] early->late, or all na when no pair survives.
f_geoPair(array<float> py, array<int> px, bool isUpper, float widthPx) =>
    int   _n  = array.size(py)
    int   _x1 = na
    float _y1 = na
    int   _x2 = na
    float _y2 = na
    if _n >= 2
        bool _done = false
        for _a = _n - 1 to 1
            if not _done
                for _b = _a - 1 to 0
                    if not _done
                        int   _cx2 = array.get(px, _a)
                        float _cy2 = array.get(py, _a)
                        int   _cx1 = array.get(px, _b)
                        float _cy1 = array.get(py, _b)
                        if _cx2 > _cx1 and f_geoClean(_cx1, _cy1, _cx2, _cy2, isUpper, widthPx)
                            _x1   := _cx1
                            _y1   := _cy1
                            _x2   := _cx2
                            _y2   := _cy2
                            _done := true
    [_x1, _y1, _x2, _y2]

// ============================================================================
// GEOMETRY — SHAPE CLASSIFIER
// ============================================================================
// Rebuilt from PIVOT SEQUENCES rather than fitted trendline slopes. It reads the same
// 6-pivot pool (gphy/gply) the trendline fitter uses, so it adds no pivot work.
//
// THE KNOWN DEFECT, and what changed. With geo_maxfit OFF the shape came from the last
// TWO pivots per side, so noise between two equal highs read as a downslope and an
// obvious rectangle was classified "Symmetrical triangle" (seen on APOLLOHOSP and
// GLAXO). Two things address it here: geo_maxfit defaults ON, so each edge is the line
// that threads the most pivots rather than the last pair, and geo_flat defaults to 0.5
// ATR rather than 0.3. Neither is a new algorithm - both were already available and
// left at the wrong defaults.
string geom = "-"
// The classified edges, lifted to global scope so RNG-EDGE can read them. For a
// rectangle these are the MEAN of the two highs and the two lows - the same values
// the box is drawn from, so what you see is what the setup measures.
float geoTop = na
float geoBot = na
// Everything the GEOMETRY section prints, lifted to global scope. These were locals
// inside the classifier, so the panel could only ever show the label and two slopes -
// which is why ONE row ended up carrying twelve shapes, a pole, a convergence test,
// two slopes and a marginal flag.
float geoUpNow  = na   // upper boundary projected to THIS bar
float geoLoNow  = na   // lower boundary projected to THIS bar
float geoConvPc = na   // how much the channel narrowed, start -> end, in %
float geoPoleA  = na   // flagpole size in ATR, signed
float geoRollPc = na   // rollback as a % of the pole
float geoHeight = na   // pattern base height - TV projects THIS from the breakout
int   geoSpanB  = na   // bars the pattern spans
int   geoUpFr   = na   // upper boundary anchors, early -> late
int   geoUpTo   = na
int   geoLoFr   = na   // lower boundary anchors
int   geoLoTo   = na
float geoOvlp   = na   // how much the two spans OVERLAP, as a % of their union
int   geoApexX  = na   // v1.4: bar where converging boundaries meet (na when parallel/widening)
float geoApexPc = na   // v1.4: how far through the pattern price is, start -> apex, in %
string geoNote  = ""   // v1.4: why a shape was withdrawn (printed on the Shape row)
var line _geoHi  = na
var line _geoLo  = na
var box  _geoBox = na
line.delete(_geoHi)
line.delete(_geoLo)
box.delete(_geoBox)
_geoHi  := na
_geoLo  := na
_geoBox := na
// FRESHNESS: a shape built from pivots older than geo_maxage is history, not a setup.
bool _geoEdge = false
bool _geoFresh = array.size(g5hx) >= 2 and array.size(g5lx) >= 2 and bar_index - math.min(array.get(g5hx, array.size(g5hx) - 2), array.get(g5lx, array.size(g5lx) - 2)) <= geo_look
float _gSlopeH = na
float _gSlopeL = na
bool _geoClean = true
// Permissible Deviation is a share of the channel width, but the width is not known
// until the lines are picked - so the tolerance uses the POOL's price range, which is
// stable, available up front, and the same order of magnitude.
float _geoSpan = (array.size(g5hy) > 0 and array.size(g5ly) > 0) ? math.max(array.max(g5hy) - array.min(g5ly), chart_atr) : chart_atr
if show_geom and d_geo and _geoFresh and array.size(g5hy) >= 2 and array.size(g5ly) >= 2
    // anchors ordered early(_2) -> late(_1)
    float _h1 = na
    float _h2 = na
    float _l1 = na
    float _l2 = na
    int   _xh1 = na
    int   _xh2 = na
    int   _xl1 = na
    int   _xl2 = na
    if geo_maxfit
        // geo_maxfit ON = TV's validated two-pivot boundary (the default). OFF = the old
        // max-threading fit, kept so the two can be compared on a live chart.
        [_xhE, _yhE, _xhL, _yhL] = f_geoPair(g5hy, g5hx, true,  _geoSpan)
        [_xlE, _ylE, _xlL, _ylL] = f_geoPair(g5ly, g5lx, false, _geoSpan)
        _h2  := _yhE
        _h1  := _yhL
        _xh2 := _xhE
        _xh1 := _xhL
        _l2  := _ylE
        _l1  := _ylL
        _xl2 := _xlE
        _xl1 := _xlL
    else
        _h1  := array.get(g5hy, array.size(g5hy) - 1)
        _h2  := array.get(g5hy, array.size(g5hy) - 2)
        _l1  := array.get(g5ly, array.size(g5ly) - 1)
        _l2  := array.get(g5ly, array.size(g5ly) - 2)
        _xh1 := array.get(g5hx, array.size(g5hx) - 1)
        _xh2 := array.get(g5hx, array.size(g5hx) - 2)
        _xl1 := array.get(g5lx, array.size(g5lx) - 1)
        _xl2 := array.get(g5lx, array.size(g5lx) - 2)
    if not na(_h1) and not na(_h2) and not na(_l1) and not na(_l2)
        // WIDTH AT EACH END - the basis for both the deviation tolerance and the
        // wedge/channel split. TV expresses Permissible Deviation as a share of the
        // distance BETWEEN the lines, so it has to be measured before validating.
        // SPAN ALIGNMENT - computed HERE, before the classification ladder, because the
        // ladder GATES on it. First version sat further down with the panel plumbing, so
        // geoOvlp was still na when the gate tested it and the gate never fired: AADHARHFC
        // 75m reported Broadening with the two boundaries sharing 0% of their span.
        //
        // f_geoPair is called independently for highs and lows, each taking its own newest
        // clean pair, and nothing made them cover the same window. When they do not,
        // 'width at the start vs width at the end' compares two segments that never
        // coexisted - so a converging structure can measure as WIDENING. TV forms ONE
        // pattern from points 1-5 over ONE span.
        int _ovFr = math.max(_xh2, _xl2)
        int _ovTo = math.min(_xh1, _xl1)
        int _unFr = math.min(_xh2, _xl2)
        int _unTo = math.max(_xh1, _xl1)
        geoOvlp := (_unTo - _unFr) > 0 ? math.max(_ovTo - _ovFr, 0) * 100.0 / (_unTo - _unFr) : na
        float _wEarly = math.abs(_h2 - _l2)
        float _wLate  = math.abs(_h1 - _l1)
        float _wMid   = math.max((_wEarly + _wLate) / 2.0, chart_atr)
        // Only re-validate on the MAX-FIT path. On the pair path the boundary was already
        // validated during selection, and re-testing it against a different width basis
        // (_wMid vs _geoSpan) could reject a line that had just passed.
        _geoClean := not geo_maxfit ? (f_geoClean(_xh2, _h2, _xh1, _h1, true, _wMid) and f_geoClean(_xl2, _l2, _xl1, _l1, false, _wMid)) : true
        // THE FLAGPOLE - the move INTO the pattern, measured over flag_look bars ending
        // at the earliest anchor. This is what separates a FLAG from a plain channel and
        // a PENNANT from a plain symmetrical triangle: identical geometry, opposite
        // meaning. A falling parallel channel after a strong up-move is a BULL FLAG, the
        // most reliable continuation shape there is - and S5 was calling it a "Falling
        // channel" and telling you it was against a long.
        int   _pEnd  = math.min(_xh2, _xl2)
        int   _pOff  = math.max(bar_index - _pEnd, 0)
        int   _pOff0 = math.min(_pOff + flag_look, 4000)
        float _pFrom = _pOff0 < 4000 ? close[_pOff0] : na
        float _pTo   = _pOff  < 4000 ? close[_pOff]  : na
        float _pole  = (na(_pFrom) or na(_pTo)) ? na : _pTo - _pFrom
        bool  _poleUp = not na(_pole) and _pole >=  flag_pole * chart_atr
        bool  _poleDn = not na(_pole) and _pole <= -flag_pole * chart_atr
        // MAX ROLLBACK - how much of the pole the correction has given back. TV caps this
        // because a correction that retraces most of the pole is a reversal, not a flag.
        float _roll   = (na(_pole) or _pole == 0) ? na : math.abs(_h2 - _l1) / math.abs(_pole) * 100.0
        bool  _rollOk = not na(_roll) and _roll <= flag_roll
        // CONVERGING = the channel narrows from the early anchors to the late ones.
        bool _conv = _wEarly > 0 and (_wEarly - _wLate) / _wEarly >= geo_conv / 100.0
        float _ft = geo_flat * chart_atr
        _gSlopeH := _h1 - _h2
        _gSlopeL := _l1 - _l2
        bool _hFlat = math.abs(_gSlopeH) <= _ft
        bool _lFlat = math.abs(_gSlopeL) <= _ft
        // MARGINAL: either slope sitting within geo_edge% of the flat threshold, on
        // either side of it. The shape is then one tick from being a different shape,
        // and the panel should say so rather than assert.
        float _eLo = _ft * (1.0 - geo_edge / 100.0)
        float _eHi = _ft * (1.0 + geo_edge / 100.0)
        _geoEdge := (math.abs(_gSlopeH) >= _eLo and math.abs(_gSlopeH) <= _eHi) or (math.abs(_gSlopeL) >= _eLo and math.abs(_gSlopeL) <= _eHi)
        bool _hDown = not _hFlat and _gSlopeH < 0
        bool _hUp   = not _hFlat and _gSlopeH > 0
        bool _lUp   = not _lFlat and _gSlopeL > 0
        bool _lDown = not _lFlat and _gSlopeL < 0
        // an if/else ladder, not a wrapped ternary: Pine reads a continuation line
        // indented by a multiple of 4 as a new block, which a wrapped ternary trips.
        if not _geoClean
            geom := "-"
        else if not na(geoOvlp) and geoOvlp < geo_ovlp
            // not one pattern - two unrelated line segments
            geom := "-"
        else if _hFlat and _lFlat
            geom := "Range / rectangle"
        else if _hFlat and _lUp
            geom := "Ascending triangle"
        else if _hDown and _lFlat
            geom := "Descending triangle"
        else if _hDown and _lUp
            // TV lists pennants separately from triangles, and the only difference is
            // the pole: a symmetrical triangle that follows one is a pennant, and it is
            // a CONTINUATION shape rather than the directionless coin-flip a triangle is.
            geom := (_poleUp and _rollOk) ? "Bullish pennant" : (_poleDn and _rollOk) ? "Bearish pennant" : "Symmetrical triangle"
        else if _hUp and _lUp
            // a rising parallel channel after a DOWN pole is a bear flag
            geom := _conv ? "Rising wedge" : (_poleDn and _rollOk) ? "Bearish flag" : "Rising channel"
        else if _hDown and _lDown
            // ...and a falling one after an UP pole is a bull flag
            geom := _conv ? "Falling wedge" : (_poleUp and _rollOk) ? "Bullish flag" : "Falling channel"
        else if _hUp and _lDown
            geom := "Broadening"
        else if _hFlat and _lDown
            geom := "Broadening (descending)"
        else if _hUp and _lFlat
            geom := "Broadening (ascending)"
        // Project both boundaries to the CURRENT bar. The anchors are history; what
        // price trades against is where those lines sit now.
        int   _dxH = _xh1 - _xh2
        int   _dxL = _xl1 - _xl2
        float _mH  = _dxH != 0 ? _gSlopeH / _dxH : 0.0
        float _mL  = _dxL != 0 ? _gSlopeL / _dxL : 0.0
        geoUpNow  := _h1 + _mH * (bar_index - _xh1)
        geoLoNow  := _l1 + _mL * (bar_index - _xl1)
        // v1.4 - THE APEX (TITAN, 11-Sep-2026: "upper 4928 < lower 4968"). Two converging
        // lines cross at the apex; projected past it they swap sides, and the panel was
        // printing that inverted pair as live boundaries. TradingView's pattern pages end
        // a triangle / wedge / pennant AT the apex - a shape whose lines have met has
        // resolved, one way or the other, whether or not a breakout was seen. So: find
        // the crossing bar, and past it (or with the boundaries inverted for any other
        // reason) withdraw the shape and say why. Also report how far through the pattern
        // price is - TV's own guidance is that a valid breakout comes before ~75% of the
        // way to the apex; later than that the coil has lost its energy.
        if _mH != _mL
            float _xA = (_l1 - _mL * _xl1 - (_h1 - _mH * _xh1)) / (_mH - _mL)
            int   _x0 = math.min(_xh2, _xl2)
            if _xA > _x0
                geoApexX  := math.round(_xA)
                geoApexPc := (bar_index - _x0) * 100.0 / (_xA - _x0)
        bool _pastApex = not na(geoApexX) and bar_index >= geoApexX
        if geom != "-" and (_pastApex or geoUpNow <= geoLoNow)
            geoNote := _pastApex ? "apex passed " + str.tostring(bar_index - geoApexX) + "b ago - the coil has resolved, no live boundaries" : "boundaries inverted - not a live shape"
            geom     := "-"
            geoUpNow := na
            geoLoNow := na
        geoConvPc := _wEarly > 0 ? (_wEarly - _wLate) / _wEarly * 100.0 : na
        geoPoleA  := na(_pole) ? na : _pole / chart_atr
        geoRollPc := _roll
        // TV documents the target for every pattern as the BASE height projected from
        // the breakout close.
        geoHeight := _wEarly
        geoSpanB  := bar_index - math.min(_xh2, _xl2)
        geoUpFr   := _xh2
        geoUpTo   := _xh1
        geoLoFr   := _xl2
        geoLoTo   := _xl1
        if geom == "Range / rectangle"
            geoTop := (_h1 + _h2) / 2.0
            geoBot := (_l1 + _l2) / 2.0
        if drawGeomLines and geom != "-" and not na(_xh1) and not na(_xh2) and not na(_xl1) and not na(_xl2)
            if geom == "Range / rectangle"
                int   _bxL = math.min(math.min(_xh1, _xh2), math.min(_xl1, _xl2))
                float _bxT = (_h1 + _h2) / 2.0
                float _bxB = (_l1 + _l2) / 2.0
                _geoBox := box.new(_bxL, _bxT, bar_index, _bxB, xloc=xloc.bar_index, border_color=color.new(#9598a1, 10), border_width=1, bgcolor=color.new(#9598a1, 94))
            else
                _geoHi := line.new(_xh2, _h2, _xh1, _h1, xloc=xloc.bar_index, color=C_GREY20, width=1, extend=extend.right, style=line.style_dashed)
                _geoLo := line.new(_xl2, _l2, _xl1, _l1, xloc=xloc.bar_index, color=C_GREY20, width=1, extend=extend.right, style=line.style_dashed)

// ============================================================================
// DRAWING — the block that actually renders levels and trendlines
// ============================================================================
// Lifted verbatim from S4 (its `if barstate.islast` render block). Without this the
// engines above compute correctly and draw NOTHING — which is exactly what the first
// build of this lab did.
if barstate.islast
    // Cleanup is UNCONDITIONAL and up front. Chart Markup kept every delete inside
    // its own `if show_*` gate, so toggling a feature off SKIPPED the delete and
    // froze that drawing on the chart forever — you ended up tuning against ghosts.
    // Deletes belong here; draw calls stay behind their gates.
    if array.size(srLines) > 0
        for i = 0 to array.size(srLines) - 1
            line.delete(array.get(srLines, i))
        array.clear(srLines)
    if array.size(srLbls) > 0
        for i = 0 to array.size(srLbls) - 1
            label.delete(array.get(srLbls, i))
        array.clear(srLbls)

    if array.size(srBoxes) > 0
        for i = 0 to array.size(srBoxes) - 1
            box.delete(array.get(srBoxes, i))
        array.clear(srBoxes)
    // MANUAL first — highest TF first so the heavy Monthly line sits under the
    // lighter Weekly/Daily ones rather than burying them.
    f_drawLv(f_lvOn(mv1, useLvM) ? mv1 : na, "M")
    f_drawLv(f_lvOn(mv2, useLvM) ? mv2 : na, "M")
    f_drawLv(f_lvOn(mv3, useLvM) ? mv3 : na, "M")
    f_drawLv(f_lvOn(mv4, useLvM) ? mv4 : na, "M")
    f_drawLv(f_lvOn(wv1, useLvW) ? wv1 : na, "W")
    f_drawLv(f_lvOn(wv2, useLvW) ? wv2 : na, "W")
    f_drawLv(f_lvOn(wv3, useLvW) ? wv3 : na, "W")
    f_drawLv(f_lvOn(wv4, useLvW) ? wv4 : na, "W")
    f_drawLv(f_lvOn(dv1, useLvD) ? dv1 : na, "D")
    f_drawLv(f_lvOn(dv2, useLvD) ? dv2 : na, "D")
    f_drawLv(f_lvOn(dv3, useLvD) ? dv3 : na, "D")
    f_drawLv(f_lvOn(dv4, useLvD) ? dv4 : na, "D")
    // AUTO — only on a TF you have NOT marked yourself. Highest TF first: a lower-TF band
    // overlapping one already drawn is skipped.
    array<float> _dLo = array.new<float>()
    array<float> _dHi = array.new<float>()
    f_drawCh(chM, "M", useLvM, sr_show_M, manM, _dLo, _dHi)
    f_drawCh(chW, "W", useLvW, sr_show_W, manW, _dLo, _dHi)
    f_drawCh(chD, "D", useLvD, sr_show_D, manD, _dLo, _dHi)
    f_drawCh(chC, tfC, isIntra, true, false, _dLo, _dHi)

    // --- MANUAL TRENDLINES. Deletes are unconditional and up front (a delete left
    // inside its own `if show_*` gate is how Chart Markup froze drawings on the
    // chart forever). Width by TF, same conviction encoding as the levels.
    line.delete(lnTlS)
    line.delete(lnTlR)
    label.delete(lbTlS)
    label.delete(lbTlR)
    if tls_live
        int _wS = tls_tfTag == "M" ? 3 : tls_tfTag == "W" ? 2 : 1
        if tl_auto and not na(_tlsAX)   // AUTO: bar-index anchors (fit projects to this bar)
            lnTlS := line.new(_tlsAX, _tlsAY, bar_index, tls_now, xloc=xloc.bar_index, color=C_OK, width=_wS)
            lbTlS := label.new(bar_index, tls_now, _chartTag + " · TL support (auto)  " + str.tostring(tls_now, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=C_OK82, textcolor=C_OK, size=size.small)
        else                            // MANUAL: bar-time anchors from the numeric inputs
            lnTlS := line.new(tls_t1, tls_p1, time, tls_now, xloc=xloc.bar_time, color=C_OK, width=_wS)   // ends AT the label anchor (collinear by construction) — extend.right ran the ray through the label text
            lbTlS := label.new(time, tls_now, tls_tfTag + " · TL support  " + str.tostring(tls_now, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=C_OK82, textcolor=C_OK, size=size.small)
    if tlr_live
        int _wR = tlr_tfTag == "M" ? 3 : tlr_tfTag == "W" ? 2 : 1
        if tl_auto and not na(_tlrAX)
            lnTlR := line.new(_tlrAX, _tlrAY, bar_index, tlr_now, xloc=xloc.bar_index, color=C_NO, width=_wR)
            lbTlR := label.new(bar_index, tlr_now, _chartTag + " · TL resistance (auto)  " + str.tostring(tlr_now, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=C_NO82, textcolor=C_NO, size=size.small)
        else
            lnTlR := line.new(tlr_t1, tlr_p1, time, tlr_now, xloc=xloc.bar_time, color=C_NO, width=_wR)
            lbTlR := label.new(time, tlr_now, tlr_tfTag + " · TL resistance  " + str.tostring(tlr_now, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=C_NO82, textcolor=C_NO, size=size.small)




// ============================================================================
// FOOTPRINT  (order flow)
// ============================================================================
// The real thing, not the lower-timeframe proxy S4 used to carry: the feed's own
// buy/sell split, delta, auction levels and per-row imbalances. Premium or Ultimate
// only, and na wherever the feed has no footprint for a bar - ordinary on older
// history. Every read below says "n/a" in that case and never a zero: unmeasured and
// measured-flat are different facts, and conflating them is how a panel starts lying.
grpFP = "Footprint (order flow)"
show_fp  = input.bool(true, "Read the footprint", group=grpFP, tooltip="Turn OFF if the chart ever reports 'Memory limits exceeded' - this is the only thing here that retains per-bar objects.")
fpTicks  = input.int(200, "Ticks per volume row", group=grpFP, minval=1, maxval=5000, tooltip="Row height in ticks. NSE mintick is 0.05, so 200 = Rs 10.00. Coarse is fine: only the AGGREGATE delta and the auction levels are read, never individual rows, so finer rows cost memory and buy nothing.")
fpVA     = input.int(70,  "Value-area %", group=grpFP, minval=30, maxval=95)
fpImb    = input.int(300, "Imbalance %",  group=grpFP, minval=110, maxval=1000, tooltip="How far one side must exceed the other for a row to count as imbalanced. 300 = three times.")
fpCumWin = input.int(20,  "Cumulative delta window (bars)", group=grpFP, minval=2, maxval=200)
fpDivWin = input.int(10,  "Divergence lookback (bars)",     group=grpFP, minval=3, maxval=100)

_fp = show_fp ? request.footprint(fpTicks, fpVA, fpImb) : na
bool fpKnown = not na(_fp)
float fpDelta = fpKnown ? _fp.delta()        : na
float fpBuy   = fpKnown ? _fp.buy_volume()   : na
float fpSell  = fpKnown ? _fp.sell_volume()  : na
float fpTot   = fpKnown ? _fp.total_volume() : na

// math.sum carries a rolling accumulator and MUST run every bar. Gating the CALL would
// skip the na bars and desynchronise the window, so accumulate always and gate the read.
float fpCumRaw = math.sum(nz(fpDelta), fpCumWin)
float fpCum = fpKnown ? fpCumRaw : na

// price makes the extreme, flow does not - the absorption read, and the reason the
// footprint earns its place over plain volume
float _fpPxHi = ta.highest(high, fpDivWin)
float _fpPxLo = ta.lowest(low,   fpDivWin)
// hoisted for the same reason as _fpPxHi/_fpPxLo directly above: these sit to the
// RIGHT of an `and`, which short-circuits, and a history-dependent ta.* that skips
// bars returns nonsense rather than failing. I hoisted the price pair and left the
// cumulative pair inline in the same edit - the compiler caught what I missed.
float _fpCumHi = ta.highest(nz(fpCumRaw), fpDivWin)
float _fpCumLo = ta.lowest(nz(fpCumRaw),  fpDivWin)
bool fpBearDiv = fpKnown and high >= _fpPxHi and nz(fpCumRaw) < _fpCumHi
bool fpBullDiv = fpKnown and low  <= _fpPxLo and nz(fpCumRaw) > _fpCumLo

float fpPoc = na
float fpVah = na
float fpVal = na
if fpKnown
    _rP = _fp.poc()
    fpPoc := na(_rP) ? na : (_rP.up_price() + _rP.down_price()) / 2.0
    _rH = _fp.vah()
    fpVah := na(_rH) ? na : _rH.up_price()
    _rL = _fp.val()
    fpVal := na(_rL) ? na : _rL.down_price()

// PER-ROW IMBALANCES, last bar only. NOT gated on barstate.isrealtime alone - that is
// true on EVERY TICK, so this loop would run hundreds of times a second and trip the
// 20s limit once the market opens. That exact bug cost two "Calculation timed out"
// errors on 13-Aug-2026.
var int fpImbBuy  = 0
var int fpImbSell = 0
if fpKnown and (barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isconfirmed))
    fpImbBuy  := 0
    fpImbSell := 0
    _rows = _fp.rows()
    if array.size(_rows) > 0
        for _i = 0 to array.size(_rows) - 1
            _vr = array.get(_rows, _i)
            if _vr.has_buy_imbalance()
                fpImbBuy += 1
            if _vr.has_sell_imbalance()
                fpImbSell += 1

// ============================================================================
// ORDER FLOW AT LEVELS  (12-Oct-2026)
// ============================================================================
// Jay: absorption, trapped traders, aggressive traders and big limit orders matter most
// AT S/R LEVELS, and measuring them is not enough - the panel has to say what they MEAN.
// So the footprint rows of the last 3 CLOSED bars are summarised, each signal is placed
// against S5's own S/R ladder (D/W/M - the same clustering engine as S4's S/R rows; S4's
// demand/supply zones are not visible on this chart), and ONE verdict is read for a long:
//   at support     DEFENDED · BREAKING · RESPONSIVE BUYING
//   at resistance  CAPPED · FAILED BREAKOUT · INITIATIVE BREAKOUT
//   elsewhere      NO LEVEL (reported, low information)
// UNVALIDATED BY CONSTRUCTION: the footprint exists only on TradingView, bar by bar, so
// none of this can be backtested. It GRADES the read; it never gates GO, size or a stop.
// The one exception is in the REVIEWER, not here: FLOW-GATE turns a model TAKE on a
// breakout entry into WAIT after a FAILED BREAKOUT at that level - pre-registered in
// docs/PREREG_flow_gate.md and removed if it does not earn its place.
// "Big passive order" is an INFERENCE from executed volume. Pine cannot see the order
// book, and the panel says so.
grpOF = "Order flow at levels"
of_on     = input.bool(true, "Read order flow at S/R levels", group=grpOF, tooltip="Summarises the footprint rows of the last 3 closed bars and reads them against the S/R ladder. Needs 'Read the footprint' ON. Display only - never gates anything.")
of_zone   = input.float(25.0, "Extreme zone (% of bar range)", group=grpOF, minval=10.0, maxval=50.0, step=5.0, tooltip="The top / bottom slice of each bar that counts as its extreme. Absorption and trapped traders are read inside it.")
of_absShr = input.float(40.0, "Absorption: extreme-zone share of bar volume (%)", group=grpOF, minval=20.0, maxval=90.0, step=5.0, tooltip="An even spread would put ~25% of volume in a 25% zone. Absorption needs the extreme to carry clearly more than that.")
of_pull   = input.float(50.0, "Absorption: close at least this far from the extreme (% of range)", group=grpOF, minval=20.0, maxval=90.0, step=5.0, tooltip="Aggression met a wall: the bar must close away from the extreme it was pushing into.")
of_dom    = input.float(30.0, "Aggression: one-sided delta in the zone (% of zone volume)", group=grpOF, minval=10.0, maxval=90.0, step=5.0, tooltip="How one-sided the extreme rows must be to count as aggressive buying or selling.")
of_stackN = input.int(3, "Stacked imbalances: consecutive rows", group=grpOF, minval=2, maxval=8, tooltip="Rows in a row imbalanced on the same side (at the footprint's Imbalance %). The usual read of initiative.")
of_bigX   = input.float(3.0, "Big row: x median row volume", group=grpOF, minval=1.5, maxval=10.0, step=0.5, tooltip="One price row this much larger than the bar's median row, at a price where the bar reversed, is read as a large PASSIVE order. An inference - the order book is not visible.")
of_lvlAtr = input.float(0.5, "At the level: within x ATR of the bar's extreme", group=grpOF, minval=0.1, maxval=2.0, step=0.1, tooltip="A level counts if the bar's low (support) or high (resistance) came within this distance of it, or pierced it and closed back.")
of_minRows = input.int(6, "Rows per bar needed for a read", group=grpOF, minval=3, maxval=30, tooltip="Too few footprint rows per bar and stacking cannot exist. Below this the panel warns and suggests a smaller 'Ticks per volume row'. Row height is fixed per chart (Pine needs a compile-time value), so it cannot follow price on its own.")

type FlowBar
    int   bi
    float hi
    float lo
    float cl
    float atr
    int   nRows
    float totV
    float botV
    float botD
    float topV
    float topD
    int   stB
    float stBlo
    float stBhi
    int   stS
    float stSlo
    float stShi
    float bigV
    float bigPx
    float medV

var array<FlowBar> ofBars = array.new<FlowBar>()

// A bar counts once it has CLOSED. The last intraday bar after the session ends stays
// unconfirmed on TradingView, so it also counts once its close time has passed.
bool _ofClosed = barstate.isconfirmed or (barstate.islast and timenow >= time_close)
// Only the last few bars are summarised, and only once each - the row loop must not run
// over the whole history (memory) or on every realtime tick (the 20 s limit).
if show_fp and of_on and fpKnown and _ofClosed and bar_index >= last_bar_index - 6
    _ofRows = _fp.rows()
    int _ofN = array.size(_ofRows)
    if _ofN > 0
        float _ofRng = math.max(high - low, syminfo.mintick)
        float _ofZ = _ofRng * of_zone / 100.0
        array<float> _ofPx = array.new<float>()
        array<float> _ofVl = array.new<float>()
        array<float> _ofDl = array.new<float>()
        array<int>   _ofIm = array.new<int>()
        for _vr in _ofRows
            array.push(_ofPx, (_vr.up_price() + _vr.down_price()) / 2.0)
            array.push(_ofVl, _vr.total_volume())
            array.push(_ofDl, _vr.delta())
            array.push(_ofIm, _vr.has_buy_imbalance() ? 1 : _vr.has_sell_imbalance() ? -1 : 0)
        array<int> _ofOrd = array.sort_indices(_ofPx, order.ascending)
        float _tot = 0.0
        float _bV = 0.0
        float _bD = 0.0
        float _tV = 0.0
        float _tD = 0.0
        float _bigV = 0.0
        float _bigPx = na
        int _cB = 0
        int _cS = 0
        int _sB = 0
        int _sS = 0
        float _rBlo = na
        float _rSlo = na
        float _sBlo = na
        float _sBhi = na
        float _sSlo = na
        float _sShi = na
        for _k = 0 to _ofN - 1
            int _i = array.get(_ofOrd, _k)
            float _p = array.get(_ofPx, _i)
            float _v = array.get(_ofVl, _i)
            float _d = array.get(_ofDl, _i)
            int _m = array.get(_ofIm, _i)
            _tot += _v
            if _p <= low + _ofZ
                _bV += _v
                _bD += _d
            if _p >= high - _ofZ
                _tV += _v
                _tD += _d
            if _v > _bigV
                _bigV := _v
                _bigPx := _p
            if _m == 1
                _cB += 1
                if _cB == 1
                    _rBlo := _p
                if _cB > _sB
                    _sB := _cB
                    _sBlo := _rBlo
                    _sBhi := _p
            else
                _cB := 0
            if _m == -1
                _cS += 1
                if _cS == 1
                    _rSlo := _p
                if _cS > _sS
                    _sS := _cS
                    _sSlo := _rSlo
                    _sShi := _p
            else
                _cS := 0
        FlowBar _fb = FlowBar.new(bar_index, high, low, close, chart_atr, _ofN, _tot, _bV, _bD, _tV, _tD, _sB, _sBlo, _sBhi, _sS, _sSlo, _sShi, _bigV, _bigPx, array.median(_ofVl))
        int _ofSz = array.size(ofBars)
        if _ofSz > 0 and array.get(ofBars, _ofSz - 1).bi == bar_index
            array.set(ofBars, _ofSz - 1, _fb)
        else
            array.push(ofBars, _fb)
            if array.size(ofBars) > 3
                array.shift(ofBars)

// ============================================================================
// WYCKOFF — DISTRIBUTION EVENTS
// ============================================================================
// S4 collapsed PSY / BC / UT / LPSY into a single "DIST" tag to buy tokens. These are
// the events themselves, rebuilt from the canonical definitions rather than recovered -
// no live code survived in any copy on disk.
//
// DISPLAY ONLY, and that is a measured position, not modesty. Wyckoff was tested twice
// as a GO veto and as a score input (28-Jul-2026): as a veto it ran BACKWARDS (the
// vetoed cohort returned +5.60% against +0.52% for the kept one) and as a score it was
// null (held-out rho +0.013, p 0.74). The reason is structural - 49% of qualified picks
// read DISTRIBUTION at signal time, because Wyckoff events fire at high-volume pivot
// highs, which is what a breakout looks like. So S5 NAMES them and never gates on them.
grpWY = "Wyckoff — distribution"
show_wy   = input.bool(true, "Detect distribution events", group=grpWY)
wy_look   = input.int(30, "Structure lookback (bars)", group=grpWY, minval=10, maxval=200, tooltip="The window that defines 'the high of the advance' for BC and the resistance an upthrust pokes through.")
wy_vol    = input.float(2.0, "Climax volume (x 20-bar avg)", group=grpWY, minval=1.0, step=0.1)
wy_volPsy = input.float(1.5, "Preliminary-supply volume (x avg)", group=grpWY, minval=1.0, step=0.1)
wy_rng    = input.float(1.5, "Climax range (x ATR)", group=grpWY, minval=0.5, step=0.1)

float _wyVa  = ta.sma(volume, 20)
float _wyRv  = _wyVa > 0 ? volume / _wyVa : na
float _wyRng = high - low
float _wyPos = _wyRng > 0 ? (close - low) / _wyRng : 0.5     // where it closed in its range
bool  _wyAdv = close > close[20]                              // there must BE an advance to distribute
float _wyHi  = ta.highest(high, wy_look)
float _wyHiP = ta.highest(high, wy_look)[1]                   // resistance EXCLUDING this bar

// PSY — the first significant supply into an advance: a wide bar on heavy volume that
// cannot hold its highs. Not yet climactic.
bool wyPSY = show_wy and _wyAdv and nz(_wyRv) >= wy_volPsy and _wyRng >= wy_rng * chart_atr and _wyPos <= 0.5
// BC — the climax itself: at the high of the advance, on climactic volume, closing in
// the bottom third. Volume is the whole point; a quiet new high is not a BC.
bool wyBC = show_wy and _wyAdv and high >= _wyHi and nz(_wyRv) >= wy_vol and _wyRng >= wy_rng * chart_atr and _wyPos <= 0.33
// AR — the automatic reaction: a sharp drop within 10 bars of a BC.
// ONE unconditional call. Everything below reads this variable, never ta.barssince
// directly: `and` short-circuits, so a call on the right of one may not execute on
// every bar, and a history-dependent function that skips bars returns nonsense.
int  _wySinceBC  = ta.barssince(wyBC)
bool _wyBCrecent = not na(_wySinceBC) and _wySinceBC <= 10
bool wyAR = show_wy and _wyBCrecent and close < close[1] - wy_rng * chart_atr
// ST — the secondary test: back near the BC high on LIGHTER volume. Light volume is
// what distinguishes a test from a resumption.
bool wyST = show_wy and _wyBCrecent and high >= _wyHi - chart_atr and nz(_wyRv) < 1.0
// UT — the upthrust: pokes above prior resistance and closes back inside it. The
// failure IS the signal; a close above is a breakout, not an upthrust.
bool wyUT = show_wy and high > _wyHiP and close < _wyHiP
// UTAD — an upthrust AFTER distribution structure has appeared (a BC in the window).
bool wyUTAD = wyUT and not na(_wySinceBC) and _wySinceBC <= wy_look
// LPSY — the last point of supply: a weak, lower-high rally on poor volume after the
// structure is in place. The rally that fails to go anywhere.
bool wyLPSY = show_wy and not na(_wySinceBC) and _wySinceBC <= wy_look and close > close[1] and high < _wyHi and nz(_wyRv) < 1.0 and _wyPos <= 0.6

string wyTxt = ""
wyTxt := wyTxt + (wyUTAD ? "UTAD  " : wyUT ? "UT  " : "")
wyTxt := wyTxt + (wyBC ? "BC  " : "")
wyTxt := wyTxt + (wyAR ? "AR  " : "")
wyTxt := wyTxt + (wyST ? "ST  " : "")
wyTxt := wyTxt + (wyLPSY ? "LPSY  " : "")
wyTxt := wyTxt + (wyPSY ? "PSY  " : "")


// ============================================================================
// SWP-RC — SWEEP / RECLAIM   (the setup the notes called "S3")
// ============================================================================
// NOT CALLED S3, deliberately. Nothing of the original survived - no live code in any
// copy on disk and no git history for S4 - and the entire surviving record is one line
// saying S3 read the SMC liquidity-sweep block. Naming this S3 would imply a
// restoration and would be read as provenance it does not have. It is named for its
// mechanic. See docs/27_S3_S6_Setup_Specs.md.
//
// THE MECHANIC. An obvious swing low is where stops sit. Price takes them, fails to
// follow through, and reclaims. You are buying the FAILURE OF THE BREAK - the sweep is
// what creates the fuel and the reclaim is what proves it was a trap and not a trend
// change.
//
// TEMPER YOUR EXPECTATIONS. This is close kin to SWG-REV, the one catalyst family
// measured NEGATIVE out-of-sample (-0.44%, payoff 1.62 against SWG-PB's 3.14, 89.3% of
// exits at the initial stop), and whose diagnosis was structural rather than fixable: a
// reversal bounce is a smaller move than a trend continuation. This book's demonstrated
// edge is trend continuation. So SWP-RC is a DETECTOR here - it names the structure and
// prints the arithmetic, and it produces no plan and gates nothing until it has been
// measured as its own catalyst family in R-multiples.
//
// TWO PARAMETERS, TWO JOBS. The draft spec let sweep depth decide both "is this a sweep
// or a breakdown" AND, implicitly, whether the trade could pay. Those are different
// questions and confounding them would make the validation sweep uninterpretable.
// Geometry: entry sits above the reclaim bar's high (near the level) and the stop sits
// below the sweep low, so risk is roughly sweep depth + reclaim bar range. At a 1.0xATR
// sweep that is ~1.5xATR of risk, and paying 2R needs the ceiling ~3xATR overhead.
// Widening the sweep does not find more trades, it finds trades that CANNOT pay - so
// depth stays tight and a separate room test decides payment.
//
// CONTEXT IS S4'S JOB. The 200-DMA gate is here because it is one cheap security call
// and a sweep below it is usually just supply. STAGE is deliberately NOT re-implemented:
// S4 already owns the stateless 2x2, and a second copy is exactly how 19 of 56 names
// came to be mis-staged in August. Read the stage off S4 on the primary chart.
grpS3 = "SWP-RC — sweep / reclaim"
show_s3     = input.bool(true,  "Detect sweep / reclaim", group=grpS3)
s3_max_sweep= input.float(1.0,  "Max sweep depth (x ATR)", group=grpS3, minval=0.1, step=0.1, tooltip="Deeper than this is a BREAKDOWN, not a sweep. Deliberately tight: the stop sits under the sweep low, so depth sets your risk, and a deeper sweep buys trades that cannot reach 2R.")
s3_reclaim_n= input.int(3,      "Reclaim within N bars", group=grpS3, minval=1, maxval=10, tooltip="Slower than this and the level was redefined, not defended.")
s3_rv       = input.float(1.0,  "Reclaim volume floor (RV)", group=grpS3, minval=0.0, step=0.1, tooltip="Note RV is time-of-day biased on intraday - measured 48% pass at 10:30 against ~18% midday - so this gate is harsher at midday than the number suggests.")
s3_min_rr   = input.float(2.0,  "Minimum room to the ceiling (R)", group=grpS3, minval=0.5, step=0.5, tooltip="The SEPARATE payment test. Rejects a valid sweep whose ceiling is too close to pay.")

// The level being swept: the nearest DAILY level below. NO touch gate of its own -
// that was a bug on ANANDRATHI 75m, where the row read "no level below with 2+
// touches" about a perfectly valid level. Two reasons it was wrong:
//   1. REDUNDANT. Reaching b1 already means the level passed f_srLevels' own
//      qualification, which is exactly `sr_min_touch` (minval 2). One rule, one place.
//   2. THE WRONG QUANTITY. The engine QUALIFIES on pivots + grazing wicks but GRADES
//      on pivots ALONE - Jay's rule that only pivot touches count as tests. So b1t is
//      a grade, not a qualification, and gating on it demanded 2 PIVOTS where the
//      engine deliberately accepts a pivot plus a confluent wick. It silently made
//      SWP-RC far stricter than its spec.
// The grade still SHOWS on the panel, where a weak level is information rather than
// a veto.
float s3_lvl = _dB1
// THREE states, not two. The old form collapsed "below the 200-DMA" and "the
// 200-DMA has not resolved" into one false, and the panel then reported UNKNOWN as
// NO - on ANANDRATHI, 1.6% off its 52-week high, the row read "blocked: below the
// 200-DMA". Same distinction the footprint row makes between n/a and a flat delta.
bool  s3_ctxKnown = not na(sma200D)
bool  s3_ctx = s3_ctxKnown and close > sma200D
// the sweep: pierced, but not broken
bool  s3_swept = show_s3 and not na(s3_lvl) and low < s3_lvl and low >= s3_lvl - s3_max_sweep * chart_atr
int   s3_since = ta.barssince(s3_swept)
float s3_swpLo = ta.valuewhen(s3_swept, low, 0)
// the reclaim, on a bar that closed strong enough to mean it
float s3_rng   = high - low
float s3_pos   = s3_rng > 0 ? (close - low) / s3_rng : 0.0
bool  s3_recl  = show_s3 and not na(s3_lvl) and not na(s3_since) and s3_since <= s3_reclaim_n and close > s3_lvl and s3_pos >= 0.5 and nz(_wyRv, 0.0) >= s3_rv
// the arithmetic, printed whether or not it passes - a rejected setup should show WHY
float s3_entry = high
float s3_stop  = s3_swpLo
float s3_tgt   = _dA1
float s3_risk  = (na(s3_stop) or na(s3_entry)) ? na : s3_entry - s3_stop
float s3_rr    = (not na(s3_risk) and s3_risk > 0 and not na(s3_tgt)) ? (s3_tgt - s3_entry) / s3_risk : na
// STRUCTURE FIRES; CONTEXT IS STATUS (Jay's catalyst-gate philosophy, 3-Jul-2026).
// The 200-DMA was a VETO here and it is not one any more. Two reasons, and the
// second is the real one:
//   1. It never resolved. sma200D reads na on a 75m chart at both 1500 and 3000
//      calc_bars_count, so the veto blocked EVERYTHING - a permanently-closed gate
//      that reported itself as a market condition.
//   2. S5's own header says context is S4's job, which is why Stage was deliberately
//      NOT re-implemented here. A 200-DMA veto is the same category of thing, and
//      adding it contradicted the principle two hundred lines later.
// So the trade fires on the STRUCTURE - swept, reclaimed, and enough room to pay -
// and the context prints beside it as something to eyeball. Read the stage off S4.
// THREE states for the ceiling, not two. nz(s3_rr, 0.0) turned "no resistance found"
// into 0R, so a name with NOTHING overhead was reported as "ceiling too close to
// pay" - the exact opposite of what an absent ceiling means. Fourth instance of this
// same collapse in this file (200-DMA, divergence, footprint zero, this).
// It still does not FIRE without a ceiling, and that is deliberate rather than
// conservative: SWP-RC is mean reversion TO a level, so no level means no defined
// target and no thesis - but the row now says which of the two it is.
bool  s3_hasTgt = not na(s3_rr)
bool  s3_fire   = s3_recl and s3_hasTgt and s3_rr >= s3_min_rr


// ============================================================================
// RNG-EDGE — RANGE EDGE   (the setup the notes called "S6")
// ============================================================================
// NOT CALLED S6, and unlike SWP-RC this one is not even a reconstruction: NOTHING is
// recorded about what S6 did. This is a new setup that fills a real gap, named for its
// mechanic. See docs/27_S3_S6_Setup_Specs.md.
//
// THE GAP IT FILLS, which is live right now. A ranging name has no playbook: it resolves
// to BREAKOUT, gets judged by a breakout's standards, and fails the room test BY
// CONSTRUCTION - the ceiling is right there, which is what a range IS. That is exactly
// the incoherence S4's Setup row was built to surface, and today the row has no correct
// answer to give for it. RNG-EDGE is that answer: in a range the EDGE is the trade and
// the middle is noise.
//
// IT INHERITS EVERY ERROR THE CLASSIFIER MAKES. This reads `geom` directly, so a
// misclassified rectangle is a false setup. That matters because the classifier's known
// defect - an obvious range called "Symmetrical triangle" on APOLLOHOSP and GLAXO - is
// addressed here only by two changed DEFAULTS (geo_maxfit ON, geo_flat 0.5) which are
// themselves unverified. Verify the geometry row before trusting this row.
//
// *** THE REVERSAL TEST BELOW IS NOT S4'S BATTERY ***
// S5 has no PA battery and deliberately does not import one. These three patterns are a
// LOCAL, minimal reversal test written for this row alone. They will NOT agree with
// S4's 17-pattern battery on every bar and no parity is claimed - S5 is an explain
// surface, like the Swing Zigzag, not a zero-drift surface. If RNG-EDGE is ever
// promoted to gate anything, it must be rewired to the canonical battery first;
// promoting it on these three would be exactly the drift this project keeps paying for.
grpS6 = "RNG-EDGE — range edge"
show_s6   = input.bool(true, "Detect range-edge entries", group=grpS6)
s6_frac   = input.float(0.33, "Lower fraction of the range that counts as the edge", group=grpS6, minval=0.1, maxval=0.5, step=0.01, tooltip="The edge is the trade; the middle is noise. 0.33 = the lower third.")
s6_min_rr = input.float(2.0, "Minimum room to the ceiling (R)", group=grpS6, minval=0.5, step=0.5)

float s6_rng  = (na(geoTop) or na(geoBot)) ? na : geoTop - geoBot
float s6_edge = (na(s6_rng) or s6_rng <= 0) ? na : geoBot + s6_rng * s6_frac
bool  s6_at   = show_s6 and not na(s6_edge) and close <= s6_edge and low >= geoBot - chart_atr

// --- the local reversal test (see the warning above) ---
float _s6body = math.abs(close - open)
float _s6rng  = high - low
bool  _s6ham  = _s6rng > 0 and (math.min(open, close) - low) >= 2.0 * _s6body and (close - low) / _s6rng >= 0.66
bool  _s6eng  = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool  _s6b3   = close[1] < close[2] and close[2] < close[3] and close > high[1]
bool  s6_rev  = show_s6 and (_s6ham or _s6eng or _s6b3)

// the arithmetic - target is the ceiling and NOTHING beyond it. A range trade that
// hopes for a breakout is two trades stapled together, and it is how a 2R plan becomes
// a 0.3R outcome.
float s6_entry = high
float s6_stop  = geoBot
float s6_risk  = (na(s6_stop) or na(s6_entry)) ? na : s6_entry - s6_stop
float s6_rr    = (not na(s6_risk) and s6_risk > 0 and not na(geoTop)) ? (geoTop - s6_entry) / s6_risk : na
bool  s6_fire  = s6_at and s6_rev and nz(s6_rr, 0.0) >= s6_min_rr

// ============================================================================
// PANEL
// ============================================================================
// The Lab drew levels and named nothing. S5 states what the geometry IS, which S/R is
// nearest on each side and how tested it is, where the trendlines sit, and - the part
// S4 had to give up - the pivot funnel, so a missing level is self-diagnosing rather
// than silently absent.
//
// It deliberately mirrors S4's panel grammar (right-aligned key, left-aligned value,
// one synthesis line at the bottom) so the two read as one instrument, and deliberately
// does NOT repeat anything S4 already prints.
grpS5P = "S5 Panel"
show_s5p  = input.bool(true, "Show the panel", group=grpS5P)
s5pPos    = input.string("Bottom Right", "Position", group=grpS5P, options=["Top Right", "Middle Right", "Bottom Right", "Top Left", "Bottom Left"], tooltip="Default is BOTTOM RIGHT so it does not collide with S4, which sits top-right.")
s5pSize   = input.string("Small", "Text size", group=grpS5P, options=["Tiny", "Small", "Normal"])

f_s5pos() =>
    s5pPos == "Top Right" ? position.top_right : s5pPos == "Middle Right" ? position.middle_right : s5pPos == "Bottom Right" ? position.bottom_right : s5pPos == "Top Left" ? position.top_left : position.bottom_left

f_s5size() =>
    s5pSize == "Tiny" ? size.tiny : s5pSize == "Normal" ? size.normal : size.small

f_px(float v) =>
    na(v) ? "-" : str.tostring(v, format.mintick)

// distance from price, in ATR - percent is volatility-blind, and 2% means nothing
// until you know whether the name moves 0.5% or 4% a day
f_dist(float lvl) =>
    (na(lvl) or na(chart_atr) or chart_atr <= 0) ? "" : "  (" + str.tostring(math.abs(close - lvl) / chart_atr, "0.0") + "x ATR)"

// MTTWR is deliberate, not a bug: tests WEAKEN a level. One tested four or more times
// is a breakout candidate, not a ceiling. Same grading S4 uses.
f_grade(int t) =>
    na(t) or t <= 0 ? "" : t >= 6 ? "  MTTWR(" + str.tostring(t) + ")" : "  " + str.tostring(t) + "t"

// nearest of the three timeframes on one side, with the TF that produced it
f_pick(float c, float d, float w, float m, bool above) =>
    float _best = na
    string _tf = ""
    if not na(c) and (above ? c > close : c < close)
        _best := c
        _tf := tfC
    if not na(d) and (above ? d > close : d < close) and (na(_best) or (above ? d < _best : d > _best))
        _best := d
        _tf := "D"
    if not na(w) and (above ? w > close : w < close) and (na(_best) or (above ? w < _best : w > _best))
        _best := w
        _tf := "W"
    if not na(m) and (above ? m > close : m < close) and (na(_best) or (above ? m < _best : m > _best))
        _best := m
        _tf := "M"
    [_best, _tf]

// ---- ORDER FLOW AT LEVELS: the read ---------------------------------------
// Nearest level to a bar's extreme: within tol of it, or pierced by the bar and closed
// back (ext and other bracket it). -1 = none.
f_ofLvl(array<float> lvP, float ext, float other, float tol) =>
    int _best = -1
    float _bd = na
    int _n = array.size(lvP)
    if _n > 0 and not na(ext)
        for _i = 0 to _n - 1
            float _l = array.get(lvP, _i)
            float _d = math.abs(_l - ext)
            bool _hit = _d <= tol or (_l > math.min(ext, other) and _l < math.max(ext, other))
            if _hit and (_best < 0 or _d < _bd)
                _best := _i
                _bd := _d
    _best

f_ofPush(array<float> p, array<string> t, float v, string tf) =>
    if not na(v) and v > 0
        array.push(p, v)
        array.push(t, tf)
    0

f_ofAge(int a) =>
    a <= 0 ? "last closed bar" : str.tostring(a) + (a == 1 ? " bar ago" : " bars ago")

f_ofVol(float v) =>
    na(v) ? "-" : (v >= 0 ? "+" : "") + str.tostring(v, format.volume)

// The verdict, scanning the newest closed bar first. Returns
// [verdict, level, level TF, age, facts, any-signal-away-from-a-level].
f_ofRead(array<FlowBar> fbs, array<float> lvP, array<string> lvT, int lastBi, int so) =>
    string _vd = ""
    float _vl = na
    string _vt = ""
    int _va = na
    string _vf = ""
    string _any = ""
    int _n = array.size(fbs)
    if _n > 0
        for _j = _n - 1 to 0
            if _vd == ""
                FlowBar _b = array.get(fbs, _j)
                int _age = lastBi - _b.bi
                float _rng = math.max(_b.hi - _b.lo, syminfo.mintick)
                float _z = _rng * of_zone / 100.0
                float _tol = of_lvlAtr * (na(_b.atr) ? _rng : _b.atr)
                float _cp = (_b.cl - _b.lo) / _rng
                bool _absBot = _b.totV > 0 and _b.botV / _b.totV * 100.0 >= of_absShr and _b.botD < 0 and _cp * 100.0 >= of_pull
                bool _absTop = _b.totV > 0 and _b.topV / _b.totV * 100.0 >= of_absShr and _b.topD > 0 and (1.0 - _cp) * 100.0 >= of_pull
                bool _aggS = _b.botV > 0 and _b.botD < 0 and -_b.botD / _b.botV * 100.0 >= of_dom and _cp < 0.5
                bool _aggB = _b.topV > 0 and _b.topD > 0 and _b.topD / _b.topV * 100.0 >= of_dom and _cp > 0.5
                // trapped: aggression in the extreme, then within 2 later bars a close back
                // through the zone they traded in (and past the bar's own close)
                bool _trS = false
                bool _trB = false
                float _later = na
                if _age >= 1
                    for _k = 1 to math.min(2, _age)
                        float _c2 = close[so + _age - _k]
                        if _aggS and _c2 > _b.lo + _z and _c2 > _b.cl
                            _trS := true
                            _later := _c2
                        if _aggB and _c2 < _b.hi - _z and _c2 < _b.cl
                            _trB := true
                            _later := _c2
                bool _stB = _b.stB >= of_stackN
                bool _stS = _b.stS >= of_stackN
                bool _big = _b.medV > 0 and _b.bigV >= of_bigX * _b.medV
                bool _bigBuy = _big and _b.bigPx <= _b.lo + _rng * 0.5 and _cp >= 0.5
                bool _bigSel = _big and _b.bigPx >= _b.lo + _rng * 0.5 and _cp <= 0.5
                int _iS = f_ofLvl(lvP, _b.lo, _b.cl, _tol)
                int _iR = f_ofLvl(lvP, _b.hi, _b.cl, _tol)
                float _S = _iS >= 0 ? array.get(lvP, _iS) : na
                float _R = _iR >= 0 ? array.get(lvP, _iR) : na
                float _now = close[so]
                // the facts, with prices
                string _f = f_ofAge(_age) + ": H " + f_px(_b.hi) + " L " + f_px(_b.lo) + " C " + f_px(_b.cl)
                if _absBot or _aggS
                    _f += " · bottom " + str.tostring(of_zone, "0") + "% of the bar held " + str.tostring(_b.botV / _b.totV * 100.0, "0") + "% of its volume, Δ " + f_ofVol(_b.botD)
                if _absTop or _aggB
                    _f += " · top " + str.tostring(of_zone, "0") + "% held " + str.tostring(_b.topV / _b.totV * 100.0, "0") + "% of its volume, Δ " + f_ofVol(_b.topD)
                if _stB
                    _f += " · " + str.tostring(_b.stB) + " stacked BUY rows " + f_px(_b.stBlo) + "-" + f_px(_b.stBhi)
                if _stS
                    _f += " · " + str.tostring(_b.stS) + " stacked SELL rows " + f_px(_b.stSlo) + "-" + f_px(_b.stShi)
                if _trS or _trB
                    _f += " · then a close at " + f_px(_later) + (_trS ? " - sellers trapped" : " - buyers trapped")
                if _bigBuy or _bigSel
                    _f += " · big row at " + f_px(_b.bigPx) + " (" + str.tostring(_b.bigV / _b.medV, "0.0") + "x median, inferred large passive " + (_bigBuy ? "buyer" : "seller") + ")"
                if not na(_R) and _trB and _now < _R
                    _vd := "FAILED BREAKOUT"
                    _vl := _R
                    _vt := array.get(lvT, _iR)
                else if not na(_S) and _stS and _b.cl < _S
                    _vd := "BREAKING"
                    _vl := _S
                    _vt := array.get(lvT, _iS)
                else if not na(_R) and _stB and _b.cl > _R
                    _vd := "INITIATIVE BREAKOUT"
                    _vl := _R
                    _vt := array.get(lvT, _iR)
                else if not na(_S) and (_absBot or _trS or _bigBuy) and _b.cl > _S
                    _vd := "DEFENDED"
                    _vl := _S
                    _vt := array.get(lvT, _iS)
                else if not na(_R) and (_absTop or _bigSel) and _b.cl < _R
                    _vd := "CAPPED"
                    _vl := _R
                    _vt := array.get(lvT, _iR)
                else if not na(_S) and _stB and _b.stBlo <= _b.lo + _rng * 0.5 and _b.cl > _S
                    _vd := "RESPONSIVE BUYING"
                    _vl := _S
                    _vt := array.get(lvT, _iS)
                if _vd != ""
                    _va := _age
                    _vf := _f
                else if _any == "" and (_absBot or _absTop or _trS or _trB or _stB or _stS or _bigBuy or _bigSel)
                    _any := _f
    [_vd, _vl, _vt, _va, _vf, _any]

f_ofText(string vd, float lv, string tf, int age, bool bearDiv, bool bullDiv) =>
    string _at = f_px(lv) + " ·" + tf + " · " + f_ofAge(age)
    string _t = vd == "DEFENDED" ? "DEFENDED · support " + _at + ": sellers met a wall at the level (absorbed, trapped, or a large passive buyer inferred). Supports a long here; void on a close below " + f_px(lv) + "." : vd == "BREAKING" ? "BREAKING · support " + _at + ": aggressive sellers closed it through the level. No long here - " + f_px(lv) + " is overhead until a close back above it." : vd == "RESPONSIVE BUYING" ? "RESPONSIVE BUYING · support " + _at + ": buyers stepped in off the level (stacked buy imbalances). Confirms a bounce; void on a close below " + f_px(lv) + "." : vd == "CAPPED" ? "CAPPED · resistance " + _at + ": buying was absorbed at the level. Do not buy the breakout until a bar closes above " + f_px(lv) + " on buy imbalances - it is the first test, not the target." : vd == "FAILED BREAKOUT" ? "FAILED BREAKOUT · resistance " + _at + ": buyers who took the break are trapped back under it. No breakout entry here; re-arms on a close back above " + f_px(lv) + " with stacked buy imbalances." : vd == "INITIATIVE BREAKOUT" ? "INITIATIVE BREAKOUT · resistance " + _at + ": real buyers took the level (stacked buy imbalances, close above). Confirms the breakout; void on a close back below " + f_px(lv) + "." : ""
    if (vd == "CAPPED" or vd == "FAILED BREAKOUT") and bearDiv
        _t += " Bearish divergence agrees."
    if (vd == "DEFENDED" or vd == "RESPONSIVE BUYING") and bullDiv
        _t += " Bullish divergence agrees."
    _t + " Grades, never gates (unvalidated)."

var table s5p = table.new(f_s5pos(), 2, 26, border_width=1, frame_width=1, frame_color=C_GRID, border_color=C_GRID)

// S4's panel grammar: a numbered section band that says what the rows under it are
// FOR, then right-aligned keys against left-aligned values. Same shape so the two
// panels read as one instrument rather than two dialects.
// VERBATIM from S4 (f_softBg / C_SOFTTXT / C_BADGE_*), so a row in either panel reads
// as the same colour. S5 v1.3 first shipped with its own flat-grey styling and the two
// panels looked like two different instruments: the band was trapped in the left column
// (widening it for every row beneath) and state was carried by TEXT colour against a
// constant grey, where S4 carries it in the BACKGROUND.
C_SOFTTXT   = color.new(#10202E, 0)
C_BADGE_BG  = color.new(#0D3B66, 0)
C_BADGE_TXT = color.new(#FFFFFF, 0)
f_softBg(color c) =>
    // color.r/g/b() return FLOAT here despite the 0-255 docs wording - an explicit
    // `int _r = color.r(c)` will not compile.
    float _r = color.r(c)
    float _g = color.g(c)
    float _b = color.b(c)
    float _mx = math.max(_r, math.max(_g, _b))
    float _mn = math.min(_r, math.min(_g, _b))
    _mx - _mn < 25 ? #AEB7C2 : _b > _r and _b > _g ? #8FC1EA : _r > 200 and _g > 100 and _b < 120 ? #F0B86E : _g >= _r and _g >= _b ? #7FCFC0 : #F1A7A0

// MERGED across both columns, like S4. Unmerged, the band sat inside column 0 and set
// its width - which is what pushed every key to the right.
f_s5sec(int r, string t) =>
    table.cell(s5p, 0, r, t, text_size=f_s5size(), text_color=C_BADGE_TXT, bgcolor=C_BADGE_BG, text_halign=text.align_left)
    table.merge_cells(s5p, 0, r, 1, r)

f_s5row(int r, string k, string v, color c) =>
    // STATE LIVES IN THE BACKGROUND, not the text - same as S4. Dark text on a soft
    // tint reads at a glance across a dozen rows; coloured text on flat grey does not.
    color _bg = f_softBg(c)
    table.cell(s5p, 0, r, k, text_size=f_s5size(), text_color=C_SOFTTXT, bgcolor=_bg, text_halign=text.align_right)
    table.cell(s5p, 1, r, v, text_size=f_s5size(), text_color=C_SOFTTXT, bgcolor=_bg, text_halign=text.align_left)

if show_s5p and barstate.islast
    table.cell(s5p, 0, 0, "S5  v1.7", text_size=f_s5size(), text_color=C_BADGE_TXT, bgcolor=C_BADGE_BG, text_halign=text.align_right)
    table.cell(s5p, 1, 0, syminfo.ticker + "  ·  " + timeframe.period + "  ·  explain-surface for S4", text_size=f_s5size(), text_color=C_BADGE_TXT, bgcolor=C_BADGE_BG, text_halign=text.align_left)

    f_s5sec(1, "  I · GEOMETRY            —  What shape is this, on TradingView criteria?")
    // ---- I - GEOMETRY -------------------------------------------------------
    // Four rows, because ONE was carrying twelve shapes, a pole, a convergence test,
    // two slopes and a marginal flag at once. Every field traces to a TradingView Help
    // Centre page except the interior-close validation, which is this file own.
    string _gShape = not d_geo ? "engine off" : geom == "-" ? (array.size(g5hy) < 2 or array.size(g5ly) < 2 ? "not enough " + str.tostring(geo_piv) + "/" + str.tostring(geo_piv) + " pivots yet (" + str.tostring(array.size(g5hy)) + "H / " + str.tostring(array.size(g5ly)) + "L, need 2 each)" : (na(_gSlopeH) and geo_maxfit) ? "no pair of " + str.tostring(geo_piv) + "/" + str.tostring(geo_piv) + " pivots forms a line the price respects" : (not na(geoOvlp) and geoOvlp < geo_ovlp) ? "boundaries describe different periods - they share only " + str.tostring(geoOvlp, "0") + "% of their span (need " + str.tostring(geo_ovlp, "0") + "%), so this is not one pattern" : not _geoClean ? "an intermediate close breaches one of the lines" : "pivots older than " + str.tostring(geo_look) + " bars - stale") : geom + (_geoEdge ? "   ·   ⚖ MARGINAL" : "") + (na(geoSpanB) ? "" : "   ·   spans " + str.tostring(geoSpanB) + " bars")
    // v1.4: a withdrawn shape says WHY (apex passed / inverted) instead of falling back
    // to "not enough pivots", which was wrong - the pivots were there.
    string _gShape2 = (geom == "-" and str.length(geoNote) > 0) ? "withdrawn - " + geoNote : _gShape
    f_s5row(2, "Shape", _gShape2, geom == "-" ? C_MUTE : _geoEdge ? C_WARN : C_INFO)

    // The boundaries where they sit NOW - what price is actually trading against.
    string _gB = (na(geoUpNow) or na(geoLoNow)) ? "-" : "upper " + f_px(geoUpNow) + f_dist(geoUpNow) + "   ·   lower " + f_px(geoLoNow) + f_dist(geoLoNow) + "   ·   width " + str.tostring((geoUpNow - geoLoNow) / chart_atr, "0.0") + "x ATR" + (na(geoApexPc) ? "" : "   ·   " + str.tostring(geoApexPc, "0") + "% to apex" + (geoApexPc > 75.0 ? " (late - TV wants the break before ~75%)" : "")) + (na(geoOvlp) ? "" : "   ·   spans upper " + str.tostring(bar_index - nz(geoUpFr, bar_index)) + "-" + str.tostring(bar_index - nz(geoUpTo, bar_index)) + "b ago / lower " + str.tostring(bar_index - nz(geoLoFr, bar_index)) + "-" + str.tostring(bar_index - nz(geoLoTo, bar_index)) + "b ago, " + str.tostring(geoOvlp, "0") + "% shared")
    f_s5row(3, "Boundaries", _gB, C_MUTE)

    // The two tests that DECIDE which shape it is, shown so the call can be audited
    // rather than trusted: TV Channel Width Ratio, and the flagpole / Max Rollback pair.
    // A negative narrowing is a WIDENING, and "narrowing -54%" makes the reader do the
    // double negative. Say which it is.
    string _gT = na(geoConvPc) ? "-" : (geoConvPc >= 0 ? "narrowing " + str.tostring(geoConvPc, "0") + "%  (wedge past " + str.tostring(geo_conv, "0") + "%)" : "WIDENING " + str.tostring(-geoConvPc, "0") + "%  (so not a wedge - it is broadening)") + (na(geoPoleA) ? "" : "   ·   pole " + str.tostring(geoPoleA, "0.0") + "x ATR" + (math.abs(nz(geoPoleA, 0.0)) >= flag_pole ? "" : " - under the " + str.tostring(flag_pole, "0.0") + "x floor, so no flag")) + (na(geoRollPc) ? "" : "   ·   rollback " + str.tostring(geoRollPc, "0") + "%  (max " + str.tostring(flag_roll, "0") + "%)")
    f_s5row(4, "Convergence · pole", _gT, C_MUTE)

    // TV state machine, and the target it documents for every pattern. Before a break it
    // shows BOTH directions, which is what TV plots as two provisional dotted lines.
    bool   _gUp   = not na(geoUpNow) and close > geoUpNow
    bool   _gDn   = not na(geoLoNow) and close < geoLoNow
    string _gStat = geom == "-" ? "-" : _gUp ? "BROKEN UP   ·   target " + f_px(close + nz(geoHeight, 0.0)) + "  (close + base height)" : _gDn ? "BROKEN DOWN   ·   target " + f_px(close - nz(geoHeight, 0.0)) + "  (close - base height)" : "AWAITING - price inside the boundaries" + (na(geoHeight) ? "" : "   ·   base height " + str.tostring(geoHeight / chart_atr, "0.0") + "x ATR, projecting " + f_px(close + geoHeight) + " up / " + f_px(close - geoHeight) + " down")
    f_s5row(5, "Status · target", _gStat, geom == "-" ? C_MUTE : _gUp ? C_OK : _gDn ? C_NO : C_WARN)

    f_s5sec(6, "  II · LEVELS             —  The horizontal and diagonal levels around price.")
    // NEAREST S/R each side, across D/W/M, with the touch grade. These four lines were
    // collateral damage in the 8-Sep panel rebuild: they sat between the old Geometry row
    // and the Resistance row, so the slice that replaced the former removed them too.
    [_aLvl, _aTf] = f_pick(_cA1, _dA1, _wA1, _mA1, true)
    [_bLvl, _bTf] = f_pick(_cB1, _dB1, _wB1, _mB1, false)
    int _aT = _aTf == "D" ? _dA1t : _aTf == "W" ? _wA1t : _aTf == "M" ? _mA1t : _aTf == tfC ? _cA1t : na
    int _bT = _bTf == "D" ? _dB1t : _bTf == "W" ? _wB1t : _bTf == "M" ? _mB1t : _bTf == tfC ? _cB1t : na
    f_s5row(7, "Resistance", not d_sr ? "engine off" : na(_aLvl) ? "none within reach" : f_px(_aLvl) + " ·" + _aTf + f_grade(_aT) + f_dist(_aLvl), na(_aLvl) ? C_MUTE : C_NO)
    f_s5row(8, "Support",    not d_sr ? "engine off" : na(_bLvl) ? "none within reach - the stop has no level under it" : f_px(_bLvl) + " ·" + _bTf + f_grade(_bT) + f_dist(_bLvl), na(_bLvl) ? C_WARN : C_OK)

    // 4. TRENDLINES — the diagonal pair, which the horizontal levels above cannot see
    f_s5row(9, "Trendlines", not d_tl ? "engine off" : (na(tls_now) and na(tlr_now)) ? "none fitted" : "support " + f_px(tls_now) + f_dist(tls_now) + "   ·   resistance " + f_px(tlr_now) + f_dist(tlr_now), (na(tls_now) and na(tlr_now)) ? C_MUTE : C_INFO)

    // 5. PIVOT FUNNEL — the diagnostic S4 gave up. A missing level is now self-explaining:
    //    no pivots is a different failure from pivots that clustered into nothing.
    f_s5sec(19, "  V · DIAGNOSTICS       —  If something above is missing, this says why.")
    f_s5row(20, "Pivot pools", "200-DMA " + (na(sma200D) ? "na" : str.tostring(sma200D, format.mintick)) + "   ·   chart len " + str.tostring(pv_chart) + "   ·   geometry " + str.tostring(geo_piv) + "/" + str.tostring(geo_piv) + " " + str.tostring(array.size(g5hy)) + "H / " + str.tostring(array.size(g5ly)) + "L   ·   zones " + str.tostring(array.size(gphy)) + "H / " + str.tostring(array.size(gply)) + "L   ·   trendline " + str.tostring(array.size(tlhy)) + "H / " + str.tostring(array.size(tlly)) + "L", (array.size(gphy) >= 2 and array.size(gply) >= 2) ? C_MUTE : C_WARN)

    // 6. LEVEL FUNNEL — per timeframe, whether the clusterer produced anything at all
    string _fn = ""
    _fn := _fn + "D " + (not _okD ? "-" : (na(_dA1) ? "0" : "1") + "/" + (na(_dB1) ? "0" : "1"))
    _fn := _fn + "   W " + (not _okW ? "-" : (na(_wA1) ? "0" : "1") + "/" + (na(_wB1) ? "0" : "1"))
    _fn := _fn + "   M " + (not _okM ? "-" : (na(_mA1) ? "0" : "1") + "/" + (na(_mB1) ? "0" : "1"))
    if isIntra
        _fn := _fn + "   " + tfC + " " + (not _okC ? "-" : (na(_cA1) ? "0" : "1") + "/" + (na(_cB1) ? "0" : "1"))
    // Per-TF build counts (22-Oct-2026): pivots in the pool, band width, candidate bands with
    // enough pivots (q), bands picked (b) and how many of those are distinct (u). b must equal
    // u - this row is what exposed the re-picking bug (b16 against 8 real bands).
    string _dg = "   ·   build D " + (_okD ? chD.dbg : "-") + " | W " + (_okW ? chW.dbg : "-") + " | M " + (_okM ? chM.dbg : "-") + (isIntra ? " | " + tfC + " " + (_okC ? chC.dbg : "-") : "")
    f_s5row(21, "Level funnel", _fn + "   (above/below per TF)" + _dg, C_MUTE)

    // 8. FOOTPRINT — the order-flow read S4 has no access to at all
    string _fpTxt = not show_fp ? "engine off" : not fpKnown ? "n/a - the feed has no footprint for this bar (ordinary on older history; NOT a delta of zero)" : (fpDelta >= 0 ? "+" : "") + str.tostring(fpDelta, format.volume) + (fpDelta > 0 ? " buyers" : fpDelta < 0 ? " sellers" : " flat") + "   ·   cum " + str.tostring(fpCumWin) + "b " + (nz(fpCum) >= 0 ? "+" : "") + str.tostring(fpCum, format.volume) + "   ·   " + str.tostring(fpBuy, format.volume) + " vs " + str.tostring(fpSell, format.volume)
    f_s5sec(10, "  III · PARTICIPATION     —  Who is actually trading it, and are they confirming price?")
    f_s5row(11, "Order flow", _fpTxt, not fpKnown ? C_MUTE : fpDelta > 0 ? C_OK : fpDelta < 0 ? C_NO : C_MUTE)

    // 9. the two things the footprint says that nothing else can
    string _fpDv = not fpKnown ? "-" : fpBearDiv ? "BEARISH - new " + str.tostring(fpDivWin) + "b high on WEAKER flow (absorption into strength)" : fpBullDiv ? "BULLISH - new " + str.tostring(fpDivWin) + "b low on STRONGER flow" : (nz(fpCum, 0.0) > 0 and close > close[fpDivWin]) or (nz(fpCum, 0.0) < 0 and close < close[fpDivWin]) ? "none - price and flow point the same way" : "no divergence AT AN EXTREME - but flow and price are pointing opposite ways; this test only fires on a new " + str.tostring(fpDivWin) + "b high or low"
    f_s5row(12, "Divergence · VA", _fpDv + (na(fpPoc) ? "" : "   ·   this bar's footprint: POC " + f_px(fpPoc) + "  VAH " + f_px(fpVah) + "  VAL " + f_px(fpVal) + " (the profile of record is S4's)") + ((fpImbBuy == 0 and fpImbSell == 0) ? "" : "   ·   imb " + str.tostring(fpImbBuy) + "B/" + str.tostring(fpImbSell) + "S"), fpBearDiv ? C_NO : fpBullDiv ? C_OK : C_MUTE)

    // 9b. ORDER FLOW AT THE LEVEL (12-Oct-2026) - what the footprint MEANS at S/R
    array<float> _ofP = array.new<float>()
    array<string> _ofT = array.new<string>()
    f_ofPush(_ofP, _ofT, _dA1, "D")
    f_ofPush(_ofP, _ofT, _dA2, "D")
    f_ofPush(_ofP, _ofT, _dB1, "D")
    f_ofPush(_ofP, _ofT, _dB2, "D")
    f_ofPush(_ofP, _ofT, _wA1, "W")
    f_ofPush(_ofP, _ofT, _wA2, "W")
    f_ofPush(_ofP, _ofT, _wB1, "W")
    f_ofPush(_ofP, _ofT, _wB2, "W")
    f_ofPush(_ofP, _ofT, _mA1, "M")
    f_ofPush(_ofP, _ofT, _mA2, "M")
    f_ofPush(_ofP, _ofT, _mB1, "M")
    f_ofPush(_ofP, _ofT, _mB2, "M")
    f_ofPush(_ofP, _ofT, _cA1, tfC)
    f_ofPush(_ofP, _ofT, _cA2, tfC)
    f_ofPush(_ofP, _ofT, _cB1, tfC)
    f_ofPush(_ofP, _ofT, _cB2, tfC)
    int _ofSo = _ofClosed ? 0 : 1
    [_ofV, _ofL, _ofTf, _ofAg, _ofF, _ofAny] = f_ofRead(ofBars, _ofP, _ofT, bar_index - _ofSo, _ofSo)
    int _ofNs = array.size(ofBars)
    int _ofRowsLast = _ofNs > 0 ? array.get(ofBars, _ofNs - 1).nRows : 0
    string _ofCoarse = _ofNs > 0 and _ofRowsLast < of_minRows ? "ROWS TOO COARSE (" + str.tostring(_ofRowsLast) + " rows on the last bar) - set 'Ticks per volume row' to about " + str.tostring(math.max(1, math.round(chart_atr / 10.0 / syminfo.mintick))) + ". " : ""
    string _ofFacts = not show_fp or not of_on ? "engine off" : _ofNs == 0 ? "no footprint on the last closed bars" : _ofV != "" ? _ofF : _ofAny != "" ? _ofAny : "no absorption, trap, stacked imbalance or big row on the last 3 closed bars"
    string _ofRd = not show_fp or not of_on ? "engine off" : _ofNs == 0 ? "n/a - no footprint for the last closed bars" : _ofV != "" ? f_ofText(_ofV, _ofL, _ofTf, _ofAg, fpBearDiv, fpBullDiv) : _ofAny != "" ? "NO LEVEL · an order-flow event away from any S/R level - low information." : "none · no order-flow event at a level in the last 3 closed bars."
    color _ofC = _ofV == "DEFENDED" or _ofV == "RESPONSIVE BUYING" or _ofV == "INITIATIVE BREAKOUT" ? C_OK : _ofV == "BREAKING" or _ofV == "FAILED BREAKOUT" ? C_NO : _ofV == "CAPPED" ? C_WARN : C_MUTE
    f_s5row(13, "At the level", _ofFacts, _ofV != "" ? C_INFO : C_MUTE)
    f_s5row(14, "ORDER-FLOW READ", _ofCoarse + _ofRd, _ofCoarse != "" ? C_WARN : _ofC)

    // 10. WYCKOFF — named, never gating (see the note on the detection block)
    f_s5sec(15, "  IV · SETUPS           —  Is there a structure here? Named only; nothing here gates.")
    f_s5row(16, "Wyckoff", not show_wy ? "engine off" : str.length(wyTxt) == 0 ? "no distribution event on this bar" : str.trim(wyTxt) + "   —   named, not gated: tested null as both veto and score", str.length(wyTxt) == 0 ? C_MUTE : C_WARN)

    // 7. READ — one synthesis line. Says what the SHAPE implies for the trade S4 is
    //    judging, and never restates a number printed above it.
    string _read = geom == "Range / rectangle" ? "A range. Both edges are levels, so the edges are the trade and the middle is noise - S4's room-to-obstacle will be small by construction here." : geom == "Ascending triangle" ? "Higher lows into a flat ceiling. Continuation shape: the base is doing the work, and the break is the event." : geom == "Descending triangle" ? "Lower highs into a flat floor. The mirror, and against a long - the floor is being tested more often than it is being defended." : geom == "Symmetrical triangle" ? "Both edges converging. Genuinely directionless until one breaks; anyone calling it now is guessing." : geom == "Bullish flag" ? "A bull flag: a strong up-move, then a shallow parallel drift against it. The most reliable continuation shape on the board - the correction is orderly and the pole is what pays. Target is the pole projected from the break of the upper rail." : geom == "Bearish flag" ? "A bear flag - the mirror, and against a long. The drift up is the correction, not the turn." : geom == "Bullish pennant" ? "A bull pennant: the same pole as a flag, but the correction COILS instead of drifting. Tighter, usually shorter, and it resolves in the direction of the pole." : geom == "Bearish pennant" ? "A bear pennant. Coiling after a down pole, and it resolves down more often than the coil suggests." : geom == "Rising wedge" ? "Rising, but NARROWING. A rising wedge resolves DOWN more often than its slope suggests - buyers are paying up for less and less range. The least attractive shape to buy into strength." : geom == "Rising channel" ? "Rising with parallel edges. A channel trades its EDGES: the lower rail is the entry and the upper rail is the exit, and buying the middle is paying for room you do not get." : geom == "Falling wedge" ? "Falling but narrowing - sellers are getting less range for their effort. The one converging shape that resolves UP more often, though it needs the upper edge to break before it means anything." : geom == "Falling channel" ? "Falling on parallel edges. Against a long until the upper rail gives way; the lower rail is where it bounces, not where it turns." : str.startswith(geom, "Broadening") ? "Broadening. Volatility expanding rather than coiling - the opposite of the compression a breakout entry wants, and stops placed inside it get hit." : "No shape yet. Nothing here argues for or against the trade; read the levels instead."
    // 10. SWP-RC — the structure and its arithmetic, never a plan
    string _s3 = not show_s3 ? "engine off" : na(s3_lvl) ? "no daily level below price yet" : not na(s3_since) and s3_since <= s3_reclaim_n ? ("swept " + f_px(s3_lvl) + " to " + f_px(s3_swpLo) + " (" + str.tostring((s3_lvl - s3_swpLo) / chart_atr, "0.0") + "x ATR), " + str.tostring(s3_since) + "b ago" + (s3_recl ? "  ·  RECLAIMED" : "  ·  not reclaimed") + (na(s3_rr) ? "" : "  ·  room " + str.tostring(s3_rr, "0.0") + "R") + (s3_fire ? "  ·  STRUCTURE COMPLETE" : not s3_recl ? "" : not s3_hasTgt ? "  ·  no ceiling found - nothing to target, so no trade thesis (not a near ceiling)" : "  ·  no trade: ceiling too close to pay") + (not s3_recl ? "" : not s3_ctxKnown ? "  ·  200-DMA unresolved, check context on S4" : s3_ctx ? "  ·  above the 200-DMA" : "  ·  NOTE: below the 200-DMA")) : "no sweep in the last " + str.tostring(s3_reclaim_n) + " bars"
    f_s5row(17, "SWP-RC", _s3, s3_fire ? C_OK : s3_recl ? C_WARN : C_MUTE)

    // 11. RNG-EDGE — location inside the range, and whether the edge pays
    string _s6 = not show_s6 ? "engine off" : geom != "Range / rectangle" ? "not a range - no edge to trade" : na(s6_rng) ? "range edges unresolved" : "range " + f_px(geoBot) + " to " + f_px(geoTop) + " (" + str.tostring(s6_rng / chart_atr, "0.1") + "x ATR)" + (s6_at ? "  ·  AT THE LOWER EDGE" : "  ·  mid-range, no trade here") + (not s6_at ? "" : (s6_rev ? "  ·  reversal bar" : "  ·  no reversal bar yet")) + (na(s6_rr) ? "" : "  ·  " + str.tostring(s6_rr, "0.0") + "R to the ceiling") + (s6_fire ? "  ·  ALL CONDITIONS MET" : (s6_at and s6_rev and nz(s6_rr, 0.0) < s6_min_rr) ? "  ·  blocked: ceiling too close to pay" : "")
    f_s5row(18, "RNG-EDGE", _s6, s6_fire ? C_OK : s6_at ? C_WARN : C_MUTE)

    f_s5sec(22, "  VI · READ               —  One line. What the structure implies for the trade S4 is judging.")
    f_s5row(23, "READ", _read, C_MUTE)
