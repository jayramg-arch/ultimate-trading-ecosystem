// <DB_LOOKUP_END>

// Tier 1 → Tier 2 hybrid resolution
f_get_hybrid_sector() =>
    string t = ""
    string n = ""
    // 1. DB Lookup first (highest accuracy — full Nifty 500 coverage)
    string __clean_t = str.replace_all(str.upper(str.trim(syminfo.ticker)), "NSE:", "")
    __clean_t := str.replace_all(__clean_t, "BSE:", "")
    string dbSec = f_db_sector_lookup(__clean_t)
    if dbSec != ""
        t := dbSec
        n := str.replace_all(dbSec, "NSE:", "")
    // 2. Fall back to keyword auto-mapper (off-list tickers)
    if t == ""
        [at, an] = f_get_sector_ticker()
        t := at
        n := an
    [t, n]

[autoSecTick, autoSecName] = f_get_hybrid_sector()
string secTick = useManual ? manualSec : autoSecTick
string secName = useManual ? str.replace_all(manualSec, "NSE:", "") : autoSecName

// Sector RS is meaningless when the "sector" resolves to the index itself
bool secIsIndex = str.replace_all(secTick, "NSE:", "") == str.replace_all(idxTick, "NSE:", "")

// ==========================================
// 3. MANSFIELD RS CALCULATION (SMOOTH CONTINUOUS & WEEKLY-TIED)
// ==========================================
// Calculate equivalent bars per week for sub-weekly timeframes to eliminate stair-stepping:
// 1 week = 5 trading days = 1,875 trading minutes (NSE India).
f_get_bars_per_week() =>
    if timeframe.isweekly
        1.0
    else if timeframe.ismonthly
        0.230769
    else if timeframe.isdaily
        5.0
    else
        float minsPerBar = timeframe.multiplier
        if timeframe.isseconds
            minsPerBar := timeframe.multiplier / 60.0
        1875.0 / math.max(1.0, minsPerBar)

float barsPerW = f_get_bars_per_week()
int calcMaLen = math.max(1, math.round(lenWeek * barsPerW))

// Continuous smooth Mansfield calculation on current chart resolution
f_mansfield_smooth(float benchClose, int length, string ma_type) =>
    float rp     = (na(benchClose) or benchClose == 0) ? na : close / benchClose
    float emaVal = ta.ema(rp, length)
    float smaVal = ta.sma(rp, length)
    float rpMa   = ma_type == "EMA" ? emaVal : smaVal
    (na(rp) or na(rpMa) or rpMa == 0) ? na : (rp / rpMa - 1) * 100

// Weekly stair-stepped Mansfield calculation (for request.security option)
f_calc_mrs_weekly(int length, string ma_type) =>
    float rp     = close
    float emaVal = ta.ema(rp, length)
    float smaVal = ta.sma(rp, length)
    float rpMa   = ma_type == "EMA" ? emaVal : smaVal
    (na(rp) or na(rpMa) or rpMa == 0) ? na : (rp / rpMa - 1) * 100

var string cleanTicker = (syminfo.prefix != "" ? syminfo.prefix + ":" : "") + syminfo.ticker
string reqIdx = cleanTicker + " / " + idxTick
string reqSec = cleanTicker + " / " + secTick

// Fetch closes for smooth calculation
float idxCloseNative = request.security(idxTick, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
float secCloseNative = request.security(secTick, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)

// Smooth continuous values vs Stair-stepped weekly values
float mrsIdxSmooth    = f_mansfield_smooth(idxCloseNative, calcMaLen, maType)
float mrsSecRawSmooth = f_mansfield_smooth(secCloseNative, calcMaLen, maType)

float mrsIdxStep      = request.security(reqIdx, "W", f_calc_mrs_weekly(lenWeek, maType), barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
float mrsSecRawStep   = request.security(reqSec, "W", f_calc_mrs_weekly(lenWeek, maType), barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)

float mrsIdx    = smoothIntraday or timeframe.isweekly ? mrsIdxSmooth : mrsIdxStep
float mrsSecRaw = smoothIntraday or timeframe.isweekly ? mrsSecRawSmooth : mrsSecRawStep
float mrsSec    = showSector and not secIsIndex ? mrsSecRaw : na

// ==========================================
// 4. BACKGROUND (RS sign) + CANONICAL RRG QUADRANT (label only)
// ==========================================
// Background = sign of the plotted Index RS line (green above zero / red below)
// — drift-free and self-consistent (it can only ever match the blue line).
//
// STAGE IS DELIBERATELY NOT COMPUTED HERE. The lightweight weekly stage read
// (f_sec_stage_lite) is a COARSE approximation (raw slope > 0, no threshold, no
// state machine) and drifts from the CANONICAL stage — v67's f_getStageAndTime
// / Python compute_weekly_stage_and_wks use a slope threshold (0.0012) + a
// stateful transition machine + strict-trend overrides. e.g. a stock whose
// 30-WMA is barely positive reads STAGE 2 here but STAGE 1 on the dashboard.
// Stage lives authoritatively on Dashboard v67 + Unified Ecosystem; duplicating
// a drifting copy on this pane only causes confusion. Removed in v1.5.
//
// The RRG quadrant below feeds ONLY the last-bar label text (v67 parity read).
//
// f_calc_rs_logic is a VERBATIM port from Dashboard v67.4.12 (do-not-touch
// RRG rule: copy exactly, never re-derive). Called on the weekly SYM/INDEX
// spread — identical inputs (jdkLen=12, trail=4) → identical quadrant to the
// dashboard's RRG cell on every bar.

// v67.4.2: Strike.Money-matched JdK formula (replaces 2-pass StockCharts default).
// Strike uses single-pass normalization with final 5-bar smoothing — NOT
// the textbook double-pass. Returns CENTERED values (RS_Ratio - 100,
// RS_Momentum - 100) so legacy >0 thresholds keep their meaning.
f_calc_rs_logic(int rsl, int rslLevel, int slopeLen, int jdkLen, int trailLen) =>
    // Called via request.security("STOCK / BENCH", ...) → close IS the ratio.
    rs           = close
    // ---- RRG STUDIO PARITY (strike_cal), ported 18-Aug-2026 ------------------
    // Identical maths to rrg_studio/rrg_engine.py + root rrg_engine.py + v67 +
    // Risk Allocator v2.2. STRIKE_CAL: 25/10/7, ratio_a 0.796, mom_a 3.498 (refit
    // d0f177f, validated out-of-sample aeb0b55). Axes are DECOUPLED so jdkLen is
    // ignored here on purpose. The affine map is origin-preserving:
    // y = 100 + a*(x-100) - the intercept is DERIVED, never fitted, or the origin
    // shifts and an index plots against itself off (100,100). Do NOT add a b term.
    // OLD (pre-parity), retained:
    // rs_sma       = ta.sma(rs, jdkLen)
    // rs_ratio_raw = 100.0 + ((rs - rs_sma) / rs_sma) * 100.0
    // rs_ratio     = ta.sma(rs_ratio_raw, 5)                 // 5-bar smooth — Strike-match
    // // RS-Momentum = SMA(length) of ROC of smoothed RS-Ratio
    // rm1          = 100.0 * (rs_ratio / rs_ratio[1])
    // rs_mom       = ta.sma(rm1, jdkLen)
    int   _calRatLen = 25
    int   _calRatSm  = 10
    int   _calMomLen = 7
    float _calRatA   = 0.796
    float _calMomA   = 3.498
    _calMa       = ta.sma(rs, _calRatLen)
    rs_ratio_raw = 100.0 + ((rs - _calMa) / _calMa) * 100.0
    _calRat      = ta.sma(rs_ratio_raw, _calRatSm)
    _calMom      = ta.sma(100.0 * (_calRat / nz(_calRat[1], _calRat)), _calMomLen)
    rs_ratio     = 100.0 + _calRatA * (_calRat - 100.0)
    rs_mom       = 100.0 + _calMomA * (_calMom - 100.0)

    // Centered (-100) so legacy >0 thresholds keep their meaning
    float val      = rs_ratio - 100.0
    float mom_c    = rs_mom   - 100.0

    // Legacy slope arrow: change in RS_Ratio over slopeLen bars
    float slope = val - nz(val[slopeLen], val)
    float pastSlope = slope[5]

    // RRG trajectory tail: where were we trailLen bars ago?
    float val_trail = nz(val[trailLen],   val)
    float mom_trail = nz(mom_c[trailLen], mom_c)

    // Warm-up: JdK needs ~3×length + buffer for stable values
    int warmup = math.max(jdkLen * 3 + 10, 60)
    bool _warmed = bar_index >= warmup and not na(rs) and rs > 0
    float val_g       = _warmed ? val       : na
    float slope_g     = _warmed ? slope     : na
    float mom_g       = _warmed ? mom_c     : na
    float val_trail_g = _warmed ? val_trail : na
    float mom_trail_g = _warmed ? mom_trail : na

    [slope_g, val_g, pastSlope, mom_g, val_trail_g, mom_trail_g]

// Verbatim from v67.4.12 — quadrant on centered JdK values.
f_rrg_quad(float v, float m) =>
    v >= 0 and m >= 0 ? "Leading" : v >= 0 ? "Weakening" : m >= 0 ? "Improving" : "Lagging"

// Weekly JdK vs Index — same call shape as v67's req500 line
// (rsLength=26, rsLevelLen=52, rsSlopeLen=8 legacy defaults).
[_slopeIdx, valIdx, _pastSlopeIdx, momIdx, _valTrailIdx, _momTrailIdx] = request.security(reqIdx, "W", f_calc_rs_logic(26, 52, 8, jdkLength, rrgTrailLen), barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)

string rrgQuad = na(valIdx) or na(momIdx) ? "" : f_rrg_quad(valIdx, momIdx)

// RS-sign tint: mirrors the plotted Index RS line (green >0 / red <0).
color bgCol = na
if bgOn and not na(mrsIdx)
    bgCol := color.new(mrsIdx > 0 ? colRSpos : colRSneg, 88)
bgcolor(bgCol, title="RS-sign background")

// ==========================================
// 5. PLOTS
// ==========================================
hline(0, "Zero", color=color.new(color.gray, 40), linestyle=hline.style_dotted)

pIdx = plot(mrsIdx, title="Index RS (Nifty 500)", color=colIdx, linewidth=2)
pSec = plot(mrsSec, title="Sector RS (auto)", color=colSec, linewidth=2)
pZero = plot(0, title="Zero (fill anchor)", color=color.new(color.gray, 100), display=display.none, editable=false)

fill(pIdx, pZero, color=color.new(colIdx, mrsIdx >= 0 ? 85 : 92), title="Index RS fill")

// ==========================================
// 6. DETECTED-SECTOR LABEL (last bar)
// ==========================================
var label secLbl = na
if showLabel and barstate.islast
    string src = useManual ? "manual" : (f_db_sector_lookup(str.replace_all(str.upper(str.trim(syminfo.ticker)), "NSE:", "")) != "" ? "DB" : "keyword")
    string txt = secIsIndex or na(mrsSec) ? "Sector: " + secName + " (" + src + ") — not plotted" : "Sector: " + secName + " (" + src + ")"
    if rrgQuad != ""
        txt := "RRG: " + str.upper(rrgQuad) + " · " + txt
    if na(secLbl)
        secLbl := label.new(bar_index, 0, txt, style=label.style_label_left, color=color.new(colSec, 80), textcolor=colSec, size=size.small)
    label.set_xy(secLbl, bar_index + 2, na(mrsSec) ? (na(mrsIdx) ? 0 : mrsIdx) : mrsSec)
    label.set_text(secLbl, txt)

// ==========================================
// 7. RSI + ATR READOUT  (17-Aug-2026, Jay: "can I superimpose RSI and ATR on the
//    MRS auto indicator? I do not want to load 2 more indicators on the screen")
//
// DELIBERATELY NOT PLOTTED. Mansfield RS oscillates around 0, RSI is bounded
// 0-100, and ATR is in rupees — three incompatible scales. Plotting them on this
// pane would either flatten the RS line against a 0-100 axis or require rescaling
// RSI/ATR into RS units, after which the y-axis means nothing for any of the
// three and every value read off it is wrong. A numeric cell has no scale to
// conflict with, and a number is what you actually read these two for.
//
// ATR is shown as a PERCENT of price, not rupees: ATR 15 says nothing until you
// know the price, and % is what the trade-type ladder and the stop policy use.
// The RSI cell is tinted by zone, so the overbought/oversold read is still a
// glance rather than a comparison.
// ==========================================
grpRA      = "RSI / ATR readout"
showRA     = input.bool(true,  "Show RSI + ATR cell",          group=grpRA)
raRsiLen   = input.int(14,     "RSI length",  minval=2,        group=grpRA)
raAtrLen   = input.int(14,     "ATR length",  minval=2,        group=grpRA)
raOB       = input.int(70,     "RSI overbought",               group=grpRA)
raOS       = input.int(30,     "RSI oversold",                 group=grpRA)
raPos      = input.string("Top Right", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpRA)

float raRsi    = ta.rsi(close, raRsiLen)
float raAtr    = ta.atr(raAtrLen)
float raAtrPct = close > 0 ? raAtr / close * 100.0 : na

if showRA and barstate.islast
    var table raTbl = na
    raTblPos = raPos == "Top Right" ? position.top_right : raPos == "Top Left" ? position.top_left : raPos == "Bottom Right" ? position.bottom_right : position.bottom_left
    if na(raTbl)
        raTbl := table.new(raTblPos, 2, 2, border_width=1, border_color=color.new(color.gray, 70), frame_width=1, frame_color=color.new(color.gray, 60))
    color raRsiCol = na(raRsi) ? color.gray : raRsi >= raOB ? #EF5350 : raRsi <= raOS ? #26A69A : #B0BEC5
    table.cell(raTbl, 0, 0, "RSI " + str.tostring(raRsiLen), text_color=color.new(color.gray, 20), text_size=size.tiny, bgcolor=color.new(color.black, 80))
    table.cell(raTbl, 1, 0, na(raRsi) ? "—" : str.tostring(raRsi, "0.0"), text_color=raRsiCol, text_size=size.small, bgcolor=color.new(color.black, 80))
    table.cell(raTbl, 0, 1, "ATR " + str.tostring(raAtrLen) + " %", text_color=color.new(color.gray, 20), text_size=size.tiny, bgcolor=color.new(color.black, 80))
    table.cell(raTbl, 1, 1, na(raAtrPct) ? "—" : str.tostring(raAtrPct, "0.00") + "%", text_color=#B0BEC5, text_size=size.small, bgcolor=color.new(color.black, 80))
