// ============================================================================
// MANSFIELD RELATIVE STRENGTH — AUTO SECTOR v1.5
// ============================================================================
// Drop-in replacement for the community "Mansfield Relative Strength indicator"
// with ONE upgrade: the Sector benchmark is AUTO-DETECTED per symbol using the
// same hybrid stock→sector mapping as "Weinstein and Swing Pro Dashboard v67":
//
//   1. DB lookup (auto-generated from sectors.db by sector_manager.py —
//      full Nifty 500 coverage). Refresh with:
//         python sector_manager.py export-pine "Mansfield_RS_AutoSector_v1.5.pine"
//   2. Keyword fallback on syminfo.sector / syminfo.industry (off-list tickers).
//   3. Manual override input (checkbox) if you ever want to force a sector.
//
// Plots (separate pane):
//   • Index RS  — Mansfield RS vs Nifty 500 (always on)
//   • Sector RS — Mansfield RS vs the auto-detected sector index
//   • Zero line + fills; last-bar label names the detected sector.
//
// Mansfield formula (identical to the original indicator):
//   RP  = close / benchmark_close
//   MRS = (RP / MA(RP, len) - 1) * 100
// MA length auto-selects by chart timeframe: Daily 200 · Weekly 26 ·
// Monthly 10 · all other 52 (same defaults as the original inputs).
//
// v1.1 — RS regime background (level × slope proxy). SUPERSEDED.
// v1.2 — canonical JdK RRG quadrant background (v67-verbatim). SUPERSEDED as
//        paint: weekly-JdK stripes diverged visually from the daily lines and
//        read as confusing, even though the quadrant matched the v67 RRG cell.
// v1.3 — simple RS-sign background. SUPERSEDED.
// v1.4 — Stage × RS confluence background. SUPERSEDED (see v1.5).
// v1.5 — STAGE REMOVED. The lightweight stage read (f_sec_stage_lite) is a
//   COARSE approximation and drifted from the CANONICAL stage (v67's
//   f_getStageAndTime / Python compute_weekly_stage_and_wks use a 0.0012 slope
//   threshold + stateful transition machine + strict-trend overrides). A stock
//   with a barely-positive 30-WMA read STAGE 2 here but STAGE 1 on the
//   dashboard/Golden Matcher — confusing. Stage lives authoritatively on
//   Dashboard v67 + Unified Ecosystem, so it is no longer computed or shown
//   here. This pane now focuses on what it does canonically:
//   • Background = simple RS-sign (🟢 Index RS > 0 · 🔴 Index RS < 0).
//   • Last-bar label = "RRG: LEADING · Sector: CNXPHARMA (DB)" — the canonical
//     JdK RRG quadrant (v67-parity) + auto-detected sector. No stage.
// ============================================================================
//@version=6
indicator("Mansfield RS — Auto Sector v1.6", shorttitle="MRS Auto", overlay=false)

// ==========================================
// 1. INPUTS
// ==========================================
grpBench = "Benchmarks"
idxTick    = input.symbol("NSE:CNX500", title="Index", group=grpBench)
useManual  = input.bool(false, title="[Enable] Manual Sector Override", group=grpBench, tooltip="If checked, the symbol below is used as the sector benchmark. If unchecked, the sector is auto-detected from the internal DB / keyword mapper.")
manualSec  = input.symbol("NSE:CNX500", title="Manual Sector", group=grpBench)
showSector = input.bool(true, title="Plot Sector RS", group=grpBench)

grpMA = "Moving Average"
maType         = input.string("SMA", title="Which moving average to use?", options=["SMA", "EMA"], group=grpMA)
lenWeek        = input.int(26, title="Weekly MA Length", minval=1, group=grpMA, tooltip="Moving average length applied on Weekly bars (default 26 weeks for Stan Weinstein Stage Analysis).")
smoothIntraday = input.bool(true, title="Smooth Sub-Weekly Curves (No Stair-Stepping)", group=grpMA, tooltip="When checked, converts the 26-week horizon into continuous rolling bars on Daily & Intraday charts (Daily = 130 bars, 75m = 650 bars), producing fluid, non-stair-stepped curves.")

grpDisp = "Display"
showLabel = input.bool(true, title="Show detected-sector label", group=grpDisp)
colIdx    = input.color(#2962ff, title="Index RS", group=grpDisp, inline="c")
colSec    = input.color(#ff9800, title="Sector RS", group=grpDisp, inline="c")

grpBg = "Background — RS sign"
bgOn      = input.bool(true, title="RS-sign background", group=grpBg, tooltip="Simple, drift-free tint that mirrors the plotted Index RS line:\n🟢 Index RS > 0 = outperforming Nifty 500\n🔴 Index RS < 0 = underperforming\nStage lives on Dashboard v67 / Unified Ecosystem — deliberately NOT duplicated here.")
colRSpos  = input.color(#26a69a, title="RS > 0", group=grpBg, inline="bg1")
colRSneg  = input.color(#ef5350, title="RS < 0", group=grpBg, inline="bg1")

grpRRG = "RRG label (canonical JdK, weekly — v67 parity)"
jdkLength   = input.int(12, title="JdK RRG Length", minval=2, group=grpRRG, tooltip="Normalization length for JdK RS-Ratio / RS-Momentum. Default 12 = v67 / Unified Ecosystem (Strike-matched 1-pass + 5-bar smooth). Keep in sync with the dashboard.")
rrgTrailLen = input.int(4, title="RRG Trajectory Tail (Weeks)", minval=1, group=grpRRG)

// ==========================================
// 2. AUTO SECTOR MAPPER (mirrors Dashboard v67 hybrid lookup)
// ==========================================

// Tier 2 fallback — keyword mapping on TradingView's sector/industry metadata (TradingView Auto-Sensing)
f_get_sector_ticker() =>
    string s = syminfo.sector
    string i = syminfo.industry
    string t = "NSE:CNX500" // Default fallback
    string n = "Nifty 500"
    // Prioritize by Industry & Sector keywords (TradingView metadata auto-sensing)
    if str.contains(i, "Aerospace") or str.contains(i, "Defense") or str.contains(s, "Producer Manufacturing") or str.contains(i, "Industrial") or str.contains(i, "Capital Goods")
        t := "BSE:CG"
        n := "Capital Goods & Defense"
    else if str.contains(s, "Chemical") or str.contains(i, "Chemical") or str.contains(i, "Fertilizer")
        t := "NSE:CNXCOMMODITIES"
        n := "Nifty Commodities"
    else if str.contains(i, "Bank") or str.contains(s, "Finance")
        t := "NSE:BANKNIFTY"
        n := "Bank Nifty"
    else if str.contains(s, "Technology") or str.contains(i, "Software") or str.contains(i, "IT")
        t := "NSE:CNXIT"
        n := "Nifty IT"
    else if str.contains(s, "Health") or str.contains(i, "Pharma")
        t := "NSE:CNXPHARMA"
        n := "Pharma"
    else if str.contains(i, "Auto")
        t := "NSE:CNXAUTO"
        n := "Nifty Auto"
    else if str.contains(s, "Consumer Non") or str.contains(i, "Food") or str.contains(i, "Beverage") or str.contains(s, "Consumer Durables")
        t := "NSE:CNXFMCG"
        n := "FMCG"
    else if str.contains(i, "Hotel") or str.contains(i, "Resort") or str.contains(i, "Restaurant") or str.contains(s, "Consumer Services")
        t := "NSE:CNXCONSUM"
        n := "Nifty India Consumption"
    else if str.contains(s, "Minerals") or str.contains(i, "Steel") or str.contains(i, "Metal")
        t := "NSE:CNXMETAL"
        n := "Metal"
    else if str.contains(s, "Energy") or str.contains(i, "Oil") or str.contains(i, "Gas")
        t := "NSE:CNXENERGY"
        n := "Energy"
    else if str.contains(s, "Real Estate") or str.contains(i, "Construction")
        t := "NSE:CNXREALTY"
        n := "Realty"
    else if str.contains(s, "Infrastructure")
        t := "NSE:CNXINFRA"
        n := "Infra"
    [t, n]

// // // // // // <DB_LOOKUP_START>
