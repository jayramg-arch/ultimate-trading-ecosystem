# Environment & Secrets
.env
.env.*

# Python
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/

# Browser/Session Data
browser_data/
dhan_session/
tv_user_data/
tv_user_data_v2/
tv_user_data_diagnostics/
strike_user_data/
strike_user_data_debug/

# Paid news (ET + Moneycontrol) Playwright profile — contains auth cookies.
# NEVER commit this. Single-user, machine-local only.
data/paid_news_profile/
data/cache/options_summary_*.json

# Claude internals
.agent/

# Armed Register — operational state, like the journal DB. Holds the plan you
# armed each name with (levels, verdict, expiry) and churns as you trade.
# Machine-local; committing it would fight across machines and leak positions.
gm_armed.json

# ── Operational state & generated artifacts (31-Jul-2026) ────────────────────
# A `git add -A` in this repo would otherwise sweep in ~1,390 untracked files:
# trading databases, 485 generated watchlists, 467 validation runs and 73 PNGs.
#
# ⚠️ .gitignore does NOT untrack what is already tracked. As of this commit the
# repo still tracks: trade_journal_v6.db (1.8 MB of live positions and P&L),
# 46 Generated_Watchlists, 18 validation_runs, 61 PNGs and 3 .bak files. To stop
# tracking them going forward:  git rm --cached -r <path>
# Their contents remain in git HISTORY either way — removing that needs a
# history rewrite (git-filter-repo / BFG), which is a separate, destructive call.

# Databases — journals, sector maps, pick logs. Positions and P&L. Never commit.
*.db
*.db-journal
*.sqlite
*.sqlite3

# Backups and binary caches
*.bak
*.pkl
*.backup_*

# Generated output — reproducible from the pipeline, churns every run
Generated_Watchlists/
validation_runs/
replay_runs/
reports/
logs/

# Screenshots / chart captures
*.png
*.jpg
*.jpeg

# pine_sweep input-order baselines (per-machine bookkeeping, not source)
.pine_input_manifest/

# Live GM settings - capital / risk / TF are PERSONAL runtime state and the app
# rewrites the file on every change. Tracked as gm_settings.example.json instead;
# a missing file is handled (_gm_settings() returns {} and the defaults apply).
gm_settings.json

