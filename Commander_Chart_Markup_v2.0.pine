//@version=6
// ============================================================================
// Commander Chart Markup v1.0 — Auto Stage-Pattern Annotator
// ----------------------------------------------------------------------------
// Automates the manual chart-reading workflow (HONAUT / RELIANCE / NAVINFLUOR /
// ACUTAAS markups) into a single, timeframe-agnostic indicator you can drop on
// ANY symbol or use in the TV screener.
//
// PIPELINE (per the 4-stage method):
//   1. DETECT   — swing pivots (ta.pivothigh/low), breakaway gaps, 52W levels.
//   2. CLASSIFY — Weinstein Stage (weekly 30-WMA), Mansfield RS vs Nifty 500.
//   3. ANNOTATE — best-fit trendlines through pivots WITH touch-count validation
//                 (>=3 = VALID solid; 2 = PROVISIONAL dashed) + geometry
//                 (rising/falling channel · falling wedge · sym. triangle) + apex.
//   4. VERDICT  — Stage + RS + setup (Stage 2 / SWG-PB / Stage 4 EXIT / reversal)
//                 + suggested entry / stop / target in a panel.
//
// DESIGN: touch-count validation encodes the "no 2-touch lines" discipline.
// Heavy pivot-pair fitting runs only on the last bar. RS/Stage reuse the same
// math as the Mansfield RS pane and the Unified Ecosystem (zero drift intent).
// ----------------------------------------------------------------------------
// v1.1 (Batch 1) — CLASSICAL PATTERNS added (reliable/geometric tier):
//   • Horizontal Support/Resistance ZONES (pivot clustering, touch-counted).
//   • FLAGS (impulse leg + tight consolidation box) — bull & bear.
//   • DOUBLE / TRIPLE TOP & BOTTOM (equal pivots + neckline, break-confirmed).
//   Detected patterns are listed in the panel.
// v1.2 (Batch 2) — HEURISTIC tier added (labelled "candidate", eyeball-only):
//   • HEAD & SHOULDERS + inverse (3-pivot, neckline, ✓break when neckline gives).
//   • CUP & HANDLE (two rims ~level + rounded low + shallow handle near rim).
//   These are false-positive-prone by nature — confirm visually before acting.
//   Recent-pivot trendlines + conservative geometry (channel only when parallel).
// v1.3 — KEY-LEVEL layers folded in (self-contained, no MCP needed):
//   • ANCHORED VWAP — ported from Dashboard v67.4.12 (anchor = Stage-2 start,
//     hlc3×vol cumulative). The true evolving curve, + manual-date override.
//   • FIBONACCI — ported from Zigzag v6.2 (retrace 50%/61.8% = high−r×range;
//     ext 1.272/1.618 = low+r×range), on the dominant lookback swing.
//   • S/R now has a tunable min-touch; AVWAP added to the verdict panel.
//   Trendlines stay auto (non-draggable) — snapshot & hand-redraw to stress-test.
// v1.4 — ANNOTATIONS optimized into a decision brief (the headline value):
//   • CONVICTION score 0–7 (Stage2 + RS>0 + RS-rising + >50MA + >AVWAP + >200MA
//     + vol-rising) → STRONG / MODERATE / WEAK at a glance.
//   • RS now shows trend arrow (↑/↓) + leads/lags; Stage shows bars-in-stage.
//   • Auto NEAREST support & resistance (from AVWAP/MA/Fib/52W) with % distance.
//   • Computed PLAN: Entry / Stop (risk%) / Target (R:R) for bullish setups.
//   • Panel reorganised into STATE · LEVELS · PLAN · VERDICT sections.
// v1.5 — DESCRIPTIVE annotations (MCP-style full-sentence notes at key levels):
//   • Sentence notes at Resistance / Support / AVWAP (what each level MEANS,
//     not just its price). Toggle: "Descriptive annotations".
//   • Headline summary OMITTED on purpose — that read lives in the panel.
// v1.6 — usability: SELECTABLE COLORS (new "Colors" input group for every
//   drawn element — trend up/down, AVWAP, Fib 50/61.8/ext, 52W H/L, apex, MAs,
//   pattern text); auto TRENDLINES no longer extend rightwards (drawn only up
//   to the current bar — no future projection).
// v1.7 — TIMEFRAME-ADAPTIVE pivot length, ported from Zigzag [Strict v6.2]
//   (Monthly 1 · Weekly 5 · Daily 2 · Intraday 2). Fixes the old flat "8"
//   that barely formed pivots on M/W and drifted from the canonical swing
//   engine. Four tunable inputs; raise Daily for cleaner markup trendlines.
// v1.8 — TRENDLINE CLOSE-RESPECT rule: a line is only accepted if no candle in
//   its span CLOSED beyond it (above resistance / below support) within the
//   touch tolerance. The classical valid-trendline test, on by default
//   ("reject if a candle closes through it"); turn off to revert to pivots-only.
// v1.9 — TRENDLINE RECENCY BIAS: line selection now scores touches + a bonus for
//   how recent the anchor is, so it prefers lines connecting RECENT pivots over
//   longer lines reaching far back. Tunable "recency bias" input (0 = old
//   most-touched behaviour).
// v2.0 — two more trendline-quality biases in the selection score:
//   • EMA20 CONFLUENCE — rewards lines that TOUCH the EMA20 near CMP (so they
//     break/breakdown together) AND travel roughly parallel (70% proximity-
//     at-current-bar + 30% slope-match). The EMA20 is now PLOTTED and is
//     timeframe-aware via request.security (Monthly→M · Weekly→W · Daily &
//     intraday 125/75-min→D), per the DNA unified-indicator spec.
//   • 45°/IDEAL ANGLE — rewards lines near the Gann 1×1 angle, defined in
//     volatility terms (ideal slope = k × ATR/bar, chart-scale-independent).
//   Both tunable (0 = off). Selection is now: touches + recency + EMA-align +
//   ideal-angle, all among non-pierced, close-respecting candidates.
// v2.1 — BUG-FIX batch (Fable-5 audit):
//   FIX1 stale-state: all fit-dependent drawings/vars (trendlines, apex, geom)
//        now reset up-front on the last bar — a failed fit can no longer leave
//        yesterday's geometry on screen.
//   FIX2 Mansfield RS now CANONICAL WEEKLY-52 via request.security("W") on the
//        SYM/BENCH spread, independent of chart TF (DNA: "52-wk primary").
//        Previously a daily chart silently computed a 52-DAY Mansfield.
//   FIX3 intraday EMA-slope scaling: chart-bars-per-EMA-TF-bar is now measured
//        empirically (session-aware) — the old seconds ratio over-counted ~4×
//        on NSE's 375-min session, understating the EMA-parallel check.
//   FIX4 plan stop sanity cap: the PLAN's stop is never further than
//        stop-cap × ATR below entry (structural level still shows in LEVELS);
//        "⚠cap" tag when applied.
// v2.2 — QUALITY + ALERTS batch:
//   • DT/DB quality gates — min trough depth (× ATR) + min top/bottom spacing.
//   • TOP-2 S/R clusters per side (R1/R2 · S1/S2, 2nd level dimmed).
//   • DIRECTION-AWARE Fib — Stage 4 reads the swing top-down (retraces above,
//     1.272/1.618 targets below; sub-zero targets suppressed).
//   • Minervini template / conviction / pullback MAs anchored to DAILY data on
//     every chart TF (canonical), while plotted MAs stay chart-TF.
//   • Nearest-S/R pickers now consider EMA20, daily 50/200-MA, all 4 Fib levels
//     and the S/R clusters (richer, side-self-selecting).
//   • ALERT SUITE (8 alertconditions): trendline breakout/breakdown, R1/S1
//     cluster break, pattern-neckline ✓break, SWG-PB 50-MA reclaim trigger,
//     conviction→STRONG, weekly stage change. All one-shot edges.
//   • Panel: TL-BREAK row (the alertable line values at the current bar);
//     position input now applies without reload. Cup gains a min-width gate.
// v2.3 — TRENDLINE/S-R fidelity fixes (RELIANCE field test):
//   • SCORING: touches now STRICTLY dominate — the recency/EMA/angle biases are
//     normalised to a combined 0..0.99 and only break ties between equal-touch
//     lines. (Pre-v2.3 they could outvote a touch, so a recent 2-touch line
//     could beat a valid 3-touch line — violated the "pivots first" rule.)
//   • S/R lines now START at their first contributing pivot (no more flat
//     200-bar back-extension through periods where the level wasn't in play).
//   • S/R touch DOTS — every pivot contributing to R1/S1 gets a small dot, so
//     "R 5×" visibly shows its 5 touches. Toggle "Mark S/R touch pivots".
//   • FLIP-AWARE labels — a pivot-high cluster BELOW price reads "R-flip→S"
//     (old resistance now acting as support), and vice versa.
// v2.4 — WICKS MAY PIERCE (Jay's green-candle correction): the pivot/wick-pierce
//   rejection contradicted the stated method — a trendline may cut through wicks
//   (even bodies in the extreme); the ONLY hard invalidation is a candle CLOSING
//   beyond the line. Wick-pierce rejection is now an OFF-by-default strict mode
//   ("wicks may pierce" toggle, default ON = closes are the only test).
// v2.5 — DOCTRINE pass (proactive, from the classical canon):
//   • PRIMARY vs RETURN line (Magee): in a downtrend THE trendline runs along
//     the highs; in an uptrend along the lows. Labels now say which is which.
//   • DISTINCT-TOUCH spacing (Bulkowski): clustered touches a few bars apart
//     count as ONE test — applies to trendline touch counts and S/R clusters.
//   • BREAK FILTER (Murphy's 1–3% penetration rule, volatility-adjusted): break
//     ALERTS need a close ≥ brk_atr × ATR beyond the line (default 1.0), not
//     just a poke past the touch tolerance.
//   • THROWBACK memory (Magee/Murphy): a just-broken trendline is frozen and
//     kept on the chart ~40 bars in its FLIPPED role ("broken TL → retest =
//     support/resistance") — the classic low-risk re-entry level.
// v2.6 — DECOUPLED the two trendlines (RELIANCE field test proved one shared
//   "fit N" can't satisfy both — tuning support wrecked resistance and vice
//   versa). Resistance (highs) and Support (lows) now each have their OWN
//   fit-N window AND their OWN touch tolerance, so each side is shaped
//   independently. Tracked-pivot pool widened 12→16 (max 24) to give the wider
//   side more reach. Per-side tolerance also lets the support line loosen just
//   enough to catch a near-collinear set of 4 wicks without loosening resistance.
// v2.7 — TOUCH RULE rewritten to Jay's exact spec + a DEBUG view:
//   • ASYMMETRIC touch: the line may cut DEEP into a wick (up to cut_mult ×
//     tolerance, different depths per pivot) and still count that pivot as a
//     touch; the 'float' side stays tight (1× tolerance). The only hard rule
//     remains "no candle CLOSES beyond the line". This is why a near-collinear
//     4-wick set now scores 4 touches instead of 2 and wins (touches dominate).
//   • DEBUG toggle marks every tracked pivot (×) so you can verify the engine
//     detected the swings your eye uses before blaming the fit.
//   Recency/EMA/angle remain sub-one-touch tie-breakers (enhancers, not rules).
// v2.9 — ADJUSTABLE + MACHINE-READ (the answer nine revisions of tuning missed):
//   The premise of v1.0-v2.8 was that a scoring function could be tuned until it
//   drew the line your eye wants. It cannot: "optimal" is chart-specific, so every
//   field test moved the weights and broke the previous fix. v2.9 stops trying.
//   • MANUAL OVERRIDES — input.price / input.time handles (DRAGGABLE on the chart,
//     and readable by the script) for R1-R3, S1-S4, both trendlines' anchors, and a
//     consolidation box. Auto-detect is now a SEED; you drag to correct; the PLAN
//     (entry/stop/target/R:R), the ALERTS and the PANEL all consume YOUR level.
//     0 = use auto, so untouched behaviour is identical to v2.8. A live manual
//     trendline REPLACES the auto-fit for that side (never both).
//     Overridden levels draw in `c_manual` and tag "·man" in the panel, so you can
//     always see which levels are yours and which the plan actually used.
//   • AUTO-NAMED manual levels — a dragged level is named for the structure it is
//     nearest (52W High/Low, EMA20, 50-DMA, 200-DMA, AVWAP) within a tolerance,
//     else "manual". Pine can't know what you meant; it reports what you hit.
//   • GHOST FIX — every delete moved OUT of its `if show_*` gate. Previously
//     toggling any feature off SKIPPED its delete and froze that drawing on the
//     chart forever (v2.1's FIX1 had solved this for trendlines only). Tuning was
//     being done against stale levels from earlier settings.
//   KNOWN LIMIT: inputs do not follow the symbol. Switch symbols and dragged levels
//   stay put and will be wrong — reset to 0 (= auto) or keep a per-symbol layout.
//   Pine offers no way around this, and it is why ADANIPORTS_SR_Overlay is a
//   per-symbol file.
// v2.10 — field-test fixes (Jay, first live run of the override layer):
//   • MANUAL LEVELS NOW OUTRANK AUTO ones (`ov_priority`, default ON). v2.9 merged
//     manual levels into ONE flat nearest-wins pool, so a level you deliberately
//     marked could be beaten by an EMA20/Fib sitting a few ticks closer — it drew
//     on the chart but never reached the PANEL or the PLAN. That inverted the
//     doctrine: your hand-drawn levels ARE the location layer (5-gate, Gate 2);
//     the auto ones are the fallback for a side you have not marked yet. The
//     picker is now two pools (manual / auto) resolved by priority; an unmarked
//     side still falls back to auto. Off = v2.9's flat behaviour.
//   • TRENDLINE ANCHORS → confirm=true (CLICK-TO-PLACE). Typing four timestamps
//     into date pickers to place one line was the wrong tool for the job. Cost:
//     the prompt fires on every add (see the note at grpOT).
//   • The manual/auto source tag moved to the picker (supSrc/resSrc) where both
//     pools are in scope. v2.9's f_ovSrc matched by VALUE against the 7 S/R handles
//     and so could never see a manual TRENDLINE (v_tlLo/v_tlUp are declared after
//     it) — a manual TL would have won the plan while the panel called it auto.
// v2.11 — TIMEFRAME-SCOPED manual S/R (the weekend marking workflow):
//   The flat R1-R3 / S1-S4 slots are replaced by THREE TF-scoped groups —
//   MONTHLY / WEEKLY / DAILY, 4 levels each. The group IS the timeframe.
//   • HTF DOWN, NEVER LTF UP. A level renders on its own TF and every lower one
//     (levelSec >= chartSec — the same guardrail the S4 zone engine uses, not a
//     second invented rule). Monthly shows everywhere; Weekly on Weekly/Daily/
//     intraday; a Daily level NEVER appears on a Weekly or Monthly chart.
//   • THE TIMEFRAME IS THE CONVICTION, so it is not cosmetic: it rides to the
//     panel's SUPPORT/RESISTANCE rows as "·W" / "·D" / "·M". A stop on a WEEKLY
//     level is a deeper distal → wider stop → SIZE DOWN (Gate 4). Reading
//     "1718.00 −2.1%" without knowing whether that floor is a daily shelf or a
//     monthly one is how a position gets mis-sized. Line weight encodes the same
//     thing visually (Monthly 3px / Weekly 2px / Daily 1px).
//   • ROLE IS DERIVED (price vs close), never fixed by which slot you typed into,
//     so a level flips Support↔Resistance as price closes through it (the R-flip→S
//     rule) instead of going stale as a mislabelled "resistance" underfoot.
//   • Marking stops at DAILY by design: "does NOT mark 125/75-min zones — LTF is a
//     timing lens, not a zone surface."
//   Ties resolve to the HIGHER timeframe: a Monthly and a Daily level at the same
//   price reads Monthly. Conviction takes the higher reading, never the lower.
// ============================================================================
indicator("Commander Chart Markup v2.11", overlay=true, max_lines_count=80, max_labels_count=200, max_boxes_count=30)
max_bars_back(close, 600)  // history buffer for the "no candle closes through the trendline" check

// ============================================================================
// 1. INPUTS
// ============================================================================
grpD = "Detection"
// Timeframe-adaptive pivot length — matches Wesinstein Swing Zigzag [Strict v6.2]
// (Monthly 1 · Weekly 5 · Daily 2 · Intraday 2) so pivots/trendlines stay in sync
// with the canonical swing engine across every timeframe.
piv_m     = input.int(1, "Monthly pivot length",  minval=1, group=grpD)
piv_w     = input.int(5, "Weekly pivot length",   minval=1, group=grpD)
piv_d     = input.int(2, "Daily pivot length",    minval=1, group=grpD, tooltip="Zigzag uses 2 for fine swing structure. For cleaner *markup* trendlines you may prefer a larger value (e.g. 4–6) — your call.")
piv_intra = input.int(2, "Intraday pivot length", minval=1, group=grpD)
int piv_lb = timeframe.ismonthly ? piv_m : timeframe.isweekly ? piv_w : timeframe.isdaily ? piv_d : piv_intra
maxPiv    = input.int(16, "Pivots tracked per side", minval=4, maxval=24, group=grpD)
// v2.6: the resistance line (from highs) and the support line (from lows) have
// DIFFERENT best windows — forcing one "fit N" on both means tuning one wrecks
// the other (RELIANCE field test). Each side now has its own window.
trend_piv_up = input.int(8, "Trendline fit N — RESISTANCE (highs)", minval=3, maxval=24, group=grpD, tooltip="How many recent pivot-HIGHS the resistance line may anchor on. Lower = steeper/recent; higher = longer base. Tune independently of the support line.")
trend_piv_lo = input.int(8, "Trendline fit N — SUPPORT (lows)",    minval=3, maxval=24, group=grpD, tooltip="How many recent pivot-LOWS the support line may anchor on. Lower = steeper/recent; higher = longer base. Tune independently of the resistance line.")
min_touch = input.int(3, "Min touches for a VALID trendline", minval=2, group=grpD)
// v2.6: per-side touch tolerance — a near-collinear set of 4 wicks may deviate
// more than one snug band; loosen the SUPPORT tolerance to catch all 4 without
// loosening RESISTANCE (and vice versa).
tol_up_atr = input.float(0.7, "Touch tolerance — RESISTANCE (× ATR)", minval=0.1, step=0.1, group=grpD)
tol_lo_atr = input.float(0.7, "Touch tolerance — SUPPORT (× ATR)",    minval=0.1, step=0.1, group=grpD)
tl_cut_mult = input.float(2.5, "Touch: wick-cut depth (× tolerance)", minval=1.0, step=0.5, group=grpD, tooltip="v2.7 (Jay's rule): a pivot counts as a touch even when the line cuts DEEP into its wick — different pivots may be cut to different depths. The cut side allows up to this × the touch tolerance; the 'float' side (pivot away from the line) stays at 1× tolerance. The only hard limit remains: no candle may CLOSE beyond the line.")
tl_debug   = input.bool(false, "Debug: mark all tracked anchors (×)", group=grpD, tooltip="v2.7: plots an × on EVERY swing the trendline engine can anchor on (highs red, lows green). Use it to verify the engine actually sees the swings your eye uses — if a low/high you'd use has no ×, lower the pivot length until it's detected. v2.8: these are now the trendline ANCHOR swings (1-bar right-confirm when soft anchors are ON), so the most recent swing appears here sooner.")
tl_soft_anchor = input.bool(true, "Trendline: 1-bar right-confirm for anchors (catch recent swings)", group=grpD, tooltip="v2.8: trendline anchor swings are detected with only 1 confirming bar to the RIGHT (left context stays = pivot length), so a recent swing low/high becomes a usable line endpoint immediately instead of waiting the full pivot length. Touch counting already scans every bar's wick, so an intermediate swing the line grazes counts even without this. OFF = anchors use the same strict pivots as S/R levels.")
tl_nobreak = input.bool(true, "Trendline: reject if a candle CLOSES through it", group=grpD, tooltip="Classical valid-trendline rule — the line is only accepted if no candle in its span closed beyond it (above resistance / below support), within the touch tolerance.")
tl_wick_ok = input.bool(true, "Trendline: wicks may pierce (CLOSES are the only test)", group=grpD, tooltip="v2.4 (Jay's rule): a trendline may cut through wicks — even bodies in the extreme — the ONLY invalidation is a candle CLOSING beyond it. OFF = also reject lines whose pivots/wicks pierce by more than the tolerance (stricter, pre-v2.4 behaviour).")
brk_atr    = input.float(1.0, "Break filter for ALERTS (× ATR beyond line)", minval=0.1, step=0.1, group=grpD, tooltip="v2.5 (Murphy's penetration filter, volatility-adjusted): a break alert needs a CLOSE this many ATRs beyond the line/level — a 0.1-ATR poke is noise, not a break. Touch tolerance stays separate.")
tl_recency = input.float(1.0, "Trendline recency bias (tie-breaker)", minval=0.0, step=0.5, group=grpD, tooltip="v2.3: TOUCHES ALWAYS WIN — the three biases below are a relative mix that only breaks ties between equal-touch lines (combined weight capped below one touch). This one prefers lines anchored on RECENT pivots.")
tl_ema_w   = input.float(1.0, "Trendline EMA20-confluence bias (tie-breaker)", minval=0.0, step=0.5, group=grpD, tooltip="Tie-breaker: rewards lines that TOUCH the EMA20 near current price (break together) AND travel roughly parallel. 70% proximity-at-CMP + 30% slope-match. Relative weight vs the other two biases.")
tl_angle_w = input.float(1.0, "Trendline 45°/ideal-angle bias (tie-breaker)", minval=0.0, step=0.5, group=grpD, tooltip="Tie-breaker: rewards lines near the 'ideal' (Gann 1×1 / 45°) angle — not too steep nor too flat. Relative weight vs the other two biases.")
tl_ideal   = input.float(0.5, "Ideal slope (× ATR per bar = '45°')", minval=0.05, step=0.05, group=grpD, tooltip="Defines the ideal angle in volatility terms (chart-scale-independent). 0.5 = the line rises/falls ~0.5 ATR per bar. Tune to match what looks like 45° on your typical chart.")
gap_pct   = input.float(4.0, "Breakaway gap % min", minval=0.5, step=0.5, group=grpD)
gap_volx  = input.float(2.0, "Gap volume × avg min", minval=1.0, step=0.5, group=grpD)

grpC = "Context"
benchSym = input.symbol("NSE:CNX500", "RS Benchmark (Nifty 500)", group=grpC)
rsLen    = input.int(52, "Mansfield RS MA length (WEEKS — canonical 52)", minval=10, group=grpC, tooltip="v2.1: the Mansfield RS is always computed on the WEEKLY spread (SYM/BENCH), regardless of chart timeframe — per the DNA '52-wk primary' spec.")
nearHi_pct = input.float(3.0, "‘At highs’ threshold (% from 52WH)", step=0.5, group=grpC)
pb_atr   = input.float(1.5, "‘Pullback to MA’ band (× ATR)", step=0.5, group=grpC)
stop_cap = input.float(2.5, "Plan: stop cap (× ATR)", minval=0.5, step=0.5, group=grpC, tooltip="v2.1: the PLAN's stop is never further than this many ATRs below entry, even when the nearest structural support is far away (the structural level still shows in LEVELS). '⚠cap' tags a capped stop.")

grpV = "Visuals"
show_tl     = input.bool(true, "Auto trendlines + geometry", group=grpV)
show_apex   = input.bool(true, "Apex marker (converging lines)", group=grpV)
show_levels = input.bool(true, "52W High / Low levels", group=grpV)
show_gaps   = input.bool(true, "Breakaway-gap markers", group=grpV)
show_ma     = input.bool(true, "Stage MAs (50/150/200)", group=grpV)
show_ema20  = input.bool(true, "EMA20 (TF-aware: M/W/D, Daily on intraday)", group=grpV)
show_panel  = input.bool(true, "Verdict panel", group=grpV)
show_notes  = input.bool(true, "Descriptive annotations (MCP-style notes)", group=grpV, tooltip="Full-sentence labels: a headline read + narrative notes at Resistance / Support / AVWAP. Turn off if the chart feels busy.")
panel_posS  = input.string("Top Right", "Panel position", options=["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right"], group=grpV)

panel_pos = panel_posS == "Top Right" ? position.top_right : panel_posS == "Top Left" ? position.top_left : panel_posS == "Bottom Right" ? position.bottom_right : panel_posS == "Bottom Left" ? position.bottom_left : position.middle_right

grpP = "Classical Patterns (v1.1)"
show_sr     = input.bool(true,  "Support/Resistance zones", group=grpP)
sr_tol_atr  = input.float(0.6, "S/R cluster tolerance (× ATR)", minval=0.1, step=0.1, group=grpP)
sr_min_t    = input.int(2, "S/R min touches", minval=2, group=grpP, tooltip="A zone must be touched by at least this many pivots to be drawn.")
sr_dots     = input.bool(true, "Mark S/R touch pivots (dots)", group=grpP, tooltip="v2.3: draws a small dot on every pivot that contributes to the R1/S1 cluster — answers 'where are the N touches?' at a glance.")
show_flags  = input.bool(true,  "Flags (impulse + tight consolidation)", group=grpP)
flag_cons   = input.int(6, "Flag consolidation bars", minval=3, group=grpP)
flag_imp    = input.int(10, "Flag impulse lookback bars", minval=4, group=grpP)
flag_impA   = input.float(4.0, "Flag impulse size (× ATR)", minval=1.0, step=0.5, group=grpP)
flag_rngA   = input.float(2.5, "Flag consolidation max (× ATR)", minval=0.5, step=0.5, group=grpP)
show_dt     = input.bool(true,  "Double / Triple Top & Bottom", group=grpP)
dt_tol_atr  = input.float(0.5, "Equal-pivot tolerance (× ATR)", minval=0.1, step=0.1, group=grpP)
dt_depth_atr = input.float(1.0, "DT/DB min trough depth (× ATR)", minval=0.0, step=0.25, group=grpP, tooltip="v2.2 quality gate: the dip between the two tops (or peak between two bottoms) must be at least this deep — kills the shallow-consolidation false positives.")
dt_min_gap   = input.int(2, "DT/DB min spacing (× pivot length)", minval=1, group=grpP, tooltip="v2.2 quality gate: the two tops/bottoms must be at least this many pivot-lengths apart in bars.")
// Batch 2 — heuristic / false-positive-prone tier (labelled "candidate")
show_hs     = input.bool(true,  "Head & Shoulders (+ inverse) — CANDIDATE", group=grpP, tooltip="Heuristic — eyeball candidate, not a confirmed signal.")
hs_tol_atr  = input.float(0.9, "H&S shoulder symmetry tol (× ATR)", minval=0.1, step=0.1, group=grpP)
show_cup    = input.bool(true,  "Cup & Handle — CANDIDATE", group=grpP, tooltip="Heuristic — loose detection; verify by eye.")
cup_dmin    = input.float(12.0, "Cup depth min %", minval=3, step=1, group=grpP)
cup_dmax    = input.float(50.0, "Cup depth max %", minval=10, step=1, group=grpP)

grpAV = "Anchored VWAP (ported from Dashboard v67.4.12)"
show_avwap   = input.bool(true,  "Anchored VWAP (curve)", group=grpAV, tooltip="Auto-anchored at the current Stage-2 start (hlc3×vol cumulative), exactly like the Dashboard. Toggle manual anchor below to override.")
avwap_manual = input.bool(false, "Use manual anchor date instead", group=grpAV)
avwap_date   = input.time(timestamp("01 Jan 2026 00:00 +0530"), "Manual anchor", group=grpAV)

grpF = "Fibonacci (ported from Zigzag v6.2)"
show_fib     = input.bool(true,  "Fib retrace 50% & 61.8%", group=grpF)
show_fib_ext = input.bool(true,  "Fib ext 1.272 & 1.618 (targets)", group=grpF)
fibLook      = input.int(120, "Fib swing lookback (bars)", minval=20, group=grpF, tooltip="Dominant swing = highest-high & lowest-low over this lookback. Retrace = high − r×range; ext = low + r×range (Zigzag v6.2 formulas).")
fib_ext_bars = input.int(15, "Fib line extend (bars right)", minval=2, maxval=100, group=grpF)

// ============================================================================
// v2.9 MANUAL OVERRIDES — the auto-detect is a SEED; your eye is the authority.
// ----------------------------------------------------------------------------
// Pine cannot make a drawn line (line.new) draggable, and it cannot read your
// native TradingView drawings. What it CAN do is expose input.price / input.time
// handles, which TradingView renders as DRAGGABLE points on the chart — and which
// the engine can then READ. That is what this group is: the auto-fit proposes,
// you correct it by dragging, and the PLAN / ALERTS / PANEL all consume YOUR
// level, not the machine's guess.
//
// 0 = USE AUTO. Every override defaults to 0, so out of the box nothing changes
// and the tool behaves exactly as before. Override only what is actually wrong.
// (A 0-default handle sits at price zero, off-chart and un-grabbable — so type
//  the value once from the panel's LEVELS row, then drag it to fine-tune.)
//
// NOTE: inputs do NOT follow the symbol. Switch symbols and your dragged levels
// stay put and will be wrong — reset them to 0 (= auto) or keep a per-symbol
// layout. There is no way around this in Pine.
// ============================================================================
// v2.11 — TIMEFRAME-SCOPED manual levels. One GROUP per timeframe, so the group IS
// the level's timeframe (no per-level dropdown). Two rules follow from that, both
// straight out of the 5-gate doctrine:
//
//  1. HTF DOWN, never LTF UP. A level shows on its own timeframe and every LOWER
//     one — Monthly everywhere, Weekly on Weekly/Daily/intraday, Daily on
//     Daily/125m/75m. A Daily level NEVER renders on a Weekly chart. Same guardrail
//     the S4 zone engine uses (levelSec >= chartSec), not a second invented rule.
//  2. THE TIMEFRAME IS THE CONVICTION. "The timeframe a zone is drawn on sets stop
//     width + size (weekly zone = deeper distal = wider stop = size down)." So the
//     TF tag is not cosmetic: it rides along to the panel's SUPPORT/RESISTANCE rows
//     so the stop you read is qualified by the weight of the level it came from.
//
// SUPPORT vs RESISTANCE is DERIVED (price vs close), never fixed by which slot you
// typed into — so a level correctly flips role when price closes through it (your
// R-flip→S rule) instead of going stale as a mislabelled "resistance" underfoot.
//
// Marking stops at Daily by design: "does NOT mark 125/75-min zones — LTF is a
// timing lens, not a zone surface."
grpOV = "Manual Overrides — master"
ov_on  = input.bool(true, "Enable manual overrides", group=grpOV, tooltip="Master switch. Off = pure auto-detection (pre-v2.9 behaviour); overrides are ignored but retained.")

grpLM = "Manual S/R — MONTHLY  (shows on ALL timeframes)"
m1 = input.price(0.0, "Monthly level 1", group=grpLM)
m2 = input.price(0.0, "Monthly level 2", group=grpLM)
m3 = input.price(0.0, "Monthly level 3", group=grpLM)
m4 = input.price(0.0, "Monthly level 4", group=grpLM)

grpLW = "Manual S/R — WEEKLY  (shows on Weekly and below)"
w1 = input.price(0.0, "Weekly level 1", group=grpLW)
w2 = input.price(0.0, "Weekly level 2", group=grpLW)
w3 = input.price(0.0, "Weekly level 3", group=grpLW)
w4 = input.price(0.0, "Weekly level 4", group=grpLW)

grpLD = "Manual S/R — DAILY  (shows on Daily and below; hidden on Weekly/Monthly)"
d1 = input.price(0.0, "Daily level 1", group=grpLD)
d2 = input.price(0.0, "Daily level 2", group=grpLD)
d3 = input.price(0.0, "Daily level 3", group=grpLD)
d4 = input.price(0.0, "Daily level 4", group=grpLD)
ov_name_tol = input.float(0.5, "Auto-name tolerance (× ATR)", minval=0.1, step=0.1, group=grpOV, tooltip="A dragged level within this many ATRs of a known structure is NAMED for it (52W High/Low, EMA20, 50-DMA, 200-DMA, AVWAP, breakout shelf). Beyond it, the level reads 'manual'. Pine can't know what you meant when you drag to 1718 — so it tells you what you actually snapped to, which is a useful cross-check on your own read.")
ov_priority = input.bool(true, "Manual levels OUTRANK auto levels", group=grpOV, tooltip="ON (default): if you have marked ANY level on a side, that side's nearest-level (and therefore the PLAN's stop / target / R:R) is chosen from YOUR levels only — auto candidates (EMA20, MAs, Fib, clusters, 52W) are ignored on that side. This is the doctrine: your hand-drawn levels ARE the location layer; the auto ones are the fallback for when you haven't marked it yet.\n\nOFF: your levels are merely added to the auto pool and the nearest wins regardless of origin — so a level you deliberately drew can be outranked by an EMA that happens to sit closer.\n\nA side you haven't marked always falls back to auto either way.")

// TRENDLINES use confirm=true = CLICK-TO-PLACE on the chart (same as your
// ADANIPORTS_SR_Overlay). Typing four timestamps into date pickers to place one
// line was the wrong tool for the job. TradingView prompts for these points when
// the indicator is ADDED to a chart; afterwards they are draggable like the S/R
// handles, and editable in Settings.
//
// COST of confirm=true, so it isn't a surprise: the prompt fires EVERY time you add
// the indicator to a chart, and you cannot skip straight to "auto-fit only". If you
// just want the breadth read, click the anchors anywhere and then zero the prices
// in Settings (0 = fall back to the auto-fit) — or click the two points you'd have
// drawn anyway, which is the whole point.
//
// A side only goes manual when BOTH its anchors have a time AND a non-zero price.
grpOT = "Manual Overrides — Trendlines  (click to place; price 0 = use auto-fit)"
ov_tls_t1 = input.time(0,    "Support TL — anchor 1 (swing low) time", group=grpOT, confirm=true)
ov_tls_p1 = input.price(0.0, "Support TL — anchor 1 price",            group=grpOT, confirm=true)
ov_tls_t2 = input.time(0,    "Support TL — anchor 2 (higher low) time",group=grpOT, confirm=true)
ov_tls_p2 = input.price(0.0, "Support TL — anchor 2 price",            group=grpOT, confirm=true)
ov_tlr_t1 = input.time(0,    "Resistance TL — anchor 1 time",          group=grpOT, confirm=true)
ov_tlr_p1 = input.price(0.0, "Resistance TL — anchor 1 price",         group=grpOT, confirm=true)
ov_tlr_t2 = input.time(0,    "Resistance TL — anchor 2 time",          group=grpOT, confirm=true)
ov_tlr_p2 = input.price(0.0, "Resistance TL — anchor 2 price",         group=grpOT, confirm=true)

grpOB = "Manual Overrides — Consolidation Box  (0 = off)"
ov_box_t1  = input.time(0,    "Box start time", group=grpOB)
ov_box_t2  = input.time(0,    "Box end time",   group=grpOB)
ov_box_top = input.price(0.0, "Box top",        group=grpOB)
ov_box_bot = input.price(0.0, "Box bottom",     group=grpOB)

grpClr = "Colors"
c_manual = input.color(#ffd54f, "Manual trendline / box", group=grpClr)
c_lvM    = input.color(#ff7043, "Manual level — Monthly", group=grpClr)
c_lvW    = input.color(#ffd54f, "Manual level — Weekly",  group=grpClr)
c_lvD    = input.color(#4fc3f7, "Manual level — Daily",   group=grpClr)
c_up     = input.color(#26a69a, "Up / support / bullish", group=grpClr)
c_dn     = input.color(#ef5350, "Down / resistance / bearish", group=grpClr)
c_avwap  = input.color(#ffa726, "Anchored VWAP", group=grpClr)
c_fibR   = input.color(#A020F0, "Fib 50% retrace", group=grpClr)
c_fib618 = input.color(color.orange, "Fib 61.8% retrace", group=grpClr)
c_fibE   = input.color(#00BFA5, "Fib extensions", group=grpClr)
c_52h    = input.color(#ce93d8, "52W High", group=grpClr)
c_52l    = input.color(#90a4ae, "52W Low", group=grpClr)
c_apex   = input.color(#b0bec5, "Apex", group=grpClr)
c_pat    = input.color(#4dd0e1, "Pattern text (panel)", group=grpClr)
c_ema20  = input.color(#42a5f5, "EMA20", group=grpClr)
c_ma50   = input.color(color.orange, "MA 50", group=grpClr)
c_ma150  = input.color(color.blue, "MA 150", group=grpClr)
c_ma200  = input.color(color.gray, "MA 200", group=grpClr)

// ============================================================================
// 2. CONTEXT — ATR, MAs, Weinstein Stage, Mansfield RS
// ============================================================================
float atr14 = ta.atr(14)
float sma50  = ta.sma(close, 50)
float sma150 = ta.sma(close, 150)
float sma200 = ta.sma(close, 200)
// EMA20 on the right reference timeframe (Monthly→M · Weekly→W · Daily & all
// intraday (125/75-min)→D), matching the DNA "EMA20(Daily) overlaid on 125/75-min".
// Used for the trendline EMA20-confluence bias AND plotted on the chart.
string ema_tf = timeframe.isintraday ? "D" : timeframe.period
[ema20, ema20_pN] = request.security(syminfo.tickerid, ema_tf, [ta.ema(close, 20), ta.ema(close, 20)[5]], lookahead=barmerge.lookahead_off)
// v2.1 FIX3: chart-bars-per-EMA-TF-bar measured EMPIRICALLY (session-aware).
// The old seconds-ratio used a 24h day vs NSE's 375-min session → ~4× error
// in the EMA-parallel check on 75/125-min charts.
var int _emaTfBars  = 1
var int _emaTfCount = 1
if timeframe.change(ema_tf)
    _emaTfBars  := _emaTfCount
    _emaTfCount := 1
else
    _emaTfCount += 1
float ema_slope = (ema20 - ema20_pN) / (5.0 * math.max(1, _emaTfBars))   // price per CHART bar

// v2.2: Minervini trend template anchored to DAILY data on every chart TF
// (on a weekly chart "SMA200" would otherwise mean 200 WEEKS). Plotted MAs
// stay chart-TF; the LOGIC uses these daily-canonical values.
[d_sma50, d_sma150, d_sma200] = request.security(syminfo.tickerid, "D", [ta.sma(close, 50), ta.sma(close, 150), ta.sma(close, 200)], lookahead=barmerge.lookahead_off)
bool minervini_up = not na(d_sma200) and close > d_sma50 and d_sma50 > d_sma150 and d_sma150 > d_sma200

// Weekly 30-WMA Weinstein anchor (works on any chart TF)
[wma30, wma30p] = request.security(syminfo.tickerid, "W", [ta.sma(close, 30), ta.sma(close, 30)[6]], lookahead=barmerge.lookahead_off)
int stage = na(wma30) ? 0 : (close > wma30 and wma30 >= wma30p ? 2 : close > wma30 ? 3 : wma30 < wma30p ? 4 : 1)
// reversal flag: was below the 30-WMA within the last 25 bars, now reclaimed
float lowest25 = ta.lowest(close, 25)
bool reclaim_30w = close > wma30 and lowest25 < wma30

// v2.1 FIX2: Mansfield RS — CANONICAL WEEKLY-52, independent of chart TF.
// Computed on the SYM/BENCH spread in the WEEKLY context (the 52-bar SMA of the
// ratio is a true 52-WEEK average). Previously a daily chart silently computed
// a 52-DAY Mansfield — a zero-drift violation vs the ecosystem's weekly spec.
f_mans_weekly() =>
    float ratio = close   // close of the SYM/BENCH spread in the "W" context
    float ma = ta.sma(ratio, rsLen)
    na(ma) or ma == 0 ? na : (ratio / ma - 1.0) * 100.0
string rsSpread = syminfo.prefix + ":" + syminfo.ticker + " / " + benchSym
float mansfield = request.security(rsSpread, "W", f_mans_weekly(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
bool rs_pos = not na(mansfield) and mansfield > 0

// 52-week extremes (rolling)
int look52 = 252
float hh52 = ta.highest(high, look52)
float ll52 = ta.lowest(low, look52)

// Hoisted ta.* (must evaluate every bar — used inside conditional blocks below)
float volSma50  = ta.sma(volume, 50)
float flagConsHi = ta.highest(high, flag_cons)
float flagConsLo = ta.lowest(low, flag_cons)

// --- Anchored VWAP (port of Dashboard v67.4.12: anchor = Stage-2 start; hlc3×vol) ---
var float av_cumV  = 0.0
var float av_cumPV = 0.0
var int   av_last  = 1
int av_anchor = avwap_manual ? avwap_date : ((stage == 2 and (na(stage[1]) or stage[1] != 2)) ? time : na)
var int av_hold = 1
if not na(av_anchor)
    av_hold := av_anchor
if av_hold > 1 and av_hold != av_last
    av_cumV  := 0.0
    av_cumPV := 0.0
    av_last  := av_hold
if av_last > 1 and time >= av_last
    av_cumV  += volume
    av_cumPV += hlc3 * volume
float avwap = av_cumV > 0 ? av_cumPV / av_cumV : na

// --- Fib dominant swing (Zigzag v6.2 formulas) — DIRECTION-AWARE (v2.2) ---
// Up-swing (default): retraces hang from the high; extensions project ABOVE.
// Stage 4 down-swing: retraces rise from the low (bounce levels); 1.272/1.618
// project BELOW the low (downside targets; suppressed if they'd go sub-zero).
float fibHi = ta.highest(high, fibLook)
float fibLo = ta.lowest(low, fibLook)
float fibRange = fibHi - fibLo
bool  fibDown = stage == 4
float fib_50  = fibHi - 0.500 * fibRange                                         // same level both directions
float fib_618 = fibDown ? fibLo + 0.618 * fibRange : fibHi - 0.618 * fibRange
float fib_e1  = fibDown ? fibHi - 1.272 * fibRange : fibLo + 1.272 * fibRange
float fib_e2  = fibDown ? fibHi - 1.618 * fibRange : fibLo + 1.618 * fibRange

// --- annotation metrics (every-bar) ---
var int stageStartBar = 0
if ta.change(stage) != 0
    stageStartBar := bar_index
bool rsRising  = not na(mansfield) and not na(mansfield[5]) and mansfield > mansfield[5]
bool volRising = ta.sma(volume, 10) > volSma50

// pick nearest support (highest level below price) / resistance (lowest above)
f_maxBelow(float acc, float cur, float px) => (not na(px) and px < cur) ? (na(acc) ? px : math.max(acc, px)) : acc
f_minAbove(float acc, float cur, float px) => (not na(px) and px > cur) ? (na(acc) ? px : math.min(acc, px)) : acc

// --- v2.9 override plumbing -------------------------------------------------
// An override is ACTIVE only when the master switch is on AND the handle has been
// moved off its 0 default. `f_ov` resolves override-else-auto for one level.
f_ovOn(float ov)            => ov_on and not na(ov) and ov > 0.0
// True when a time handle has been placed (0 = untouched).
f_ovT(int t)                => ov_on and not na(t) and t > 0

// --- v2.11 TF guardrail: HTF levels propagate DOWN, LTF levels never render UP ---
// Mirrors the S4 zone engine's rule (same constants, same comparison) rather than
// inventing a second one. `>=` not `>`: a Daily level MUST still show on a Daily
// chart. (S4 uses strict `>` only because its Daily zones arrive via a separate
// native path on a Daily chart — there is no native path for a hand-typed level.)
int _lvlChartSec = timeframe.in_seconds(timeframe.period)
bool showMonthlyLv = 1900800 >= _lvlChartSec      // Monthly: always
bool showWeeklyLv  = 432000  >= _lvlChartSec      // Weekly: Weekly and below
bool showDailyLv   = 86400   >= _lvlChartSec      // Daily: Daily and below

// A manual level is live if the master switch is on, it has been placed (>0), AND
// its timeframe is >= the chart's.
f_lvOn(float px, bool tfOk) => ov_on and tfOk and not na(px) and px > 0.0
// Role is DERIVED, so it flips as price closes through the level.
f_lvRole(float px) => px > close ? "Resistance" : "Support"

// Which timeframe did a winning level come from? This is what qualifies the PLAN's
// stop: a weekly floor means a deeper distal, a wider stop and SIZE DOWN (Gate 4).
// Highest TF wins a tie — if a Monthly and a Daily level sit at the same price, the
// level is Monthly; conviction takes the higher reading, never the lower.
f_lvTf(float lvl) =>
    string t = ""
    if not na(lvl)
        if (f_lvOn(m1, showMonthlyLv) and m1 == lvl) or (f_lvOn(m2, showMonthlyLv) and m2 == lvl) or (f_lvOn(m3, showMonthlyLv) and m3 == lvl) or (f_lvOn(m4, showMonthlyLv) and m4 == lvl)
            t := "M"
        else if (f_lvOn(w1, showWeeklyLv) and w1 == lvl) or (f_lvOn(w2, showWeeklyLv) and w2 == lvl) or (f_lvOn(w3, showWeeklyLv) and w3 == lvl) or (f_lvOn(w4, showWeeklyLv) and w4 == lvl)
            t := "W"
        else if (f_lvOn(d1, showDailyLv) and d1 == lvl) or (f_lvOn(d2, showDailyLv) and d2 == lvl) or (f_lvOn(d3, showDailyLv) and d3 == lvl) or (f_lvOn(d4, showDailyLv) and d4 == lvl)
            t := "D"
    t

// A manual trendline needs BOTH anchors placed (2 times + 2 prices). When one is
// live it REPLACES the auto-fit for that side — otherwise both would draw and you
// would be looking at two lines per side with no way to tell which the plan used.
bool ovTlS_live = ov_on and ov_tls_t1 > 0 and ov_tls_t2 > 0 and ov_tls_p1 > 0.0 and ov_tls_p2 > 0.0
bool ovTlR_live = ov_on and ov_tlr_t1 > 0 and ov_tlr_t2 > 0 and ov_tlr_p1 > 0.0 and ov_tlr_p2 > 0.0

// AUTO-NAME a manual level. Pine can't know what you MEANT when you drag to 1718,
// so it reports what you actually snapped to — which doubles as a cross-check on
// your own read (drag to "support" and get told it's the 200-DMA = confirmation;
// get told "manual" = you're on air, not structure).
// `bd` starts at the tolerance and shrinks, so the NEAREST structure within
// tolerance wins rather than the first one tested.
f_ovName(float px) =>
    float bd = ov_name_tol * atr14
    string nm = "manual"
    if not na(hh52) and math.abs(px - hh52) <= bd
        bd := math.abs(px - hh52)
        nm := "52W High"
    if not na(ll52) and math.abs(px - ll52) <= bd
        bd := math.abs(px - ll52)
        nm := "52W Low"
    if not na(d_sma200) and math.abs(px - d_sma200) <= bd
        bd := math.abs(px - d_sma200)
        nm := "200-DMA"
    if not na(d_sma50) and math.abs(px - d_sma50) <= bd
        bd := math.abs(px - d_sma50)
        nm := "50-DMA"
    if not na(ema20) and math.abs(px - ema20) <= bd
        bd := math.abs(px - ema20)
        nm := "EMA20"
    if not na(avwap) and math.abs(px - avwap) <= bd
        bd := math.abs(px - avwap)
        nm := "AVWAP"
    nm

// (The "did this level come from a manual handle?" test lives at the picker, where
//  the manual and auto pools are both in scope — see supSrc/resSrc. An earlier
//  f_ovSrc() here matched by VALUE against the 7 S/R handles, which could not see a
//  manual TRENDLINE at all, since v_tlLo/v_tlUp are declared further down.)

// ============================================================================
// 3. PIVOT COLLECTION
// ============================================================================
var array<int>   phx = array.new<int>()
var array<float> phy = array.new<float>()
var array<int>   plx = array.new<int>()
var array<float> ply = array.new<float>()
// v2.8: SEPARATE trendline-anchor pivots. Same LEFT context (piv_lb) so they're
// genuine swings, but confirmed with only 1 bar to the RIGHT — the most recent
// swing becomes a usable line endpoint immediately, instead of waiting piv_lb
// bars. Strict phx/plx (piv_lb,piv_lb) still drive S/R clusters + patterns
// (kept clean/lagging-confirmed); the trendline fitter uses these instead.
var array<int>   taphx = array.new<int>()
var array<float> taphy = array.new<float>()
var array<int>   taplx = array.new<int>()
var array<float> taply = array.new<float>()

float ph = ta.pivothigh(piv_lb, piv_lb)
float pl = ta.pivotlow(piv_lb, piv_lb)
if not na(ph)
    array.push(phx, bar_index - piv_lb)
    array.push(phy, ph)
    if array.size(phx) > maxPiv
        array.shift(phx)
        array.shift(phy)
if not na(pl)
    array.push(plx, bar_index - piv_lb)
    array.push(ply, pl)
    if array.size(plx) > maxPiv
        array.shift(plx)
        array.shift(ply)

int tl_right = tl_soft_anchor ? 1 : piv_lb
float taph = ta.pivothigh(piv_lb, tl_right)
float tapl = ta.pivotlow(piv_lb, tl_right)
if not na(taph)
    array.push(taphx, bar_index - tl_right)
    array.push(taphy, taph)
    if array.size(taphx) > maxPiv
        array.shift(taphx)
        array.shift(taphy)
if not na(tapl)
    array.push(taplx, bar_index - tl_right)
    array.push(taply, tapl)
    if array.size(taplx) > maxPiv
        array.shift(taplx)
        array.shift(taply)

// ============================================================================
// 4. BEST-FIT TRENDLINE (max touches within tolerance through pivot pairs)
//    Returns [x1,y1,x2,y2,touches]. Direction-agnostic so it naturally yields
//    rising channels (Stage 2) or descending resistance (Stage 4).
// ============================================================================
// upper=true → line must be a true RESISTANCE (no pivot pierces meaningfully ABOVE);
// upper=false → true SUPPORT (no pivot pierces BELOW). Among valid (non-pierced)
// lines, pick the one with the most touches. This keeps geometry trend-consistent.
f_fit(array<int> xs, array<float> ys, float tol, bool upper, int recentK, bool noBreak, bool wickOk, int minSpace, float recencyW, float emaSlope, float emaCur, float atrRef, float emaW, float angleW, float idealK, float cutMult) =>
    int n = array.size(xs)
    int s = math.max(0, n - recentK)   // consider only the last recentK pivots → anchors near CMP
    float bx1 = na
    float by1 = na
    float bx2 = na
    float by2 = na
    int best = 0
    float bestScore = -1.0
    if n - s >= 2
        for i = s to n - 2
            for j = i + 1 to n - 1
                int xi = array.get(xs, i)
                float yi = array.get(ys, i)
                int xj = array.get(xs, j)
                float yj = array.get(ys, j)
                if xj != xi
                    float slope = (yj - yi) / (xj - xi)
                    int t = 0
                    int pierce = 0
                    int lastTx = -99999
                    bool brk = false
                    float cutTol = cutMult * tol
                    // ============================================================
                    // v2.8 ARCHITECTURAL FIX — count touches + CLOSE-respect against
                    // EVERY BAR'S WICK in the span, not just the detected pivot set.
                    // Before v2.8 the inner loop walked only xs/ys (the pivots), so a
                    // swing the line grazes that was never flagged a strict pivot was
                    // INVISIBLE — it could never add a touch (Jay: "4th pivot valid by
                    // eye, engine didn't sense it"). Now the line is judged by the real
                    // price action it hugs: any bar whose wick lands within the band
                    // counts, pivot or not. The anchors (xi/xj) still set the geometry;
                    // selection maximises true wick-touches → far less rigid.
                    // ============================================================
                    int bStart = int(math.max(math.min(xi, xj), bar_index - 400))
                    for b = bStart to bar_index
                        float lineYb = yi + slope * (b - xi)
                        float wick = upper ? high[bar_index - b] : low[bar_index - b]
                        float cls  = close[bar_index - b]
                        float diff = wick - lineYb
                        // v2.7 ASYMMETRIC touch (Jay's rule): the line may cut DEEP into
                        // a wick (up to cutTol) and still count as a touch; the 'float'
                        // side (wick away from the line) stays tight (tol).
                        bool isTouch = upper ? (diff >= -tol and diff <= cutTol) : (diff >= -cutTol and diff <= tol)
                        if isTouch
                            // v2.5 (Bulkowski): only WELL-SEPARATED touches count as
                            // distinct tests — a 2-bar cluster is one touch, not three.
                            if b - lastTx >= minSpace
                                t := t + 1
                                lastTx := b
                        // v2.4: wick pierce only disqualifies when wickOk is OFF —
                        // Jay's rule: wicks may pierce; CLOSES are the only hard test.
                        else if not wickOk and upper and diff > cutTol
                            pierce := pierce + 1
                        else if not wickOk and not upper and diff < -cutTol
                            pierce := pierce + 1
                        // CLOSE-respect: no candle may CLOSE beyond the line in its span
                        if noBreak and ((upper and cls > lineYb + tol) or (not upper and cls < lineYb - tol))
                            brk := true
                    // quality score (v2.3): TOUCHES STRICTLY DOMINATE. The biases
                    // (recency, EMA20-confluence, ideal-angle) are normalised to a
                    // combined 0..0.99, so they can only break ties between lines
                    // with EQUAL touch counts — never outvote a pivot. (Pre-v2.3
                    // they could add ~3 touches of score, letting a recent 2-touch
                    // line beat a valid 3-touch line — Jay's rule: pivots first.)
                    float lineYnow  = yi + slope * (bar_index - xi)
                    float proxScore = atrRef > 0 ? math.max(0.0, 1.0 - math.abs(lineYnow - emaCur) / atrRef) : 0.0
                    float parScore  = atrRef > 0 ? math.max(0.0, 1.0 - math.abs(slope - emaSlope) / atrRef) : 0.0
                    float emaAlign  = 0.7 * proxScore + 0.3 * parScore
                    float idealMag = idealK * atrRef
                    float angleScore = idealMag > 0 ? math.max(0.0, 1.0 - math.abs(math.abs(slope) - idealMag) / idealMag) : 0.0
                    float recN = (n - 2 - s) > 0 ? float(i - s) / float(n - 2 - s) : 0.0
                    float biasDen = recencyW + emaW + angleW
                    float bias = biasDen > 0 ? 0.99 * (recencyW * recN + emaW * emaAlign + angleW * angleScore) / biasDen : 0.0
                    float score = float(t) + bias
                    if pierce == 0 and not brk and score > bestScore
                        bestScore := score
                        best := t
                        bx1 := xi
                        by1 := yi
                        bx2 := xj
                        by2 := yj
    [bx1, by1, bx2, by2, best]

// v2.2: TOP-2 horizontal clusters in a pivot array, within price band [lo,hi]
// (band filters out stale pivots off the current 52W range). The 2nd cluster
// must sit clear of the 1st (> 2×tol away) so it's a genuinely distinct level.
// v2.3: also returns the FIRST contributing pivot's bar, so the level is drawn
// from where it actually began (not a flat 200 bars back through history).
// → [level1, count1, firstBar1, level2, count2, firstBar2]
f_cluster2(array<int> xs, array<float> ys, float tol, float lo, float hi, int minSpace) =>
    int n = array.size(ys)
    float l1 = na
    int   c1 = 0
    float l2 = na
    int   c2 = 0
    if n >= 2
        for i = 0 to n - 1
            float yi = array.get(ys, i)
            if yi >= lo and yi <= hi
                int c = 0
                float sum = 0.0
                int lastTx = -99999
                for k = 0 to n - 1
                    float yk = array.get(ys, k)
                    int xk = array.get(xs, k)
                    if yk >= lo and yk <= hi and math.abs(yk - yi) <= tol and xk - lastTx >= minSpace
                        c := c + 1
                        sum := sum + yk
                        lastTx := xk
                if c > c1
                    c1 := c
                    l1 := sum / c
        for i = 0 to n - 1
            float yi = array.get(ys, i)
            if yi >= lo and yi <= hi and (na(l1) or math.abs(yi - l1) > 2 * tol)
                int c = 0
                float sum = 0.0
                int lastTx = -99999
                for k = 0 to n - 1
                    float yk = array.get(ys, k)
                    int xk = array.get(xs, k)
                    if yk >= lo and yk <= hi and math.abs(yk - yi) <= tol and (na(l1) or math.abs(yk - l1) > tol) and xk - lastTx >= minSpace
                        c := c + 1
                        sum := sum + yk
                        lastTx := xk
                if c > c2
                    c2 := c
                    l2 := sum / c
    int fx1 = na
    int fx2 = na
    if not na(l1)
        for k = 0 to n - 1
            float yk = array.get(ys, k)
            if yk >= lo and yk <= hi and math.abs(yk - l1) <= tol
                int xk = array.get(xs, k)
                fx1 := na(fx1) ? xk : math.min(fx1, xk)
    if not na(l2)
        for k = 0 to n - 1
            float yk = array.get(ys, k)
            if yk >= lo and yk <= hi and math.abs(yk - l2) <= tol
                int xk = array.get(xs, k)
                fx2 := na(fx2) ? xk : math.min(fx2, xk)
    [l1, c1, fx1, l2, c2, fx2]

// Lowest pivot-low strictly between bar indices a and b (na if none) — neckline for tops
f_troughBetween(array<int> lxs, array<float> lys, int a, int b) =>
    float lo = na
    if array.size(lxs) > 0
        for m = 0 to array.size(lxs) - 1
            int lx = array.get(lxs, m)
            if lx > a and lx < b
                float ly = array.get(lys, m)
                lo := na(lo) ? ly : math.min(lo, ly)
    lo

// Highest pivot-high strictly between bar indices a and b (na if none) — neckline for bottoms
f_peakBetween(array<int> hxs, array<float> hys, int a, int b) =>
    float hi = na
    if array.size(hxs) > 0
        for m = 0 to array.size(hxs) - 1
            int hx = array.get(hxs, m)
            if hx > a and hx < b
                float hy = array.get(hys, m)
                hi := na(hi) ? hy : math.max(hi, hy)
    hi

// ============================================================================
// 5. RENDER (last bar only) — trendlines, geometry, apex, levels, panel
// ============================================================================
var line  lnUp   = na
var line  lnLo   = na
var line  lnHH   = na
var line  lnLL   = na
var line  lnApex = na
var label lbUp   = na
var label lbLo   = na
var label lbApex = na
var table panel  = na
// v1.1 classical-pattern handles
var line  lnR    = na
var line  lnS    = na
var label lbR    = na
var label lbS    = na
var box   bxFlag = na
var label lbFlag = na
var line  lnNeck = na
var label lbDT   = na
// Batch 2 handles
var line  lnHS   = na
var label lbHS   = na
var label lbCup  = na
// v1.3 Fib handles
var line  fib50L  = na
var line  fib618L = na
var line  fibE1L  = na
var line  fibE2L  = na
var label fib50Lb = na
var label fib618Lb = na
var label fibE1Lb = na
var label fibE2Lb = na
// v1.4 descriptive-note handles
var label lbSupN = na
var label lbResN = na
var label lbAvwN = na
// v2.2 second-cluster handles
var line  lnR2 = na
var line  lnS2 = na
var label lbR2 = na
var label lbS2 = na
// v2.9 manual-override handles
var array<line>  ovLines = array.new<line>()
var array<label> ovLbls  = array.new<label>()
var line  lnOvTlS = na
var line  lnOvTlR = na
var label lbOvTlS = na
var label lbOvTlR = na
var box   bxOv    = na

// Draw one TF-scoped manual level. MUST live at global scope — Pine does not allow
// a function to be declared inside a conditional block.
// Line WEIGHT encodes conviction, matching the doctrine that the timeframe a level
// is drawn on IS its weight: Monthly thickest/solid, Weekly medium, Daily thin.
// You should be able to tell a weekly floor from a daily one without reading a word.
f_drawLv(float px, bool tfOk, string tfTag) =>
    if f_lvOn(px, tfOk)
        int   w  = tfTag == "M" ? 3 : tfTag == "W" ? 2 : 1
        color lc = tfTag == "M" ? c_lvM : tfTag == "W" ? c_lvW : c_lvD
        array.push(ovLines, line.new(bar_index - 300, px, bar_index + 10, px, xloc=xloc.bar_index, color=color.new(lc, 0), width=w, extend=extend.right))
        array.push(ovLbls,  label.new(bar_index + 10, px, tfTag + " · " + f_lvRole(px) + "  " + str.tostring(px, format.mintick) + " · " + f_ovName(px), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(lc, 82), textcolor=lc, size=size.small))

// v2.3 S/R touch-dot handles
var array<label> srDotLbls = array.new<label>()
// v2.7 debug pivot-marker handles
var array<label> dbgLbls = array.new<label>()

// v2.2 alert state — levels published by the last-bar render, event edges one-shot
var float v_tlUp = na   // resistance trendline value at the current bar
var float v_tlLo = na   // support trendline value at the current bar
var float v_tlUpSlope = na
var float v_tlLoSlope = na
var float v_R1   = na   // strongest resistance cluster
var float v_S1   = na   // strongest support cluster
// v2.5 throwback memory — a broken trendline stays on the chart in its flipped
// role (the retest of the broken line is the classic low-risk entry)
var int   brkUpBar  = na
var float brkUpY    = na
var float brkUpSlp  = na
var int   brkDnBar  = na
var float brkDnY    = na
var float brkDnSlp  = na
var line  lnBrkUp = na
var label lbBrkUp = na
var line  lnBrkDn = na
var label lbBrkDn = na
var bool ev_tl_up = false
var bool pv_tl_up = false
var bool ev_tl_dn = false
var bool pv_tl_dn = false
var bool ev_r_brk = false
var bool pv_r_brk = false
var bool ev_s_brk = false
var bool pv_s_brk = false
var bool ev_pat   = false
var bool pv_pat   = false
var bool ev_pb    = false
var bool pv_pb    = false
var bool ev_conv  = false
var bool pv_conv  = false

// v2.2: panel position input now applies without a chart reload
var string _ppPrev = panel_posS
if panel_posS != _ppPrev
    table.delete(panel)
    panel := na
    _ppPrev := panel_posS

// gap markers (per-bar, self-managing)
bool gapUp = show_gaps and not na(close[1]) and open > close[1] * (1.0 + gap_pct / 100.0) and volume > volSma50 * gap_volx and close > open
bool gapDn = show_gaps and not na(close[1]) and open < close[1] * (1.0 - gap_pct / 100.0) and volume > volSma50 * gap_volx and close < open
plotshape(gapUp, "Breakaway gap up", style=shape.triangleup, location=location.belowbar, color=color.new(c_up, 0), size=size.small)
plotshape(gapDn, "Breakaway gap dn", style=shape.triangledown, location=location.abovebar, color=color.new(c_dn, 0), size=size.small)

// MAs for stage context
plot(show_ema20 ? ema20 : na, "EMA20", color=color.new(c_ema20, 0), linewidth=2)
plot(show_ma ? sma50 : na, "SMA50", color=color.new(c_ma50, 0), linewidth=1)
plot(show_ma ? sma150 : na, "SMA150", color=color.new(c_ma150, 40), linewidth=1)
plot(show_ma ? sma200 : na, "SMA200", color=color.new(c_ma200, 0), linewidth=1)

// geometry holders (string for panel)
var string geom = "—"
var string apexTxt = "—"
var string setup = "—"
var string verdict = "—"
var string pats = "none"

if barstate.islast
    float tolUp = tol_up_atr * atr14   // v2.6: per-side touch tolerance
    float tolLo = tol_lo_atr * atr14
    float tol = math.max(tolUp, tolLo) // shared fallback for any non-fit use
    int tSpace = math.max(3, 2 * piv_lb)   // v2.5: distinct-touch spacing (Bulkowski)
    // v2.5 (Magee): in a downtrend THE trendline runs along the highs (the line
    // under the lows is the channel's return line) — and vice versa in an uptrend.
    int trendDir = stage == 2 ? 1 : stage == 4 ? -1 : (not na(d_sma50) and close > d_sma50 ? 1 : -1)

    // v2.9 FIX1 (widened) — UNCONDITIONAL stale-state cleanup for EVERY drawing this
    // block owns. v2.1 applied this to the trendlines only; every other subsystem kept
    // its delete INSIDE its own `if show_*` gate, so switching a feature OFF skipped the
    // delete and froze its last drawing on the chart permanently. That made tuning
    // actively misleading — you could be reading a ghost level from three settings ago.
    // RULE: deletes belong here, unconditionally. Draw calls stay behind their gates.
    line.delete(lnUp)
    label.delete(lbUp)
    line.delete(lnLo)
    label.delete(lbLo)
    line.delete(lnApex)
    label.delete(lbApex)
    line.delete(lnHH)          // was gated by show_levels
    line.delete(lnLL)
    line.delete(lnR)           // was gated by show_sr
    label.delete(lbR)
    line.delete(lnS)
    label.delete(lbS)
    line.delete(lnR2)
    label.delete(lbR2)
    line.delete(lnS2)
    label.delete(lbS2)
    box.delete(bxFlag)         // was gated by show_flags
    label.delete(lbFlag)
    line.delete(lnNeck)        // was gated by show_dt
    label.delete(lbDT)
    line.delete(lnHS)          // was gated by show_hs
    label.delete(lbHS)
    label.delete(lbCup)        // was gated by show_cup
    label.delete(lbResN)       // was gated by show_notes
    label.delete(lbSupN)
    label.delete(lbAvwN)
    line.delete(lnOvTlS)       // v2.9 manual TLs — created in the TL section BELOW,
    line.delete(lnOvTlR)       // so their deletes must live here, ahead of it. (Left
    label.delete(lbOvTlS)      // in the override block they would have deleted the
    label.delete(lbOvTlR)      // line that had just been drawn.)
    geom := "—"
    apexTxt := "—"
    v_tlUp := na
    v_tlLo := na
    v_tlUpSlope := na
    v_tlLoSlope := na
    v_R1   := na
    v_S1   := na

    // --- fit upper resistance (highs) & lower support (lows), recent pivots only ---
    [ux1, uy1, ux2, uy2, ut] = f_fit(taphx, taphy, tolUp, true, trend_piv_up, tl_nobreak, tl_wick_ok, tSpace, tl_recency, ema_slope, ema20, atr14, tl_ema_w, tl_angle_w, tl_ideal, tl_cut_mult)
    [vx1, vy1, vx2, vy2, vt] = f_fit(taplx, taply, tolLo, false, trend_piv_lo, tl_nobreak, tl_wick_ok, tSpace, tl_recency, ema_slope, ema20, atr14, tl_ema_w, tl_angle_w, tl_ideal, tl_cut_mult)

    float slopeU = na
    float slopeL = na
    // v2.9 MANUAL TRENDLINES — handled HERE, alongside the auto-fit, not in the
    // override block below. Two reasons this matters:
    //  1. slopeU/slopeL feed the channel/wedge geometry classifier a few lines down.
    //     Drawing the manual line later would leave them `na` and silently blank the
    //     GEOM read whenever you drew your own line.
    //  2. The manual anchors are in TIME (ms) while the auto anchors are in bar_index.
    //     Assigning a price-per-ms slope into a variable holding price-per-bar is the
    //     same dimensional error that made `parScore` a useless constant — so convert.
    //     The geometry tests are ratio-based, so a consistent scale factor is safe.
    float _msPerBar = math.max(1.0, timeframe.in_seconds(timeframe.period) * 1000.0)
    if show_tl and ovTlR_live
        float _slMs = (ov_tlr_p2 - ov_tlr_p1) / math.max(1, ov_tlr_t2 - ov_tlr_t1)
        slopeU      := _slMs * _msPerBar                       // → price per BAR
        v_tlUp      := ov_tlr_p2 + _slMs * (time - ov_tlr_t2)  // project to this bar
        v_tlUpSlope := slopeU
        lnOvTlR := line.new(ov_tlr_t1, ov_tlr_p1, ov_tlr_t2, ov_tlr_p2, xloc=xloc.bar_time, extend=extend.right, color=color.new(c_manual, 0), width=2)
        lbOvTlR := label.new(time, v_tlUp, "TRENDLINE ▼ manual", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(c_manual, 80), textcolor=c_manual, size=size.small)
    if show_tl and ovTlS_live
        float _slMs = (ov_tls_p2 - ov_tls_p1) / math.max(1, ov_tls_t2 - ov_tls_t1)
        slopeL      := _slMs * _msPerBar
        v_tlLo      := ov_tls_p2 + _slMs * (time - ov_tls_t2)
        v_tlLoSlope := slopeL
        lnOvTlS := line.new(ov_tls_t1, ov_tls_p1, ov_tls_t2, ov_tls_p2, xloc=xloc.bar_time, extend=extend.right, color=color.new(c_manual, 0), width=2)
        lbOvTlS := label.new(time, v_tlLo, "TRENDLINE ▲ manual", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(c_manual, 80), textcolor=c_manual, size=size.small)

    // A live manual line REPLACES the auto-fit for that side — otherwise both would
    // render and you'd have two lines per side with no way to know which one the
    // plan and the alerts actually used.
    if show_tl and not ovTlR_live and not na(ux1) and ux2 != ux1
        slopeU := (uy2 - uy1) / (ux2 - ux1)
        bool validU = ut >= min_touch
        color cU = slopeU < 0 ? color.new(c_dn, 0) : color.new(c_up, 0)
        float uy_now = uy1 + slopeU * (bar_index - ux1)
        v_tlUp := uy_now           // publish for alerts + panel TL-BREAK row
        v_tlUpSlope := slopeU      // for throwback memory
        // v2.5 (Magee): in a downtrend the line along the HIGHS is THE trendline;
        // in an uptrend it's only the channel's return line.
        string roleU = trendDir == -1 ? "TRENDLINE ▼ " : "Return line "
        lnUp := line.new(int(ux1), uy1, bar_index, uy_now, xloc=xloc.bar_index, extend=extend.none, color=cU, width=2, style=(validU ? line.style_solid : line.style_dashed))
        lbUp := label.new(bar_index, uy_now, roleU + (validU ? "VALID " : "prov. ") + str.tostring(ut) + "×", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(cU, 80), textcolor=cU, size=size.small)

    if show_tl and not ovTlS_live and not na(vx1) and vx2 != vx1
        slopeL := (vy2 - vy1) / (vx2 - vx1)
        bool validL = vt >= min_touch
        color cL = slopeL > 0 ? color.new(c_up, 0) : color.new(c_dn, 0)
        float vy_now = vy1 + slopeL * (bar_index - vx1)
        v_tlLo := vy_now           // publish for alerts + panel TL-BREAK row
        v_tlLoSlope := slopeL      // for throwback memory
        string roleL = trendDir == 1 ? "TRENDLINE ▲ " : "Return line "
        lnLo := line.new(int(vx1), vy1, bar_index, vy_now, xloc=xloc.bar_index, extend=extend.none, color=cL, width=2, style=(validL ? line.style_solid : line.style_dashed))
        lbLo := label.new(bar_index, vy_now, roleL + (validL ? "VALID " : "prov. ") + str.tostring(vt) + "×", xloc=xloc.bar_index, style=label.style_label_up, color=color.new(cL, 80), textcolor=cL, size=size.small)

    // --- v2.7 DEBUG: mark every tracked pivot (verify the engine's raw inputs) ---
    if array.size(dbgLbls) > 0
        for di = 0 to array.size(dbgLbls) - 1
            label.delete(array.get(dbgLbls, di))
        array.clear(dbgLbls)
    if tl_debug
        // v2.8: mark the TRENDLINE ANCHOR swings (what the fitter actually uses),
        // not the strict S/R pivots — so a recent 1-bar-confirmed swing shows here.
        for k = 0 to array.size(taphy) - 1
            array.push(dbgLbls, label.new(array.get(taphx, k), array.get(taphy, k), "", xloc=xloc.bar_index, style=label.style_xcross, color=color.new(c_dn, 0), size=size.tiny))
        for k = 0 to array.size(taply) - 1
            array.push(dbgLbls, label.new(array.get(taplx, k), array.get(taply, k), "", xloc=xloc.bar_index, style=label.style_xcross, color=color.new(c_up, 0), size=size.tiny))

    // --- geometry classification ---
    if not na(slopeU) and not na(slopeL)
        float avgMag = (math.abs(slopeU) + math.abs(slopeL)) / 2.0
        float conv = slopeU - slopeL          // <0 converging, >0 diverging
        bool sameDir = (slopeU > 0) == (slopeL > 0)
        bool parallelish = avgMag > 0 and math.abs(conv) <= 0.25 * avgMag and sameDir
        if parallelish
            geom := slopeU > 0 ? "Rising channel" : "Falling channel"
        else if conv < 0   // narrowing
            geom := (slopeU < 0 and slopeL < 0) ? "Falling wedge" : (slopeU > 0 and slopeL > 0) ? "Rising wedge" : "Triangle (converging)"
        else               // widening
            geom := (slopeU > 0 and slopeL > 0) ? "Uptrend (rising support/resist, not parallel)" : (slopeU < 0 and slopeL < 0) ? "Downtrend (falling, not parallel)" : "Broadening"

        // --- apex (where upper & lower cross) — deletes/reset handled by FIX1 ---
        float denom = slopeU - slopeL
        if math.abs(denom) > 1e-9
            // uy1 + slopeU*(x-ux1) = vy1 + slopeL*(x-vx1)
            float xApex = (vy1 - uy1 - slopeL * vx1 + slopeU * ux1) / denom
            float yApex = uy1 + slopeU * (xApex - ux1)
            int barsAhead = int(xApex) - bar_index
            if show_apex and barsAhead > 0 and barsAhead < 300
                lnApex := line.new(int(xApex), yApex, int(xApex), yApex + atr14, xloc=xloc.bar_index, extend=extend.both, color=color.new(c_apex, 30), width=1, style=line.style_dotted)
                lbApex := label.new(int(xApex), yApex, "◆ apex ~" + str.tostring(yApex, format.mintick) + " · " + str.tostring(barsAhead) + " bars", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(c_apex, 70), textcolor=c_apex, size=size.small)
                apexTxt := str.tostring(yApex, format.mintick) + " in " + str.tostring(barsAhead) + " bars"

    // --- 52W high / low levels ---
    if show_levels
        lnHH := line.new(bar_index - look52, hh52, bar_index + 10, hh52, xloc=xloc.bar_index, color=color.new(c_52h, 0), width=1, style=line.style_dotted)
        lnLL := line.new(bar_index - look52, ll52, bar_index + 10, ll52, xloc=xloc.bar_index, color=color.new(c_52l, 0), width=1, style=line.style_dotted)

    // --- setup + verdict ---
    float distHi = hh52 > 0 ? (hh52 - close) / hh52 * 100.0 : na
    bool nearMA = not na(d_sma50) and math.abs(close - d_sma50) <= pb_atr * atr14   // v2.2: daily-canonical 50-MA
    if stage == 4 and not rs_pos
        setup := "STAGE 4 decline"
        verdict := "EXIT / avoid — no new longs"
    else if reclaim_30w and (stage == 1 or stage == 2) and rs_pos
        setup := "Stage 4→2 reversal (30-WMA reclaim)"
        verdict := "Emerging long — confirm RS rising"
    else if stage == 2 and minervini_up and rs_pos
        if nearMA
            setup := "SWG-PB (pullback to rising MA)"
            verdict := "Buy-the-dip — entry on MA reclaim, stop < MA"
        else if not na(distHi) and distHi <= nearHi_pct
            setup := "Stage 2 at highs"
            verdict := "Breakout/continuation — buy strength, watch extension"
        else
            setup := "Stage 2 uptrend"
            verdict := "Hold / add on pullback to MA"
    else if stage == 1
        setup := "Stage 1 base"
        verdict := "Watch — needs breakout + RS > 0"
    else
        setup := "Neutral / mixed"
        verdict := "No edge — wait"

    // ========================================================================
    // 5b. CLASSICAL PATTERNS (v1.1 Batch 1)
    // ========================================================================
    pats := ""

    // --- horizontal Support / Resistance zones (pivot clustering, TOP-2 v2.2) ---
    // v2.3: lines start at the FIRST contributing pivot (no stale back-extension),
    // contributing pivots get dots, and a level price has crossed is labelled as
    // FLIPPED (old resistance below price = support now, and vice versa).
    if array.size(srDotLbls) > 0
        for di = 0 to array.size(srDotLbls) - 1
            label.delete(array.get(srDotLbls, di))
        array.clear(srDotLbls)
    if show_sr
        float srTol = sr_tol_atr * atr14
        [rLvl, rCnt, rFx, rLvl2, rCnt2, rFx2] = f_cluster2(phx, phy, srTol, ll52, hh52, tSpace)
        [sLvl, sCnt, sFx, sLvl2, sCnt2, sFx2] = f_cluster2(plx, ply, srTol, ll52, hh52, tSpace)
        if not na(rLvl) and rCnt >= sr_min_t
            v_R1 := rLvl   // publish for alerts + nearest-level pickers
            bool rFlip = close > rLvl
            string rTag = (rFlip ? "R-flip→S " : "R ") + str.tostring(rCnt) + "×"
            lnR := line.new(na(rFx) ? bar_index - 200 : rFx, rLvl, bar_index + 10, rLvl, xloc=xloc.bar_index, color=color.new(c_dn, 20), width=1)
            lbR := label.new(bar_index + 10, rLvl, rTag, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_dn, 80), textcolor=c_dn, size=size.small)
            if sr_dots
                for k = 0 to array.size(phy) - 1
                    float yk = array.get(phy, k)
                    if yk >= ll52 and yk <= hh52 and math.abs(yk - rLvl) <= srTol
                        array.push(srDotLbls, label.new(array.get(phx, k), yk, "", xloc=xloc.bar_index, style=label.style_circle, color=color.new(c_dn, 30), size=size.tiny))
        if not na(rLvl2) and rCnt2 >= sr_min_t
            lnR2 := line.new(na(rFx2) ? bar_index - 200 : rFx2, rLvl2, bar_index + 10, rLvl2, xloc=xloc.bar_index, color=color.new(c_dn, 55), width=1, style=line.style_dotted)
            lbR2 := label.new(bar_index + 10, rLvl2, "R2 " + str.tostring(rCnt2) + "×", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_dn, 88), textcolor=color.new(c_dn, 30), size=size.small)
        if not na(sLvl) and sCnt >= sr_min_t
            v_S1 := sLvl   // publish for alerts + nearest-level pickers
            bool sFlip = close < sLvl
            string sTag = (sFlip ? "S-flip→R " : "S ") + str.tostring(sCnt) + "×"
            lnS := line.new(na(sFx) ? bar_index - 200 : sFx, sLvl, bar_index + 10, sLvl, xloc=xloc.bar_index, color=color.new(c_up, 20), width=1)
            lbS := label.new(bar_index + 10, sLvl, sTag, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_up, 80), textcolor=c_up, size=size.small)
            if sr_dots
                for k = 0 to array.size(ply) - 1
                    float yk = array.get(ply, k)
                    if yk >= ll52 and yk <= hh52 and math.abs(yk - sLvl) <= srTol
                        array.push(srDotLbls, label.new(array.get(plx, k), yk, "", xloc=xloc.bar_index, style=label.style_circle, color=color.new(c_up, 30), size=size.tiny))
        if not na(sLvl2) and sCnt2 >= sr_min_t
            lnS2 := line.new(na(sFx2) ? bar_index - 200 : sFx2, sLvl2, bar_index + 10, sLvl2, xloc=xloc.bar_index, color=color.new(c_up, 55), width=1, style=line.style_dotted)
            lbS2 := label.new(bar_index + 10, sLvl2, "S2 " + str.tostring(sCnt2) + "×", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_up, 88), textcolor=color.new(c_up, 30), size=size.small)

    // --- flags (impulse leg + tight consolidation) ---
    if show_flags
        float consHi = flagConsHi
        float consLo = flagConsLo
        float consRange = consHi - consLo
        float priorMove = close[flag_cons] - close[flag_cons + flag_imp]
        bool tight = consRange < flag_rngA * atr14
        bool bullFlag = tight and priorMove > flag_impA * atr14
        bool bearFlag = tight and priorMove < -flag_impA * atr14
        if bullFlag or bearFlag
            color fc = bullFlag ? c_up : c_dn
            bxFlag := box.new(bar_index - flag_cons + 1, consHi, bar_index, consLo, border_color=fc, bgcolor=color.new(fc, 88), border_width=1)
            lbFlag := label.new(bar_index - flag_cons + 1, consHi, (bullFlag ? "Bull" : "Bear") + " flag", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(fc, 70), textcolor=fc, size=size.small)
            pats := (bullFlag ? "Bull flag" : "Bear flag")

    // --- double / triple top & bottom (equal pivots + neckline) ---
    if show_dt
        float dtTol = dt_tol_atr * atr14
        bool drewDT = false
        // TOPS (pivot highs)
        int nH = array.size(phy)
        if nH >= 2 and not drewDT
            float h1 = array.get(phy, nH - 1)
            float h2 = array.get(phy, nH - 2)
            int hx1 = array.get(phx, nH - 1)
            int hx2 = array.get(phx, nH - 2)
            bool trip = false
            if nH >= 3
                float h3 = array.get(phy, nH - 3)
                trip := math.abs(h3 - h1) <= dtTol and math.abs(h3 - h2) <= dtTol
            if math.abs(h1 - h2) <= dtTol and (hx1 - hx2) >= dt_min_gap * piv_lb
                float neck = f_troughBetween(plx, ply, hx2, hx1)
                if not na(neck) and (math.min(h1, h2) - neck) >= dt_depth_atr * atr14
                    string nm = (trip ? "Triple" : "Double") + " Top" + (close < neck ? " ✓break" : "")
                    lnNeck := line.new(hx2, neck, bar_index + 10, neck, xloc=xloc.bar_index, color=color.new(c_dn, 0), width=1, style=line.style_dashed)
                    lbDT := label.new(hx1, math.max(h1, h2), nm, xloc=xloc.bar_index, style=label.style_label_down, color=color.new(c_dn, 70), textcolor=c_dn, size=size.small)
                    pats := str.length(pats) == 0 ? nm : pats + " · " + nm
                    drewDT := true
        // BOTTOMS (pivot lows)
        int nL = array.size(ply)
        if nL >= 2 and not drewDT
            float l1 = array.get(ply, nL - 1)
            float l2 = array.get(ply, nL - 2)
            int lx1 = array.get(plx, nL - 1)
            int lx2 = array.get(plx, nL - 2)
            bool trip2 = false
            if nL >= 3
                float l3 = array.get(ply, nL - 3)
                trip2 := math.abs(l3 - l1) <= dtTol and math.abs(l3 - l2) <= dtTol
            if math.abs(l1 - l2) <= dtTol and (lx1 - lx2) >= dt_min_gap * piv_lb
                float neck2 = f_peakBetween(phx, phy, lx2, lx1)
                if not na(neck2) and (neck2 - math.max(l1, l2)) >= dt_depth_atr * atr14
                    string nm2 = (trip2 ? "Triple" : "Double") + " Bottom" + (close > neck2 ? " ✓break" : "")
                    lnNeck := line.new(lx2, neck2, bar_index + 10, neck2, xloc=xloc.bar_index, color=color.new(c_up, 0), width=1, style=line.style_dashed)
                    lbDT := label.new(lx1, math.min(l1, l2), nm2, xloc=xloc.bar_index, style=label.style_label_up, color=color.new(c_up, 70), textcolor=c_up, size=size.small)
                    pats := str.length(pats) == 0 ? nm2 : pats + " · " + nm2

    // --- Head & Shoulders (+ inverse) — CANDIDATE (heuristic, last 3 pivots) ---
    if show_hs
        float hsTol = hs_tol_atr * atr14
        bool drewHS = false
        // regular H&S — 3 pivot highs, head highest, shoulders ~equal
        int nHh = array.size(phy)
        if nHh >= 3
            float lsh = array.get(phy, nHh - 3)
            float hdh = array.get(phy, nHh - 2)
            float rsh = array.get(phy, nHh - 1)
            int xlsh = array.get(phx, nHh - 3)
            int xhdh = array.get(phx, nHh - 2)
            int xrsh = array.get(phx, nHh - 1)
            if hdh > lsh and hdh > rsh and math.abs(lsh - rsh) <= hsTol and (hdh - math.max(lsh, rsh)) > hsTol
                float t1h = f_troughBetween(plx, ply, xlsh, xhdh)
                float t2h = f_troughBetween(plx, ply, xhdh, xrsh)
                if not na(t1h) and not na(t2h)
                    float neckH = (t1h + t2h) / 2.0
                    string nmh = "H&S" + (close < neckH ? " ✓break" : " (cand)")
                    lnHS := line.new(xlsh, neckH, bar_index + 10, neckH, xloc=xloc.bar_index, color=color.new(c_dn, 0), width=1, style=line.style_dotted)
                    lbHS := label.new(xhdh, hdh, nmh, xloc=xloc.bar_index, style=label.style_label_down, color=color.new(c_dn, 75), textcolor=c_dn, size=size.small)
                    pats := str.length(pats) == 0 ? nmh : pats + " · " + nmh
                    drewHS := true
        // inverse H&S — 3 pivot lows, head lowest
        int nLh = array.size(ply)
        if nLh >= 3 and not drewHS
            float lsl = array.get(ply, nLh - 3)
            float hdl = array.get(ply, nLh - 2)
            float rsl = array.get(ply, nLh - 1)
            int xlsl = array.get(plx, nLh - 3)
            int xhdl = array.get(plx, nLh - 2)
            int xrsl = array.get(plx, nLh - 1)
            if hdl < lsl and hdl < rsl and math.abs(lsl - rsl) <= hsTol and (math.min(lsl, rsl) - hdl) > hsTol
                float t1l = f_peakBetween(phx, phy, xlsl, xhdl)
                float t2l = f_peakBetween(phx, phy, xhdl, xrsl)
                if not na(t1l) and not na(t2l)
                    float neckL = (t1l + t2l) / 2.0
                    string nml = "Inv H&S" + (close > neckL ? " ✓break" : " (cand)")
                    lnHS := line.new(xlsl, neckL, bar_index + 10, neckL, xloc=xloc.bar_index, color=color.new(c_up, 0), width=1, style=line.style_dotted)
                    lbHS := label.new(xhdl, hdl, nml, xloc=xloc.bar_index, style=label.style_label_up, color=color.new(c_up, 75), textcolor=c_up, size=size.small)
                    pats := str.length(pats) == 0 ? nml : pats + " · " + nml

    // --- Cup & Handle — CANDIDATE (loose: two rims ~level, rounded low, handle) ---
    if show_cup
        int nHc = array.size(phy)
        if nHc >= 2
            float rightRim = array.get(phy, nHc - 1)
            int xRight = array.get(phx, nHc - 1)
            float leftRim = na
            int xLeft = na
            for m = nHc - 2 to 0
                float hm = array.get(phy, m)
                if na(leftRim) and math.abs(hm - rightRim) <= 0.05 * rightRim
                    leftRim := hm
                    xLeft := array.get(phx, m)
            if not na(leftRim) and not na(xLeft)
                float cupLow = f_troughBetween(plx, ply, xLeft, xRight)
                if not na(cupLow)
                    float depth = (rightRim - cupLow) / rightRim * 100.0
                    bool handle = close < rightRim and close > rightRim * 0.88
                    bool wideEnough = (xRight - xLeft) >= math.max(10, 4 * piv_lb)   // v2.2: no 2-bar "cups"
                    if depth >= cup_dmin and depth <= cup_dmax and handle and wideEnough
                        lbCup := label.new(xRight, rightRim, "Cup&Handle? (cand)", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(c_up, 75), textcolor=c_up, size=size.small)
                        pats := str.length(pats) == 0 ? "Cup&Handle? (cand)" : pats + " · Cup&Handle? (cand)"

    if str.length(pats) == 0
        pats := "none"

    // --- Fibonacci (Zigzag v6.2 port) — retrace high−r×range; ext low+r×range ---
    line.delete(fib50L)
    line.delete(fib618L)
    line.delete(fibE1L)
    line.delete(fibE2L)
    label.delete(fib50Lb)
    label.delete(fib618Lb)
    label.delete(fibE1Lb)
    label.delete(fibE2Lb)
    if (show_fib or show_fib_ext) and not na(fibHi) and not na(fibLo) and fibHi > fibLo
        int fS = bar_index - fibLook
        int fE = bar_index + fib_ext_bars
        if show_fib
            fib50L   := line.new(fS, fib_50,  fE, fib_50,  xloc=xloc.bar_index, color=color.new(c_fibR, 0), width=1)
            fib618L  := line.new(fS, fib_618, fE, fib_618, xloc=xloc.bar_index, color=color.new(c_fib618, 0), width=1)
            fib50Lb  := label.new(fE, fib_50,  "50% "   + str.tostring(fib_50,  format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=c_fibR, size=size.small)
            fib618Lb := label.new(fE, fib_618, "61.8% " + str.tostring(fib_618, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=c_fib618, size=size.small)
        if show_fib_ext
            if fib_e1 > 0
                fibE1L   := line.new(fS, fib_e1, fE, fib_e1, xloc=xloc.bar_index, color=color.new(c_fibE, 0), width=1)
                fibE1Lb  := label.new(fE, fib_e1, "1.272 " + str.tostring(fib_e1, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=c_fibE, size=size.small)
            if fib_e2 > 0
                fibE2L   := line.new(fS, fib_e2, fE, fib_e2, xloc=xloc.bar_index, color=color.new(c_fibE, 0), width=1)
                fibE2Lb  := label.new(fE, fib_e2, "1.618 " + str.tostring(fib_e2, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=c_fibE, size=size.small)

    // === v2.9 MANUAL OVERRIDES — draw + publish ==============================
    // Drawn LAST so a manual level sits on top of any auto level it replaces, and
    // in a distinct colour so you always know which levels are YOURS. Every one of
    // these is fed into the nearest-S/R pickers below, which is the single funnel
    // that the PLAN (entry/stop/target/R:R), the notes and the panel all read — so
    // a dragged level propagates everywhere without touching those consumers.
    if array.size(ovLbls) > 0
        for di = 0 to array.size(ovLbls) - 1
            label.delete(array.get(ovLbls, di))
        array.clear(ovLbls)
    if array.size(ovLines) > 0
        for di = 0 to array.size(ovLines) - 1
            line.delete(array.get(ovLines, di))
        array.clear(ovLines)
    box.delete(bxOv)

    // Highest TF first, so on a busy chart the Monthly line is drawn under the
    // lighter Weekly/Daily ones rather than burying them.
    f_drawLv(m1, showMonthlyLv, "M")
    f_drawLv(m2, showMonthlyLv, "M")
    f_drawLv(m3, showMonthlyLv, "M")
    f_drawLv(m4, showMonthlyLv, "M")
    f_drawLv(w1, showWeeklyLv,  "W")
    f_drawLv(w2, showWeeklyLv,  "W")
    f_drawLv(w3, showWeeklyLv,  "W")
    f_drawLv(w4, showWeeklyLv,  "W")
    f_drawLv(d1, showDailyLv,   "D")
    f_drawLv(d2, showDailyLv,   "D")
    f_drawLv(d3, showDailyLv,   "D")
    f_drawLv(d4, showDailyLv,   "D")

    // (Manual TRENDLINES are handled up in the trendline section — they must set
    //  slopeU/slopeL before the geometry classifier runs. See the v2.9 note there.)

    if f_ovT(ov_box_t1) and f_ovT(ov_box_t2) and f_ovOn(ov_box_top) and f_ovOn(ov_box_bot)
        bxOv := box.new(ov_box_t1, ov_box_top, ov_box_t2, ov_box_bot, xloc=xloc.bar_time, border_color=color.new(c_manual, 40), border_width=1, bgcolor=color.new(c_manual, 90))

    // === shared metrics (used by both the descriptive notes and the panel) ===
    int barsInStage = bar_index - stageStartBar
    string rsArrow = na(mansfield) ? "" : (rsRising ? " ↑" : " ↓")
    // v2.2: conviction MAs anchored to DAILY (canonical) on every chart TF
    int conv = (stage == 2 ? 1 : 0) + (rs_pos ? 1 : 0) + (rsRising ? 1 : 0) + ((not na(d_sma50) and close > d_sma50) ? 1 : 0) + ((not na(avwap) and close > avwap) ? 1 : 0) + ((not na(d_sma200) and close > d_sma200) ? 1 : 0) + (volRising ? 1 : 0)
    string convTxt = conv >= 6 ? "STRONG" : conv >= 4 ? "MODERATE" : "WEAK"
    color  convCol = conv >= 6 ? color.lime : conv >= 4 ? color.yellow : color.red
    // === nearest-level pickers — MANUAL pool and AUTO pool, resolved by priority ===
    // supN/resN is the single funnel the PLAN (entry/stop/target/R:R), the
    // descriptive notes and the panel LEVELS rows all read.
    //
    // v2.9: these are now built as TWO pools. v2.8 merged manual levels into one
    // flat nearest-wins pool, which meant a level you deliberately marked could be
    // outranked by an EMA20 or Fib that happened to sit a few ticks closer — your
    // level drew on the chart but never reached the panel or the plan. That
    // inverted the doctrine: your hand-drawn levels ARE the location layer, and the
    // auto candidates are the fallback for a side you haven't marked yet.
    //
    // Levels are candidates on BOTH sides — f_maxBelow/f_minAbove self-select by
    // which side of price each one sits, so an R dragged below price correctly
    // becomes support (a flip) and vice versa.
    // v2.11: the manual pool is the 12 TF-scoped levels — but ONLY those whose
    // timeframe is visible on this chart (f_lvOn embeds the guardrail), so a Daily
    // level cannot set the stop on a Weekly chart. Role is derived, so every level
    // is offered to BOTH sides and self-selects by which side of price it sits.
    float supM = na                                                // MANUAL pool (yours)
    supM := f_maxBelow(supM, close, f_lvOn(m1, showMonthlyLv) ? m1 : na)
    supM := f_maxBelow(supM, close, f_lvOn(m2, showMonthlyLv) ? m2 : na)
    supM := f_maxBelow(supM, close, f_lvOn(m3, showMonthlyLv) ? m3 : na)
    supM := f_maxBelow(supM, close, f_lvOn(m4, showMonthlyLv) ? m4 : na)
    supM := f_maxBelow(supM, close, f_lvOn(w1, showWeeklyLv) ? w1 : na)
    supM := f_maxBelow(supM, close, f_lvOn(w2, showWeeklyLv) ? w2 : na)
    supM := f_maxBelow(supM, close, f_lvOn(w3, showWeeklyLv) ? w3 : na)
    supM := f_maxBelow(supM, close, f_lvOn(w4, showWeeklyLv) ? w4 : na)
    supM := f_maxBelow(supM, close, f_lvOn(d1, showDailyLv) ? d1 : na)
    supM := f_maxBelow(supM, close, f_lvOn(d2, showDailyLv) ? d2 : na)
    supM := f_maxBelow(supM, close, f_lvOn(d3, showDailyLv) ? d3 : na)
    supM := f_maxBelow(supM, close, f_lvOn(d4, showDailyLv) ? d4 : na)
    supM := f_maxBelow(supM, close, ovTlS_live ? v_tlLo : na)      // your trendline counts as yours
    float supA = na                                                // AUTO pool (the machine's)
    supA := f_maxBelow(supA, close, avwap)
    supA := f_maxBelow(supA, close, ema20)
    supA := f_maxBelow(supA, close, d_sma50)
    supA := f_maxBelow(supA, close, d_sma200)
    supA := f_maxBelow(supA, close, fib_50)
    supA := f_maxBelow(supA, close, fib_618)
    supA := f_maxBelow(supA, close, fib_e1)
    supA := f_maxBelow(supA, close, fib_e2)
    supA := f_maxBelow(supA, close, v_S1)
    supA := f_maxBelow(supA, close, ll52)
    supA := f_maxBelow(supA, close, ovTlS_live ? na : v_tlLo)      // the auto-fit trendline
    float supN = na
    if ov_priority and not na(supM)
        supN := supM                                               // your side — auto ignored
    else
        supN := supA
        supN := f_maxBelow(supN, close, supM)                      // flat nearest-wins

    float resM = na                                                // MANUAL pool (yours)
    resM := f_minAbove(resM, close, f_lvOn(m1, showMonthlyLv) ? m1 : na)
    resM := f_minAbove(resM, close, f_lvOn(m2, showMonthlyLv) ? m2 : na)
    resM := f_minAbove(resM, close, f_lvOn(m3, showMonthlyLv) ? m3 : na)
    resM := f_minAbove(resM, close, f_lvOn(m4, showMonthlyLv) ? m4 : na)
    resM := f_minAbove(resM, close, f_lvOn(w1, showWeeklyLv) ? w1 : na)
    resM := f_minAbove(resM, close, f_lvOn(w2, showWeeklyLv) ? w2 : na)
    resM := f_minAbove(resM, close, f_lvOn(w3, showWeeklyLv) ? w3 : na)
    resM := f_minAbove(resM, close, f_lvOn(w4, showWeeklyLv) ? w4 : na)
    resM := f_minAbove(resM, close, f_lvOn(d1, showDailyLv) ? d1 : na)
    resM := f_minAbove(resM, close, f_lvOn(d2, showDailyLv) ? d2 : na)
    resM := f_minAbove(resM, close, f_lvOn(d3, showDailyLv) ? d3 : na)
    resM := f_minAbove(resM, close, f_lvOn(d4, showDailyLv) ? d4 : na)
    resM := f_minAbove(resM, close, ovTlR_live ? v_tlUp : na)
    float resA = na                                                // AUTO pool
    resA := f_minAbove(resA, close, hh52)
    resA := f_minAbove(resA, close, ema20)
    resA := f_minAbove(resA, close, d_sma50)
    resA := f_minAbove(resA, close, d_sma200)
    resA := f_minAbove(resA, close, fib_50)
    resA := f_minAbove(resA, close, fib_618)
    resA := f_minAbove(resA, close, fib_e1)
    resA := f_minAbove(resA, close, fib_e2)
    resA := f_minAbove(resA, close, v_R1)
    resA := f_minAbove(resA, close, ovTlR_live ? na : v_tlUp)
    float resN = na
    if ov_priority and not na(resM)
        resN := resM
    else
        resN := resA
        resN := f_minAbove(resN, close, resM)
    // Which pool won, and — if it was yours — at what TIMEFRAME? The TF is the point:
    // a stop sitting on a WEEKLY level is a deeper distal and therefore a wider stop
    // and a SMALLER size (Gate 4). Reading "1718.00 −2.1%" without knowing whether
    // that floor is a daily shelf or a monthly one is how a position gets mis-sized.
    string supSrc = (not na(supM) and supN == supM) ? (" ·" + (f_lvTf(supN) != "" ? f_lvTf(supN) : "man")) : ""
    string resSrc = (not na(resM) and resN == resM) ? (" ·" + (f_lvTf(resN) != "" ? f_lvTf(resN) : "man")) : ""
    float supPct = (not na(supN) and close > 0) ? (close - supN) / close * 100 : na
    float resPct = (not na(resN) and close > 0) ? (resN - close) / close * 100 : na
    bool   bullish  = stage == 2 or str.contains(setup, "reversal")
    float  pEntry   = close
    // v2.1 FIX4: structural stop, but the PLAN never risks more than stop_cap×ATR
    float  pStopRaw = na(supN) ? close - 2.0 * atr14 : supN * 0.995
    float  pStopCapL = close - stop_cap * atr14
    bool   pStopCapped = pStopRaw < pStopCapL
    float  pStop    = pStopCapped ? pStopCapL : pStopRaw
    float  pT1      = na(resN) ? hh52 : resN
    float  pRR      = (pEntry - pStop) > 0 and not na(pT1) ? (pT1 - pEntry) / (pEntry - pStop) : na
    float  pRiskPct = pEntry > 0 ? (pEntry - pStop) / pEntry * 100 : na
    string stg_txt = stage == 2 ? "Stage 2 ✓" : stage == 1 ? "Stage 1" : stage == 3 ? "Stage 3 ⚠" : stage == 4 ? "Stage 4 ✗" : "—"
    color  stg_col = stage == 2 ? color.lime : stage == 1 ? color.yellow : stage == 3 ? color.orange : stage == 4 ? color.red : color.gray
    color  rs_col  = rs_pos ? color.lime : color.red
    color  vd_col  = str.contains(verdict, "EXIT") ? color.red : (str.contains(verdict, "Buy") or str.contains(verdict, "long") or str.contains(verdict, "Breakout")) ? color.lime : color.silver

    // === descriptive annotations (MCP-style full-sentence notes at key levels) ===
    // (Headline summary intentionally omitted — that read lives in the panel.)
    if show_notes
        if not na(resN)
            lbResN := label.new(bar_index + 2, resN, "Resistance " + str.tostring(resN, format.mintick) + " (+" + str.tostring(resPct, "0.0") + "%) — overhead supply / first target; a clean break = continuation", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_52h, 82), textcolor=c_52h, size=size.small)
        if not na(supN)
            lbSupN := label.new(bar_index + 2, supN, "Support " + str.tostring(supN, format.mintick) + " (−" + str.tostring(supPct, "0.0") + "%) — nearest floor (AVWAP/MA/Fib); stop reference / buy-the-dip", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_up, 82), textcolor=c_up, size=size.small)
        if not na(avwap)
            lbAvwN := label.new(bar_index + 2, avwap, "AVWAP " + str.tostring(avwap, format.mintick) + (close > avwap ? " — price ABOVE: Stage-2 cost basis holding as support" : " — price BELOW: cost basis flipped to resistance (caution)"), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_avwap, 82), textcolor=c_avwap, size=size.small)

    // --- compact panel ---
    if show_panel
        if na(panel)
            panel := table.new(panel_pos, 2, 17, border_width=1, border_color=color.gray)
        color  hdrbg   = color.new(#1A237E, 0)
        color  valbg   = color.new(#131722, 0)

        table.cell(panel, 0, 0, "◧ MARKUP", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 0, syminfo.ticker + " · " + timeframe.period, bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        
        table.cell(panel, 0, 1, "STAGE", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 1, stg_txt + " · " + str.tostring(barsInStage) + "b", bgcolor=valbg, text_color=stg_col, text_size=size.small)
        
        table.cell(panel, 0, 2, "RS (MANSFIELD)", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 2, (na(mansfield) ? "n/a" : str.tostring(mansfield, "0.0")) + rsArrow + (rs_pos ? " leads" : " lags"), bgcolor=valbg, text_color=rs_col, text_size=size.small)
        
        table.cell(panel, 0, 3, "SETUP", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 3, setup, bgcolor=valbg, text_color=color.white, text_size=size.small)
        
        table.cell(panel, 0, 4, "TREND", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 4, geom + (apexTxt == "—" ? "" : " · apex " + apexTxt), bgcolor=valbg, text_color=color.silver, text_size=size.small)
        
        table.cell(panel, 0, 5, "CONVICTION", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 5, convTxt + " (" + str.tostring(conv) + "/7)", bgcolor=valbg, text_color=convCol, text_size=size.small)
        
        table.cell(panel, 0, 6, "── LEVELS ──", bgcolor=hdrbg, text_color=color.silver, text_size=size.tiny)
        table.cell(panel, 1, 6, "", bgcolor=hdrbg, text_size=size.tiny)
        
        table.cell(panel, 0, 7, "RESISTANCE", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 7, na(resN) ? "—" : str.tostring(resN, format.mintick) + (na(resPct) ? "" : "  +" + str.tostring(resPct, "0.0") + "%") + resSrc, bgcolor=valbg, text_color=resSrc != "" ? c_manual : color.new(c_52h, 0), text_size=size.small)
        
        table.cell(panel, 0, 8, "SUPPORT", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 8, na(supN) ? "—" : str.tostring(supN, format.mintick) + (na(supPct) ? "" : "  −" + str.tostring(supPct, "0.0") + "%") + supSrc, bgcolor=valbg, text_color=supSrc != "" ? c_manual : color.new(c_up, 0), text_size=size.small)
        
        table.cell(panel, 0, 9, "AVWAP", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 9, na(avwap) ? "n/a" : str.tostring(avwap, format.mintick) + (close > avwap ? " ✓" : " ✗"), bgcolor=valbg, text_color=color.new(c_avwap, 0), text_size=size.small)
        
        table.cell(panel, 0, 10, "TL BREAK @", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 10, (na(v_tlUp) ? "▲ —" : "▲ " + str.tostring(v_tlUp, format.mintick)) + "  ·  " + (na(v_tlLo) ? "▼ —" : "▼ " + str.tostring(v_tlLo, format.mintick)), bgcolor=valbg, text_color=color.silver, text_size=size.small)

        table.cell(panel, 0, 11, "PATTERNS", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 11, pats, bgcolor=valbg, text_color=color.new(c_pat, 0), text_size=size.small)

        table.cell(panel, 0, 12, "── PLAN ──", bgcolor=hdrbg, text_color=color.silver, text_size=size.tiny)
        table.cell(panel, 1, 12, "", bgcolor=hdrbg, text_size=size.tiny)

        table.cell(panel, 0, 13, "ENTRY", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 13, bullish ? str.tostring(pEntry, format.mintick) : "—", bgcolor=valbg, text_color=color.white, text_size=size.small)

        table.cell(panel, 0, 14, "STOP", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 14, bullish ? str.tostring(pStop, format.mintick) + (na(pRiskPct) ? "" : "  (−" + str.tostring(pRiskPct, "0.0") + "%)") + (pStopCapped ? " ⚠cap" : "") : "—", bgcolor=valbg, text_color=color.new(c_dn, 0), text_size=size.small)

        table.cell(panel, 0, 15, "TARGET · R:R", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 15, (bullish and not na(pT1)) ? str.tostring(pT1, format.mintick) + (na(pRR) ? "" : "  (" + str.tostring(pRR, "0.0") + "R)") : "—", bgcolor=valbg, text_color=color.new(c_up, 0), text_size=size.small)

        table.cell(panel, 0, 16, "VERDICT", bgcolor=hdrbg, text_color=color.white, text_size=size.small)
        table.cell(panel, 1, 16, verdict, bgcolor=valbg, text_color=vd_col, text_size=size.small)

    // === v2.2 ALERT EVENTS — one-shot edges (fire once when the state flips) ===
    // v2.5: breaks use Murphy's penetration filter (brk_atr × ATR beyond the
    // line), volatility-adjusted — not the touch tolerance.
    float brkF = brk_atr * atr14
    bool _nUp = not na(v_tlUp) and close > v_tlUp + brkF
    ev_tl_up := _nUp and not pv_tl_up
    pv_tl_up := _nUp
    bool _nDn = not na(v_tlLo) and close < v_tlLo - brkF
    ev_tl_dn := _nDn and not pv_tl_dn
    pv_tl_dn := _nDn
    bool _nR = not na(v_R1) and close > v_R1 + brkF
    ev_r_brk := _nR and not pv_r_brk
    pv_r_brk := _nR
    bool _nS = not na(v_S1) and close < v_S1 - brkF
    ev_s_brk := _nS and not pv_s_brk
    pv_s_brk := _nS

    // === v2.5 THROWBACK memory (Magee/Murphy) — freeze a just-broken trendline
    // and keep it on the chart in its FLIPPED role for ~40 bars; the retest of
    // the broken line is the classic low-risk entry. ===
    if ev_tl_up and not na(v_tlUpSlope)
        brkUpBar := bar_index
        brkUpY   := v_tlUp
        brkUpSlp := v_tlUpSlope
    if ev_tl_dn and not na(v_tlLoSlope)
        brkDnBar := bar_index
        brkDnY   := v_tlLo
        brkDnSlp := v_tlLoSlope
    line.delete(lnBrkUp)
    label.delete(lbBrkUp)
    line.delete(lnBrkDn)
    label.delete(lbBrkDn)
    if not na(brkUpBar) and bar_index - brkUpBar <= 40
        float byNow = brkUpY + brkUpSlp * (bar_index - brkUpBar)
        lnBrkUp := line.new(brkUpBar - 10, brkUpY - 10 * brkUpSlp, bar_index, byNow, xloc=xloc.bar_index, color=color.new(c_up, 35), width=1, style=line.style_dashed)
        lbBrkUp := label.new(bar_index, byNow, "broken TL → retest = support", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_up, 85), textcolor=c_up, size=size.small)
    if not na(brkDnBar) and bar_index - brkDnBar <= 40
        float byNow2 = brkDnY + brkDnSlp * (bar_index - brkDnBar)
        lnBrkDn := line.new(brkDnBar - 10, brkDnY - 10 * brkDnSlp, bar_index, byNow2, xloc=xloc.bar_index, color=color.new(c_dn, 35), width=1, style=line.style_dashed)
        lbBrkDn := label.new(bar_index, byNow2, "broken TL → retest = resistance", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_dn, 85), textcolor=c_dn, size=size.small)
    bool _nPat = str.contains(pats, "✓break")
    ev_pat := _nPat and not pv_pat
    pv_pat := _nPat
    bool _nPB = str.contains(setup, "SWG-PB") and close > d_sma50
    ev_pb := _nPB and not pv_pb
    pv_pb := _nPB
    bool _nCv = conv >= 6
    ev_conv := _nCv and not pv_conv
    pv_conv := _nCv

// === v2.2 ALERTS — create from the TradingView alert dialog (condition list) ===
alertcondition(ev_tl_up, "Markup: trendline breakout",  "Close broke ABOVE the auto resistance trendline (EMA20-confluent line)")
alertcondition(ev_tl_dn, "Markup: trendline breakdown", "Close broke BELOW the auto support trendline")
alertcondition(ev_r_brk, "Markup: resistance cluster break", "Close broke above the R1 pivot cluster")
alertcondition(ev_s_brk, "Markup: support cluster break",    "Close broke below the S1 pivot cluster")
alertcondition(ev_pat,   "Markup: pattern neckline ✓break",  "A Double/Triple Top-Bottom or H&S neckline break just confirmed")
alertcondition(ev_pb,    "Markup: SWG-PB trigger",  "Stage-2 pullback setup reclaimed the daily 50-MA")
alertcondition(ev_conv,  "Markup: conviction STRONG", "Conviction score crossed to 6+/7")
alertcondition(ta.change(stage) != 0, "Markup: Weinstein stage change", "Weekly stage classification changed")

// Anchored VWAP — the true evolving curve (overlay)
plot(show_avwap ? avwap : na, "Anchored VWAP", color=color.new(c_avwap, 0), linewidth=2)

// data-window plots for screener columns
plot(stage, "Stage", display=display.data_window)
plot(mansfield, "Mansfield RS", display=display.data_window)
plot(avwap, "AVWAP", display=display.data_window)
